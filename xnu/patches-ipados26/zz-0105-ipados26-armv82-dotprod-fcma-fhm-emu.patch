+static inline bool
+sweet_fp64_isnan(uint64_t d)
+{
+	return (d & 0x7FFFFFFFFFFFFFFFULL) > 0x7FF0000000000000ULL;
+}
+
+static inline bool
+sweet_fp64_isinf(uint64_t d)
+{
+	return (d & 0x7FFFFFFFFFFFFFFFULL) == 0x7FF0000000000000ULL;
