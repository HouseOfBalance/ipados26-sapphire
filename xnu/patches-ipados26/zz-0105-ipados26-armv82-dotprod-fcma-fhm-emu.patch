+static uint32_t
+sweet_norm124_to_fp32(uint32_t sign, int e_norm, unsigned __int128 m_norm)
+{
+	if (e_norm > 127) {
+		return sign | 0x7F800000U;
+	}
+	if (e_norm < -150) {
+		return sign;
+	}
+	if (e_norm == -150) {
+		return (m_norm > ((unsigned __int128)1U << 124)) ? (sign | 1U) : sign;
+	}
+	int shift;
+	uint32_t biased_exp;
+	if (e_norm >= -126) {
+		biased_exp = (uint32_t)(e_norm + 127);
+		shift = 101;
+	} else {
+		biased_exp = 0;
+		shift = -25 - e_norm;
+	}
+	uint32_t mant = (uint32_t)(m_norm >> shift);
+	unsigned __int128 half = (unsigned __int128)1U << (shift - 1);
+	unsigned __int128 rem = m_norm & (((unsigned __int128)1U << shift) - 1U);
+	bool round_up = (rem > half) || (rem == half && (mant & 1U));
+	uint32_t res = sign | (biased_exp << 23) | (biased_exp > 0 ? (mant & 0x7FFFFFU) : mant);
+	if (round_up) {
+		res++;
+	}
+	return res;
+}
