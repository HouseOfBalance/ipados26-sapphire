+/*
+ * Pure-integer ARMv8.2 FEAT_DotProd (SDOT / UDOT), ARMv8.2 FEAT_FHM
+ * (FMLAL / FMLSL / FMLAL2 / FMLSL2), and ARMv8.3 FEAT_FCMA (FCADD / FCMLA)
+ * trap emulator for Kryo 260 (Cortex-A73/A53, ARMv8.0-A).
+ *
+ * Compiles cleanly under -mgeneral-regs-only with zero FP/SIMD types:
+ * binary32 and binary64 fused multiply-add and complex operations use exact
+ * 128-bit / 256-bit integer significand alignment with IEEE-754 RNE rounding.
+ */
+static inline int
+sweet_u128_msb(unsigned __int128 x)
+{
+	uint64_t hi = (uint64_t)(x >> 64);
+	if (hi != 0) {
+		return 127 - __builtin_clzll(hi);
+	}
+	return 63 - __builtin_clzll((uint64_t)x);
+}
