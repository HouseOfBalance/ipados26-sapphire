+static bool
+sweet_emulate_dotprod_fcma_fhm(arm_saved_state_t *state, uint32_t instr)
+{
+	/* 0. ARMv8.4/v8.5 FEAT_FlagM / FEAT_FlagM2: CFINV, XAFLAG, AXFLAG (integer PSTATE.NZCV) */
+	if (instr == 0xD500401FU) {
+		set_saved_state_cpsr(state, get_saved_state_cpsr(state) ^ (1U << 29));
+		add_saved_state_pc(state, 4);
+		return true;
+	}
+	if (instr == 0xD500403FU) {
+		uint32_t cpsr = get_saved_state_cpsr(state);
+		uint32_t z = (cpsr >> 30) & 1U, c = (cpsr >> 29) & 1U;
+		uint32_t nzcv = (((~c & ~z) & 1U) << 3) | ((z & c) << 2) | ((c | z) << 1) | ((~c & z) & 1U);
+		set_saved_state_cpsr(state, (cpsr & ~0xF0000000U) | (nzcv << 28));
+		add_saved_state_pc(state, 4);
+		return true;
+	}
+	if (instr == 0xD500405FU) {
+		uint32_t cpsr = get_saved_state_cpsr(state);
+		uint32_t z = (cpsr >> 30) & 1U, c = (cpsr >> 29) & 1U, v = (cpsr >> 28) & 1U;
+		uint32_t nzcv = ((z | v) << 2) | ((c & ~v & 1U) << 1);
+		set_saved_state_cpsr(state, (cpsr & ~0xF0000000U) | (nzcv << 28));
+		add_saved_state_pc(state, 4);
+		return true;
+	}
+
+	thread_t th = current_thread();
+	if (th == THREAD_NULL || th->machine.uNeon == NULL) {
+		return false;
+	}
+	arm_neon_saved_state64_t *ns = neon_state64(th->machine.uNeon);
+	uint32_t rd = instr & 31U, rn = (instr >> 5) & 31U, rm = (instr >> 16) & 31U;
+
