+static inline uint64_t
+sweet_q_get_d(const arm_neon_saved_state64_t *ns, uint32_t reg, uint32_t lane)
+{
+	__uint128_t q = ns->v.q[reg];
+	return (uint64_t)(q >> (64U * lane));
+}
+
+static inline bool
+sweet_fp32_isnan(uint32_t s)
+{
+	return (s & 0x7FFFFFFFU) > 0x7F800000U;
+}
+
+static inline bool
+sweet_fp32_isinf(uint32_t s)
+{
+	return (s & 0x7FFFFFFFU) == 0x7F800000U;
+}
+
+static uint32_t
+sweet_fp16_to_fp32_bits(uint16_t h)
+{
+	uint32_t sign = (uint32_t)(h & 0x8000U) << 16;
+	uint32_t exp = (h >> 10) & 0x1FU;
+	uint32_t frac = h & 0x03FFU;
+	if (exp == 0x1FU) {
+		return frac != 0 ? 0x7FC00000U : (sign | 0x7F800000U);
+	}
+	if (exp == 0) {
+		if (frac == 0) {
+			return sign;
+		}
+		int msb = 31 - __builtin_clz(frac);
+		uint32_t e32 = (uint32_t)(103 + msb);
+		uint32_t f32 = (frac ^ (1U << msb)) << (23 - msb);
+		return sign | (e32 << 23) | f32;
+	}
+	return sign | ((exp + 112U) << 23) | (frac << 13);
+}
+
+static inline int
+sweet_fp32_unpack(uint32_t s, uint32_t *mant_out)
+{
+	uint32_t exp = (s >> 23) & 0xFFU;
+	uint32_t frac = s & 0x7FFFFFU;
+	if (exp == 0) {
+		int lz = __builtin_clz(frac) - 8;
+		*mant_out = frac << lz;
+		return -126 - lz;
+	}
+	*mant_out = (1U << 23) | frac;
+	return (int)exp - 127;
+}
