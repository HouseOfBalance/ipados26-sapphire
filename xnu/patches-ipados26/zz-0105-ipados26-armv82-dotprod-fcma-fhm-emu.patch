+	int ce = sweet_fp32_unpack(addend, &mc);
+	uint32_t csign = addend & 0x80000000U;
+	unsigned __int128 c_m124 = (unsigned __int128)mc << 101;
+
+	bool p_ge_c = (pe > ce) || (pe == ce && p_m124 >= c_m124);
+	uint32_t s_big = p_ge_c ? psign : csign;
+	uint32_t s_sml = p_ge_c ? csign : psign;
+	int e_big = p_ge_c ? pe : ce;
+	int diff = p_ge_c ? (pe - ce) : (ce - pe);
+	unsigned __int128 m_big = p_ge_c ? p_m124 : c_m124;
+	unsigned __int128 m_sml = p_ge_c ? c_m124 : p_m124;
