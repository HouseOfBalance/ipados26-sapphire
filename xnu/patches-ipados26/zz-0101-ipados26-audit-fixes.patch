--- a/bsd/dev/sweet_bt.c
+++ b/bsd/dev/sweet_bt.c
@@ -903,11 +903,11 @@ static int
 qcabt_close(__unused dev_t dev, __unused int flags, __unused int devtype, __unused struct proc *p)
 {
 	bt_rx_run = false;
-	for (int i = 0; i < 200 && bt_rx_alive; i++) {
+	while (bt_rx_alive) {
 		IOSleep(1);
 	}
-	bt_open_flag = false;
 	lck_mtx_lock(&sweet_bt_mtx);
+	bt_open_flag = false;
 	btlog("/dev/qcabt closed: rx overrun %u, parity/framing %u, break %u, ring drops %u", bt_ovr, bt_par, bt_brk, bt_rdrops);
