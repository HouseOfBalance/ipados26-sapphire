-	    pv_bytes, pv_seq, pv_latest);
-	return pv_seq != 0 ? 0 : EIO;
+	uint64_t wait_ms = 300;
+	if (slot == 0 && cam_frame_ns / 1000000ull * 2 + 100 > wait_ms) {
+		wait_ms = cam_frame_ns / 1000000ull * 2 + 100;
+		if (wait_ms > 3000) {
+			wait_ms = 3000;
+		}
+	}
+	uint64_t waited = 0;
+	while (waited < wait_ms && pv_seq == 0) {
+		IOSleep(10);
+		waited += 10;
+	}
+	if (waited < 300 && pv_seq != 0) {
+		IOSleep(50);
