+
+void
+SapphireGPUClient::stopReapTimer(void)
+{
+	thread_call_t t = NULL;
+	if (service_lock != NULL) {
+		IOLockLock(service_lock);
+		fReapTimerArmed = false;
+		t = fReapTimer;
+		fReapTimer = NULL;
+		IOLockUnlock(service_lock);
+	} else {
+		fReapTimerArmed = false;
+		t = fReapTimer;
+		fReapTimer = NULL;
+	}
