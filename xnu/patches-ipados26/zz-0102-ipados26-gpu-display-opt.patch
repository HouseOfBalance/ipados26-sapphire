+static inline uint32_t
+sweet_fb_blend_one(uint32_t fg, uint32_t bg)
+{
+	uint32_t a8 = fg >> 24;
+	if (a8 == 0xffu) {
+		return fg;
+	}
+	if (a8 == 0u) {
+		return bg;
+	}
+	uint32_t ia = 255u - a8;
+	uint32_t rb = (bg & 0x00ff00ffu) * ia + 0x00800080u;
+	rb = ((rb + ((rb >> 8) & 0x00ff00ffu)) >> 8) & 0x00ff00ffu;
+	uint32_t g = ((bg >> 8) & 0xffu) * ia + 0x80u;
+	g = ((g + (g >> 8)) >> 8) << 8;
+	uint32_t b_out = (fg & 0xffu) + (rb & 0xffu);
+	uint32_t g_out = ((fg >> 8) & 0xffu) + ((g >> 8) & 0xffu);
+	uint32_t r_out = ((fg >> 16) & 0xffu) + ((rb >> 16) & 0xffu);
+	if (b_out > 255u) {
+		b_out = 255u;
+	}
+	if (g_out > 255u) {
+		g_out = 255u;
+	}
+	if (r_out > 255u) {
+		r_out = 255u;
+	}
+	return 0xff000000u | (r_out << 16) | (g_out << 8) | b_out;
+}
