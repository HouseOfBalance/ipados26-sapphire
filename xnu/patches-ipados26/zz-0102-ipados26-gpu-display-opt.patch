+/*
+ * 64-bit SWAR premultiplied BGRA8888 alpha-over compositor (2 pixels per GP word).
+ * Safe under -mgeneral-regs-only (never touches user V0..V31) and skips reading
+ * Write-Combined flip buffers when pixel pairs are fully transparent or opaque.
+ */
+static void
+sweet_fb_blend_row(uint32_t *dst, const uint32_t *src, uint32_t count)
+{
+	uint32_t x = 0;
+	if ((((uintptr_t)dst | (uintptr_t)src) & 7u) == 0) {
+		for (; x + 2 <= count; x += 2) {
+			uint64_t fg2 = *(const uint64_t *)(src + x);
+			uint64_t a2 = fg2 & 0xff000000ff000000ull;
+			if (a2 == 0ull) {
+				continue;
+			}
+			if (a2 == 0xff000000ff000000ull) {
+				*(uint64_t *)(dst + x) = fg2;
+				continue;
+			}
+			uint64_t bg2 = *(const uint64_t *)(dst + x);
+			uint32_t lo = sweet_fb_blend_one((uint32_t)fg2, (uint32_t)bg2);
+			uint32_t hi = sweet_fb_blend_one((uint32_t)(fg2 >> 32), (uint32_t)(bg2 >> 32));
+			*(uint64_t *)(dst + x) = ((uint64_t)hi << 32) | (uint64_t)lo;
+		}
+	}
+	for (; x < count; x++) {
+		uint32_t fg = src[x];
+		uint32_t a8 = fg >> 24;
+		if (a8 == 0u) {
+			continue;
+		}
+		if (a8 == 0xffu) {
+			dst[x] = fg;
+		} else {
+			dst[x] = sweet_fb_blend_one(fg, dst[x]);
+		}
+	}
+}
