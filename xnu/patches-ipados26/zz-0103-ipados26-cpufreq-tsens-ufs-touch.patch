+/* ---------------------------------------------------------------- TSENS0 v2.3 */
+
+static bool
+sweet_tsens_map_locked(void)
+{
+	if (tsens_srot_base == 0) {
+		tsens_srot_base = ml_io_map(TSENS0_SROT_PA, 0x1000);
+	}
+	if (tsens_tm_base == 0) {
+		tsens_tm_base = ml_io_map(TSENS0_TM_PA, 0x1000);
+	}
+	if (tsens_srot_base == 0 || tsens_tm_base == 0) {
+		return false;
+	}
+	uint32_t ctrl = *(volatile uint32_t *)(tsens_srot_base + TSENS_SROT_CTRL);
+	return (ctrl & 1u) != 0;
+}
+
+static int
+sweet_tsens_read_sensor_mc(vm_offset_t tm, uint32_t idx, int *mc_out)
+{
+	if (idx >= TSENS_MAX_SENSORS) {
+		return -1;
+	}
+	uint32_t st = *(volatile uint32_t *)(tm + TSENS_TM_SN_STATUS + 4u * idx);
+	if (!(st & TSENS_VALID_BIT)) {
+		st = *(volatile uint32_t *)(tm + TSENS_TM_SN_STATUS + 4u * idx);
+		if (!(st & TSENS_VALID_BIT)) {
+			return -1;
+		}
+	}
+	int32_t deci_c = (int32_t)(st & 0xfffu);
+	if (deci_c & 0x800) {
+		deci_c -= 0x1000;
+	}
+	if (deci_c < -200 || deci_c > 1400) {
+		return -1;
+	}
+	*mc_out = deci_c * 100;
 	return 0;
 }
 
+static int
+sweet_tsens_max_mc(void)
+{
+	int max_mc = -100000;
+	lck_mtx_lock(&sweet_cpufreq_lock);
+	if (sweet_tsens_map_locked()) {
+		for (uint32_t i = 0; i < TSENS_MAX_SENSORS; i++) {
+			int mc = 0;
+			if (sweet_tsens_read_sensor_mc(tsens_tm_base, i, &mc) == 0 && mc > max_mc) {
+				max_mc = mc;
+			}
+		}
+	}
+	lck_mtx_unlock(&sweet_cpufreq_lock);
+	return max_mc > -40000 ? max_mc : -1;
+}
