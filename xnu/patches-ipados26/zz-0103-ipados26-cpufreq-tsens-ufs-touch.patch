+int
+sweet_cpufreq_max(void)
+{
+	if (!sweet_cpufreq_enabled()) {
+		return 0;
+	}
+	lck_mtx_lock(&sweet_cpufreq_lock);
+	uint32_t cap = sweet_cpu_max_freq > 300000 ? (uint32_t)sweet_cpu_max_freq : 2803200u;
+	int rc = sweet_cpufreq_apply_cap_locked(cap, true);
+	os_atomic_store(&cpufreq_at_target, 1, relaxed);
+	lck_mtx_unlock(&sweet_cpufreq_lock);
+	return rc;
