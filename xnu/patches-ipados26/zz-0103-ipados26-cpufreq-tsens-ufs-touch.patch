+static vm_offset_t
+sweet_cpufreq_map_locked(struct sweet_cpufreq_domain *dom)
+{
+	if (dom->base == 0) {
+		dom->base = ml_io_map(dom->pa, 0x1000);
+	}
+	if (dom->base != 0 && !dom->lut_ready) {
+		uint32_t prev = 0, best_row = 0, best_khz = 0, cnt = 0;
+		for (uint32_t i = 0; i < (uint32_t)CPUFREQ_LUT_MAX; i++) {
+			uint32_t khz = sweet_cpufreq_hw_lut_khz(dom->base, i);
+			if (i > 0 && khz == prev) {
+				break;  /* Qualcomm OSM repeats final valid OPP entry */
+			}
+			dom->lut_khz[i] = khz;
+			prev = khz;
+			cnt = i + 1;
+			if (khz > best_khz) {
+				best_khz = khz;
+				best_row = i;
+			}
+		}
+		if (cnt == 0) {
+			dom->lut_khz[0] = 300000u;
+			cnt = 1;
+			best_khz = 300000u;
+		}
+		dom->lut_count = cnt;
+		dom->max_row = best_row;
+		dom->max_khz = best_khz;
+		dom->cur_row = *(volatile uint32_t *)(dom->base + CPUFREQ_PERF_STATE);
+		dom->lut_ready = true;
+	}
+	return dom->base;
+}
