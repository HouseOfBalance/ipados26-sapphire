+void
+sweet_cpufreq_panel_notify(int awake)
+{
+	if (!sweet_cpufreq_enabled()) {
+		return;
+	}
+	os_atomic_store(&cpufreq_panel_awake, awake ? 1 : 0, relaxed);
+	lck_mtx_lock(&sweet_cpufreq_lock);
+	if (!awake) {
+		/* Drop Gold & Silver to 300 MHz floor immediately while panel is blanked */
+		(void)sweet_cpufreq_apply_cap_locked(300000u, false);
+		os_atomic_store(&cpufreq_at_target, 0, relaxed);
+	} else {
+		uint32_t cap = sweet_cpu_max_freq > 0 ? (uint32_t)sweet_cpu_max_freq : 2803200u;
+		(void)sweet_cpufreq_apply_cap_locked(cap, false);
+		os_atomic_store(&cpufreq_at_target, 1, relaxed);
+	}
+	lck_mtx_unlock(&sweet_cpufreq_lock);
+}
