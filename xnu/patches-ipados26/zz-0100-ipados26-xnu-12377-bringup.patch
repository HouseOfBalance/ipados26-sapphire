+	uint64_t band = (uint64_t)(vinfo.v_height / vinfo.v_rows) * vinfo.v_rowbytes;
+	if (bottom > vinfo.v_rows) {
+		bottom = vinfo.v_rows;
+	}
+	if (!panic_active()) {
+		/* batched: AppleCLCD cleans the dirty rows once per vsync */
+		if (sweet_dirty_top > top) {
+			sweet_dirty_top = top;
+		}
+		if (sweet_dirty_bottom < bottom) {
+			sweet_dirty_bottom = bottom;
+		}
+		return;
+	}
+	sweet_dcache_clean((vm_offset_t)(vinfo.v_baseaddr + top * band), (unsigned)((bottom - top) * band));
+	if (sweet_console_show_hook != NULL) {
+		sweet_console_show_hook();
+	}
+}
+
+/*
+ * Anything drawn since the last call? AppleCLCD's vsync then copies the
+ * shadow into its back buffer and flips (the shadow itself is not scanned).
+ */
+int
+sweet_console_copy_dirty(void *dst)
+{
+	if (sweet_shadow_va == 0) {
+		return 0;
+	}
+	/* under the putc lock: a scroll repaints the whole screen inside one
+	 * locked character, so the copy never catches it half done */
+	VCPUTC_LOCK_LOCK();
+	int dirty = sweet_dirty_bottom > sweet_dirty_top;
+	if (dirty) {
+		memcpy(dst, (const void *)sweet_shadow_va, (size_t)vinfo.v_rowbytes * vinfo.v_height);
+	}
+	sweet_dirty_top = ~0u;
+	sweet_dirty_bottom = 0;
+	VCPUTC_LOCK_UNLOCK();
+	return dirty;
+}
