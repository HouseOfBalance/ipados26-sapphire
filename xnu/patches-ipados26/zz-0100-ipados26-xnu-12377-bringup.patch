+	 * sapphire 0299: boot-arg sweet_splash (the boot screen, video_console.c): muted from the
+	 * start, the boot screen stays until iOS's first frame. The log still goes to the ring.
+	 */
+	static int sweet_splash = -1;
+	if (sweet_splash < 0) {
+		uint64_t v = 0;
+		sweet_splash = PE_parse_boot_argn("sweet_splash", &v, sizeof(v)) && v != 0;
+		if (sweet_splash) {
+			sweet_console_muted = 1;
+		}
+	}
+	if (sweet_console_muted && !panic_active()) {
+		return;
+	}
+	if (sweet_log_filter < 0) {
+		sweet_log_filter = PE_parse_boot_argn("sweetlog", sweet_log_words, sizeof(sweet_log_words)) &&
+		    sweet_log_words[0] != '\0';
+	}
+	if (sweet_log_filter > 0 && !panic_active()) {
+		/* collect whole lines; draw the ones that match */
+		while (size-- > 0) {
+			char ch = *c++;
+			if (sweet_log_len < (int)sizeof(sweet_log_line) - 1) {
+				sweet_log_line[sweet_log_len++] = ch;
+			}
+			if (ch == '\n') {
+				if (sweet_log_wanted(sweet_log_line, sweet_log_len) && !disableConsoleOutput) {
+					for (int i = 0; i < sweet_log_len; i++) {
+						_cnputc(sweet_log_line[i], poll);
+					}
+				}
+				sweet_log_len = 0;
+			}
+		}
+		return;
+	}
+#endif
+
 	if (disableConsoleOutput) {
 		return;
 	}
