+/* op 9's extra: the stream, the capture path and their clocks */
+static void
+cam_stream_off_all(void)
+{
+	pv_stop();
+	if (cam_csid != 0 && cam_csid_up) {
+		wr(cam_csid, 0x308, 0);
+		wr(cam_csid, 0x2300, 0);
+		wr(cam_csid, 0x1460, 0);
+		wr(cam_csid, 0x102C, 0x2);
+	}
+	if (cam_streaming && camss_up) {
+		(void)cam_stream_onoff(false);
+	}
+	if (cam_phy != 0 && cam_csid_up) {
+		wr(cam_phy, 0x814, 0);                          /* CSIPHY lanes off, reset */
+		wr(cam_phy, 0x800, 0x01);
+		IOSleep(1);
+		wr(cam_phy, 0x800, 0x00);
+	}
+	if (gcc != 0) {
+		branch_off("tfe_0", 0x5201Cu);
+		branch_off("tfe_0_cphy_rx", 0x5207Cu);
+		branch_off("tfe_0_csid", 0x520ACu);
+		for (unsigned n = 0; n < 3; n++) {
+			branch_off("csiphytimer", 0x59018u + 0x1Cu * n);
+			branch_off("cphy", 0x52088u + 4u * n);
+		}
+	}
+	cam_streaming = false;
+	cam_csid_up = false;
+	w_ready = false;
+	/* the RPM votes for L4/L18 stay: they are APPS' only vote on rails the display and USB PHYs share, at the values UEFI set */
+}
+
+/*
+ * 0277 op 6: both CCI buses' levels with every camera rail on (VIO, AVDD PM6125 GPIO2, DVDD PM7250B
+ * GPIO3) and no reset/MCLK change: an I2C bus at rest reads high on SDA and SCL; low means a
+ * device holds it (an unpowered sensor clamps it) or the pin is not on the bus.
+ */
+static int
+cam_bus_check(void)
+{
+	if (!camss_up) {
+		int r = camss_on();
+		if (r != 0) {
+			return r;
+		}
+	}
+	bool ok = pin_out(GPIO_VIO, 1) && avdd(1) && dvdd(1);
+	IOSleep(10);
+	for (unsigned i = 0; i < 4; i++) {
+		volatile uint32_t *g = tlmm_pin(cci_pins[i]);
+		camlog("CCI m%u %s gpio%u: ctl %#x level %u", i / 2, (i & 1) ? "SCL" : "SDA", cci_pins[i], g ? g[0] : 0, g ? (g[1] & 1) : 9);
+	}
+	camlog("op 6: rails %s", ok ? "on" : "NOT all on");
+	return ok ? 0 : EIO;
+}
+
+/* 0279: every register window and pin the camera code will ever touch, mapped once */
+static bool
+cam_premap(void)
+{
+	static bool done;
+	static const unsigned pins[] = { 18, 19, 20, 21, 22, 23, 24, 26, 27, 28, 29, 30, 34, 54, 68, 85, 83, 101 };
+	if (done) {
+		return true;
+	}
+	unsigned before = cam_maps;
+	for (unsigned i = 0; i < sizeof(pins) / sizeof(pins[0]); i++) {
+		if (tlmm_pin(pins[i]) == NULL) {
+			camlog("premap: gpio%u failed", pins[i]);
+			return false;
+		}
+	}
+	if (cci == 0) {
+		cci = cam_io(CCI_PA, 0x1000);
+		cpas = cam_io(CPAS_PA, 0x1000);
+	}
+	for (unsigned n = 0; n < 3; n++) {
+		if (cam_phys[n] == 0) {
+			cam_phys[n] = cam_io(CSIPHY_PA(n), 0x2000);
+		}
+	}
+	if (cam_ppi == 0) {
+		cam_ppi = cam_io(PPI_PA, 0x1000);
+		cam_csid = cam_io(CSID0_PA, 0x5000);
+	}
+	if (cam_smmu == 0) {
+		cam_smmu = cam_io(SMMU_PA, 0x80000);
+	}
+	bool ok = cci && cpas && cam_phys[0] && cam_phys[1] && cam_phys[2] && cam_ppi && cam_csid && cam_smmu && cam_pool_map();
+	camlog("premap: %u new mappings (%u in all, %llu KB) + the pool: %s", cam_maps - before, cam_maps, cam_map_bytes >> 10,
+	    ok ? "ok" : "FAILED");
+	done = ok;
+	return ok;
+}
+
+static int
+sysctl_sweet_cam SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	int v = cam_last;
+	int err = sysctl_io_number(req, v, sizeof(v), &v, NULL);
+	if (err != 0 || req->newptr == USER_ADDR_NULL) {
+		return err;
+	}
+	lck_mtx_lock(&sweet_cam_mtx);
+	cam_log_len = 0;
+	cam_log[0] = 0;
+	camlog("op %d", v);
+	int r;
+	switch (v) {
+	case 1:
+		r = camss_on();
+		break;
+	case 2: case 3: case 4: case 5:
+		r = slot_on((unsigned)(v - 2));
+		break;
+	case 6:
+		r = cam_bus_check();
+		break;
+	case 9:
+		r = cam_off();
+		break;
+	case 10:
+		r = cam_sensor_on();
+		break;
+	case 11:
+		r = cam_link_on();
+		link_slot = r == 0 ? (int)cs.slot : -1;
+		break;
+	case 12:
+		camlog("op 12 is split since 0274: 20 SMMU, 21 TFE read, 22 WM7 config, 23 capture");
+		r = EINVAL;
+		break;
+	case 20:
+		r = cam_smmu_stage();
+		break;
+	case 30:
+		r = pv_start();
+		break;
+	case 31:
+		pv_stop();
+		r = 0;
+		break;
+	case 32:
+		r = cam_still();
+		break;
+	case 21:
+		r = cam_tfe_read();
+		break;
+	case 22:
+		r = cam_wm_config();
+		break;
+	case 23:
+		r = cam_capture_staged();
+		break;
+	case 13:
+		r = cam_stop();
+		break;
+	case 14:
+		r = cam_pool_test();
+		break;
+	default:
+		r = EINVAL;
+		break;
+	}
+	camlog("op %d: %d (mappings %u, %llu KB)", v, r, cam_maps, cam_map_bytes >> 10);
+	cam_last = r;
+	lck_mtx_unlock(&sweet_cam_mtx);
+	return r;
+}
