+	b	5f
+20:	cmp	w1, #8
+	b.ne	21f
+	mov	\r\()11, \r\()2
+	b	5f
+21:	cmp	w1, #0
+	b.ne	22f
+	add	\r\()11, \r\()10, \r\()2
+	b	5f
+22:	cmp	w1, #1
+	b.ne	23f
+	bic	\r\()11, \r\()10, \r\()2
+	b	5f
+23:	cmp	w1, #2
+	b.ne	24f
+	eor	\r\()11, \r\()10, \r\()2
+	b	5f
+24:	cmp	w1, #3
+	b.ne	25f
+	orr	\r\()11, \r\()10, \r\()2
+	b	5f
+25:	\sxa
+	\sxb
+	cmp	w1, #4
+	b.ne	26f
+	cmp	\r\()12, \r\()13
+	csel	\r\()11, \r\()10, \r\()2, gt
+	b	5f
+26:	cmp	w1, #5
+	b.ne	27f
+	cmp	\r\()12, \r\()13
+	csel	\r\()11, \r\()10, \r\()2, lt
+	b	5f
+27:	cmp	\r\()10, \r\()2
+	csel	\r\()11, \r\()10, \r\()2, hi
