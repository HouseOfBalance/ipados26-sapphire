+{
+    _timeStamp = timeStamp;
+    if (type == kIOHIDEventTimestampTypeAbsolute) {
+        _options &= ~kIOHIDEventOptionContinuousTime;
+    } else if (type == kIOHIDEventTimestampTypeContinuous) {
+        _options |= kIOHIDEventOptionContinuousTime;
+    }
