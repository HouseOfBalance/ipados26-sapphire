diff --git a/bsd/dev/mem.c b/bsd/dev/mem.c
index c64e636..291a546 100644
--- a/bsd/dev/mem.c
+++ b/bsd/dev/mem.c
@@ -153,6 +153,44 @@ mmioctl(dev_t dev, u_long cmd, __unused caddr_t data,
 	return 0;
 }
 
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+/*
+ * SWEET: daemons started by launchd write stdout/stderr to /dev/null, and
+ * pointing a launchd job at /dev/console stops it from launching at all
+ * (backboardd, v8 image). Instead, what the processes named in boot-arg
+ * sweetnull (comma separated, default "backboardd,SpringBoard") write to
+ * /dev/null goes to the console (and so to the persistent log) as
+ * "|name| text". sweetnull=- turns it off.
+ */
+static char sweet_null_names[128];
+static int sweet_null_parsed;
+
+static bool
+sweet_null_tee(char *name, size_t len)
+{
+	if (!sweet_null_parsed) {
+		if (!PE_parse_boot_argn("sweetnull", sweet_null_names, sizeof(sweet_null_names))) {
+			strlcpy(sweet_null_names, "backboardd,SpringBoard", sizeof(sweet_null_names));
+		}
+		sweet_null_parsed = 1;
+	}
+	proc_selfname(name, (int)len);
+	size_t n = strlen(name);
+	for (const char *t = sweet_null_names; *t;) {
+		const char *end = strchr(t, ',');
+		size_t tl = end ? (size_t)(end - t) : strlen(t);
+		if (tl == n && n > 0 && strncmp(t, name, n) == 0) {
+			return true;
+		}
+		if (!end) {
+			break;
+		}
+		t = end + 1;
+	}
+	return false;
+}
+#endif
+
 int
 mmrw(dev_t dev, struct uio *uio, enum uio_rw rw)
 {
@@ -216,6 +254,22 @@ mmrw(dev_t dev, struct uio *uio, enum uio_rw rw)
 			if (rw == UIO_READ) {
 				return 0;
 			}
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+			{
+				char name[32];
+				if (sweet_null_tee(name, sizeof(name))) {
+					char buf[256];
+					c = MIN(uio_curriovlen(uio), sizeof(buf));
+					error = uiomove(buf, (int)c, uio);
+					if (error) {
+						break;
+					}
+					printf("|%s| %.*s%s", name, (int)c, buf,
+					    (c > 0 && buf[c - 1] == '\n') ? "" : "\n");
+					continue;
+				}
+			}
+#endif
 			c = uio_curriovlen(uio);
 
 			error = 0; /* Always succeeds, always consumes all input */
diff --git a/bsd/dev/sapphire_apple80211.c b/bsd/dev/sapphire_apple80211.c
new file mode 100644
index 0000000..9b2c551
--- /dev/null
+++ b/bsd/dev/sapphire_apple80211.c
@@ -0,0 +1,976 @@
+/*
+ * Ported from HackiOS (OOSEX GANG, github.com/oosexgang/hackios-xnu-kernel @8e61187098f2, bsd/dev/redwood_apple80211.c;
+ * Apple Public Source License 2.0, as the rest of XNU) for sapphire: renamed, and fed by the
+ * WCN3988 station of TopazModem.cpp through bsd/dev/sapphire_wlan.c instead of ath11k.
+ */
+/*
+ * Darwin on sapphire: Apple80211, answered in the kernel.
+ *
+ * iOS's Wi-Fi side -- wifid, and through it Settings and the status bar -- talks to a Wi-Fi
+ * driver in requests that were once ioctls and are, where the driver offers no user client,
+ * ioctls still: SIOCGA80211 and SIOCSA80211 on any socket, with a struct apple80211req that
+ * names the interface, a request type, a value, and a buffer in the caller's memory
+ * (IO80211.framework: Apple80211Get/Set and their kin all end there). XNU hands an interface
+ * ioctl it does not know to the interface, so they arrive in bsd/dev/sapphire_net.c, which
+ * passes them here when its link is a radio.
+ *
+ * What is asked is answered from the station boundary (sys/sapphire_sta.h): the radio's power,
+ * its channels, a scan and what it heard, the network joined. What happens there by itself is
+ * told to iOS the way a driver tells it: kernel events of class 6 (IEEE 802.11), subclass 1,
+ * whose code is Apple80211's own event number and whose data begins with the interface's name
+ * in 16 bytes (IO80211.framework reads them from a PF_SYSTEM socket and compares the name).
+ *
+ * Every request is still written to the log -- who asks, get or set, the type, the value, the
+ * length -- because which of them wifid needs is found that way. Never what a request carries:
+ * a network's name or its key may be in there.
+ *
+ * The request types and the layouts are Apple's. The old ones are as the headers of its open
+ * IO80211 sources once described them (apple80211_ioctl.h, apple80211_var.h); where iOS 16.5
+ * differs the layout was read out of IO80211.framework of 16.5, which fills and reads the same
+ * structures on the other side (Apple80211GetWithIOCTL, _getScanData, _addScanResultToList,
+ * _performAssociation, _dispatchAsyncAssocEvent, _dispatchLinkChangedEvent).
+ *
+ * A join: ASSOCIATE (20) carries the network's name, perhaps its access point, and the
+ * passphrase as typed (the framework does not make the key of it), and is answered at once;
+ * when the station has joined or failed, event 9 says so, and ASSOCIATE_RESULT (21) gives the
+ * outcome as one of Apple80211's result numbers, which the framework turns into its errors:
+ * 1 success, 21 "invalid PMK" (a wrong passphrase), 9 a timeout, 2 anything else.
+ */
+#include <kern/kalloc.h>
+#include <kern/locks.h>
+#include <libkern/libkern.h>
+#include <sys/errno.h>
+#include <sys/kern_event.h>
+#include <sys/kernel.h>
+#include <sys/proc.h>
+#include <sys/sapphire_net.h>
+#include <sys/sapphire_sta.h>
+#include <sys/sockio.h>
+#include <sys/systm.h>
+#include <sys/sysctl.h>
+
+/*
+ * 0322: how many times wifid has read the RSSI bounds, i.e. opened the device and gone on to power and
+ * scan. com.sapphire.wifidkick reads it 25 s into the boot and restarts wifid only if it is still 0
+ * (a wifid restarted when it was fine sat ~4.5 min before touching en0 again).
+ */
+static int sweet_wifid_opened;
+SYSCTL_INT(_kern, OID_AUTO, sweet_wifid_opened, CTLFLAG_RD | CTLFLAG_LOCKED, &sweet_wifid_opened, 0,
+    "sapphire: times wifid read RSSI_BOUNDS (the device opened)");
+
+#define SIOCSA80211             0x802869c8u     /* _IOW('i', 200, struct apple80211req) */
+#define SIOCGA80211             0xc02869c9u     /* _IOWR('i', 201, struct apple80211req) */
+
+struct apple80211req {
+	char req_if_name[16];
+	int32_t req_type;
+	int32_t req_val;
+	uint32_t req_len;
+	user_addr_t req_data __attribute__((aligned(8)));
+};
+
+/* (as far as they have come by: the names help reading the log) */
+static const char *
+type_name(int32_t type)
+{
+	static const struct {
+		int32_t type;
+		const char *name;
+	} names[] = {
+		{ 1, "SSID" }, { 2, "AUTH_TYPE" }, { 3, "CIPHER_KEY" }, { 4, "CHANNEL" }, { 5, "POWERSAVE" }, { 6, "PROTMODE" },
+		{ 7, "TXPOWER" }, { 8, "RATE" }, { 9, "BSSID" }, { 10, "SCAN_REQ" }, { 11, "SCAN_RESULT" }, { 12, "CARD_CAPABILITIES" },
+		{ 13, "STATE" }, { 14, "PHY_MODE" }, { 15, "OP_MODE" }, { 16, "RSSI" }, { 17, "NOISE" }, { 18, "INT_MIT" }, { 19, "POWER" },
+		{ 20, "ASSOCIATE" }, { 21, "ASSOCIATE_RESULT" }, { 22, "DISASSOCIATE" }, { 23, "STATUS_DEV_NAME" }, { 24, "IBSS_MODE" },
+		{ 25, "HOST_AP_MODE" }, { 26, "AP_MODE" }, { 27, "SUPPORTED_CHANNELS" }, { 28, "LOCALE" }, { 29, "DEAUTH" },
+		{ 30, "COUNTERMEASURES" }, { 32, "RATE_SET" }, { 42, "STATION_LIST" }, { 43, "DRIVER_VERSION" },
+		{ 44, "HARDWARE_VERSION" }, { 46, "RSN_IE" }, { 47, "BACKGROUND_SCAN" }, { 48, "AP_IE_LIST" }, { 49, "STATS" },
+		{ 50, "ASSOCIATION_STATUS" }, { 51, "COUNTRY_CODE" }, { 54, "RADIO_INFO" }, { 57, "MCS" }, { 66, "MCS_INDEX_SET" },
+		{ 79, "STA_STATS" }, { 80, "ROAM_THRESH" }, { 85, "IE" }, { 86, "SCAN_REQ_MULTIPLE" }, { 87, "BTCOEX_MODE" },
+		{ 90, "SCANCACHE_CLEAR" }, { 94, "VIRTUAL_IF_CREATE" }, { 95, "VIRTUAL_IF_DELETE" }, { 103, "CURRENT_NETWORK" },
+		{ 106, "RSSI_BOUNDS" }, { 107, "ROAM" }, { 207, "CHANNELS_INFO" }, { 254, "HW_SUPPORTED_CHANNELS" },
+	};
+
+	for (unsigned i = 0; i < sizeof(names) / sizeof(names[0]); i++) {
+		if (names[i].type == type) {
+			return names[i].name;
+		}
+	}
+	return "?";
+}
+
+/* ---- the layouts ------------------------------------------------------------------------------------------ */
+
+#define CHANNEL_20MHZ           0x2u
+#define CHANNEL_2GHZ            0x8u
+#define CHANNEL_5GHZ            0x10u
+#define CHANNEL_ACTIVE          0x80u           /* the radio may send there */
+#define CHANNEL_DFS             0x100u
+
+struct apple80211_channel {
+	uint32_t version, channel, flags;
+};
+
+/* SUPPORTED_CHANNELS (27) and HW_SUPPORTED_CHANNELS (254): 4824 bytes */
+struct apple80211_channels {
+	uint32_t version, count;
+	struct apple80211_channel channels[401];
+	uint32_t unused;
+};
+
+/* CHANNELS_INFO (207): 10016 bytes; of each channel a byte in each of several rows, and a word of flags */
+struct apple80211_channels_info {
+	uint8_t unknown_0[12];
+	uint16_t count;
+	uint8_t unknown_1[800];
+	uint8_t number[400], indoor[400], dfs[400], passive[400], wide_40[400], wide_80[400];
+	uint8_t unknown_2[1602];
+	uint32_t flags[400];
+	uint8_t unknown_3[3600];
+} __attribute__((packed));
+
+/* SCAN_REQ (10): 5456 bytes */
+struct apple80211_scan_request {
+	uint32_t version, bss_type;
+	uint8_t bssid[6], unused_0[2];
+	uint32_t ssid_length;
+	uint8_t ssid[32];
+	uint32_t scan_type;                     /* 1: asking, 2: listening only */
+	uint32_t phy_mode;
+	uint16_t dwell_ms, unused_1;
+	uint32_t rest_ms;
+	uint32_t channel_count;
+	struct apple80211_channel channels[400];
+	uint64_t flags;
+	uint32_t unused_2;
+	uint32_t name_count;                    /* networks asked for by name, each in 56 bytes */
+	uint8_t names[10][56];
+	uint32_t short_ssid, unused_3;
+};
+
+/* SCAN_RESULT (11) and CURRENT_NETWORK (103): 1164 bytes */
+struct apple80211_scan_result {
+	uint32_t version;
+	struct apple80211_channel channel;
+	uint16_t noise_known;
+	int16_t noise, snr, rssi;
+	uint16_t beacon_interval, capability;
+	uint8_t bssid[6];
+	uint8_t rate_count, unused_0;
+	uint32_t rates[15];                     /* Mbit/s */
+	uint8_t ssid_length, ssid[32], unused_1[3];
+	uint32_t age_ms;
+	uint8_t flags, unused_2;
+	uint16_t elements_length;               /* comes in as the room there is */
+	uint8_t elements[1024];
+};
+
+/* ASSOCIATE (20): 592 bytes; of what follows the key (the RSN element wifid built, flags) nothing is used */
+struct apple80211_assoc {
+	uint32_t version;
+	uint16_t mode, auth_lower, auth_upper, unused_0;
+	uint32_t ssid_length;
+	uint8_t ssid[32];
+	uint8_t bssid[6], unused_1[2];
+	uint32_t key_version, key_length, key_cipher;   /* cipher 10: a passphrase as typed; 6: the key (from 64 hex digits) */
+	uint16_t key_flags, key_index;
+	uint8_t key[64];
+	uint8_t rest[0x250 - 0x88];
+};
+
+#define CIPHER_PMK              6
+#define CIPHER_PASSPHRASE       10
+
+/* the link event's data (at least 32 bytes, or the framework drops the event) */
+struct apple80211_link_changed {
+	uint8_t down, unused_0[3];
+	int32_t rssi;
+	uint16_t snr, noise;
+	uint8_t unused_1[4];
+	uint8_t involuntary, unused_2[3];
+	uint32_t reason, subreason;
+	uint8_t unused_3[4];
+};
+
+_Static_assert(sizeof(struct apple80211_assoc) == 592 && offsetof(struct apple80211_assoc, key) == 0x48,
+    "the association request as iOS 16.5 has it");
+_Static_assert(sizeof(struct apple80211_link_changed) == 32 && offsetof(struct apple80211_link_changed, reason) == 0x14,
+    "the link event as iOS 16.5 reads it");
+_Static_assert(sizeof(struct apple80211_channels) == 4824, "the channel list as iOS 16.5 has it");
+_Static_assert(sizeof(struct apple80211_channels_info) == 10016 && offsetof(struct apple80211_channels_info, number) == 0x32e &&
+    offsetof(struct apple80211_channels_info, flags) == 0x12d0, "the channels' description as iOS 16.5 has it");
+_Static_assert(sizeof(struct apple80211_scan_request) == 5456 && offsetof(struct apple80211_scan_request, channels) == 0x48 &&
+    offsetof(struct apple80211_scan_request, flags) == 0x1308 && offsetof(struct apple80211_scan_request, names) == 0x1318,
+    "the scan request as iOS 16.5 has it");
+_Static_assert(sizeof(struct apple80211_scan_result) == 1164 && offsetof(struct apple80211_scan_result, ssid_length) == 0x60 &&
+    offsetof(struct apple80211_scan_result, age_ms) == 0x84 && offsetof(struct apple80211_scan_result, elements) == 0x8c,
+    "a scan's result as iOS 16.5 has it");
+
+/* Apple80211's events (APPLE80211_M_...) */
+enum { EVENT_POWER_CHANGED = 1, EVENT_SSID_CHANGED = 2, EVENT_BSSID_CHANGED = 3, EVENT_LINK_CHANGED = 4, EVENT_ASSOC_DONE = 9,
+       EVENT_SCAN_DONE = 10 };
+
+static const char interface_name[16] = "en0";
+
+/*
+ * 0294: the noise floor every answer reports. The firmware gives no noise figure; scan results and
+ * the link went out with noise 0 dBm, so CoreWiFi's auto-join saw every access point's
+ * signal-to-noise ratio below its minimum ("Below minimum RSSI threshold" for a network heard at
+ * -60 dBm) and never joined anything by itself, even with its password in the keychain.
+ */
+#define NOISE_FLOOR_DBM         (-95)
+
+static int16_t
+snr_of(int rssi)
+{
+	int snr = rssi - NOISE_FLOOR_DBM;
+	return (int16_t)(snr < 0 ? 0 : snr > 90 ? 90 : snr);
+}   /* (bsd/dev/sapphire_net.c makes one interface, and that is its name) */
+
+static LCK_GRP_DECLARE(apple80211_lock_group, "sapphire-apple80211");
+static LCK_MTX_DECLARE(apple80211_lock, &apple80211_lock_group);
+static unsigned result_next;                    /* which of what the last scan heard a SCAN_RESULT request gets next */
+static uint32_t join_result;                    /* of the last join asked for: 0 while it runs, then Apple80211's number */
+
+/* ---- channels ---------------------------------------------------------------------------------------- */
+
+static unsigned
+channel_number(unsigned frequency)
+{
+	return frequency == 2484 ? 14 : frequency < 4000 ? (frequency - 2407) / 5 : (frequency - 5000) / 5;
+}
+
+static unsigned
+channel_frequency(const struct apple80211_channel *channel)
+{
+	bool low = channel->flags & CHANNEL_2GHZ ? true : channel->flags & CHANNEL_5GHZ ? false : channel->channel <= 14;
+
+	if (channel->channel == 0 || channel->channel > 196 || (channel->flags & 0x2000)) {     /* (0x2000: 6 GHz) */
+		return 0;
+	}
+	return low ? (channel->channel == 14 ? 2484 : 2407 + 5 * channel->channel) : 5000 + 5 * channel->channel;
+}
+
+static void
+channel_fill(struct apple80211_channel *channel, unsigned frequency, unsigned flags)
+{
+	channel->version = 1;
+	channel->channel = channel_number(frequency);
+	channel->flags = CHANNEL_20MHZ | (frequency < 4000 ? CHANNEL_2GHZ : CHANNEL_5GHZ) | (flags & SAPPHIRE_STA_CHANNEL_PASSIVE ?
+	    0 : CHANNEL_ACTIVE) | (flags & SAPPHIRE_STA_CHANNEL_RADAR ? CHANNEL_DFS : 0);
+}
+
+/* ---- what the caller is given back ------------------------------------------------------------------- */
+
+/* At most as many bytes as it has room for. */
+static int
+give(const struct apple80211req *request, const void *data, size_t length)
+{
+	return request->req_data == USER_ADDR_NULL ? 0 : copyout(data, request->req_data, length < request->req_len ? length :
+	       request->req_len);
+}
+
+/* An access point in the form a scan's result has; the caller has said how much room for elements there is. */
+static int
+give_network(const struct apple80211req *request, const struct sapphire_sta_bss *bss)
+{
+	struct apple80211_scan_result *result = kalloc_data(sizeof(*result), Z_WAITOK | Z_ZERO);
+	unsigned room = sizeof(result->elements);
+	int error;
+
+	if (result == NULL) {
+		return ENOMEM;
+	}
+	if (request->req_len >= sizeof(*result) && copyin(request->req_data, result, offsetof(struct apple80211_scan_result,
+	    elements)) == 0 && result->elements_length < room) {
+		room = result->elements_length;
+	}
+	bzero(result, sizeof(*result));
+	result->version = 1;
+	channel_fill(&result->channel, bss->frequency, 0);
+	result->rssi = bss->rssi;
+	result->noise_known = 1;
+	result->noise = NOISE_FLOOR_DBM;
+	result->snr = snr_of(bss->rssi);
+	result->beacon_interval = bss->beacon_interval;
+	result->capability = bss->capability;
+	memcpy(result->bssid, bss->bssid, sizeof(result->bssid));
+	result->ssid_length = bss->ssid_length;
+	memcpy(result->ssid, bss->ssid, bss->ssid_length);
+	result->age_ms = bss->age_ms;
+	result->elements_length = (uint16_t)(bss->elements_length <= room ? bss->elements_length : 0);
+	memcpy(result->elements, bss->elements, result->elements_length);
+	/* the rates it says it has (elements 1 and 50: units of 500 kbit/s, the top bit marks the ones everybody must have) */
+	for (unsigned at = 0; at + 2 <= bss->elements_length && at + 2 + bss->elements[at + 1] <= bss->elements_length;
+	    at += 2 + bss->elements[at + 1]) {
+		for (unsigned i = 0; (bss->elements[at] == 1 || bss->elements[at] == 50) && i < bss->elements[at + 1]; i++) {
+			unsigned rate = (bss->elements[at + 2 + i] & 0x7f) / 2;
+
+			if (rate != 0 && rate <= 54 && result->rate_count < 15) {
+				result->rates[result->rate_count++] = rate;
+			}
+		}
+	}
+	error = give(request, result, sizeof(*result));
+	kfree_data(result, sizeof(*result));
+	return error;
+}
+
+/* ---- get ---------------------------------------------------------------------------------------------- */
+
+static int
+get(struct apple80211req *request)
+{
+	struct sapphire_sta_state *state;
+	int error = 0;
+
+	switch (request->req_type) {
+	case 43:
+	case 44: {                              /* the driver's and the hardware's name: the text alone, in 256 bytes */
+		static const char name[256] = "redwood: ath11k for the WCN6750";
+
+		return give(request, name, sizeof(name));
+	}
+	case 12: {
+		/*
+		 * What the card can do, a bit each (apple80211_var.h: APPLE80211_CAP_*): the 13 bytes are the
+		 * bits alone, from the first (the framework hands in a buffer that begins after the old
+		 * header's version word). AES, AES-CCM, power management, short slot and preamble, WPA2, WME,
+		 * short guard interval at 20 MHz. Read wrong, the framework sees no WPA2 and builds no join
+		 * for a WPA2 network ("Unable to join").
+		 */
+		uint8_t bits[13] = { 0 };
+		static const uint8_t has[] = { 2, 3, 6, 9, 10, 14, 17, 19 };
+
+		for (unsigned i = 0; i < sizeof(has); i++) {
+			bits[has[i] / 8] |= (uint8_t)(1u << (has[i] % 8));
+		}
+		return give(request, bits, sizeof(bits));
+	}
+	case 19: {                              /* the radio's power: one radio. Until the driver is up it counts as on: it */
+		struct {                        /* is being brought up, and iOS asks this once, early */
+			uint32_t version, radios, state[4];
+		} answer = { .version = 1, .radios = 1, .state = { !sapphire_sta_present() || sapphire_sta_powered() } };
+
+		return give(request, &answer, sizeof(answer));
+	}
+	case 15:                                /* the mode: a station (APPLE80211_M_STA) */
+		request->req_val = 1;
+		return 0;
+	case 27:
+	case 254: {                             /* the channels the radio may tune to */
+		struct apple80211_channels *answer;
+		struct sapphire_sta_channel channels[96];
+		unsigned count = sapphire_sta_channels(channels, 96);
+
+		if (count == 0 || (answer = kalloc_data(sizeof(*answer), Z_WAITOK | Z_ZERO)) == NULL) {
+			return count == 0 ? ENXIO : ENOMEM;
+		}
+		answer->version = 1;
+		answer->count = count;
+		for (unsigned i = 0; i < count; i++) {
+			channel_fill(&answer->channels[i], channels[i].frequency, channels[i].flags);
+		}
+		error = give(request, answer, sizeof(*answer));
+		kfree_data(answer, sizeof(*answer));
+		return error;
+	}
+	case 207: {                             /* ... and more of each */
+		struct apple80211_channels_info *answer;
+		struct sapphire_sta_channel channels[96];
+		unsigned count = sapphire_sta_channels(channels, 96);
+
+		if (count == 0 || (answer = kalloc_data(sizeof(*answer), Z_WAITOK | Z_ZERO)) == NULL) {
+			return count == 0 ? ENXIO : ENOMEM;
+		}
+		answer->count = (uint16_t)count;
+		for (unsigned i = 0; i < count; i++) {
+			struct apple80211_channel channel;
+
+			channel_fill(&channel, channels[i].frequency, channels[i].flags);
+			answer->number[i] = (uint8_t)channel.channel;
+			answer->dfs[i] = (channels[i].flags & SAPPHIRE_STA_CHANNEL_RADAR) != 0;
+			answer->passive[i] = (channels[i].flags & SAPPHIRE_STA_CHANNEL_PASSIVE) != 0;
+			answer->flags[i] = channel.flags;
+		}
+		error = give(request, answer, sizeof(*answer));
+		kfree_data(answer, sizeof(*answer));
+		return error;
+	}
+	case 106: {                             /* 0297: the RSSI bounds: version, min, max, auto-join threshold */
+		/*
+		 * wifid reads them once, as the device opens (IO80211's dictionary RSSI_MIN, RSSI_MAX,
+		 * RSSI_THRESHOLD), and refuses to auto-join any network heard more weakly than the threshold
+		 * ("Below minimum RSSI threshold"). Unanswered, the threshold was 0 dBm: no network was ever
+		 * strong enough, and every join had to be made by hand.
+		 */
+		struct {
+			uint32_t version;
+			int32_t min, max, threshold;
+		} answer = { .version = 1, .min = NOISE_FLOOR_DBM, .max = -20, .threshold = -85 };
+
+		sweet_wifid_opened++;           /* (0322: wifid got as far as opening the device) */
+		return give(request, &answer, sizeof(answer));
+	}
+	case 21:                                /* how the last join went (0: not over yet) */
+		lck_mtx_lock(&apple80211_lock);
+		request->req_val = (int32_t)join_result;
+		lck_mtx_unlock(&apple80211_lock);
+		return 0;
+	case 11: {                              /* what the last scan heard, one access point a request; EIO: that was all */
+		struct sapphire_sta_bss *bss = kalloc_data(sizeof(*bss), Z_WAITOK);
+		unsigned index;
+		bool there;
+
+		if (bss == NULL) {
+			return ENOMEM;
+		}
+		lck_mtx_lock(&apple80211_lock);
+		index = result_next++;
+		lck_mtx_unlock(&apple80211_lock);
+		there = sapphire_sta_heard(index, bss);
+		error = there ? give_network(request, bss) : EIO;
+		kfree_data(bss, sizeof(*bss));
+		return error;
+	}
+	default:
+		break;
+	}
+
+	/* the rest is about the network joined, and there is none unless the station says so */
+	if ((state = kalloc_data(sizeof(*state), Z_WAITOK)) == NULL) {
+		return ENOMEM;
+	}
+	sapphire_sta_state(state);
+	switch (request->req_type) {
+	case 13:                                /* the state: APPLE80211_S_INIT 0, _SCAN 1, _AUTH 2, _ASSOC 3, _RUN 4 */
+		request->req_val = state->phase == SAPPHIRE_STA_JOINED ? 4 : state->phase == SAPPHIRE_STA_JOINING ? 2 :
+		    state->phase == SAPPHIRE_STA_SCANNING ? 1 : 0;
+		break;
+	case 1:                                 /* its name; the length goes back in the request */
+		if (state->phase != SAPPHIRE_STA_JOINED) {
+			error = ENXIO;
+		} else if ((error = give(request, state->bss.ssid, state->bss.ssid_length)) == 0) {
+			request->req_len = state->bss.ssid_length;
+		}
+		break;
+	case 9:                                 /* its access point's address */
+		error = state->phase != SAPPHIRE_STA_JOINED ? ENXIO : give(request, state->bss.bssid, 6);
+		break;
+	case 4: {                               /* its channel */
+		struct {
+			uint32_t version;
+			struct apple80211_channel channel;
+		} answer = { .version = 1 };
+
+		if (state->phase != SAPPHIRE_STA_JOINED) {
+			error = ENXIO;
+		} else {
+			channel_fill(&answer.channel, state->bss.frequency, 0);
+			error = give(request, &answer, sizeof(answer));
+		}
+		break;
+	}
+	case 16: {                              /* how strongly it is heard: dBm, per radio and all together, twice over */
+		struct {
+			uint32_t version, radios, unit;
+			int32_t each[4], all, each_ext[4], all_ext;
+		} answer = { .version = 1, .radios = 1, .each = { state->bss.rssi }, .all = state->bss.rssi,
+			     .each_ext = { state->bss.rssi }, .all_ext = state->bss.rssi };
+
+		error = state->phase != SAPPHIRE_STA_JOINED ? ENXIO : give(request, &answer, sizeof(answer));
+		break;
+	}
+	case 17: {                              /* 0294: the noise floor, in the RSSI answer's shape */
+		struct {
+			uint32_t version, radios, unit;
+			int32_t each[4], all, each_ext[4], all_ext;
+		} answer = { .version = 1, .radios = 1, .each = { NOISE_FLOOR_DBM }, .all = NOISE_FLOOR_DBM,
+			     .each_ext = { NOISE_FLOOR_DBM }, .all_ext = NOISE_FLOOR_DBM };
+
+		/* 0296: answered joined or not: auto-join reads the noise before it joins anything */
+		error = give(request, &answer, sizeof(answer));
+		break;
+	}
+	case 103:                               /* all of it, as a scan's result */
+		error = state->phase != SAPPHIRE_STA_JOINED ? ENXIO : give_network(request, &state->bss);
+		break;
+	case 2: {                               /* how it was joined: open system, then WPA2 with a passphrase */
+		struct {
+			uint32_t version, lower, upper, extended;
+		} answer = { .version = 1, .lower = 1, .upper = 8 };
+
+		error = state->phase != SAPPHIRE_STA_JOINED ? ENXIO : give(request, &answer, sizeof(answer));
+		break;
+	}
+	default:
+		error = EOPNOTSUPP;
+		break;
+	}
+	kfree_data(state, sizeof(*state));
+	return error;
+}
+
+#include <net/ethernet.h>
+#include <net/if.h>
+#include <net/if_ether.h>
+#include <net/if_media.h>
+#include <net/if_types.h>
+#include <net/kpi_interface.h>
+#include <sys/kpi_mbuf.h>
+
+extern void sapphire_net_set_awdl_tap(void (*tap)(const uint8_t *frame, size_t length));
+extern void topaz_wlan_address(uint8_t address[6]);
+extern bool topaz_wlan_joined(void);
+extern bool topaz_wlan_transmit(const uint8_t *frame, size_t length);
+
+static ifnet_t awdl_ifp;
+static const uint8_t awdl_mac[6] = { 0x02, 0x00, 0x5e, 0x77, 0xee, 0x02 };
+
+static void
+awdl_rx_from_en0(const uint8_t *frame, size_t length)
+{
+	ifnet_t ifp = awdl_ifp;
+	if (ifp == NULL || length < 14 || length > 1514) {
+		return;
+	}
+	uint16_t etype = (uint16_t)((uint16_t)frame[12] << 8 | frame[13]);
+	bool is_mcast6 = (frame[0] == 0x33 && frame[1] == 0x33);
+	bool is_to_awdl = (memcmp(frame, awdl_mac, 6) == 0);
+	/* Forward IPv6 multicast (mDNS _airdrop._tcp.local, NDP) and frames addressed to awdl0 */
+	if (etype != 0x86DD || (!is_mcast6 && !is_to_awdl)) {
+		return;
+	}
+	struct ifnet_stat_increment_param stats = { .packets_in = 1, .bytes_in = (uint32_t)length };
+	unsigned int chunks = 1;
+	mbuf_t packet = NULL;
+	if (mbuf_allocpacket(MBUF_DONTWAIT, length, &chunks, &packet) != 0) {
+		return;
+	}
+	if (mbuf_copyback(packet, 0, length, frame, MBUF_DONTWAIT) != 0) {
+		mbuf_freem(packet);
+		return;
+	}
+	char *header = mbuf_data(packet);
+	mbuf_pkthdr_setrcvif(packet, ifp);
+	mbuf_pkthdr_setheader(packet, header);
+	mbuf_pkthdr_adjustlen(packet, -14);
+	mbuf_setdata(packet, header + 14, length - 14);
+	ifnet_input(ifp, packet, &stats);
+}
+
+static errno_t
+awdl_output(ifnet_t ifp, mbuf_t m)
+{
+	size_t len = mbuf_pkthdr_len(m);
+	if (len >= 14 && len <= 1514 && topaz_wlan_joined()) {
+		uint8_t buf[1514];
+		if (mbuf_copydata(m, 0, len, buf) == 0) {
+			/* Rewrite source MAC to en0's radio MAC so the AP forwards the frame */
+			topaz_wlan_address(buf + 6);
+			if (topaz_wlan_transmit(buf, len)) {
+				ifnet_stat_increment_out(ifp, 1, (uint32_t)len, 0);
+			}
+		}
+	}
+	mbuf_freem(m);
+	return 0;
+}
+
+static errno_t
+awdl_ioctl(ifnet_t ifp, unsigned long cmd, void *data)
+{
+	switch (cmd) {
+	case SIOCSIFADDR:
+		ifnet_set_flags(ifp, IFF_UP | IFF_RUNNING, IFF_UP | IFF_RUNNING);
+		return 0;
+	case SIOCSIFFLAGS:
+	case SIOCAIFADDR:
+	case SIOCADDMULTI:
+	case SIOCDELMULTI:
+		return 0;
+	case SIOCGIFMEDIA32:
+	case SIOCGIFMEDIA64: {
+		const int media[] = { IFM_IEEE80211 | IFM_AUTO };
+		struct ifmediareq *mr = data;
+		user_addr_t list = (cmd == SIOCGIFMEDIA64) ?
+		    ((struct ifmediareq64 *)mr)->ifmu_ulist :
+		    CAST_USER_ADDR_T(((struct ifmediareq32 *)mr)->ifmu_ulist);
+		mr->ifm_active = mr->ifm_current = media[0];
+		mr->ifm_mask = 0;
+		mr->ifm_status = IFM_AVALID | IFM_ACTIVE;
+		mr->ifm_count = 1;
+		if (list != USER_ADDR_NULL) {
+			return copyout(media, list, sizeof(media));
+		}
+		return 0;
+	}
+	case SIOCGA80211:
+	case SIOCSA80211:
+		return sapphire_apple80211_ioctl(cmd, data);
+	default:
+		return EOPNOTSUPP;
+	}
+}
+
+static int
+awdl_create(void)
+{
+	if (awdl_ifp != NULL) {
+		return 0;
+	}
+	static const uint8_t bcast[6] = { 0xff, 0xff, 0xff, 0xff, 0xff, 0xff };
+	struct ifnet_init_eparams init = {
+		.ver = IFNET_INIT_CURRENT_VERSION,
+		.len = sizeof(init),
+		.flags = IFNET_INIT_LEGACY | IFNET_INIT_NX_NOAUTO,
+		.uniqueid = "sapphire-awdl0",
+		.uniqueid_len = 14,
+		.name = "awdl",
+		.unit = 0,
+		.family = IFNET_FAMILY_ETHERNET,
+		.subfamily = IFNET_SUBFAMILY_WIFI,
+		.type = IFT_ETHER,
+		.output = awdl_output,
+		.demux = ether_demux,
+		.add_proto = ether_add_proto,
+		.del_proto = ether_del_proto,
+		.check_multi = ether_check_multi,
+		.framer_extended = ether_frameout_extended,
+		.ioctl = awdl_ioctl,
+		.broadcast_addr = bcast,
+		.broadcast_len = 6,
+	};
+	ifnet_t ifp = NULL;
+	errno_t err = ifnet_allocate_extended(&init, &ifp);
+	if (err != 0) {
+		printf("apple80211: awdl0 allocate failed: %d\n", err);
+		return err;
+	}
+	ifnet_set_capabilities_enabled(ifp, 0, -1);
+	ifnet_set_addrlen(ifp, 6);
+	ifnet_set_baudrate(ifp, 100 * 1000 * 1000);
+	ifnet_set_mtu(ifp, 1484);
+	ifnet_set_flags(ifp, IFF_UP | IFF_RUNNING | IFF_BROADCAST | IFF_MULTICAST | IFF_SIMPLEX, 0xffff);
+	ifnet_set_eflags(ifp, IFEF_AWDL, IFEF_AWDL);
+	ifnet_set_hdrlen(ifp, 14);
+	ifnet_set_offload(ifp, 0);
+	err = ifnet_attach(ifp, NULL);
+	if (err != 0) {
+		printf("apple80211: awdl0 attach failed: %d\n", err);
+		ifnet_release(ifp);
+		return err;
+	}
+	ifnet_set_lladdr(ifp, awdl_mac, 6);
+	awdl_ifp = ifp;
+	sapphire_net_set_awdl_tap(awdl_rx_from_en0);
+	printf("apple80211: awdl0 interface created and bridged to en0 (IFEF_AWDL)\n");
+	return 0;
+}
+
+static int
+awdl_delete(void)
+{
+	if (awdl_ifp == NULL) {
+		return 0;
+	}
+	sapphire_net_set_awdl_tap(NULL);
+	ifnet_detach(awdl_ifp);
+	ifnet_release(awdl_ifp);
+	awdl_ifp = NULL;
+	printf("apple80211: awdl0 interface deleted\n");
+	return 0;
+}
+
+/* ---- set ---------------------------------------------------------------------------------------------- */
+
+static int
+set_scan(const struct apple80211req *request, char *said, size_t said_size)
+{
+	struct apple80211_scan_request *asked;
+	struct sapphire_sta_scan *what;
+	unsigned unknown = 0;
+	int error;
+
+	if (request->req_len != sizeof(*asked)) {
+		return EINVAL;
+	}
+	if (!sapphire_sta_present()) {
+		return EBUSY;                   /* (the radio is still being brought up: the framework tries again) */
+	}
+	asked = kalloc_data(sizeof(*asked), Z_WAITOK);
+	what = kalloc_data(sizeof(*what), Z_WAITOK | Z_ZERO);
+	if (asked == NULL || what == NULL || (error = copyin(request->req_data, asked, sizeof(*asked))) != 0) {
+		error = asked == NULL || what == NULL ? ENOMEM : error;
+		goto out;
+	}
+	if (asked->ssid_length <= sizeof(what->ssid)) {
+		what->ssid_length = (uint8_t)asked->ssid_length;
+		memcpy(what->ssid, asked->ssid, asked->ssid_length);
+	}
+	what->passive = asked->scan_type == 2;
+	what->dwell_ms = asked->dwell_ms;
+	/* (more channels than there is room to name: every channel) */
+	for (unsigned i = 0; i < asked->channel_count && i < 400 && asked->channel_count <= 64; i++) {
+		unsigned frequency = channel_frequency(&asked->channels[i]);
+
+		if (frequency != 0) {
+			what->frequencies[what->frequency_count++] = (uint16_t)frequency;
+		} else {
+			unknown++;
+		}
+	}
+	snprintf(said, said_size, " (a scan: type %u, %u channels of which %u are not the radio's, %u ms on each, a name of %u bytes, "
+	    "%u more names, flags %#llx)", asked->scan_type, asked->channel_count, unknown, asked->dwell_ms, asked->ssid_length,
+	    asked->name_count, asked->flags);
+	if (asked->channel_count != 0 && asked->channel_count <= 64 && what->frequency_count == 0) {
+		error = EINVAL;                 /* (nothing of what is asked for is a channel of this radio's) */
+	} else {
+		lck_mtx_lock(&apple80211_lock);
+		result_next = 0;
+		lck_mtx_unlock(&apple80211_lock);
+		error = sapphire_sta_ask_scan(what);
+	}
+out:
+	if (asked != NULL) {
+		kfree_data(asked, sizeof(*asked));
+	}
+	if (what != NULL) {
+		kfree_data(what, sizeof(*what));
+	}
+	return error;
+}
+
+static int
+set_join(const struct apple80211req *request, char *said, size_t said_size)
+{
+	struct apple80211_assoc *asked;
+	struct sapphire_sta_join *what;
+	int error;
+
+	if (request->req_len < offsetof(struct apple80211_assoc, rest)) {
+		return EINVAL;
+	}
+	asked = kalloc_data(sizeof(*asked), Z_WAITOK | Z_ZERO);
+	what = kalloc_data(sizeof(*what), Z_WAITOK | Z_ZERO);
+	if (asked == NULL || what == NULL || (error = copyin(request->req_data, asked, offsetof(struct apple80211_assoc, rest))) != 0) {
+		error = asked == NULL || what == NULL ? ENOMEM : error;
+		goto out;
+	}
+	/* (lengths and kinds only: the name, the access point and the key stay out of the log) */
+	snprintf(said, said_size, " (a join: a name of %u bytes, %s access point, authentication %#x/%#x, a key of %u bytes of kind %u)",
+	    asked->ssid_length, asked->bssid[0] | asked->bssid[1] | asked->bssid[2] | asked->bssid[3] | asked->bssid[4] |
+	    asked->bssid[5] ? "a given" : "any", asked->auth_lower, asked->auth_upper, asked->key_length, asked->key_cipher);
+	if (asked->ssid_length == 0 || asked->ssid_length > sizeof(what->ssid)) {
+		error = EINVAL;
+		goto out;
+	}
+	what->ssid_length = (uint8_t)asked->ssid_length;
+	memcpy(what->ssid, asked->ssid, asked->ssid_length);
+	memcpy(what->bssid, asked->bssid, sizeof(what->bssid));
+	if (asked->key_length == 0) {
+		what->security = SAPPHIRE_STA_OPEN;
+	} else if (asked->key_cipher == CIPHER_PASSPHRASE && asked->key_length >= 8 && asked->key_length <= 63) {
+		what->security = SAPPHIRE_STA_WPA2_PSK;
+		what->passphrase_length = (uint8_t)asked->key_length;
+		memcpy(what->passphrase, asked->key, asked->key_length);
+	} else if (asked->key_cipher == CIPHER_PMK && asked->key_length == sizeof(what->pmk)) {
+		what->security = SAPPHIRE_STA_WPA2_PSK;
+		memcpy(what->pmk, asked->key, sizeof(what->pmk));
+	} else {
+		error = EINVAL;
+		goto out;
+	}
+	lck_mtx_lock(&apple80211_lock);
+	join_result = 0;
+	lck_mtx_unlock(&apple80211_lock);
+	error = sapphire_sta_ask_join(what);
+out:
+	if (asked != NULL) {
+		memset_s(asked, sizeof(*asked), 0, sizeof(*asked));
+		kfree_data(asked, sizeof(*asked));
+	}
+	if (what != NULL) {
+		memset_s(what, sizeof(*what), 0, sizeof(*what));
+		kfree_data(what, sizeof(*what));
+	}
+	return error;
+}
+
+static int
+set(const struct apple80211req *request, char *said, size_t said_size)
+{
+	switch (request->req_type) {
+	case 20:
+		return set_join(request, said, said_size);
+	case 22:                                /* leave the network */
+		return sapphire_sta_ask_leave();
+	case 19: {                              /* the radio's power */
+		struct {
+			uint32_t version, radios, state[4];
+		} asked;
+		int error;
+
+		if (request->req_len < sizeof(asked) || (error = copyin(request->req_data, &asked, sizeof(asked))) != 0) {
+			return request->req_len < sizeof(asked) ? EINVAL : error;
+		}
+		snprintf(said, said_size, " (power: %s)", asked.state[0] ? "on" : "off");
+		return sapphire_sta_ask_power(asked.state[0] != 0);
+	}
+	case 10:
+		return set_scan(request, said, said_size);
+	case 94:                                /* VIRTUAL_IF_CREATE: awdl0 bridged to en0 for sharingd/mDNSResponder */
+		return awdl_create();
+	case 95:                                /* VIRTUAL_IF_DELETE */
+		return awdl_delete();
+	default:
+		return EOPNOTSUPP;
+	}
+}
+
+/* ---- events -------------------------------------------------------------------------------------------- */
+
+static void
+post(uint32_t code, const void *data, uint32_t length)
+{
+	struct kev_msg message = { .vendor_code = KEV_VENDOR_APPLE, .kev_class = KEV_IEEE80211_CLASS, .kev_subclass = 1,
+		                   .event_code = code };
+	char name[16];
+
+	memcpy(name, interface_name, sizeof(name));
+	message.dv[0].data_length = sizeof(name);
+	message.dv[0].data_ptr = name;
+	if (length != 0) {
+		message.dv[1].data_length = length;
+		message.dv[1].data_ptr = __DECONST(void *, data);
+	}
+	kev_post_msg(&message);
+}
+
+/* What the station side says has happened (bsd/dev/sapphire_sta.c calls this, on its thread or the station's). */
+void
+sapphire_apple80211_event(enum sapphire_sta_event event, int status)
+{
+	static unsigned said;
+
+	if (said < 200) {
+		said++;
+		printf("apple80211: the station says: %s, %d\n", event == SAPPHIRE_STA_POWER ? "power" : event == SAPPHIRE_STA_SCAN_DONE ?
+		    "a scan is over" : event == SAPPHIRE_STA_JOIN_DONE ? "a join is over" : "the link", status);
+	}
+	switch (event) {
+	case SAPPHIRE_STA_POWER:
+		post(EVENT_POWER_CHANGED, NULL, 0);
+		break;
+	case SAPPHIRE_STA_SCAN_DONE:
+		lck_mtx_lock(&apple80211_lock);
+		result_next = 0;
+		lck_mtx_unlock(&apple80211_lock);
+		post(EVENT_SCAN_DONE, NULL, 0);
+		break;
+	case SAPPHIRE_STA_JOIN_DONE:
+		lck_mtx_lock(&apple80211_lock);
+		join_result = status == 0 ? 1 : status == EAUTH ? 21 : status == ETIMEDOUT ? 9 : 2;
+		lck_mtx_unlock(&apple80211_lock);
+		post(EVENT_ASSOC_DONE, NULL, 0);
+		break;
+	case SAPPHIRE_STA_LINK: {
+		struct apple80211_link_changed link = { .down = status != 1, .involuntary = status != 1 && status != 0,
+			                                .reason = status != 1 && status != 0 ? 4 : 0 };      /* (4: gone, not asked) */
+		struct sapphire_sta_state *state = kalloc_data(sizeof(*state), Z_WAITOK | Z_ZERO);
+
+		if (state != NULL) {
+			sapphire_sta_state(state);
+			link.rssi = status == 1 ? state->bss.rssi : 0;
+			if (status == 1) {
+				link.snr = (uint16_t)snr_of(state->bss.rssi);
+				link.noise = (uint16_t)(int16_t)NOISE_FLOOR_DBM;
+			}
+			kfree_data(state, sizeof(*state));
+		}
+		post(EVENT_SSID_CHANGED, NULL, 0);
+		post(EVENT_BSSID_CHANGED, NULL, 0);
+		post(EVENT_LINK_CHANGED, &link, sizeof(link));
+		break;
+	}
+	}
+}
+
+/* ---- the requests as they arrive --------------------------------------------------------------------- */
+
+/*
+ * How often each kind of request came and how it fared: said when the run ends, because the
+ * lines said along the way can be lost with the middle of a long log.
+ */
+static struct {
+	int32_t type;
+	bool set;
+	unsigned times, answered;
+	int last_error;
+} kinds[96];
+static unsigned kind_count;
+
+static void
+note(const struct apple80211req *request, bool is_set, int error)
+{
+	unsigned i;
+
+	lck_mtx_lock(&apple80211_lock);
+	for (i = 0; i < kind_count && !(kinds[i].type == request->req_type && kinds[i].set == is_set); i++) {
+	}
+	if (i < sizeof(kinds) / sizeof(kinds[0])) {
+		if (i == kind_count) {
+			kinds[kind_count++] = (typeof(kinds[0])) { .type = request->req_type, .set = is_set };
+		}
+		kinds[i].times++;
+		kinds[i].answered += error == 0;
+		kinds[i].last_error = error != 0 ? error : kinds[i].last_error;
+	}
+	lck_mtx_unlock(&apple80211_lock);
+}
+
+void
+sapphire_apple80211_summary(void)
+{
+	static bool said;
+
+	if (said) {
+		return;
+	}
+	said = true;
+	for (unsigned i = 0; i < kind_count; i++) {
+		printf("apple80211: in this run: %s %d (%s) %u times, answered %u times%s", kinds[i].set ? "set" : "get", kinds[i].type,
+		    type_name(kinds[i].type), kinds[i].times, kinds[i].answered, kinds[i].last_error == 0 ? "\n" : "");
+		if (kinds[i].last_error != 0) {
+			printf("; the last refusal: %d%s\n", kinds[i].last_error, kinds[i].last_error == EOPNOTSUPP ? " (not built)" : "");
+		}
+	}
+}
+
+/* An Apple80211 request for the radio's interface, from the process that is running now. */
+errno_t
+sapphire_apple80211_ioctl(u_long command, void *data)
+{
+	static unsigned said;
+	struct apple80211req *request = data;
+	char who[32] = "?", what[200] = "";
+	bool is_set = command == SIOCSA80211;
+	int error;
+
+	if (command != SIOCSA80211 && command != SIOCGA80211) {
+		return EOPNOTSUPP;
+	}
+	proc_selfname(who, sizeof(who));
+	error = is_set ? set(request, what, sizeof(what)) : get(request);
+	note(request, is_set, error);
+	/* (a request that is repeated for ever is said a few hundred times) */
+	if (said < 800) {
+		said++;
+		printf("apple80211: %s %s %d (%s), value %d, %u bytes%s: %s", who, is_set ? "sets" : "gets", request->req_type,
+		    type_name(request->req_type), request->req_val, request->req_len, what, error == 0 ? "answered\n" : error ==
+		    EOPNOTSUPP ? "REFUSED\n" : "");
+		if (error != 0 && error != EOPNOTSUPP) {
+			printf("error %d\n", error);
+		}
+	}
+	return error;
+}
diff --git a/bsd/dev/sapphire_net.c b/bsd/dev/sapphire_net.c
new file mode 100644
index 0000000..ceacccf
--- /dev/null
+++ b/bsd/dev/sapphire_net.c
@@ -0,0 +1,393 @@
+/*
+ * Ported from HackiOS (OOSEX GANG, github.com/oosexgang/hackios-xnu-kernel @8e61187098f2, bsd/dev/redwood_net.c;
+ * Apple Public Source License 2.0, as the rest of XNU) for sapphire: renamed, and fed by the
+ * WCN3988 station of TopazModem.cpp through bsd/dev/sapphire_wlan.c instead of ath11k.
+ */
+/*
+ * en0: a network interface that is Ethernet as far as the rest of the kernel and iOS can tell.
+ *
+ * iOS expects its interfaces from IONetworkingFamily, which this kernel does not have; the BSD
+ * half of the kernel does not need it. The interface is made with the kernel's own interface
+ * KPI, the way bsd/net/if_fake.c makes its "feth": family Ethernet, the stock Ethernet framing
+ * and demultiplexing, one function that is given a frame to send and one call to hand a frame
+ * that has arrived to the stack. What iOS's user space makes of an interface that has no
+ * IOKit object behind it is another matter: see userland/src/net_test.m.
+ *
+ * What carries the frames is a link driver's business; sys/sapphire_net.h is all that the two
+ * know of each other. The first link is QEMU's virtio network device (sapphire_virtio_net.c).
+ */
+#include <kern/clock.h>
+#include <kern/locks.h>
+#include <kern/thread.h>
+#include <libkern/libkern.h>
+#include <mach/mach_types.h>
+#include <net/bpf.h>
+#include <net/ethernet.h>
+#include <net/if.h>
+#include <net/if_ether.h>
+#include <net/if_media.h>
+#include <net/if_types.h>
+#include <net/kpi_interface.h>
+#include <netinet/in.h>
+#include <pexpert/pexpert.h>
+#include <sys/kern_event.h>
+#include <sys/kpi_mbuf.h>
+#include <sys/proc.h>
+#include <sys/sapphire_net.h>
+#include <sys/sockio.h>
+#include <sys/systm.h>
+
+extern void SapphireWLANStart(const char *interface, const uint8_t *address);  /* iokit/Kernel/SapphireWLAN.cpp */
+
+static LCK_GRP_DECLARE(net_lck_grp, "sapphire-net");
+static LCK_MTX_DECLARE(net_tx_lock, &net_lck_grp);
+static const struct sapphire_net_link *net_link;
+static bool net_link_up;
+static ifnet_t net_ifp;
+
+/* What has gone through: said once a minute while anything moves. */
+static struct {
+	uint64_t sent, received, sent_bytes, received_bytes, dropped_out, dropped_in;
+} net_count;
+
+/*
+ * Boot-arg net_trace=N: a line in the log for each of the first N frames, either way.
+ * Boot-arg net_names=1: a line for every name asked of a DNS server and for every TCP connection
+ * begun from here -- which is how to see what a system that has just been given a network does
+ * with it (up to NAMES_MAX lines).
+ */
+#define NAMES_MAX       3000
+static uint32_t net_trace, net_names;
+
+static void
+trace_frame(const char *way, const uint8_t *frame, size_t length, size_t whole)
+{
+	static uint32_t said, names;
+	const uint8_t *end = frame + length, *ip = frame + ETHER_HDR_LEN, *l4;
+	uint16_t type;
+	bool ports;
+
+	if (length < ETHER_HDR_LEN + 28 || (said >= net_trace && (!net_names || names >= NAMES_MAX))) {
+		return;
+	}
+	type = (uint16_t)(frame[12] << 8 | frame[13]);
+	l4 = ip + 4 * (ip[0] & 0xf);
+	ports = type == ETHERTYPE_IP && (ip[9] == IPPROTO_TCP || ip[9] == IPPROTO_UDP) && l4 + 4 <= end;
+	if (net_names && names < NAMES_MAX && ports && way[0] == 'o') {
+		if (ip[9] == IPPROTO_UDP && (l4[2] << 8 | l4[3]) == 53 && l4 + 8 + 12 < end) {
+			char name[128];
+			const uint8_t *label = l4 + 8 + 12;
+			size_t n = 0;
+
+			/* the question: lengths and labels, up to a zero */
+			while (label < end && *label != 0 && *label < 64 && label + 1 + *label < end && n + *label + 2 < sizeof(name)) {
+				memcpy(name + n, label + 1, *label);
+				n += *label;
+				name[n++] = '.';
+				label += 1 + *label;
+			}
+			name[n ? n - 1 : 0] = 0;
+			names++;
+			printf("net: asks for the name %s (type %u)\n", name, label + 2 < end ? label[1] << 8 | label[2] : 0);
+		} else if (ip[9] == IPPROTO_TCP && l4 + 14 <= end && (l4[13] & 0x12) == 0x02) {
+			names++;
+			printf("net: connects to %u.%u.%u.%u port %u\n", ip[16], ip[17], ip[18], ip[19], l4[2] << 8 | l4[3]);
+		}
+	}
+	if (said >= net_trace) {
+		return;
+	}
+	said++;
+	if (type == ETHERTYPE_IP) {
+		printf("net: %s %zu bytes: IPv4 %s %u.%u.%u.%u:%u -> %u.%u.%u.%u:%u%s\n", way, whole, ip[9] == IPPROTO_TCP ? "TCP" :
+		    ip[9] == IPPROTO_UDP ? "UDP" : ip[9] == IPPROTO_ICMP ? "ICMP" : "protocol?", ip[12], ip[13], ip[14], ip[15],
+		    ports ? l4[0] << 8 | l4[1] : 0, ip[16], ip[17], ip[18], ip[19], ports ? l4[2] << 8 | l4[3] : 0,
+		    ip[9] == IPPROTO_TCP && ports && l4 + 14 <= end ? (l4[13] & 2 ? " SYN" : l4[13] & 1 ? " FIN" : l4[13] & 4 ? " RST" : "") : "");
+	} else {
+		printf("net: %s %zu bytes: %s (type %#x) to %02x:%02x:%02x:%02x:%02x:%02x\n", way, whole, type == ETHERTYPE_ARP ? "ARP" :
+		    type == ETHERTYPE_IPV6 ? "IPv6" : "?", type, frame[0], frame[1], frame[2], frame[3], frame[4], frame[5]);
+	}
+}
+
+/* ... of a frame on its way out: the start of it is enough */
+static void
+trace_packet(mbuf_t packet, size_t length)
+{
+	uint8_t start[192];
+	size_t have = length < sizeof(start) ? length : sizeof(start);
+
+	if ((net_trace || net_names) && mbuf_copydata(packet, 0, have, start) == 0) {
+		trace_frame("out", start, have, length);
+	}
+}
+
+/* ---- the interface -------------------------------------------------------------------------------- */
+
+/* The stack has a frame to send (a chain of mbufs that starts with the Ethernet header). */
+static errno_t
+net_output(ifnet_t ifp, mbuf_t packet)
+{
+	size_t length = mbuf_pkthdr_len(packet);
+	bool sent = false;
+
+	if (length <= SAPPHIRE_NET_FRAME_MAX && net_link_up) {
+		bpf_tap_out(ifp, DLT_EN10MB, packet, NULL, 0);
+		trace_packet(packet, length);
+		lck_mtx_lock(&net_tx_lock);
+		sent = net_link->transmit(packet, length);
+		lck_mtx_unlock(&net_tx_lock);
+	}
+	if (sent) {
+		net_count.sent++;
+		net_count.sent_bytes += length;
+		ifnet_stat_increment_out(ifp, 1, (uint32_t)length, 0);
+	} else {
+		net_count.dropped_out++;
+		ifnet_stat_increment_out(ifp, 0, 0, 1);
+	}
+	mbuf_freem(packet);
+	return 0;
+}
+
+static void (*awdl_rx_tap_fn)(const uint8_t *frame, size_t length);
+
+void
+sapphire_net_set_awdl_tap(void (*tap)(const uint8_t *frame, size_t length))
+{
+	awdl_rx_tap_fn = tap;
+}
+
+/* A frame has arrived. */
+void
+sapphire_net_input(const uint8_t *frame, size_t length)
+{
+	struct ifnet_stat_increment_param stats = { .packets_in = 1, .bytes_in = (uint32_t)length };
+	unsigned int chunks = 1;
+	mbuf_t packet = NULL;
+	char *header;
+
+	trace_frame("in ", frame, length, length);
+	if (awdl_rx_tap_fn != NULL && length >= ETHER_HDR_LEN && length <= SAPPHIRE_NET_FRAME_MAX) {
+		awdl_rx_tap_fn(frame, length);
+	}
+	if (net_ifp == NULL || length < ETHER_HDR_LEN || length > SAPPHIRE_NET_FRAME_MAX ||
+	    mbuf_allocpacket(MBUF_DONTWAIT, length, &chunks, &packet) != 0) {
+		net_count.dropped_in++;
+		return;
+	}
+	if (mbuf_copyback(packet, 0, length, frame, MBUF_DONTWAIT) != 0) {
+		mbuf_freem(packet);
+		net_count.dropped_in++;
+		return;
+	}
+	/* as every Ethernet driver hands a frame up: the header noted and stepped over */
+	header = mbuf_data(packet);
+	mbuf_pkthdr_setrcvif(packet, net_ifp);
+	mbuf_pkthdr_setheader(packet, header);
+	mbuf_pkthdr_adjustlen(packet, -ETHER_HDR_LEN);
+	mbuf_setdata(packet, header + ETHER_HDR_LEN, length - ETHER_HDR_LEN);
+	bpf_tap_in(net_ifp, DLT_EN10MB, packet, header, ETHER_HDR_LEN);
+	net_count.received++;
+	net_count.received_bytes += length;
+	ifnet_input(net_ifp, packet, &stats);
+}
+
+static unsigned net_ioctls_said;
+
+static errno_t
+net_ioctl(ifnet_t ifp, u_long command, void *data)
+{
+	/* (a radio says it is one here too: IO80211.framework lists the interfaces whose media is 802.11) */
+	const int media[] = { (net_link->wireless ? IFM_IEEE80211 : IFM_ETHER) | IFM_AUTO };
+	struct ifreq *request = data;
+	struct ifmediareq *media_request = data;
+	user_addr_t list;
+	errno_t error = 0;
+
+	if (net_link->wireless && net_ioctls_said < 80) {
+		char who[32] = "?";
+
+		/* (while iOS's Wi-Fi side is being got to talk to this: who asks the interface what) */
+		proc_selfname(who, sizeof(who));
+		if (strcmp(who, "configd") != 0) {
+			net_ioctls_said++;
+			printf("net: en0 is asked %#lx by %s\n", command, who);
+		}
+	}
+	switch (command) {
+	case SIOCSIFADDR:
+		ifnet_set_flags(ifp, IFF_UP, IFF_UP);
+		break;
+	case SIOCSIFFLAGS:
+		/* running whenever it is up: the link is there or it is not, nothing is switched on */
+		ifnet_set_flags(ifp, (ifnet_flags(ifp) & IFF_UP) ? IFF_RUNNING : 0, IFF_RUNNING);
+		break;
+	case SIOCGIFMEDIA32:
+	case SIOCGIFMEDIA64:
+		/* what configd asks to learn whether the cable is in */
+		list = command == SIOCGIFMEDIA64 ? ((struct ifmediareq64 *)media_request)->ifmu_ulist :
+		    CAST_USER_ADDR_T(((struct ifmediareq32 *)media_request)->ifmu_ulist);
+		media_request->ifm_active = media_request->ifm_current = media[0];
+		media_request->ifm_mask = 0;
+		media_request->ifm_status = IFM_AVALID | (net_link_up ? IFM_ACTIVE : 0);
+		if (list != USER_ADDR_NULL && media_request->ifm_count > 0) {
+			error = copyout(media, list, sizeof(media));
+		}
+		media_request->ifm_count = 1;
+		break;
+	case SIOCGIFDEVMTU:
+		request->ifr_devmtu.ifdm_current = ifnet_mtu(ifp);
+		request->ifr_devmtu.ifdm_max = ETHERMTU;
+		request->ifr_devmtu.ifdm_min = IF_MINMTU;
+		break;
+	case SIOCSIFMTU:
+		error = request->ifr_mtu > ETHERMTU || request->ifr_mtu < IF_MINMTU ? EINVAL : ifnet_set_mtu(ifp, request->ifr_mtu);
+		break;
+	case SIOCADDMULTI:
+	case SIOCDELMULTI:
+		break;                          /* the link hands us everything anyway */
+	default:
+		/* what iOS's Wi-Fi side asks of a radio's interface: bsd/dev/sapphire_apple80211.c */
+		error = net_link->wireless ? sapphire_apple80211_ioctl(command, data) : EOPNOTSUPP;
+		break;
+	}
+	return error;
+}
+
+/* Tell whoever listens for kernel events (configd does) that the link is up, or down. */
+static void
+net_link_event(ifnet_t ifp, uint32_t code)
+{
+	_Alignas(struct kern_event_msg) char message[sizeof(struct kern_event_msg) + sizeof(struct net_event_data)] = { 0 };
+	struct kern_event_msg *header = (struct kern_event_msg *)message;
+	struct net_event_data *about = (struct net_event_data *)(header + 1);
+
+	header->total_size = sizeof(message);
+	header->vendor_code = KEV_VENDOR_APPLE;
+	header->kev_class = KEV_NETWORK_CLASS;
+	header->kev_subclass = KEV_DL_SUBCLASS;
+	header->event_code = code;
+	about->if_family = ifnet_family(ifp);
+	about->if_unit = ifnet_unit(ifp);
+	strlcpy(about->if_name, ifnet_name(ifp), IFNAMSIZ);
+	ifnet_event(ifp, header);
+}
+
+void
+sapphire_net_link_state(bool up)
+{
+	if (net_ifp == NULL || up == net_link_up) {
+		return;
+	}
+	net_link_up = up;
+	printf("net: the link (%s) is %s\n", net_link->name, up ? "up" : "down");
+	net_link_event(net_ifp, up ? KEV_DL_LINK_ON : KEV_DL_LINK_OFF);
+}
+
+/* The interface's own thread: for a link that wants to be asked, and for the minute's line in the log. */
+static void
+net_thread(__unused void *parameter, __unused wait_result_t result)
+{
+	uint64_t said = 0, total;
+	unsigned quiet = 0;
+
+	for (unsigned tick = 1;; tick++) {
+		quiet = net_link->poll != NULL && net_link->poll() ? 0 : quiet + 1;
+		/* about once a minute, if anything has moved since */
+		total = net_count.sent + net_count.received + net_count.dropped_out + net_count.dropped_in;
+		if (tick % 8192 == 0 && total != said) {
+			said = total;
+			printf("net: so far %llu frames sent (%llu bytes), %llu received (%llu bytes); dropped: %llu out, %llu in\n",
+			    net_count.sent, net_count.sent_bytes, net_count.received, net_count.received_bytes,
+			    net_count.dropped_out, net_count.dropped_in);
+		}
+		delay_for_interval(quiet < 100 ? 2 : 10, NSEC_PER_MSEC);
+	}
+}
+
+bool
+sapphire_net_attach(const struct sapphire_net_link *link)
+{
+	struct ifnet_init_eparams init = {
+		.ver = IFNET_INIT_CURRENT_VERSION,
+		.len = sizeof(init),
+		/*
+		 * The simple model: every frame straight to net_output(). And no Skywalk "nexus" made for
+		 * the interface by itself: sockets are all that is asked of it so far.
+		 */
+		.flags = IFNET_INIT_LEGACY | IFNET_INIT_NX_NOAUTO,
+		.uniqueid = "sapphire-en0",
+		.uniqueid_len = 11,
+		.name = "en",
+		.unit = 0,
+		.family = IFNET_FAMILY_ETHERNET,
+		.subfamily = link->wireless ? IFNET_SUBFAMILY_WIFI : IFNET_SUBFAMILY_ANY,
+		.type = IFT_ETHER,
+		.output = net_output,
+		.demux = ether_demux,
+		.add_proto = ether_add_proto,
+		.del_proto = ether_del_proto,
+		.check_multi = ether_check_multi,
+		.framer_extended = ether_frameout_extended,
+		.ioctl = net_ioctl,
+		.broadcast_addr = etherbroadcastaddr,
+		.broadcast_len = ETHER_ADDR_LEN,
+	};
+	const uint8_t *address = link->address;
+	ifnet_t ifp = NULL;
+	thread_t thread;
+	errno_t error;
+
+	if (net_link != NULL) {
+		printf("net: en0 is on %s already; %s is not attached\n", net_link->name, link->name);
+		return false;
+	}
+	net_link = link;
+	net_link_up = link->up;
+	error = ifnet_allocate_extended(&init, &ifp);
+	if (error != 0) {
+		printf("net: the interface cannot be made: error %d\n", error);
+		net_link = NULL;
+		return false;
+	}
+	ifnet_set_capabilities_enabled(ifp, 0, -1);
+	ifnet_set_addrlen(ifp, ETHER_ADDR_LEN);
+	ifnet_set_baudrate(ifp, 100 * 1000 * 1000);
+	ifnet_set_mtu(ifp, ETHERMTU);
+	ifnet_set_flags(ifp, IFF_BROADCAST | IFF_MULTICAST | IFF_SIMPLEX, 0xffff);
+	ifnet_set_hdrlen(ifp, ETHER_HDR_LEN);
+	ifnet_set_offload(ifp, 0);
+	error = ifnet_attach(ifp, NULL);
+	if (error != 0) {
+		printf("net: the interface cannot be attached: error %d\n", error);
+		ifnet_release(ifp);
+		net_link = NULL;
+		return false;
+	}
+	ifnet_set_lladdr(ifp, address, ETHER_ADDR_LEN);
+	bpfattach(ifp, DLT_EN10MB, ETHER_HDR_LEN);
+	net_ifp = ifp;
+	if (net_link_up) {
+		net_link_event(ifp, KEV_DL_LINK_ON);
+	}
+	if (link->wireless) {
+		/* (a radio's address is the phone's own: not for the log; and iOS's Wi-Fi side finds the interface by a service) */
+		printf("net: en0 attached on %s (a radio), link %s\n", link->name, net_link_up ? "up" : "down");
+		SapphireWLANStart("en0", address);
+	} else {
+		printf("net: en0 attached on %s, address %02x:%02x:%02x:%02x:%02x:%02x, link %s\n", link->name, address[0],
+		    address[1], address[2], address[3], address[4], address[5], net_link_up ? "up" : "down");
+	}
+	if (kernel_thread_start(net_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+	return true;
+}
+
+void
+sapphire_net_init(void)
+{
+	PE_parse_boot_argn("net_trace", &net_trace, sizeof(net_trace));
+	PE_parse_boot_argn("net_names", &net_names, sizeof(net_names));
+	/* (the link is the radio: bsd/dev/sapphire_wlan.c attaches it) */
+}
diff --git a/bsd/dev/sapphire_sta.c b/bsd/dev/sapphire_sta.c
new file mode 100644
index 0000000..5487388
--- /dev/null
+++ b/bsd/dev/sapphire_sta.c
@@ -0,0 +1,375 @@
+/*
+ * Ported from HackiOS (OOSEX GANG, github.com/oosexgang/hackios-xnu-kernel @8e61187098f2, bsd/dev/redwood_sta.c;
+ * Apple Public Source License 2.0, as the rest of XNU) for sapphire: renamed, and fed by the
+ * WCN3988 station of TopazModem.cpp through bsd/dev/sapphire_wlan.c instead of ath11k.
+ */
+/*
+ * Darwin on sapphire: what stands between the two sides of the station boundary
+ * (sys/sapphire_sta.h).
+ *
+ * Whoever wants a network asks from wherever it happens to be: an ioctl of wifid's, the thread
+ * that brings the radio up. The station side wants to be called by one thread, one call at a
+ * time, and a scan or a join takes seconds. So what is asked for is noted here and done by a
+ * thread of this file's; the asker returns at once and hears the outcome as an event. One
+ * request of each kind can wait: a second scan asked for while the first has not begun
+ * replaces it, as does a second join.
+ *
+ * What the last scan heard is kept here, so that it can be read without entering the station
+ * side, and so is the list of channels.
+ *
+ * The network the kernel was given in a file is a standing request: joined at the start, and
+ * again whenever the radio is turned back on (Settings' switch), until somebody asks for
+ * another network -- as iOS itself rejoins the networks it knows. If that other network cannot
+ * be joined (a wrong passphrase), the standing one is joined again.
+ */
+#include <kern/kalloc.h>
+#include <kern/locks.h>
+#include <kern/sched_prim.h>
+#include <kern/thread.h>
+#include <libkern/libkern.h>
+#include <mach/mach_types.h>
+#include <sys/errno.h>
+#include <sys/sapphire_sta.h>
+#include <sys/systm.h>
+
+extern void thread_set_thread_name(thread_t thread, const char *name);
+
+#define HEARD_MOST      128
+#define CHANNELS_MOST   96
+
+static LCK_GRP_DECLARE(sta_lock_group, "sapphire-sta");
+static LCK_MTX_DECLARE(sta_lock, &sta_lock_group);
+
+static const struct sapphire_sta_ops *sta_ops;   /* the station side, while there is one */
+static bool sta_thread_made;
+static bool sta_calls;                          /* the thread is in a call of the station side's */
+static unsigned sta_reads;                      /* ... and so many others are in its state() */
+static bool sta_on;                             /* the radio's power, as last asked for */
+
+/* what has been asked for and not begun */
+static bool asked_power, asked_power_on, asked_scan, asked_join, asked_leave;
+static struct sapphire_sta_scan asked_scan_what;
+static struct sapphire_sta_join asked_join_what;
+static struct sapphire_sta_join standing;        /* the network joined whenever the radio comes on (ssid_length 0: none) */
+static struct sapphire_sta_join fallback;        /* ... as it was before a join that has not come through yet */
+
+static struct sapphire_sta_bss *heard;           /* by the last scan that came to an end */
+static unsigned heard_count;
+static struct sapphire_sta_channel channels[CHANNELS_MOST];
+static unsigned channel_count;
+
+static void
+heard_one(const struct sapphire_sta_bss *bss, __unused void *context)
+{
+	/* (only the thread writes the list, and it reads the count without the lock) */
+	if (heard_count < HEARD_MOST) {
+		lck_mtx_lock(&sta_lock);
+		heard[heard_count++] = *bss;
+		lck_mtx_unlock(&sta_lock);
+	}
+}
+
+static void
+sta_runs(__unused void *parameter, __unused wait_result_t result)
+{
+	static struct sapphire_sta_scan scan;
+	static struct sapphire_sta_join join;
+
+	for (;;) {
+		const struct sapphire_sta_ops *ops;
+		bool power = false, power_on = false, leave = false, do_join = false, do_scan = false;
+		int error = 0;
+
+		lck_mtx_lock(&sta_lock);
+		while (sta_ops == NULL || !(asked_power || asked_leave || asked_join || asked_scan)) {
+			lck_mtx_sleep(&sta_lock, LCK_SLEEP_DEFAULT, (event_t)&sta_ops, THREAD_UNINT);
+		}
+		ops = sta_ops;
+		/* one thing at a time, in the order that makes sense when several wait */
+		if (asked_power) {
+			power = true;
+			power_on = asked_power_on;
+			asked_power = false;
+		} else if (asked_leave) {
+			leave = true;
+			asked_leave = false;
+		} else if (asked_join) {
+			do_join = true;
+			join = asked_join_what;
+			bzero(&asked_join_what, sizeof(asked_join_what));
+			asked_join = false;
+		} else {
+			do_scan = true;
+			scan = asked_scan_what;
+			asked_scan = false;
+		}
+		sta_calls = true;
+		lck_mtx_unlock(&sta_lock);
+
+		if (power) {
+			struct sapphire_sta_state *state = kalloc_data(sizeof(*state), Z_WAITOK | Z_ZERO);
+			bool was_joined = false;
+
+			if (state != NULL) {
+				ops->state(state);
+				was_joined = state->phase == SAPPHIRE_STA_JOINED;
+				kfree_data(state, sizeof(*state));
+			}
+			error = ops->power(power_on);
+			if (!power_on && was_joined) {
+				sapphire_apple80211_event(SAPPHIRE_STA_LINK, 0);
+			}
+			sapphire_apple80211_event(SAPPHIRE_STA_POWER, error == 0 ? power_on : !power_on);
+			lck_mtx_lock(&sta_lock);
+			if (error == 0 && power_on && standing.ssid_length != 0 && !asked_join) {
+				asked_join_what = standing;
+				asked_join = true;
+			}
+			lck_mtx_unlock(&sta_lock);
+		} else if (leave) {
+			ops->leave();
+			sapphire_apple80211_event(SAPPHIRE_STA_LINK, 0);
+		} else if (do_join) {
+			error = ops->join(&join);
+			bzero(&join, sizeof(join));
+			sapphire_apple80211_event(SAPPHIRE_STA_JOIN_DONE, error);
+			if (error == 0) {
+				sapphire_apple80211_event(SAPPHIRE_STA_LINK, 1);
+			}
+			/* a join that did not come through (a wrong passphrase) leaves things as they were: the standing network again */
+			lck_mtx_lock(&sta_lock);
+			if (error != 0 && fallback.ssid_length != 0 && !asked_join && !asked_leave && !asked_power) {
+				standing = asked_join_what = fallback;
+				asked_join = true;
+			}
+			bzero(&fallback, sizeof(fallback));
+			lck_mtx_unlock(&sta_lock);
+		} else if (do_scan) {
+			error = ops->scan(&scan);
+			lck_mtx_lock(&sta_lock);
+			heard_count = 0;
+			lck_mtx_unlock(&sta_lock);
+			ops->heard(heard_one, NULL);
+			sapphire_apple80211_event(SAPPHIRE_STA_SCAN_DONE, error);
+		}
+
+		lck_mtx_lock(&sta_lock);
+		sta_calls = false;
+		lck_mtx_unlock(&sta_lock);
+		thread_wakeup((event_t)&sta_calls);
+	}
+}
+
+/* ---- the station side ---------------------------------------------------------------------------------- */
+
+void
+sapphire_sta_attach(const struct sapphire_sta_ops *ops)
+{
+	thread_t thread;
+
+	if (ops == NULL) {
+		lck_mtx_lock(&sta_lock);
+		sta_ops = NULL;
+		asked_power = asked_scan = asked_join = asked_leave = false;
+		while (sta_calls || sta_reads != 0) {
+			lck_mtx_sleep(&sta_lock, LCK_SLEEP_DEFAULT, (event_t)&sta_calls, THREAD_UNINT);
+		}
+		heard_count = channel_count = 0;
+		lck_mtx_unlock(&sta_lock);
+		return;
+	}
+	if (heard == NULL) {
+		heard = kalloc_data(HEARD_MOST * sizeof(*heard), Z_WAITOK | Z_ZERO);
+	}
+	if (heard == NULL) {
+		sapphire_wifi_tell("wifi: no memory for what a scan hears: nobody can ask the radio for a network\n");
+		return;
+	}
+	if (!sta_thread_made) {
+		if (kernel_thread_start(sta_runs, NULL, &thread) != KERN_SUCCESS) {
+			sapphire_wifi_tell("wifi: no thread for the station: nobody can ask the radio for a network\n");
+			return;
+		}
+		thread_set_thread_name(thread, "wifi-station");
+		thread_deallocate(thread);
+		sta_thread_made = true;
+	}
+	channel_count = ops->channels(channels, CHANNELS_MOST);
+	lck_mtx_lock(&sta_lock);
+	sta_ops = ops;
+	sta_on = true;
+	lck_mtx_unlock(&sta_lock);
+	thread_wakeup((event_t)&sta_ops);
+	sapphire_apple80211_event(SAPPHIRE_STA_POWER, 1);
+}
+
+void
+sapphire_sta_lost(int error)
+{
+	sapphire_apple80211_event(SAPPHIRE_STA_LINK, error != 0 ? error : ECONNRESET);
+}
+
+/* ---- who wants a network ------------------------------------------------------------------------------- */
+
+bool
+sapphire_sta_present(void)
+{
+	return sta_ops != NULL;
+}
+
+bool
+sapphire_sta_powered(void)
+{
+	return sta_ops != NULL && sta_on;
+}
+
+bool
+sapphire_sta_busy(void)
+{
+	bool busy;
+
+	lck_mtx_lock(&sta_lock);
+	busy = sta_ops != NULL && (sta_calls || asked_power || asked_leave || asked_join || asked_scan);
+	lck_mtx_unlock(&sta_lock);
+	return busy;
+}
+
+int
+sapphire_sta_ask_power(bool on)
+{
+	lck_mtx_lock(&sta_lock);
+	if (sta_ops == NULL) {
+		lck_mtx_unlock(&sta_lock);
+		return ENXIO;
+	}
+	sta_on = on;
+	asked_power = true;
+	asked_power_on = on;
+	if (!on) {
+		asked_scan = asked_join = asked_leave = false;
+	}
+	lck_mtx_unlock(&sta_lock);
+	thread_wakeup((event_t)&sta_ops);
+	return 0;
+}
+
+int
+sapphire_sta_ask_scan(const struct sapphire_sta_scan *what)
+{
+	lck_mtx_lock(&sta_lock);
+	if (sta_ops == NULL || !sta_on) {
+		lck_mtx_unlock(&sta_lock);
+		return sta_ops == NULL ? ENXIO : ENETDOWN;
+	}
+	asked_scan_what = *what;
+	asked_scan = true;
+	lck_mtx_unlock(&sta_lock);
+	thread_wakeup((event_t)&sta_ops);
+	return 0;
+}
+
+int
+sapphire_sta_ask_join_standing(const struct sapphire_sta_join *what)
+{
+	int error = sapphire_sta_ask_join(what);
+
+	lck_mtx_lock(&sta_lock);
+	if (error == 0) {
+		standing = *what;
+	}
+	lck_mtx_unlock(&sta_lock);
+	return error;
+}
+
+int
+sapphire_sta_ask_join(const struct sapphire_sta_join *what)
+{
+	lck_mtx_lock(&sta_lock);
+	if (sta_ops == NULL || !sta_on) {
+		lck_mtx_unlock(&sta_lock);
+		return sta_ops == NULL ? ENXIO : ENETDOWN;
+	}
+	if (standing.ssid_length != 0) {
+		fallback = standing;
+	}
+	bzero(&standing, sizeof(standing));     /* (whoever asks for a network now has the say) */
+	asked_join_what = *what;
+	asked_join = true;
+	asked_leave = false;
+	lck_mtx_unlock(&sta_lock);
+	thread_wakeup((event_t)&sta_ops);
+	return 0;
+}
+
+int
+sapphire_sta_ask_leave(void)
+{
+	lck_mtx_lock(&sta_lock);
+	if (sta_ops == NULL) {
+		lck_mtx_unlock(&sta_lock);
+		return ENXIO;
+	}
+	asked_leave = true;
+	asked_join = false;
+	bzero(&asked_join_what, sizeof(asked_join_what));
+	bzero(&fallback, sizeof(fallback));
+	lck_mtx_unlock(&sta_lock);
+	thread_wakeup((event_t)&sta_ops);
+	return 0;
+}
+
+bool
+sapphire_sta_heard(unsigned index, struct sapphire_sta_bss *bss)
+{
+	bool there;
+
+	lck_mtx_lock(&sta_lock);
+	if ((there = index < heard_count)) {
+		*bss = heard[index];
+	}
+	lck_mtx_unlock(&sta_lock);
+	return there;
+}
+
+void
+sapphire_sta_state(struct sapphire_sta_state *state)
+{
+	const struct sapphire_sta_ops *ops;
+
+	bzero(state, sizeof(*state));
+	lck_mtx_lock(&sta_lock);
+	if ((ops = sta_ops) != NULL) {
+		sta_reads++;
+	}
+	lck_mtx_unlock(&sta_lock);
+	if (ops != NULL) {
+		ops->state(state);
+		lck_mtx_lock(&sta_lock);
+		sta_reads--;
+		lck_mtx_unlock(&sta_lock);
+		thread_wakeup((event_t)&sta_calls);
+	}
+}
+
+unsigned
+sapphire_sta_channels(struct sapphire_sta_channel *out, unsigned most)
+{
+	unsigned count;
+
+	lck_mtx_lock(&sta_lock);
+	count = channel_count < most ? channel_count : most;
+	memcpy(out, channels, count * sizeof(*out));
+	lck_mtx_unlock(&sta_lock);
+	return count;
+}
+
+bool
+sapphire_sta_address(uint8_t *address)
+{
+	const struct sapphire_sta_ops *ops = sta_ops;
+
+	if (ops != NULL) {
+		memcpy(address, ops->address, 6);
+	}
+	return ops != NULL;
+}
diff --git a/bsd/dev/sapphire_wlan.c b/bsd/dev/sapphire_wlan.c
new file mode 100644
index 0000000..3a40068
--- /dev/null
+++ b/bsd/dev/sapphire_wlan.c
@@ -0,0 +1,257 @@
+/*
+ * sapphire: the WCN3988 station (iokit/Kernel/arm/TopazModem.cpp, upstream's 0129/0130 with
+ * sapphire's boot-arg join 0144) behind en0 and iOS's Wi-Fi side, which are HackiOS's
+ * (bsd/dev/sapphire_net.c, sapphire_sta.c, sapphire_apple80211.c, iokit SapphireWLAN.cpp).
+ *
+ * With boot-arg wifi=1, at the end of the network stack's start (bsd_init, after net_init_run):
+ * en0 is made, link down, with the station's address, and its registry entries published, so
+ * that configd and wifid find a Wi-Fi interface as soon as they run (they look once). When the
+ * modem has the radio up (topaz_wlan_ready_hook, a few seconds later), the station operations
+ * below are handed to sapphire_sta.c: from then on wifid's scans and joins reach the radio.
+ *
+ * Frames: what the station receives once joined is Ethernet already (topaz_wlan_rx_hook), and
+ * goes to sapphire_net_input(); what en0 sends is copied out of its mbufs into
+ * topaz_wlan_transmit(), which queues it for the modem thread. topaz_wlan_link_hook says when
+ * frames can pass: the link is up (configd starts DHCP), or down (and if nobody asked for that,
+ * the network was lost).
+ */
+#include <pexpert/arm64/board_config.h>
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <libkern/libkern.h>
+#include <pexpert/pexpert.h>
+#include <sys/errno.h>
+#include <sys/kpi_mbuf.h>
+#include <sys/systm.h>
+#include <sys/sapphire_net.h>
+#include <sys/sapphire_sta.h>
+
+/* TopazModem.cpp's station */
+struct topaz_wlan_bss {
+	uint8_t bssid[6];
+	uint8_t ssid[32], ssid_length;
+	uint16_t frequency;
+	int16_t rssi;
+	uint16_t beacon_interval, capability;
+	uint32_t age_ms;
+	uint16_t elements_length;
+	uint8_t elements[768];
+};
+extern void (*topaz_wlan_ready_hook)(void);
+extern void (*topaz_wlan_rx_hook)(const uint8_t *frame, size_t length);
+extern void (*topaz_wlan_link_hook)(bool up);
+extern bool topaz_wlan_ready(void);
+extern int topaz_wlan_scan(void);
+extern bool topaz_wlan_heard(unsigned index, struct topaz_wlan_bss *bss);
+extern void topaz_wlan_address(uint8_t address[6]);
+extern int topaz_wlan_join(const uint8_t *ssid, unsigned ssid_len, const uint8_t *bssid, const uint8_t *pass,
+    unsigned pass_len);
+extern int topaz_wlan_join_pmk(const uint8_t *ssid, unsigned ssid_len, const uint8_t *bssid, const uint8_t pmk[32]);
+extern int topaz_wlan_leave(void);
+extern bool topaz_wlan_joined(void);
+extern bool topaz_wlan_transmit(const uint8_t *frame, size_t length);
+
+static uint8_t wlan_frame[SAPPHIRE_NET_FRAME_MAX];     /* under sapphire_net.c's transmit lock */
+static volatile bool wlan_joining, wlan_leaving;
+static volatile int wlan_error;
+static struct sapphire_sta_bss wlan_bss;                /* the network joined or being joined */
+
+static void
+bss_from(const struct topaz_wlan_bss *t, struct sapphire_sta_bss *b)
+{
+	bzero(b, sizeof(*b));
+	memcpy(b->bssid, t->bssid, 6);
+	memcpy(b->ssid, t->ssid, sizeof(b->ssid));
+	b->ssid_length = t->ssid_length;
+	b->frequency = t->frequency;
+	b->rssi = t->rssi;
+	b->beacon_interval = t->beacon_interval;
+	b->capability = t->capability;
+	b->age_ms = t->age_ms;
+	b->elements_length = t->elements_length;
+	memcpy(b->elements, t->elements, t->elements_length);
+}
+
+/* ---- the link behind en0 */
+
+static bool
+wlan_transmit(mbuf_t packet, size_t length)
+{
+	if (length > sizeof(wlan_frame) || mbuf_copydata(packet, 0, length, wlan_frame) != 0) {
+		return false;
+	}
+	return topaz_wlan_transmit(wlan_frame, length);
+}
+
+static struct sapphire_net_link wlan_link = {
+	.name = "the phone's radio (WCN3988)",
+	.wireless = true,
+	.up = false,
+	.transmit = wlan_transmit,
+};
+
+static void
+wlan_rx(const uint8_t *frame, size_t length)
+{
+	sapphire_net_input(frame, length);
+}
+
+static void
+wlan_link_changed(bool up)
+{
+	sapphire_net_link_state(up);
+	if (!up && !wlan_leaving && !wlan_joining) {
+		sapphire_sta_lost(ENETDOWN);            /* the access point let us go */
+	}
+}
+
+/* ---- the station operations (sys/sapphire_sta.h) */
+
+static int
+op_power(bool on)
+{
+	if (!on) {
+		wlan_leaving = true;
+		(void)topaz_wlan_leave();
+		return 0;
+	}
+	return topaz_wlan_ready() ? 0 : ENXIO;          /* the radio is up while the modem is: nothing to switch on */
+}
+
+static int
+op_scan(__unused const struct sapphire_sta_scan *what)
+{
+	return topaz_wlan_scan();                       /* every channel, the station's own way */
+}
+
+static void
+op_heard(void (*each)(const struct sapphire_sta_bss *bss, void *context), void *context)
+{
+	static struct topaz_wlan_bss t;
+	static struct sapphire_sta_bss b;
+
+	for (unsigned i = 0; topaz_wlan_heard(i, &t); i++) {
+		bss_from(&t, &b);
+		each(&b, context);
+	}
+}
+
+static int
+op_join(const struct sapphire_sta_join *what)
+{
+	static struct topaz_wlan_bss t;
+	static const uint8_t none[6];
+	const uint8_t *bssid = memcmp(what->bssid, none, 6) != 0 ? what->bssid : NULL;
+	int error;
+
+	bzero(&wlan_bss, sizeof(wlan_bss));
+	memcpy(wlan_bss.ssid, what->ssid, what->ssid_length);
+	wlan_bss.ssid_length = what->ssid_length;
+	for (unsigned i = 0; topaz_wlan_heard(i, &t); i++) {
+		if (t.ssid_length == what->ssid_length && memcmp(t.ssid, what->ssid, what->ssid_length) == 0 &&
+		    (bssid == NULL || memcmp(t.bssid, bssid, 6) == 0)) {
+			bss_from(&t, &wlan_bss);
+			break;
+		}
+	}
+	wlan_joining = true;
+	wlan_leaving = false;
+	if (what->security == SAPPHIRE_STA_OPEN) {
+		error = topaz_wlan_join(what->ssid, what->ssid_length, bssid, NULL, 0);
+	} else if (what->passphrase_length != 0) {
+		error = topaz_wlan_join(what->ssid, what->ssid_length, bssid, what->passphrase, what->passphrase_length);
+	} else {
+		error = topaz_wlan_join_pmk(what->ssid, what->ssid_length, bssid, what->pmk);
+	}
+	wlan_joining = false;
+	wlan_error = error;
+	return error;
+}
+
+static int
+op_leave(void)
+{
+	wlan_leaving = true;
+	(void)topaz_wlan_leave();
+	for (int i = 0; i < 30 && topaz_wlan_joined(); i++) {
+		delay_for_interval(100, NSEC_PER_MSEC);
+	}
+	return 0;
+}
+
+static void
+op_state(struct sapphire_sta_state *state)
+{
+	state->phase = !topaz_wlan_ready() ? SAPPHIRE_STA_OFF : topaz_wlan_joined() ? SAPPHIRE_STA_JOINED :
+	    wlan_joining ? SAPPHIRE_STA_JOINING : SAPPHIRE_STA_IDLE;
+	state->bss = wlan_bss;
+	state->last_error = wlan_error;
+}
+
+/* what WCN3988 tunes to here: 2.4 GHz 1-13, 5 GHz UNII-1..3 (52-144 with radar care) */
+static unsigned
+op_channels(struct sapphire_sta_channel *channels, unsigned most)
+{
+	static const uint16_t five[] = { 5180, 5200, 5220, 5240, 5260, 5280, 5300, 5320, 5500, 5520, 5540, 5560, 5580,
+		                         5600, 5620, 5640, 5660, 5680, 5700, 5720, 5745, 5765, 5785, 5805, 5825 };
+	unsigned n = 0;
+
+	for (unsigned i = 0; i < 13 && n < most; i++, n++) {
+		channels[n].frequency = (uint16_t)(2412 + 5 * i);
+		channels[n].flags = 0;
+	}
+	for (unsigned i = 0; i < sizeof(five) / sizeof(five[0]) && n < most; i++, n++) {
+		channels[n].frequency = five[i];
+		channels[n].flags = five[i] >= 5260 && five[i] <= 5720 ?
+		    SAPPHIRE_STA_CHANNEL_PASSIVE | SAPPHIRE_STA_CHANNEL_RADAR : 0;
+	}
+	return n;
+}
+
+static struct sapphire_sta_ops wlan_ops = {
+	.power = op_power,
+	.scan = op_scan,
+	.heard = op_heard,
+	.join = op_join,
+	.leave = op_leave,
+	.state = op_state,
+	.channels = op_channels,
+};
+
+/* the modem thread, once the radio is up */
+static void
+wlan_ready(void)
+{
+	printf("wlan: the radio is up: iOS's Wi-Fi side can scan and join\n");
+	sapphire_sta_attach(&wlan_ops);
+}
+
+void sapphire_wlan_init(void);
+
+/* bsd_init, after net_init_run */
+void
+sapphire_wlan_init(void)
+{
+	uint32_t on = 0;
+
+	if (!PE_parse_boot_argn("wifi", &on, sizeof(on)) || on == 0) {
+		return;
+	}
+	sapphire_net_init();
+	topaz_wlan_address(wlan_link.address);
+	memcpy(wlan_ops.address, wlan_link.address, 6);
+	topaz_wlan_rx_hook = wlan_rx;
+	topaz_wlan_link_hook = wlan_link_changed;
+	topaz_wlan_ready_hook = wlan_ready;
+	if (!sapphire_net_attach(&wlan_link)) {
+		printf("wlan: en0 could not be made\n");
+		return;
+	}
+	if (topaz_wlan_ready()) {
+		wlan_ready();                           /* (the radio was quicker) */
+	}
+}
+
+#endif /* ARM64_BOARD_CONFIG_SWEET */
diff --git a/bsd/dev/sweet_audio_ctl.c b/bsd/dev/sweet_audio_ctl.c
new file mode 100644
index 0000000..72774e3
--- /dev/null
+++ b/bsd/dev/sweet_audio_ctl.c
@@ -0,0 +1,45 @@
+/*
+ * kern.sweet_audio: the audio test driven from user space (ssh), carried out by TopazModem's
+ * ADSP thread, which owns the GLINK edge and the SoundWire buses.
+ * Write a request, read the answer:
+ *   op << 56 | target << 48 | addr << 32 | value
+ *   op 1 beep (value: seconds), 2 write, 3 read (the answer: the value), 4 the whole test again,
+ *   5 test flags (value; TopazModem.cpp a_flags)
+ *   target 1 WCD937x, 2 RX macro, 3 VA macro, 4 RX SoundWire master, 5 VA SoundWire master,
+ *   6 FS1815 (addr: I2C address << 8 | register), 7 the WCD937x's RX SoundWire slave,
+ *   8 a TLMM pin's ctl, 9 its io (addr: the GPIO; the answer io << 32 | ctl)
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/kernel.h>
+#include <sys/sysctl.h>
+#include <sys/errno.h>
+#include <libkern/libkern.h>
+
+extern void IOSleep(unsigned int milliseconds);
+
+volatile uint64_t sweet_audio_req, sweet_audio_rsp;
+volatile uint32_t sweet_audio_seq, sweet_audio_done;
+
+static int
+sysctl_sweet_audio SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	uint64_t v = sweet_audio_rsp;
+	int err = sysctl_io_number(req, (long long)v, sizeof(v), &v, NULL);
+	if (err != 0 || req->newptr == USER_ADDR_NULL) {
+		return err;
+	}
+	uint32_t seq = sweet_audio_seq + 1;
+	sweet_audio_req = v;
+	__asm__ volatile("dmb ish" ::: "memory");
+	sweet_audio_seq = seq;
+	for (int i = 0; i < 60000 && sweet_audio_done != seq; i++) {
+		IOSleep(1);
+	}
+	return sweet_audio_done == seq ? 0 : ETIMEDOUT;
+}
+
+SYSCTL_PROC(_kern, OID_AUTO, sweet_audio, CTLTYPE_QUAD | CTLFLAG_RW | CTLFLAG_LOCKED,
+    0, 0, sysctl_sweet_audio, "Q", "audio test requests (sweet_audio_ctl.c)");
+#endif /* ARM64_BOARD_CONFIG_SWEET */
diff --git a/bsd/dev/sweet_audio_dev.c b/bsd/dev/sweet_audio_dev.c
new file mode 100644
index 0000000..4508e54
--- /dev/null
+++ b/bsd/dev/sweet_audio_dev.c
@@ -0,0 +1,147 @@
+/*
+ * /dev/redwood-audio (and /dev/topaz-audio): the sound iOS plays. HackiOS's RedwoodAudio.driver
+ * HAL plug-in in mediaserverd writes whole 48 kHz 16-bit stereo frames here (ABI of its
+ * sys/redwood_audio.h, as in ios-topaz 0146 / 0935) and sets the volume with
+ * ioctl _IOW('r', 1, {below, muted}): eighths of a dB under the loudest, and whether muted.
+ * write() never waits: the writer is the audio server's real-time thread; what does not fit
+ * is dropped. TopazModem's ADSP thread takes the frames out (sweet_audio_take(), mixed to the
+ * one channel of its graph) and feeds the DSP 10 ms at a time.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/conf.h>
+#include <sys/uio.h>
+#include <sys/errno.h>
+#include <sys/ioccom.h>
+#include <sys/proc.h>
+#include <miscfs/devfs/devfs.h>
+#include <kern/clock.h>
+
+#define SA_RING         16384u                  /* frames, 341 ms */
+
+struct sa_volume { uint32_t below, muted; };
+#define SA_SET_VOLUME   _IOW('r', 1, struct sa_volume)
+
+static int16_t sa_ring[SA_RING * 2];
+static volatile uint32_t sa_head, sa_tail;      /* frames written / taken, wrapping counters */
+volatile uint64_t sweet_audio_last_write;       /* mach_absolute_time() of the last write */
+volatile uint32_t sweet_audio_vol_below, sweet_audio_vol_muted, sweet_audio_vol_gen;
+volatile uint64_t sweet_audio_frames_in, sweet_audio_frames_dropped;
+
+uint32_t sweet_audio_avail(void);
+uint32_t sweet_audio_take(int16_t *mono, uint32_t frames);
+void sweet_audio_flush(void);
+void sweet_audio_dev_init(void);
+
+uint32_t
+sweet_audio_avail(void)
+{
+	return sa_head - sa_tail;
+}
+
+uint32_t
+sweet_audio_take(int16_t *mono, uint32_t frames)
+{
+	uint32_t t = sa_tail, n = sa_head - t;
+	__asm__ volatile("dmb ish" ::: "memory");
+	if (n > frames) {
+		n = frames;
+	}
+	for (uint32_t i = 0; i < n; i++) {
+		uint32_t k = (t + i) % SA_RING;
+		mono[i] = (int16_t)(((int32_t)sa_ring[2 * k] + sa_ring[2 * k + 1]) / 2);
+	}
+	__asm__ volatile("dmb ish" ::: "memory");
+	sa_tail = t + n;
+	return n;
+}
+
+void
+sweet_audio_flush(void)
+{
+	sa_tail = sa_head;
+}
+
+static int
+sa_open(__unused dev_t dev, __unused int flags, __unused int devtype, __unused struct proc *p)
+{
+	return 0;
+}
+
+static int
+sa_close(__unused dev_t dev, __unused int flags, __unused int devtype, __unused struct proc *p)
+{
+	return 0;
+}
+
+static int
+sa_write(__unused dev_t dev, struct uio *uio, __unused int ioflag)
+{
+	int16_t buf[512 * 2];
+
+	while (uio_resid(uio) >= 4) {
+		user_ssize_t n = uio_resid(uio);
+		if (n > (user_ssize_t)sizeof(buf)) {
+			n = sizeof(buf);
+		}
+		n &= ~3;
+		int err = uiomove((char *)buf, (int)n, uio);
+		if (err != 0) {
+			return err;
+		}
+		uint32_t frames = (uint32_t)(n / 4), h = sa_head, room = SA_RING - 1 - (h - sa_tail);
+		if (frames > room) {
+			sweet_audio_frames_dropped += frames - room;
+			frames = room;
+		}
+		for (uint32_t i = 0; i < frames; i++) {
+			uint32_t k = (h + i) % SA_RING;
+			sa_ring[2 * k] = buf[2 * i];
+			sa_ring[2 * k + 1] = buf[2 * i + 1];
+		}
+		__asm__ volatile("dmb ish" ::: "memory");
+		sa_head = h + frames;
+		sweet_audio_frames_in += frames;
+		sweet_audio_last_write = mach_absolute_time();
+	}
+	return 0;
+}
+
+static int
+sa_ioctl(__unused dev_t dev, u_long cmd, caddr_t data, __unused int flag, __unused struct proc *p)
+{
+	if (cmd != SA_SET_VOLUME) {
+		return ENOTTY;
+	}
+	const struct sa_volume *v = (const struct sa_volume *)data;
+	sweet_audio_vol_below = v->below;
+	sweet_audio_vol_muted = v->muted;
+	sweet_audio_vol_gen++;
+	return 0;
+}
+
+static const struct cdevsw sa_cdevsw = {
+	.d_open = sa_open, .d_close = sa_close, .d_read = eno_rdwrt, .d_write = sa_write, .d_ioctl = sa_ioctl,
+	.d_stop = eno_stop, .d_reset = eno_reset, .d_ttys = NULL, .d_select = eno_select, .d_mmap = eno_mmap,
+	.d_strategy = eno_strat, .d_type = 0,
+};
+
+/* once the DSP's graph is ready (TopazModem audio_test()) */
+void
+sweet_audio_dev_init(void)
+{
+	static int major = -1;
+	if (major >= 0) {
+		return;
+	}
+	major = cdevsw_add(-1, &sa_cdevsw);
+	if (major < 0) {
+		printf("sweet audio: no major\n");
+		return;
+	}
+	void *a = devfs_make_node(makedev(major, 0), DEVFS_CHAR, UID_ROOT, GID_WHEEL, 0666, "redwood-audio");
+	void *b = devfs_make_node(makedev(major, 0), DEVFS_CHAR, UID_ROOT, GID_WHEEL, 0666, "topaz-audio");
+	printf("sweet audio: /dev/redwood-audio %s, /dev/topaz-audio %s\n", a ? "ready" : "failed", b ? "ready" : "failed");
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
diff --git a/bsd/dev/sweet_bt.c b/bsd/dev/sweet_bt.c
new file mode 100755
index 0000000..e2aec2f
--- /dev/null
+++ b/bsd/dev/sweet_bt.c
@@ -0,0 +1,1161 @@
+/*
+ * sapphire 0280: Bluetooth phase 1 (research/bluetooth.md): the WCN3988's BT side on its UART,
+ * QUP0 SE3 (0x04a8c000) in GENI FIFO mode, polled. Nothing runs at boot.
+ *   kern.sweet_bt = op: 1 rails (RPM votes L9/L16/L17/L23, never off), SE3 clocks (vote 0x7900c
+ *     bit 13, CBCR 0x1f4d4, RCG 0x1f4d8: gcc-khaje.ko), the SE's protocol checked (FW_REVISION
+ *     0x68 bits 15:8 == 2, UART) before anything else, GPIO 8-11 to qup3 (function 1,
+ *     pinctrl-khaje.ko), then the UART at 115200 8N1 with RTS/CTS; 2 the power pulse (0xFC at 2400
+ *     baud, no flow control), HCI_Reset and the Qualcomm version request (0xFC00 sub-op 0x19);
+ *     3 HCI_Read_Local_Version and HCI_Read_BD_ADDR; 9 off (UART stopped, rails stay voted: they
+ *     feed Wi-Fi and the fingerprint sensor too). Reading it gives the last result.
+ *   kern.sweet_bt_log: the log of the last request (also in the kernel log, "SWEET BT:").
+ *   /dev/qcabt: raw H4 bytes both ways (write = to the controller; read = what it sent), filled
+ *     by a polling thread while the node is open; ops 2/3 answer EBUSY meanwhile.
+ *     0281: the ioctls of userland/bluetooth/qcabt.h (POWER, SETBAUD 1200..4000000, FLOW, FLUSH,
+ *     SWCTRL, DRAIN) and select(). The polling thread polls every ~20 us while bytes flow and
+ *     sleeps 1 ms once idle; RX FIFO overruns, parity/framing errors, breaks and ring drops are
+ *     counted and logged.
+ *     0282: back to one byte per FIFO word both ways (0281's four-byte packing broke TX and RX;
+ *     0280's one byte per word worked): BT_BPW. op 4: a self-test, HCI_Reset +
+ *     HCI_Read_Local_Version 20 times, failures counted.
+ *   At boot (0281) only device nodes are made, no hardware is touched: /dev/qcabt and two stubs,
+ *     /dev/uart.bluetooth and /dev/cu.bluetooth, whose open answers ENXIO (bluetoothd only checks
+ *     that the node exists). Boot-arg bt=0 skips them.
+ * UART clock: SE3's RCG is in DFS mode on Qualcomm boards (its levels set by the boot loader):
+ * for each baud rate the first level within 1.5 % of baud x oversampling is picked (GENI_CLK_SEL).
+ * Without DFS the RCG is programmed from GPLL0 even (300 MHz) with M/N: 7.3728 MHz (384/15625, the
+ * kernel's own table entry), 14.7456, 48 (4/25), 51.2 (64/375), 64 (16/75), 96 (8/25) or 102.4 MHz
+ * (128/375), the lowest one that fits (3 Mbaud x 16 = 48 MHz, 3.2 Mbaud x 16 = 51.2 MHz).
+ * Every wait bounded, every step logged.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <stdbool.h>
+#include <stdarg.h>
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/conf.h>
+#include <sys/uio.h>
+#include <sys/errno.h>
+#include <sys/fcntl.h>
+#include <sys/proc.h>
+#include <sys/sysctl.h>
+#include <sys/vnode.h>
+#include <sys/select.h>
+#include <sys/ioccom.h>
+#include <pexpert/pexpert.h>
+#include <miscfs/devfs/devfs.h>
+#include <kern/locks.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+extern void IODelay(unsigned microseconds);
+extern void IOSleep(unsigned milliseconds);
+extern kern_return_t thread_terminate(thread_t);
+extern int topaz_rpm_ldo(uint32_t id, uint32_t uv, uint32_t ma, uint32_t set);
+
+#define BT_SE_PA        0x04a8c000u
+#define BT_QUP_PA       0x04ac0000u             /* QUPv3_0 wrapper: hw version at +0x4 */
+#define GCC_PA          0x01400000u
+#define GCC_VOTE        0x7900cu                /* 0x79000 window */
+#define BT_VOTE_BITS    0x23C0u                 /* m_ahb 6, s_ahb 7, core 8, core_2x 9, s3 13 */
+#define BT_CBCR         0x1f4d4u                /* gcc_qupv3_wrap0_s3_clk (0x1f000 window) */
+#define BT_RCG          0x1f4d8u                /* its clk_src: CMD, CFG +4, M +8, N +0xC, D +0x10 */
+#define RCG_DFSR        0x14u
+#define RCG_PERF(l)     (0x1Cu + 4u * (l))
+#define RCG_PERF_M(l)   (0x5Cu + 4u * (l))
+#define RCG_PERF_N(l)   (0x9Cu + 4u * (l))
+static const unsigned bt_pins[4] = { 8, 9, 10, 11 };   /* CTS, RTS, TX, RX */
+#define BT_SWCTRL       87
+
+/* GENI (qcom-geni-se.h, qcom_geni_serial.c) */
+#define GENI_FORCE_DEFAULT 0x020
+#define GENI_OUTPUT_CTRL 0x024
+#define GENI_CGC_CTRL   0x028
+#define GENI_STATUS     0x040
+#define GENI_M_CLK_CFG  0x048
+#define GENI_S_CLK_CFG  0x04C
+#define GENI_FW_REV     0x068
+#define GENI_CLK_SEL    0x07C
+#define UART_LOOPBACK   0x22C
+#define SE_BYTE_GRAN    0x254
+#define SE_DMA_MODE_EN  0x258
+#define UART_TX_CFG     0x25C
+#define TX_PACK0        0x260
+#define TX_PACK1        0x264
+#define UART_TX_WORDLEN 0x268
+#define UART_TX_STOPLEN 0x26C
+#define UART_TX_LEN     0x270
+#define UART_RX_CFG     0x280
+#define RX_PACK0        0x284
+#define RX_PACK1        0x288
+#define UART_RX_WORDLEN 0x28C
+#define UART_RX_STALE   0x294
+#define UART_TX_PARITY  0x2A4
+#define UART_RX_PARITY  0x2A8
+#define UART_MANUAL_RFR 0x2AC
+#define M_CMD0          0x600
+#define M_CMD_CTRL      0x604
+#define M_IRQ_STATUS    0x610
+#define M_IRQ_EN        0x614
+#define M_IRQ_CLEAR     0x618
+#define S_CMD0          0x630
+#define S_CMD_CTRL      0x634
+#define S_IRQ_STATUS    0x640
+#define S_IRQ_EN        0x644
+#define S_IRQ_CLEAR     0x648
+#define TX_FIFO         0x700
+#define RX_FIFO         0x780
+#define TX_FIFO_STATUS  0x800
+#define RX_FIFO_STATUS  0x804
+#define TX_WATERMARK    0x80C
+#define RX_WATERMARK    0x810
+#define RX_RFR_WM       0x814
+#define SE_GSI_EVENT_EN 0xE18
+#define SE_IRQ_EN       0xE1C
+#define SE_HW_PARAM_0   0xE24
+#define SE_HW_PARAM_1   0xE28
+#define SE_DMA_GENERAL  0xE30
+#define M_CMD_ACTIVE    (1u << 0)
+#define S_CMD_ACTIVE    (1u << 12)
+
+static LCK_GRP_DECLARE(sweet_bt_grp, "sweet_bt");
+static LCK_MTX_DECLARE(sweet_bt_mtx, &sweet_bt_grp);       /* the hardware */
+static LCK_MTX_DECLARE(sweet_bt_rxmtx, &sweet_bt_grp);     /* the RX ring */
+static vm_offset_t bt_se, bt_gcc1f, bt_gcc79, bt_qup, bt_pin[4], bt_sw;
+static bool bt_up, bt_open_flag;
+static volatile bool bt_rx_run, bt_rx_alive;
+static int bt_last = -1;
+static unsigned bt_samp = 32, bt_level = 0, bt_tx_depth = 16;
+static uint64_t bt_clk_hz;
+static char bt_logbuf[8192];
+static size_t bt_loglen;
+#define BT_RING 8192
+static uint8_t bt_ring[BT_RING];
+static volatile uint32_t bt_rhead, bt_rtail;
+static uint32_t bt_rdrops;
+static bool bt_dfs;
+static uint64_t bt_dfs_hz[8];
+static uint32_t bt_baud_now, bt_ovr, bt_par, bt_brk;
+static bool bt_flow_on = true;
+static struct selinfo bt_sel;
+static uint8_t bt_wbuf[2048];                   /* write(): under sweet_bt_mtx */
+#define S_RX_FIFO_WR_ERR (1u << 25)
+#define BT_BPW          1u                      /* bytes per FIFO word (pack cfg 0xF / 0) */
+#define S_GP_PARITY     ((1u << 9) | (1u << 10))
+#define S_GP_BREAK      ((1u << 11) | (1u << 12))
+#define QCABT_POWER     _IOW('q', 1, int)
+#define QCABT_SETBAUD   _IOW('q', 2, uint32_t)
+#define QCABT_FLOW      _IOW('q', 3, int)
+#define QCABT_FLUSH     _IO('q', 4)
+#define QCABT_SWCTRL    _IOR('q', 5, int)
+#define QCABT_DRAIN     _IO('q', 6)
+static int bt_major = -1;
+
+static void
+btlog(const char *fmt, ...)
+{
+	char line[256];
+	va_list ap;
+	va_start(ap, fmt);
+	int n = vsnprintf(line, sizeof(line), fmt, ap);
+	va_end(ap);
+	if (n < 0) {
+		return;
+	}
+	printf("SWEET BT: %s\n", line);
+	if (bt_loglen + strlen(line) + 2 >= sizeof(bt_logbuf)) {
+		bt_loglen = (size_t)snprintf(bt_logbuf, sizeof(bt_logbuf), "(log wrapped)\n");
+	}
+	if (bt_loglen + strlen(line) + 2 < sizeof(bt_logbuf)) {
+		bt_loglen += (size_t)snprintf(bt_logbuf + bt_loglen, sizeof(bt_logbuf) - bt_loglen, "%s\n", line);
+	}
+}
+
+static inline uint32_t rd(vm_offset_t b, uint32_t o) { return *(volatile uint32_t *)(b + o); }
+static inline void wr(vm_offset_t b, uint32_t o, uint32_t v)
+{
+	__asm__ volatile ("dsb sy" ::: "memory");
+	*(volatile uint32_t *)(b + o) = v;
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+static vm_offset_t
+pin_map(unsigned gpio)
+{
+	static const char tile[] = "WWWWWWWWEEEEWWWWWWEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEWWWWWWWSSSSSSSSWWWWWWWEEWEEWWWWWWSSSSSSSSSSSSSSS";
+	uint64_t base = tile[gpio] == 'S' ? 0x00900000ull : tile[gpio] == 'E' ? 0x00D00000ull : 0x00500000ull;
+	return ml_io_map(base + gpio * 0x1000ull, 0x1000);
+}
+
+/* everything mapped once */
+static bool
+bt_map(void)
+{
+	if (bt_se != 0) {
+		return true;
+	}
+	bt_gcc1f = ml_io_map(GCC_PA + 0x1f000, 0x1000);
+	bt_gcc79 = ml_io_map(GCC_PA + 0x79000, 0x1000);
+	bt_qup = ml_io_map(BT_QUP_PA, 0x1000);
+	for (unsigned i = 0; i < 4; i++) {
+		bt_pin[i] = pin_map(bt_pins[i]);
+	}
+	bt_sw = pin_map(BT_SWCTRL);
+	bt_se = ml_io_map(BT_SE_PA, 0x4000);
+	return bt_se && bt_gcc1f && bt_gcc79 && bt_qup && bt_pin[0] && bt_pin[1] && bt_pin[2] && bt_pin[3] && bt_sw;
+}
+
+/* ---------------------------------------------------------------- op 1 */
+
+static bool
+bt_rails(void)
+{
+	static const struct { uint32_t id, uv, ma; const char *name; } r[4] = {
+		{ 9, 1800000, 15, "L9 vdd-io 1.8 V" }, { 16, 1800000, 80, "L16 vdd-xtal 1.8 V" },
+		{ 17, 1304000, 300, "L17 vdd-core 1.304 V" }, { 23, 3200000, 450, "L23 vdd-pa 3.2 V" },
+	};
+	bool ok = true;
+	for (unsigned i = 0; i < 4; i++) {
+		int v = topaz_rpm_ldo(r[i].id, r[i].uv, r[i].ma, 0);
+		btlog("rail %s (%u mA), active set: %d (0: taken)", r[i].name, r[i].ma, v);
+		ok = ok && v == 0;
+	}
+	return ok;
+}
+
+static void
+bt_pins_mux(void)
+{
+	/* CTS, RTS, TX: qup3 (function 1), 2 mA, no pull; RX: pull-up (the line idles high) */
+	for (unsigned i = 0; i < 4; i++) {
+		volatile uint32_t *g = (volatile uint32_t *)bt_pin[i];
+		uint32_t ctl = g[0], io = g[1];
+		uint32_t nv = (1u << 2) | (i == 3 ? 3u : 0u) | ((ctl & (1u << 11)) ? (1u << 12) : 0);
+		g[0] = nv;
+		__asm__ volatile ("dsb sy" ::: "memory");
+		btlog("gpio%u: ctl %#x io %#x -> ctl %#x io %#x", bt_pins[i], ctl, io, g[0], g[1]);
+	}
+	volatile uint32_t *s = (volatile uint32_t *)bt_sw;
+	btlog("gpio%u (SW_CTRL, input): ctl %#x level %u", BT_SWCTRL, s[0], s[1] & 1);
+}
+
+static bool
+bt_clocks(void)
+{
+	uint32_t vote = rd(bt_gcc79, GCC_VOTE & 0xfff), cbcr = rd(bt_gcc1f, BT_CBCR & 0xfff);
+	btlog("GCC QUP vote %#x, s3 CBCR %#x, RCG cmd %#x cfg %#x", vote, cbcr, rd(bt_gcc1f, BT_RCG & 0xfff),
+	    rd(bt_gcc1f, (BT_RCG + 4) & 0xfff));
+	wr(bt_gcc79, GCC_VOTE & 0xfff, vote | BT_VOTE_BITS);
+	for (int i = 0; i < 100; i++) {
+		if ((rd(bt_gcc1f, BT_CBCR & 0xfff) >> 31) == 0) {
+			btlog("SE3 clock on: vote %#x CBCR %#x", rd(bt_gcc79, GCC_VOTE & 0xfff), rd(bt_gcc1f, BT_CBCR & 0xfff));
+			return true;
+		}
+		IODelay(10);
+	}
+	btlog("SE3 clock still off after 1 ms (CBCR %#x): stop", rd(bt_gcc1f, BT_CBCR & 0xfff));
+	return false;
+}
+
+/* the SE clock source: the DFS levels are read and kept; without DFS the RCG is programmed per baud */
+static bool
+bt_clock_rate(void)
+{
+	static const uint64_t parent[8] = { 19200000, 600000000, 300000000, 0, 0, 0, 0, 0 };
+	uint32_t rcg = BT_RCG & 0xfff;
+	uint32_t dfs = rd(bt_gcc1f, rcg + RCG_DFSR);
+	btlog("RCG DFS register %#x (%s), cmd %#x cfg %#x", dfs, (dfs & 1) ? "DFS on" : "DFS off", rd(bt_gcc1f, rcg),
+	    rd(bt_gcc1f, rcg + 4));
+	bt_dfs = (dfs & 1) != 0;
+	bt_clk_hz = 0;                                  /* without DFS: unknown until programmed */
+	if (!bt_dfs) {
+		return true;
+	}
+	for (unsigned l = 0; l < 8; l++) {
+		uint32_t cfg = rd(bt_gcc1f, rcg + RCG_PERF(l)), src = (cfg >> 8) & 7, hid = cfg & 0x1f, mode = (cfg >> 12) & 3;
+		uint64_t rate = parent[src];
+		uint32_t m = 0, n = 0;
+		if (mode != 0) {
+			m = rd(bt_gcc1f, rcg + RCG_PERF_M(l)) & 0xffff;
+			n = ((~rd(bt_gcc1f, rcg + RCG_PERF_N(l))) & 0xffff) + m;
+			n &= 0xffff;
+			rate = n ? rate * m / n : 0;
+		}
+		if (hid != 0) {
+			rate = rate * 2 / (hid + 1);
+		}
+		bt_dfs_hz[l] = rate;
+		btlog("DFS level %u: cfg %#x (src %u, div %u, mode %u, m %u n %u) = %llu Hz", l, cfg, src, hid, mode, m, n, rate);
+	}
+	return true;
+}
+
+/* the divider for baud at rate, 0 if it is more than 1.5 % off (or out of the 12-bit range) */
+static uint32_t
+bt_div_for(uint64_t rate, uint32_t baud)
+{
+	uint64_t unit = (uint64_t)baud * bt_samp;
+	if (rate == 0 || unit == 0) {
+		return 0;
+	}
+	uint64_t div = (rate + unit / 2) / unit;
+	if (div == 0 || div > 0xfff) {
+		return 0;
+	}
+	uint64_t got = rate / div, err = got > unit ? got - unit : unit - got;
+	return err * 1000 / unit < 15 ? (uint32_t)div : 0;
+}
+
+static const struct { uint32_t hz, m, n; } bt_rates[] = {
+	{ 7372800, 384, 15625 }, { 14745600, 768, 15625 }, { 48000000, 4, 25 }, { 51200000, 64, 375 },
+	{ 64000000, 16, 75 }, { 96000000, 8, 25 }, { 102400000, 128, 375 },
+};
+
+/* GPLL0 even (source 2) x m / n, dual-edge M/N, no pre-divider (D = ~n: 50 % duty, clk-rcg2.c) */
+static bool
+bt_rcg_set(unsigned i)
+{
+	uint32_t rcg = BT_RCG & 0xfff, m = bt_rates[i].m, n = bt_rates[i].n;
+	btlog("RCG before: cmd %#x cfg %#x m %#x n %#x d %#x", rd(bt_gcc1f, rcg), rd(bt_gcc1f, rcg + 4), rd(bt_gcc1f, rcg + 8),
+	    rd(bt_gcc1f, rcg + 0xC), rd(bt_gcc1f, rcg + 0x10));
+	wr(bt_gcc1f, rcg + 0x8, m);
+	wr(bt_gcc1f, rcg + 0xC, (~(n - m)) & 0xffff);
+	wr(bt_gcc1f, rcg + 0x10, (~n) & 0xffff);
+	wr(bt_gcc1f, rcg + 0x4, (2u << 12) | (2u << 8) | 1u);
+	wr(bt_gcc1f, rcg, rd(bt_gcc1f, rcg) | 1);
+	for (int k = 0; k < 100 && (rd(bt_gcc1f, rcg) & 1); k++) {
+		IODelay(10);
+	}
+	btlog("RCG %u Hz: cmd %#x cfg %#x m %#x n %#x d %#x", bt_rates[i].hz, rd(bt_gcc1f, rcg), rd(bt_gcc1f, rcg + 4),
+	    rd(bt_gcc1f, rcg + 8), rd(bt_gcc1f, rcg + 0xC), rd(bt_gcc1f, rcg + 0x10));
+	if (rd(bt_gcc1f, rcg) & 1) {
+		btlog("RCG update did not complete");
+		bt_clk_hz = 0;
+		return false;
+	}
+	bt_clk_hz = bt_rates[i].hz;
+	return true;
+}
+
+static unsigned bt_rx_poll(void);
+static void bt_rx_start(void);
+static int bt_drain(unsigned ms);
+
+static int
+bt_set_baud(uint32_t baud)
+{
+	if (baud < 1200 || baud > 4000000) {
+		btlog("baud %u: out of range", baud);
+		return EINVAL;
+	}
+	int pick = -1;
+	uint32_t div = 0;
+	uint64_t hz = 0;
+	if (bt_dfs) {
+		for (unsigned l = 0; l < 8 && pick < 0; l++) {
+			if ((div = bt_div_for(bt_dfs_hz[l], baud)) != 0) {
+				pick = (int)l;
+				hz = bt_dfs_hz[l];
+			}
+		}
+	} else {
+		/* the current rate if it fits, else the lowest table rate that does */
+		if (bt_clk_hz != 0 && (div = bt_div_for(bt_clk_hz, baud)) != 0) {
+			hz = bt_clk_hz;
+			for (unsigned i = 0; i < sizeof(bt_rates) / sizeof(bt_rates[0]); i++) {
+				if (bt_rates[i].hz == hz) {
+					pick = (int)i;
+				}
+			}
+		}
+		for (unsigned i = 0; i < sizeof(bt_rates) / sizeof(bt_rates[0]) && pick < 0; i++) {
+			if ((div = bt_div_for(bt_rates[i].hz, baud)) != 0) {
+				pick = (int)i;
+				hz = bt_rates[i].hz;
+			}
+		}
+	}
+	if (pick < 0) {
+		btlog("baud %u: no SE clock gives it (oversampling %u)", baud, bt_samp);
+		return ENOTSUP;
+	}
+	/* TX finished, what RX holds into the ring, RX stopped (cancel, then abort), bounded */
+	if (bt_baud_now != 0) {
+		(void)bt_drain(200);
+	}
+	(void)bt_rx_poll();
+	if (rd(bt_se, GENI_STATUS) & S_CMD_ACTIVE) {
+		wr(bt_se, S_CMD_CTRL, 1u << 2);
+		for (int k = 0; k < 100 && (rd(bt_se, GENI_STATUS) & S_CMD_ACTIVE); k++) {
+			IODelay(10);
+		}
+		if (rd(bt_se, GENI_STATUS) & S_CMD_ACTIVE) {
+			wr(bt_se, S_CMD_CTRL, 1u << 1);
+			for (int k = 0; k < 100 && (rd(bt_se, GENI_STATUS) & S_CMD_ACTIVE); k++) {
+				IODelay(10);
+			}
+		}
+	}
+	if (!bt_dfs && hz != bt_clk_hz && !bt_rcg_set((unsigned)pick)) {
+		return EIO;
+	}
+	bt_level = bt_dfs ? (unsigned)pick : 0;
+	bt_clk_hz = hz;
+	wr(bt_se, GENI_CLK_SEL, bt_level);
+	wr(bt_se, GENI_M_CLK_CFG, (div << 4) | 1);
+	wr(bt_se, GENI_S_CLK_CFG, (div << 4) | 1);
+	wr(bt_se, S_IRQ_CLEAR, 0xffffffffu);
+	bt_rx_start();
+	bt_baud_now = baud;
+	btlog("UART %u baud (%s %u: %llu Hz / %u / %u = %llu)", baud, bt_dfs ? "DFS level" : "rate", (unsigned)pick, hz, div,
+	    bt_samp, hz / ((uint64_t)div * bt_samp));
+	return 0;
+}
+
+/* flow on: CTS gates TX, RFR by the hardware; off: CTS ignored, RFR as given (0: the hardware's) */
+static void
+bt_flow(bool on, uint32_t rfr)
+{
+	wr(bt_se, UART_TX_CFG, on ? 0 : 2);             /* bit 1: ignore CTS */
+	wr(bt_se, UART_MANUAL_RFR, on ? 0 : rfr);
+	bt_flow_on = on;
+	btlog("flow control %s (manual RFR %#x)", on ? "on" : "off", rd(bt_se, UART_MANUAL_RFR));
+}
+
+static int
+bt_baud(uint32_t baud, bool flow)
+{
+	int r = bt_set_baud(baud);
+	bt_flow(flow, 0);
+	return r;
+}
+
+static void
+bt_rx_start(void)
+{
+	if ((rd(bt_se, GENI_STATUS) & S_CMD_ACTIVE) == 0) {
+		wr(bt_se, S_IRQ_CLEAR, 0xffffffffu);
+		wr(bt_se, S_CMD0, 1u << 27);                /* UART_START_READ */
+	}
+}
+
+static int
+bt_init(void)
+{
+	if (!bt_map()) {
+		btlog("mappings failed");
+		return ENOMEM;
+	}
+	if (!bt_rails()) {
+		btlog("a rail was not taken: stop");
+		return EIO;
+	}
+	IOSleep(10);
+	if (!bt_clocks()) {
+		return EIO;
+	}
+	uint32_t fw = rd(bt_se, GENI_FW_REV), st = rd(bt_se, GENI_STATUS);
+	btlog("SE3 FW_REVISION %#x (protocol %u), status %#x, hw param0 %#x param1 %#x", fw, (fw >> 8) & 0xff, st,
+	    rd(bt_se, SE_HW_PARAM_0), rd(bt_se, SE_HW_PARAM_1));
+	if (((fw >> 8) & 0xff) != 2) {
+		btlog("SE3 is not a UART (protocol %u): stop", (fw >> 8) & 0xff);
+		return ENODEV;
+	}
+	bt_pins_mux();
+	uint32_t ver = rd(bt_qup, 0x4);
+	bt_samp = ver >= 0x20050000u ? 16 : 32;
+	btlog("QUP hw version %#x: oversampling %u", ver, bt_samp);
+	if (!bt_clock_rate()) {
+		return EIO;
+	}
+	bt_tx_depth = (rd(bt_se, SE_HW_PARAM_0) >> 16) & 0x3f;
+	uint32_t rxd = (rd(bt_se, SE_HW_PARAM_1) >> 16) & 0x3f;
+	bt_tx_depth = bt_tx_depth ? bt_tx_depth : 16;
+	/* FIFO mode, polled; one byte per FIFO word both ways (as 0280) */
+	wr(bt_se, M_CMD_CTRL, 1u << 1);                 /* abort anything left */
+	wr(bt_se, S_CMD_CTRL, 1u << 1);
+	IODelay(100);
+	wr(bt_se, SE_GSI_EVENT_EN, 0);
+	wr(bt_se, SE_IRQ_EN, 0xF);
+	wr(bt_se, M_IRQ_CLEAR, 0xffffffffu);
+	wr(bt_se, S_IRQ_CLEAR, 0xffffffffu);
+	wr(bt_se, SE_DMA_MODE_EN, 0);
+	wr(bt_se, GENI_CGC_CTRL, rd(bt_se, GENI_CGC_CTRL) | 0x7f);
+	wr(bt_se, SE_DMA_GENERAL, rd(bt_se, SE_DMA_GENERAL) | 0x0f);
+	wr(bt_se, GENI_OUTPUT_CTRL, 0x7f);
+	wr(bt_se, GENI_FORCE_DEFAULT, 1);
+	wr(bt_se, SE_BYTE_GRAN, 0);
+	wr(bt_se, TX_PACK0, 0xF);
+	wr(bt_se, TX_PACK1, 0);
+	wr(bt_se, RX_PACK0, 0xF);
+	wr(bt_se, RX_PACK1, 0);
+	wr(bt_se, TX_WATERMARK, 0);
+	wr(bt_se, RX_WATERMARK, 0);
+	wr(bt_se, RX_RFR_WM, rxd > 2 ? rxd - 2 : 1);
+	wr(bt_se, UART_LOOPBACK, 0);
+	wr(bt_se, UART_TX_WORDLEN, 8);
+	wr(bt_se, UART_TX_STOPLEN, 0);
+	wr(bt_se, UART_RX_CFG, 0);
+	wr(bt_se, UART_RX_WORDLEN, 8);
+	wr(bt_se, UART_RX_STALE, 160);
+	wr(bt_se, UART_TX_PARITY, 0);
+	wr(bt_se, UART_RX_PARITY, 0);
+	wr(bt_se, M_IRQ_EN, (1u << 0) | 0x3eu | (1u << 30));
+	wr(bt_se, S_IRQ_EN, (1u << 0) | (1u << 26) | (1u << 27) | S_RX_FIFO_WR_ERR | S_GP_PARITY | S_GP_BREAK);
+	bt_baud_now = 0;
+	if (bt_baud(115200, true) != 0) {
+		btlog("115200 not possible: stop");
+		return EIO;
+	}
+	bt_rx_start();
+	bt_up = true;
+	btlog("UART up: tx fifo %u words, rx fifo %u words, status %#x", bt_tx_depth, rxd, rd(bt_se, GENI_STATUS));
+	return 0;
+}
+
+/* ---------------------------------------------------------------- bytes */
+
+static void
+bt_count(const char *what, uint32_t *c)
+{
+	++*c;
+	if ((*c & (*c - 1)) == 0) {                     /* 1, 2, 4, 8 ...: not a log line per error */
+		btlog("rx: %s, %u so far (overrun %u, parity/framing %u, break %u, ring drops %u)", what, *c, bt_ovr, bt_par,
+		    bt_brk, bt_rdrops);
+	}
+}
+
+/*
+ * what the RX FIFO holds into the ring, BT_BPW bytes per word; with more than one, the last word may
+ * be partial (stale timeout): RX_FIFO_STATUS bit 31 with the valid byte count in bits 30:28.
+ */
+static unsigned
+bt_rx_poll(void)
+{
+	unsigned got = 0;
+	for (int k = 0; k < 64; k++) {
+		uint32_t st = rd(bt_se, RX_FIFO_STATUS), wc = st & 0x1ffffffu;
+		if (wc == 0) {
+			break;
+		}
+		unsigned lastb = (BT_BPW > 1 && (st >> 31)) ? (st >> 28) & 7 : 0;
+		lck_mtx_lock(&sweet_bt_rxmtx);
+		for (uint32_t i = 0; i < wc; i++) {
+			uint32_t w = rd(bt_se, RX_FIFO);
+			unsigned nb = (i + 1 == wc && lastb != 0) ? lastb : BT_BPW;
+			for (unsigned b = 0; b < nb; b++) {
+				if (bt_rhead - bt_rtail < BT_RING) {
+					bt_ring[bt_rhead % BT_RING] = (uint8_t)(w >> (8 * b));
+					bt_rhead++;
+				} else {
+					bt_rdrops++;
+				}
+				got++;
+			}
+		}
+		lck_mtx_unlock(&sweet_bt_rxmtx);
+	}
+	uint32_t s = rd(bt_se, S_IRQ_STATUS);
+	if (s) {
+		wr(bt_se, S_IRQ_CLEAR, s);
+		if (s & S_RX_FIFO_WR_ERR) {
+			bt_count("RX FIFO overrun", &bt_ovr);
+		}
+		if (s & S_GP_PARITY) {
+			bt_count("parity/framing error", &bt_par);
+		}
+		if (s & S_GP_BREAK) {
+			bt_count("break", &bt_brk);
+		}
+	}
+	bt_rx_start();
+	if (got) {
+		wakeup(bt_ring);
+		selwakeup(&bt_sel);
+	}
+	return got;
+}
+
+static int
+bt_tx(const uint8_t *p, uint32_t n)
+{
+	for (int i = 0; i < 500 && (rd(bt_se, GENI_STATUS) & M_CMD_ACTIVE); i++) {
+		(void)bt_rx_poll();
+		IODelay(100);
+	}
+	if (rd(bt_se, GENI_STATUS) & M_CMD_ACTIVE) {
+		btlog("tx: the previous transfer is still running: aborted");
+		wr(bt_se, M_CMD_CTRL, 1u << 1);
+		IODelay(100);
+	}
+	wr(bt_se, M_IRQ_CLEAR, 0xffffffffu);
+	wr(bt_se, UART_TX_LEN, n);
+	wr(bt_se, M_CMD0, 1u << 27);                    /* UART_START_TX */
+	uint32_t words = (n + BT_BPW - 1) / BT_BPW;
+	for (uint32_t i = 0; i < words; i++) {
+		int w = 0;
+		while ((rd(bt_se, TX_FIFO_STATUS) & 0x0fffffffu) >= bt_tx_depth && w < 2000) {
+			if ((w & 3) == 0) {
+				(void)bt_rx_poll();             /* the controller may talk while we wait */
+			}
+			IODelay(50);
+			w++;
+		}
+		if (w >= 2000) {
+			btlog("tx: the FIFO stays full after %u of %u bytes (CTS low?): aborted", i * BT_BPW, n);
+			wr(bt_se, M_CMD_CTRL, 1u << 1);
+			return ETIMEDOUT;
+		}
+		uint32_t v = 0;
+		for (uint32_t b = 0; b < BT_BPW && i * BT_BPW + b < n; b++) {
+			v |= (uint32_t)p[i * BT_BPW + b] << (8 * b);
+		}
+		wr(bt_se, TX_FIFO, v);
+	}
+	/* twice the FIFO's last bytes at this baud, plus 50 ms */
+	uint32_t baud = bt_baud_now ? bt_baud_now : 115200;
+	uint32_t ms = 50 + (uint32_t)(((uint64_t)(bt_tx_depth + 1) * BT_BPW * 10 * 1000 * 2) / baud);
+	for (uint32_t i = 0; i < ms * 10; i++) {
+		uint32_t s = rd(bt_se, M_IRQ_STATUS);
+		if (s & 1) {
+			wr(bt_se, M_IRQ_CLEAR, s);
+			return 0;
+		}
+		if ((i & 3) == 0) {
+			(void)bt_rx_poll();
+		}
+		IODelay(100);
+	}
+	btlog("tx: no done in %u ms (m irq %#x, status %#x): aborted", ms, rd(bt_se, M_IRQ_STATUS), rd(bt_se, GENI_STATUS));
+	wr(bt_se, M_CMD_CTRL, 1u << 1);
+	return ETIMEDOUT;
+}
+
+/* TX FIFO empty and no TX command running, then one character time; bounded by ms */
+static int
+bt_drain(unsigned ms)
+{
+	for (unsigned i = 0; i < ms * 10; i++) {
+		if ((rd(bt_se, GENI_STATUS) & M_CMD_ACTIVE) == 0 && (rd(bt_se, TX_FIFO_STATUS) & 0x0fffffffu) == 0) {
+			uint32_t baud = bt_baud_now ? bt_baud_now : 115200;
+			IODelay(10 * 1000000u / baud + 10);
+			return 0;
+		}
+		if ((i & 3) == 0) {
+			(void)bt_rx_poll();
+		}
+		IODelay(100);
+	}
+	btlog("drain: TX still busy after %u ms (status %#x, tx fifo %#x)", ms, rd(bt_se, GENI_STATUS), rd(bt_se, TX_FIFO_STATUS));
+	return ETIMEDOUT;
+}
+
+static void
+bt_ring_clear(void)
+{
+	(void)bt_rx_poll();
+	lck_mtx_lock(&sweet_bt_rxmtx);
+	bt_rtail = bt_rhead;
+	lck_mtx_unlock(&sweet_bt_rxmtx);
+}
+
+/* one HCI event (H4 0x04, code, len, payload) within ms; returns its length, 0 if none */
+static unsigned
+bt_event(uint8_t *out, unsigned max, unsigned ms)
+{
+	for (unsigned t = 0; t <= ms; t++) {
+		(void)bt_rx_poll();
+		lck_mtx_lock(&sweet_bt_rxmtx);
+		uint32_t avail = bt_rhead - bt_rtail;
+		while (avail > 0 && bt_ring[bt_rtail % BT_RING] != 0x04) {
+			bt_rtail++;                             /* not an event start: skip */
+			avail--;
+		}
+		if (avail >= 3) {
+			unsigned len = 3u + bt_ring[(bt_rtail + 2) % BT_RING];
+			if (avail >= len) {
+				unsigned n = len < max ? len : max;
+				for (unsigned i = 0; i < n; i++) {
+					out[i] = bt_ring[(bt_rtail + i) % BT_RING];
+				}
+				bt_rtail += len;
+				lck_mtx_unlock(&sweet_bt_rxmtx);
+				return n;
+			}
+		}
+		lck_mtx_unlock(&sweet_bt_rxmtx);
+		IOSleep(1);
+	}
+	return 0;
+}
+
+static void
+bt_hex(const char *what, const uint8_t *p, unsigned n)
+{
+	char line[200];
+	size_t k = 0;
+	for (unsigned i = 0; i < n && k + 4 < sizeof(line); i++) {
+		k += (size_t)snprintf(line + k, sizeof(line) - k, "%02x ", p[i]);
+	}
+	line[k] = 0;
+	btlog("%s (%u bytes): %s", what, n, line);
+}
+
+/* an HCI command and its event(s), logged */
+static unsigned
+bt_cmd(const char *what, const uint8_t *cmd, unsigned n, uint8_t *ev, unsigned max, unsigned ms)
+{
+	bt_hex(what, cmd, n);
+	if (bt_tx(cmd, n) != 0) {
+		return 0;
+	}
+	unsigned got = bt_event(ev, max, ms);
+	if (got == 0) {
+		btlog("%s: no event in %u ms", what, ms);
+	} else {
+		bt_hex("  event", ev, got);
+	}
+	return got;
+}
+
+/* ---------------------------------------------------------------- ops 2, 3, 9 */
+
+static int
+bt_power_reset(void)
+{
+	uint8_t ev[96];
+	if (!bt_up) {
+		btlog("op 2: UART not up (op 1 first)");
+		return EAGAIN;
+	}
+	bt_ring_clear();
+	/* the power pulse: 0xFC at 2400 baud, no flow control (hci_qca qca_send_power_pulse) */
+	bt_baud(2400, false);
+	uint8_t pulse = 0xFC;
+	int r = bt_tx(&pulse, 1);
+	btlog("power pulse 0xfc at 2400 baud: %d", r);
+	IOSleep(5);
+	bt_baud(115200, true);
+	IOSleep(100);
+	volatile uint32_t *s = (volatile uint32_t *)bt_sw;
+	btlog("SW_CTRL gpio%u level %u", BT_SWCTRL, s[1] & 1);
+	bt_ring_clear();
+	static const uint8_t reset[] = { 0x01, 0x03, 0x0C, 0x00 };
+	unsigned n = bt_cmd("HCI_Reset", reset, sizeof(reset), ev, sizeof(ev), 500);
+	bool ok = n >= 7 && ev[1] == 0x0E && ev[4] == 0x03 && ev[5] == 0x0C && ev[6] == 0x00;
+	btlog("HCI_Reset: %s", ok ? "Command Complete, status 0" : n ? "unexpected answer" : "NO ANSWER");
+	static const uint8_t ver[] = { 0x01, 0x00, 0xFC, 0x01, 0x19 };
+	n = bt_cmd("EDL_PATCH_VER_REQ (0xfc00 / 0x19)", ver, sizeof(ver), ev, sizeof(ev), 500);
+	if (n != 0 && ev[1] != 0xFF) {
+		unsigned n2 = bt_event(ev, sizeof(ev), 300);      /* a Command Complete first, the vendor event after */
+		if (n2) {
+			bt_hex("  event", ev, n2);
+			n = n2;
+		}
+	}
+	if (n >= 3 && ev[1] == 0xFF) {
+		/* hci_qca / btqca: vendor event, then product id, patch version, rom version, soc id (LE) */
+		bt_hex("  version payload", ev + 3, n - 3);
+	}
+	return ok ? 0 : EIO;
+}
+
+static int
+bt_info(void)
+{
+	uint8_t ev[96];
+	if (!bt_up) {
+		return EAGAIN;
+	}
+	bt_ring_clear();
+	static const uint8_t lv[] = { 0x01, 0x01, 0x10, 0x00 };
+	unsigned n = bt_cmd("HCI_Read_Local_Version", lv, sizeof(lv), ev, sizeof(ev), 500);
+	if (n >= 15 && ev[1] == 0x0E && ev[6] == 0) {
+		btlog("  HCI %u rev %#x, LMP %u, manufacturer %u, LMP subversion %#x", ev[7], ev[8] | ev[9] << 8, ev[10],
+		    ev[11] | ev[12] << 8, ev[13] | ev[14] << 8);
+	}
+	static const uint8_t ba[] = { 0x01, 0x09, 0x10, 0x00 };
+	n = bt_cmd("HCI_Read_BD_ADDR", ba, sizeof(ba), ev, sizeof(ev), 500);
+	if (n >= 13 && ev[1] == 0x0E && ev[6] == 0) {
+		btlog("  BD_ADDR %02x:%02x:%02x:%02x:%02x:%02x", ev[12], ev[11], ev[10], ev[9], ev[8], ev[7]);
+	}
+	return n ? 0 : EIO;
+}
+
+/* op 4: HCI_Reset + HCI_Read_Local_Version, 20 rounds; only failures are logged */
+static bool
+bt_expect_cc(const uint8_t *cmd, unsigned n, uint16_t opcode, unsigned round, const char *what)
+{
+	uint8_t ev[64];
+	if (bt_tx(cmd, n) != 0) {
+		btlog("round %u %s: tx failed", round, what);
+		return false;
+	}
+	unsigned got = bt_event(ev, sizeof(ev), 500);
+	if (got >= 7 && ev[1] == 0x0E && (ev[4] | ev[5] << 8) == opcode && ev[6] == 0) {
+		return true;
+	}
+	if (got == 0) {
+		btlog("round %u %s: no event in 500 ms", round, what);
+	} else {
+		char t[40];
+		snprintf(t, sizeof(t), "round %u %s: wrong event", round, what);
+		bt_hex(t, ev, got);
+	}
+	return false;
+}
+
+static int
+bt_selftest(void)
+{
+	if (!bt_up) {
+		btlog("op 4: UART not up (op 1 first)");
+		return EAGAIN;
+	}
+	static const uint8_t reset[] = { 0x01, 0x03, 0x0C, 0x00 }, lv[] = { 0x01, 0x01, 0x10, 0x00 };
+	unsigned fr = 0, fv = 0;
+	uint32_t o0 = bt_ovr, p0 = bt_par, d0 = bt_rdrops;
+	bt_ring_clear();
+	for (unsigned i = 0; i < 20; i++) {
+		fr += !bt_expect_cc(reset, sizeof(reset), 0x0C03, i, "HCI_Reset");
+		fv += !bt_expect_cc(lv, sizeof(lv), 0x1001, i, "Read_Local_Version");
+	}
+	btlog("self-test at %u baud: HCI_Reset %u/20 failed, Read_Local_Version %u/20 failed; new rx overruns %u, "
+	    "parity/framing %u, ring drops %u", bt_baud_now, fr, fv, bt_ovr - o0, bt_par - p0, bt_rdrops - d0);
+	return (fr || fv) ? EIO : 0;
+}
+
+static int
+bt_off(void)
+{
+	if (bt_se != 0 && bt_up) {
+		wr(bt_se, M_CMD_CTRL, 1u << 1);
+		wr(bt_se, S_CMD_CTRL, 1u << 1);
+		IODelay(100);
+		wr(bt_se, M_IRQ_CLEAR, 0xffffffffu);
+		wr(bt_se, S_IRQ_CLEAR, 0xffffffffu);
+	}
+	bt_up = false;
+	btlog("UART stopped (the rails stay voted: Wi-Fi and the fingerprint sensor share them)");
+	return 0;
+}
+
+/* ---------------------------------------------------------------- /dev/qcabt */
+
+static void
+bt_rx_thread(void *arg __unused, wait_result_t wres __unused)
+{
+	unsigned idle = 0;
+	while (bt_rx_run) {
+		unsigned got = 0;
+		lck_mtx_lock(&sweet_bt_mtx);
+		if (bt_up) {
+			got = bt_rx_poll();
+		}
+		lck_mtx_unlock(&sweet_bt_mtx);
+		/*
+		 * 3 Mbaud is ~300 bytes/ms, a byte per FIFO word: every ~20 us while bytes flow (RFR stops
+		 * the controller at the watermark), 1 ms after ~2 ms idle
+		 */
+		if (got != 0) {
+			idle = 0;
+			IODelay(20);
+		} else if (++idle < 100) {
+			IODelay(20);
+		} else {
+			IOSleep(1);
+		}
+	}
+	bt_rx_alive = false;
+	wakeup(bt_ring);
+	thread_terminate(current_thread());
+}
+
+static int
+qcabt_open(__unused dev_t dev, __unused int flags, __unused int devtype, __unused struct proc *p)
+{
+	lck_mtx_lock(&sweet_bt_mtx);
+	if (bt_open_flag || bt_rx_alive) {
+		lck_mtx_unlock(&sweet_bt_mtx);
+		return EBUSY;
+	}
+	lck_mtx_lock(&sweet_bt_rxmtx);
+	bt_rtail = bt_rhead;
+	lck_mtx_unlock(&sweet_bt_rxmtx);
+	bt_open_flag = true;
+	bt_rx_run = true;
+	bt_rx_alive = true;
+	thread_t th;
+	if (kernel_thread_start(bt_rx_thread, NULL, &th) != KERN_SUCCESS) {
+		bt_open_flag = bt_rx_run = bt_rx_alive = false;
+		lck_mtx_unlock(&sweet_bt_mtx);
+		return ENOMEM;
+	}
+	thread_deallocate(th);
+	lck_mtx_unlock(&sweet_bt_mtx);
+	return 0;
+}
+
+static int
+qcabt_close(__unused dev_t dev, __unused int flags, __unused int devtype, __unused struct proc *p)
+{
+	bt_rx_run = false;
+	for (int i = 0; i < 200 && bt_rx_alive; i++) {
+		IOSleep(1);
+	}
+	bt_open_flag = false;
+	lck_mtx_lock(&sweet_bt_mtx);
+	btlog("/dev/qcabt closed: rx overrun %u, parity/framing %u, break %u, ring drops %u", bt_ovr, bt_par, bt_brk, bt_rdrops);
+	lck_mtx_unlock(&sweet_bt_mtx);
+	return 0;
+}
+
+static int
+qcabt_read(__unused dev_t dev, struct uio *uio, int ioflag)
+{
+	uint8_t buf[256];
+	lck_mtx_lock(&sweet_bt_rxmtx);
+	while (bt_rhead == bt_rtail) {
+		if ((ioflag & IO_NDELAY) || !bt_rx_alive) {
+			lck_mtx_unlock(&sweet_bt_rxmtx);
+			return bt_rx_alive ? EWOULDBLOCK : 0;
+		}
+		struct timespec ts = { 0, 100 * 1000 * 1000 };
+		int err = msleep(bt_ring, &sweet_bt_rxmtx, PCATCH | PZERO, "qcabt", &ts);
+		if (err != 0 && err != EWOULDBLOCK) {
+			lck_mtx_unlock(&sweet_bt_rxmtx);
+			return err;
+		}
+	}
+	uint32_t n = bt_rhead - bt_rtail;
+	user_ssize_t want = uio_resid(uio);
+	n = n > sizeof(buf) ? (uint32_t)sizeof(buf) : n;
+	n = (user_ssize_t)n > want ? (uint32_t)want : n;
+	for (uint32_t i = 0; i < n; i++) {
+		buf[i] = bt_ring[(bt_rtail + i) % BT_RING];
+	}
+	bt_rtail += n;
+	lck_mtx_unlock(&sweet_bt_rxmtx);
+	return uiomove((char *)buf, (int)n, uio);
+}
+
+static int
+qcabt_write(__unused dev_t dev, struct uio *uio, __unused int ioflag)
+{
+	user_ssize_t n = uio_resid(uio);
+	if (n <= 0 || n > (user_ssize_t)sizeof(bt_wbuf)) {
+		return EINVAL;
+	}
+	lck_mtx_lock(&sweet_bt_mtx);
+	int err = uiomove((char *)bt_wbuf, (int)n, uio);
+	if (err == 0) {
+		err = bt_up ? bt_tx(bt_wbuf, (uint32_t)n) : ENXIO;
+	}
+	lck_mtx_unlock(&sweet_bt_mtx);
+	return err;
+}
+
+static int
+qcabt_ioctl(__unused dev_t dev, u_long cmd, caddr_t data, __unused int flag, __unused struct proc *p)
+{
+	int r = 0;
+	lck_mtx_lock(&sweet_bt_mtx);
+	switch (cmd) {
+	case QCABT_POWER:
+		btlog("ioctl POWER %d", *(int *)data);
+		if (*(int *)data) {
+			r = bt_up ? 0 : bt_init();
+		} else {
+			r = bt_off();
+		}
+		break;
+	case QCABT_SETBAUD:
+		r = bt_up ? bt_set_baud(*(uint32_t *)data) : ENXIO;
+		break;
+	case QCABT_FLOW:
+		if (bt_up) {
+			bt_flow(*(int *)data != 0, 0x80000001u);    /* off: RTS held asserted (manual RFR, ready) */
+		} else {
+			r = ENXIO;
+		}
+		break;
+	case QCABT_FLUSH:
+		if (bt_up) {
+			(void)bt_rx_poll();
+		}
+		lck_mtx_lock(&sweet_bt_rxmtx);
+		bt_rtail = bt_rhead;
+		lck_mtx_unlock(&sweet_bt_rxmtx);
+		break;
+	case QCABT_SWCTRL:
+		if (bt_map()) {
+			*(int *)data = (int)(((volatile uint32_t *)bt_sw)[1] & 1);
+		} else {
+			r = ENOMEM;
+		}
+		break;
+	case QCABT_DRAIN:
+		r = bt_up ? bt_drain(1000) : ENXIO;
+		break;
+	default:
+		r = ENOTTY;
+		break;
+	}
+	if (r != 0 && cmd != (u_long)QCABT_POWER) {
+		btlog("ioctl %#lx: %d", cmd, r);
+	}
+	lck_mtx_unlock(&sweet_bt_mtx);
+	return r;
+}
+
+static int
+qcabt_select(__unused dev_t dev, int which, void *wql, struct proc *p)
+{
+	if (which == FWRITE) {
+		return 1;
+	}
+	if (which != FREAD) {
+		return 0;
+	}
+	lck_mtx_lock(&sweet_bt_rxmtx);
+	int ready = bt_rhead != bt_rtail || !bt_rx_alive;
+	if (!ready) {
+		selrecord(p, &bt_sel, wql);
+	}
+	lck_mtx_unlock(&sweet_bt_rxmtx);
+	return ready;
+}
+
+static const struct cdevsw qcabt_cdevsw = {
+	.d_open = qcabt_open, .d_close = qcabt_close, .d_read = qcabt_read, .d_write = qcabt_write, .d_ioctl = qcabt_ioctl,
+	.d_stop = eno_stop, .d_reset = eno_reset, .d_ttys = NULL, .d_select = qcabt_select, .d_mmap = eno_mmap,
+	.d_strategy = eno_strat, .d_type = 0,
+};
+
+static void
+qcabt_node(void)
+{
+	if (bt_major >= 0) {
+		return;
+	}
+	bt_major = cdevsw_add(-1, &qcabt_cdevsw);
+	if (bt_major < 0) {
+		btlog("/dev/qcabt: no major");
+		return;
+	}
+	if (devfs_make_node(makedev(bt_major, 0), DEVFS_CHAR, UID_ROOT, GID_WHEEL, 0600, "qcabt") == NULL) {
+		btlog("/dev/qcabt: devfs node failed");
+	} else {
+		btlog("/dev/qcabt ready (major %d)", bt_major);
+	}
+}
+
+/*
+ * bluetoothd's start gate: it checks that /dev/uart.bluetooth exists (the transport is btshim's).
+ * These nodes only exist: open answers ENXIO.
+ */
+static int
+btstub_open(__unused dev_t dev, __unused int flags, __unused int devtype, __unused struct proc *p)
+{
+	return ENXIO;
+}
+
+static const struct cdevsw btstub_cdevsw = {
+	.d_open = btstub_open, .d_close = eno_opcl, .d_read = eno_rdwrt, .d_write = eno_rdwrt, .d_ioctl = eno_ioctl,
+	.d_stop = eno_stop, .d_reset = eno_reset, .d_ttys = NULL, .d_select = eno_select, .d_mmap = eno_mmap,
+	.d_strategy = eno_strat, .d_type = 0,
+};
+
+/* at boot (bsd/dev/sweet_ufs.c): device nodes only, no hardware; boot-arg bt=0 skips it */
+void sweet_bt_boot_init(void);
+void
+sweet_bt_boot_init(void)
+{
+	int on = 1;
+	(void)PE_parse_boot_argn("bt", &on, sizeof(on));
+	if (!on) {
+		return;
+	}
+	lck_mtx_lock(&sweet_bt_mtx);
+	qcabt_node();
+	int major = cdevsw_add(-1, &btstub_cdevsw);
+	if (major >= 0) {
+		void *a = devfs_make_node(makedev(major, 0), DEVFS_CHAR, UID_ROOT, GID_WHEEL, 0666, "uart.bluetooth");
+		void *b = devfs_make_node(makedev(major, 1), DEVFS_CHAR, UID_ROOT, GID_WHEEL, 0666, "cu.bluetooth");
+		btlog("boot: /dev/uart.bluetooth %s, /dev/cu.bluetooth %s (stubs, major %d)", a ? "made" : "FAILED",
+		    b ? "made" : "FAILED", major);
+	} else {
+		btlog("boot: no major for the uart.bluetooth stubs");
+	}
+	lck_mtx_unlock(&sweet_bt_mtx);
+}
+
+/* ---------------------------------------------------------------- sysctls */
+
+static int
+sysctl_sweet_bt SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	int v = bt_last;
+	int err = sysctl_io_number(req, v, sizeof(v), &v, NULL);
+	if (err != 0 || req->newptr == USER_ADDR_NULL) {
+		return err;
+	}
+	lck_mtx_lock(&sweet_bt_mtx);
+	bt_loglen = 0;
+	bt_logbuf[0] = 0;
+	btlog("op %d", v);
+	int r;
+	if (bt_open_flag && (v == 2 || v == 3 || v == 4 || v == 9)) {
+		btlog("op %d: /dev/qcabt is open", v);
+		r = EBUSY;
+	} else {
+		switch (v) {
+		case 1:
+			r = bt_init();
+			if (r == 0) {
+				qcabt_node();
+			}
+			break;
+		case 2:
+			r = bt_power_reset();
+			break;
+		case 3:
+			r = bt_info();
+			break;
+		case 4:
+			r = bt_selftest();
+			break;
+		case 9:
+			r = bt_off();
+			break;
+		default:
+			r = EINVAL;
+			break;
+		}
+	}
+	btlog("op %d: %d (rx drops %u)", v, r, bt_rdrops);
+	bt_last = r;
+	lck_mtx_unlock(&sweet_bt_mtx);
+	return r;
+}
+
+SYSCTL_PROC(_kern, OID_AUTO, sweet_bt, CTLTYPE_INT | CTLFLAG_RW | CTLFLAG_LOCKED,
+    0, 0, sysctl_sweet_bt, "I", "Bluetooth UART: 1 up, 2 power pulse + reset + version, 3 local version + BD_ADDR, 4 self-test, 9 off");
+
+static int
+sysctl_sweet_bt_log SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
