diff --git a/iokit/Kernel/arm/hid/IOHIDShared.h b/iokit/Kernel/arm/hid/IOHIDShared.h
new file mode 100644
index 0000000..d9b5b69
--- /dev/null
+++ b/iokit/Kernel/arm/hid/IOHIDShared.h
@@ -0,0 +1,291 @@
+/*
