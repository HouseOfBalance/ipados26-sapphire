diff --git a/iokit/Kernel/arm/SapphireWLAN.cpp b/iokit/Kernel/arm/SapphireWLAN.cpp
new file mode 100644
index 0000000..f86a956
--- /dev/null
+++ b/iokit/Kernel/arm/SapphireWLAN.cpp
@@ -0,0 +1,173 @@
+/*
+ * Ported from HackiOS (OOSEX GANG, github.com/oosexgang/hackios-xnu-kernel @8e61187098f2, iokit/Kernel/RedwoodWLAN.cpp;
+ * Apple Public Source License 2.0, as the rest of XNU) for sapphire: renamed, and fed by the
+ * WCN3988 station of TopazModem.cpp through bsd/dev/sapphire_wlan.c instead of ath11k.
+ */
+/*
+ * SapphireWLAN: the registry entries by which iOS finds the Wi-Fi interface.
+ *
+ * en0 is made with the BSD interface KPI (bsd/dev/sapphire_net.c) and has no IOKit object behind
+ * it of its own; iOS looks for two, as IO80211Family would have made them:
+ *
+ *   - wifid's device is whatever service has the property IO80211InterfaceRole =
+ *     "Infrastructure", and IO80211.framework binds to an interface through a service whose
+ *     IOInterfaceName is the interface's name. The service has no user client, on purpose:
+ *     the framework's attempt to open one fails, it says "Falling back to IOCTL path", and
+ *     from then on every request is an ioctl on a socket, which bsd/dev/sapphire_apple80211.c
+ *     answers.
+ *   - SystemConfiguration (SCNetworkInterfaceCopyAll) lists the network interfaces it finds as
+ *     objects of the class IONetworkInterface, and calls one a Wi-Fi interface when its parent
+ *     is of the class IO80211Controller; type, unit, name and built-in-ness are properties of
+ *     the interface, the hardware address one of the controller. configd makes a network
+ *     service (DHCP and the rest) for an interface it has listed, and only an interface with a
+ *     service can be the one the system routes through -- which wifid waits for after a join
+ *     ("failed to become routable interface") before Settings ticks the network.
+ *
+ *   - MobileGestalt (the Wi-Fi address, asked by lsd for every bundle it registers) reads the
+ *     property local-mac-address of the "wlan" device, as a device tree has it on a phone;
+ *     without it, it waits up to 5 s for an IONetworkController to its liking, every time:
+ *     rebuilding the LaunchServices database took more than an hour.
+ *
+ * So: a controller of the class IO80211Controller (an IOEthernetController, an
+ * IONetworkController, as in IO80211Family) under the "wlan" device, and below it one object
+ * that is both, an IONetworkInterface with wifid's properties. The classes are ours, named as
+ * IO80211Family and IONetworkingFamily name theirs; none has anything but properties.
+ */
+
+#include <IOKit/IOLib.h>
+#include <IOKit/IOPlatformExpert.h>
+#include <IOKit/IOService.h>
+#include <IOKit/IOUserClient.h>
+#include <libkern/c++/OSData.h>
+#include <libkern/c++/OSNumber.h>
+
+extern "C" void SapphireWLANStart(const char * interface, const uint8_t * address);
+
+class IONetworkController : public IOService
+{
+	OSDeclareDefaultStructors(IONetworkController);
+};
+
+OSDefineMetaClassAndStructors(IONetworkController, IOService);
+
+class IOEthernetController : public IONetworkController
+{
+	OSDeclareDefaultStructors(IOEthernetController);
+};
+
+OSDefineMetaClassAndStructors(IOEthernetController, IONetworkController);
+
+class IO80211Controller : public IOEthernetController
+{
+	OSDeclareDefaultStructors(IO80211Controller);
+};
+
+OSDefineMetaClassAndStructors(IO80211Controller, IOEthernetController);
+
+class IONetworkInterface : public IOService
+{
+	OSDeclareDefaultStructors(IONetworkInterface);
+};
+
+OSDefineMetaClassAndStructors(IONetworkInterface, IOService);
+
+class SapphireWLAN : public IONetworkInterface
+{
+	OSDeclareDefaultStructors(SapphireWLAN);
+
+public:
+	virtual IOReturn newUserClient(task_t owningTask, void * securityID, UInt32 type, OSDictionary * properties,
+	    IOUserClient ** handler) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(SapphireWLAN, IONetworkInterface);
+
+/* There is none (see the top); that somebody asked shows that the service was found. */
+IOReturn
+SapphireWLAN::newUserClient(task_t owningTask, void * securityID, UInt32 type, OSDictionary * properties, IOUserClient ** handler)
+{
+	static unsigned said;
+
+	if (said++ < 8) {
+		IOLog("SapphireWLAN: a user client of type %u is asked for: there is none\n", (unsigned) type);
+	}
+	return kIOReturnUnsupported;
+}
+
+/* attach, start, register: the service, or NULL */
+static IOService *
+publish(IOService * service, IOService * provider, const char * name)
+{
+	if (service == NULL || !service->attach(provider)) {
+		OSSafeReleaseNULL(service);
+		return NULL;
+	}
+	service->setName(name);
+	if (!service->start(provider)) {
+		service->detach(provider);
+		service->release();
+		return NULL;
+	}
+	service->registerService();
+	return service;
+}
+
+/* Once, when the interface of a radio exists. */
+void
+SapphireWLANStart(const char * interface, const uint8_t * address)
+{
+	IOService * platform = IOService::getPlatform();
+	OSDictionary * match = IOService::nameMatching("wlan");
+	IOService * device = match != NULL ? IOService::copyMatchingService(match) : NULL;
+	IO80211Controller * controller = OSTypeAlloc(IO80211Controller);
+	SapphireWLAN * wlan = OSTypeAlloc(SapphireWLAN);
+	OSData * mac;
+	OSNumber * number;
+
+	if (platform == NULL || controller == NULL || wlan == NULL || !controller->init() || !wlan->init()) {
+		OSSafeReleaseNULL(controller);
+		OSSafeReleaseNULL(wlan);
+		OSSafeReleaseNULL(device);
+		OSSafeReleaseNULL(match);
+		IOLog("SapphireWLAN: cannot create the services\n");
+		return;
+	}
+	if ((mac = OSData::withBytes(address, 6)) != NULL) {
+		controller->setProperty("IOMACAddress", mac);
+		if (device != NULL) {
+			device->setProperty("local-mac-address", mac);
+		}
+		mac->release();
+	}
+	controller->setProperty("IOBuiltin", true);
+	OSSafeReleaseNULL(match);
+	/* under the "wlan" device MobileGestalt finds first; the platform if there is none */
+	controller = (IO80211Controller *) publish(controller, device != NULL ? device : platform, "SapphireWLANController");
+	OSSafeReleaseNULL(device);
+	if (controller == NULL) {
+		wlan->release();
+		IOLog("SapphireWLAN: the controller did not start\n");
+		return;
+	}
+
+	wlan->setProperty("IOInterfaceName", interface);
+	wlan->setProperty("BSD Name", interface);
+	wlan->setProperty("IOInterfaceNamePrefix", "en");
+	if ((number = OSNumber::withNumber(6ULL, 32)) != NULL) {        /* IFT_ETHER */
+		wlan->setProperty("IOInterfaceType", number);
+		number->release();
+	}
+	if ((number = OSNumber::withNumber((unsigned long long) (interface[2] - '0'), 32)) != NULL) {
+		wlan->setProperty("IOInterfaceUnit", number);
+		number->release();
+	}
+	wlan->setProperty("IOBuiltin", true);
+	wlan->setProperty("IOPrimaryInterface", true);
+	wlan->setProperty("IO80211InterfaceRole", "Infrastructure");
+	if (publish(wlan, controller, "SapphireWLAN") == NULL) {
+		IOLog("SapphireWLAN: the service did not start\n");
+	} else {
+		wlan->release();
+	}
+	controller->release();
+}
diff --git a/iokit/Kernel/arm/SweetAMFIService.cpp b/iokit/Kernel/arm/SweetAMFIService.cpp
new file mode 100644
index 0000000..7d61209
--- /dev/null
+++ b/iokit/Kernel/arm/SweetAMFIService.cpp
@@ -0,0 +1,107 @@
+/*
+ * SWEET: an IOService named AppleMobileFileIntegrity, as the AMFI kext publishes on a device.
+ * ExtensionKit reads the signed extension cache (/System/Library/xpc/extensions.plist,
+ * +[NSDictionary _EX_dictionaryWithSignedURL:error:]) only after asking AMFI's user client
+ * whether the signature's cdhash is in the trust cache: IOServiceGetMatchingService(
+ * "AppleMobileFileIntegrity"), IOServiceOpen type 0, IOConnectCallMethod selector 6 with one
+ * scalar and the cdhash. Without the service: "Unable to find AMFI", no extension point in
+ * LaunchServices, PlugInKit -10814 for every extension point (no wallpapers, widgets, file
+ * providers). This kernel enforces no code signatures (sweet_amfi.c), so every hash is trusted:
+ * every call succeeds. Each selector is logged the first time.
+ */
+#include <pexpert/arm64/board_config.h>
+
+#if defined(SWEET)
+#include <IOKit/IOService.h>
+#include <IOKit/IOUserClient.h>
+#include <IOKit/IOLib.h>
+#include <sys/proc.h>
+
+class AppleMobileFileIntegrity : public IOService
+{
+	OSDeclareDefaultStructors(AppleMobileFileIntegrity);
+public:
+	IOReturn newUserClient(task_t owningTask, void *securityID, UInt32 type, IOUserClient **handler) APPLE_KEXT_OVERRIDE;
+};
+
+class AppleMobileFileIntegrityUserClient : public IOUserClient
+{
+	OSDeclareDefaultStructors(AppleMobileFileIntegrityUserClient);
+public:
+	IOReturn externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+	    IOExternalMethodDispatch *dispatch, OSObject *target, void *reference) APPLE_KEXT_OVERRIDE;
+	IOReturn clientClose(void) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(AppleMobileFileIntegrity, IOService);
+OSDefineMetaClassAndStructors(AppleMobileFileIntegrityUserClient, IOUserClient);
+
+IOReturn
+AppleMobileFileIntegrity::newUserClient(task_t owningTask, void *securityID __unused, UInt32 type __unused,
+    IOUserClient **handler)
+{
+	AppleMobileFileIntegrityUserClient *client = OSTypeAlloc(AppleMobileFileIntegrityUserClient);
+
+	if (client == NULL || !client->initWithTask(owningTask, NULL, 0) || !client->attach(this) || !client->start(this)) {
+		if (client != NULL) {
+			client->detach(this);
+			client->release();
+		}
+		return kIOReturnNoMemory;
+	}
+	*handler = client;
+	return kIOReturnSuccess;
+}
+
+IOReturn
+AppleMobileFileIntegrityUserClient::externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+    IOExternalMethodDispatch *dispatch __unused, OSObject *target __unused, void *reference __unused)
+{
+	static uint64_t seen;
+
+	if (selector < 64 && !(seen & (1ULL << selector))) {
+		char name[32];
+		seen |= 1ULL << selector;
+		proc_selfname(name, sizeof(name));
+		IOLog("SWEET AMFI: user client selector %u from %s (%u scalars, %u bytes in): trusted\n", selector, name,
+		    args->scalarInputCount, args->structureInputSize);
+	}
+	for (uint32_t i = 0; i < args->scalarOutputCount; i++) {
+		args->scalarOutput[i] = 0;
+	}
+	if (args->structureOutputDescriptor == NULL && args->structureOutput != NULL) {
+		bzero(args->structureOutput, args->structureOutputSize);
+	}
+	return kIOReturnSuccess;
+}
+
+IOReturn
+AppleMobileFileIntegrityUserClient::clientClose(void)
+{
+	terminate();
+	return kIOReturnSuccess;
+}
+
+extern "C" void
+sweet_amfi_service_init(void)
+{
+	static bool done;
+	AppleMobileFileIntegrity *amfi;
+
+	if (done) {
+		return;
+	}
+	done = true;
+	amfi = OSTypeAlloc(AppleMobileFileIntegrity);
+	if (amfi == NULL || !amfi->init() || !amfi->attach(IOService::getServiceRoot())) {
+		IOLog("SWEET AMFI: no AppleMobileFileIntegrity service\n");
+		OSSafeReleaseNULL(amfi);
+		return;
+	}
+	amfi->registerService();
+	IOLog("SWEET AMFI: AppleMobileFileIntegrity service published\n");
+}
+
+#else
+extern "C" void sweet_amfi_service_init(void) {}
+#endif
diff --git a/iokit/Kernel/arm/SweetBattery.cpp b/iokit/Kernel/arm/SweetBattery.cpp
