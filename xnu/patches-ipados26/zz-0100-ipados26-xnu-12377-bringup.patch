+/* ---------------------------------------------------------------- 0257: untrusted enroll / auth */
+
+static uint32_t q_enroll_fid;
+static unsigned q_enroll_left = ~0u;
+
+/* (1003,3) UNTRUSTED_CFG, 0x120: +0x1c 1 enroll / 0 auth, +0x20 path (none) */
+static uint32_t
+untrusted_cfg(uint32_t enroll)
+{
+	bzero(q_cmd, 0x120);
+	put32(q_cmd, 0x1c, enroll);
+	return gf_cmd(1003, 3, 0x120, enroll ? "UNTRUSTED_CFG(enroll)" : "UNTRUSTED_CFG(auth)");
+}
+
+/* op 14: UNTRUSTED_CFG 1, PRE_ENROLL, ENROLL (gid 0, no HAT) */
+static int
+fp_enroll_begin(void)
+{
+	if (!q_inited || q_goodix_id == 0) {
+		LOG("op 14: run op 10 first");
+		return EAGAIN;
+	}
+	uint32_t gu = untrusted_cfg(1);
+	bzero(q_cmd, 0x28);
+	uint32_t gp = gf_cmd(1000, 2, 0x28, "PRE_ENROLL");
+	LOG("PRE_ENROLL: challenge %08x%08x", get32(q_cmd, 0x24), get32(q_cmd, 0x20));
+	bzero(q_cmd, 0x6c);
+	put32(q_cmd, 0x1c, 0);
+	uint32_t ge = gf_cmd(1000, 3, 0x6c, "ENROLL");
+	q_enroll_fid = 0;
+	q_enroll_left = ~0u;
+	LOG("op 14: untrusted cfg %u %s, pre_enroll %u %s, enroll %u %s", gu, gu == ~0u ? "-" : gf_err_name(gu), gp,
+	    gp == ~0u ? "-" : gf_err_name(gp), ge, ge == ~0u ? "-" : gf_err_name(ge));
+	return gu == ~0u || gp == ~0u || ge == ~0u ? EIO : 0;
+}
+
+/* op 15: one touch; *value = samples remaining, or -gf error */
+static int
+fp_enroll_touch(int *value)
+{
+	if (!q_inited || q_goodix_id == 0) {
+		LOG("op 15: run op 10 and 14 first");
+		return EAGAIN;
+	}
+	bzero(q_cmd, 0x20);
+	q_cmd[0x1d] = 0xff;
+	uint32_t gw = gf_cmd(1002, 9, 0x20, "WAKEUP");
+	bzero(q_cmd, 0x1c);
+	q_cmd[0x10] = 1;
+	uint32_t ge = gf_cmd(1002, 14, 0x1c, "SET_EXPO");
+	bzero(q_cmd, 0x28);
+	put32(q_cmd, 0x1c, 0);                      /* retry */
+	put32(q_cmd, 0x20, 1);                      /* op: enroll */
+	uint32_t gc = gf_cmd(1002, 3, 0x28, "CAPTURE_IMG");
+	if (gw == ~0u || ge == ~0u || gc == ~0u) {
+		return EIO;
+	}
+	if (gc != 0) {
+		*value = -(int)gc;
+		LOG("op 15: capture %u %s: no enroll step", gc, gf_err_name(gc));
+		return 0;
+	}
+	bzero(q_cmd, 0x38);
+	uint32_t ga = gf_cmd(1001, 1, 0x38, "ALGO_ENROLL");
+	if (ga == ~0u) {
+		return EIO;
+	}
+	uint32_t gid = get32(q_cmd, 0x1c), fid = get32(q_cmd, 0x20);
+	uint16_t left;
+	memcpy(&left, q_cmd + 0x28, 2);
+	LOG("ALGO_ENROLL: %u %s, gid %u, finger id %u, samples remaining %u", ga, gf_err_name(ga), gid, fid, left);
+	if (ga == 0) {
+		q_enroll_fid = fid;
+		q_enroll_left = left;
+		*value = left;
+	} else {
+		*value = -(int)ga;
+	}
+	bzero(q_cmd, 0xbc);
+	uint32_t gk = gf_cmd(1001, 4, 0xbc, "ALGO_KPI");
+	if (gk == 0) {
+		LOG("KPI: quality %u, valid area %u, match score %u, study %u, key points %u, increase rate %u, overlay %u",
+		    get32(q_cmd, 0x1c), get32(q_cmd, 0x20), get32(q_cmd, 0x24), get32(q_cmd, 0x28), get32(q_cmd, 0x2c),
+		    get32(q_cmd, 0x30), get32(q_cmd, 0x34));
+	}
+	LOG("op 15: enroll step %u %s, finger %u, %u samples to go", ga, gf_err_name(ga), q_enroll_fid, q_enroll_left);
+	return 0;
+}
+
+/* op 16: SAVE_TEMPLATES (gid 0, the enrolled finger), POST_ENROLL; the store afterwards */
+static int
+fp_enroll_finish(void)
+{
+	if (!q_inited || q_goodix_id == 0) {
+		LOG("op 16: run op 10 first");
+		return EAGAIN;
+	}
+	if (q_enroll_fid == 0 || q_enroll_left != 0) {
+		LOG("op 16: finger %u has %u samples to go: saving anyway", q_enroll_fid, q_enroll_left);
+	}
+	bzero(q_cmd, 0x24);
+	put32(q_cmd, 0x1c, 0);
+	put32(q_cmd, 0x20, q_enroll_fid);
+	uint32_t gs = gf_cmd(1000, 9, 0x24, "SAVE_TEMPLATES");
+	bzero(q_cmd, 0x1c);
+	uint32_t gp = gf_cmd(1000, 4, 0x1c, "POST_ENROLL");
+	(void)fp_enum("op 16");
+	for (unsigned i = 0; i < QF_MAX_FILES; i++) {
+		if (q_files[i].used) {
+			LOG("store: %s %u bytes %s %s", q_files[i].name, q_files[i].len, q_files[i].dirty ? "dirty" : "clean",
+			    q_files[i].from_user ? "user" : "ta");
+		}
+	}
+	LOG("op 16: save %u %s, post_enroll %u %s (finger %u)", gs, gs == ~0u ? "-" : gf_err_name(gs), gp,
+	    gp == ~0u ? "-" : gf_err_name(gp), q_enroll_fid);
+	return gs == ~0u || gp == ~0u ? EIO : 0;
+}
+
+/* op 17: UNTRUSTED_CFG 0, then op 11's capture; *value = the matched finger id, or -gf error */
+static int
+fp_auth_untrusted(int *value)
+{
+	if (!q_inited || q_goodix_id == 0) {
+		LOG("op 17: run op 10 first");
+		return EAGAIN;
+	}
+	uint32_t gu = untrusted_cfg(0);
+	if (gu == ~0u) {
+		return EIO;
+	}
+	*value = 0;
+	int r = fp_capture(1, value);
+	LOG("op 17: untrusted cfg %u %s, capture path %d, result value %d (finger id, or -gf error)", gu, gf_err_name(gu), r,
+	    *value);
+	return r;
+}
+
+/* ENUMERATE (1000,7) and GET_ID (1000,5), as the HAL calls them after init and after an enroll */
+static int
+fp_enum(const char *when)
+{
+	if (q_goodix_id == 0 || q_va == NULL) {
+		LOG("%s: enumerate: no TA", when);
+		return EAGAIN;
+	}
+	bzero(q_cmd, 0x70);
+	uint32_t ge = gf_cmd(1000, 7, 0x70, "ENUMERATE");
+	const uint32_t cnt = ge == 0 ? get32(q_cmd, 0x1c) : 0;
+	unsigned n = 0;
+	for (unsigned i = 0; i < 10 && ge == 0; i++) {
+		uint32_t gid = get32(q_cmd, 0x20 + 4 * i), fid = get32(q_cmd, 0x48 + 4 * i);
+		if (gid != 0 || fid != 0) {
+			LOG("%s: enumerate slot %u: gid %u, finger id %u", when, i, gid, fid);
+			n++;
+		}
+	}
+	bzero(q_cmd, 0x28);
+	uint32_t gi = gf_cmd(1000, 5, 0x28, "GET_ID");
+	LOG("%s: enumerate %u %s (%u non-zero slots, +0x1c %u), authenticator id %08x%08x (%u %s)", when, ge,
+	    ge == ~0u ? "-" : gf_err_name(ge), n, cnt, get32(q_cmd, 0x24), get32(q_cmd, 0x20), gi,
+	    gi == ~0u ? "-" : gf_err_name(gi));
+	return ge == ~0u || gi == ~0u ? EIO : 0;
+}
+
+/* ---------------------------------------------------------------- 0258: auth with retries, file out */
+
+/*
+ * op 18: FingerprintCore::onAuthDownEvt's loop. Retry 0 builds the auth struct as op 17 does;
+ * later passes send back the struct the TA returned, header and inputs rewritten. Goes on while
+ * the result is NOT_MATCH / PREPROCESS_FAILED with +0x9c bit 0 (the TA's retry flag) set.
+ * *value = the matched finger id, or -gf error.
+ */
+extern "C" int sweet_qsee_arg;                /* bsd/dev/sweet_qsee_ctl.c, kern.sweet_qsee_arg */
+
+static int
+fp_auth_retry(int *value, uint32_t arg)
+{
+	static uint8_t auth[0xa4];
+	uint32_t r = ~0u;
+
+	if (!q_inited || q_goodix_id == 0) {
+		LOG("op 18: run op 10 first");
+		return EAGAIN;
+	}
+	uint32_t max = q_auth_retries == 0 ? 2 : MIN(q_auth_retries, 5u);
+	const uint32_t atype = (arg & 0xf) == 0 ? 1 : (arg & 0xf);
+	const uint8_t expo = (arg & 0x40) != 0 ? 5 : 1;
+	LOG("auth: arg 0x%x: auth type %u, %s, %s, exposure %u, %s, %s", arg, atype,
+	    (arg & 0x10) != 0 ? "no UNTRUSTED_CFG(auth)" : "UNTRUSTED_CFG(auth)",
+	    (arg & 0x20) != 0 ? "UNTRUSTED_CFG(enroll) first" : "no UNTRUSTED_CFG(enroll)", expo,
+	    (arg & 0x80) != 0 ? "no AUTHENTICATE" : "AUTHENTICATE", (arg & 0x100) != 0 ? "spot lit (local HBM)" : "spot not lit");
+	uint32_t gu = 0, g = 0;
+	if ((arg & 0x10) == 0) {
+		gu = untrusted_cfg(0);
+	}
+	if ((arg & 0x20) != 0 && gu != ~0u) {
+		gu = untrusted_cfg(1);
+	}
+	if ((arg & 0x80) == 0) {
+		bzero(q_cmd, 0x30);
+		put32(q_cmd, 0x1c, 0);
+		put64(q_cmd, 0x20, 1);
+		g = gf_cmd(1000, 1, 0x30, "AUTHENTICATE");
+	}
+	bzero(q_cmd, 0x20);
+	q_cmd[0x1d] = 0xff;
+	uint32_t gw = gf_cmd(1002, 9, 0x20, "WAKEUP");
+	if (gu == ~0u || g == ~0u || gw == ~0u) {
+		return EIO;
+	}
+	*value = -(int)(g != 0 ? g : 1012);
+	if (g == 0) {
+		bzero(auth, sizeof(auth));
+		for (uint32_t retry = 0; retry <= max; retry++) {
+			if (retry == 0) {
+				bzero(q_cmd, 0x1c);
+				q_cmd[0x10] = expo;
+				(void)gf_cmd(1002, 14, 0x1c, "SET_EXPO");
+			}
+			bzero(q_cmd, 0x28);
+			put32(q_cmd, 0x1c, retry);
+			put32(q_cmd, 0x20, 2);
+			uint32_t gc = gf_cmd(1002, 3, 0x28, "CAPTURE_IMG");
+			if (gc != 0) {
+				r = gc;
+				LOG("auth retry %u: capture %u %s: stop", retry, gc, gc == ~0u ? "-" : gf_err_name(gc));
+				break;
+			}
+			memcpy(q_cmd, auth, sizeof(auth));     /* retry 0: zeros; later: what the TA returned */
+			put32(q_cmd, 0x0c, 0);
+			put32(q_cmd, 0x1c, retry);
+			put32(q_cmd, 0x24, atype);
+			q_cmd[0x3c] = 0;
+			q_cmd[0x58] = 2;
+			if (retry == 0) {
+				put32(q_cmd, 0x90, (uint32_t)-1000);
+				put32(q_cmd, 0x94, (uint32_t)-1000);
+			}
+			q_cmd[0x9e] = 0;
+			q_cmd[0x9f] = 0;
+			r = gf_cmd(1001, 2, 0xa4, "ALGO_AUTHENTICATE");
+			if (r == ~0u) {
+				break;
+			}
+			memcpy(auth, q_cmd, sizeof(auth));
+			uint16_t flag;
+			memcpy(&flag, auth + 0x9c, 2);
+			LOG("auth retry %u: r %u %s, matched %u, fid %u, retry_flag %u", retry, r, gf_err_name(r), get32(auth, 0x28),
+			    get32(auth, 0x30), flag);
+			bzero(q_cmd, 0xbc);
+			if (gf_cmd(1001, 4, 0xbc, "ALGO_KPI") == 0) {
+				LOG("auth retry %u: KPI quality %u, valid area %u, match score %u", retry, get32(q_cmd, 0x1c),
+				    get32(q_cmd, 0x20), get32(q_cmd, 0x24));
+			}
+			if (r == 0 || !((r == 1008 || r == 1011) && (flag & 1))) {
+				break;
+			}
+		}
+		if (r == 0) {
+			*value = (int)get32(auth, 0x30);
+		} else if (r != ~0u) {
+			*value = -(int)r;
+		}
+	}
+	bzero(q_cmd, 0x1c);
+	(void)gf_cmd(1000, 8, 0x1c, "AUTH_CANCEL");
+	LOG("op 18: %s, result %u %s, value %d (max retries %u)", r == 0 ? "MATCH" : "no match", r,
+	    r == ~0u ? "-" : gf_err_name(r), *value, max);
+	return r == ~0u ? EIO : 0;
+}
+
+/* kern.sweet_qsee_filesel: which store file kern.sweet_qsee_fileout returns */
+extern "C" int
+sweet_qsee_file_select(const char *name)
+{
+	if (!qsee_enabled()) {
+		return ENODEV;
+	}
+	qsee_lock_init();
+	IOLockLock(q_lock);
+	strlcpy(q_file_sel, name, sizeof(q_file_sel));
+	int i = qf_find(q_file_sel);
+	LOG("file %s selected for kern.sweet_qsee_fileout: %s (%u bytes)", q_file_sel, i < 0 ? "NOT in the store" : "found",
+	    i < 0 ? 0 : q_files[i].len);
+	IOLockUnlock(q_lock);
+	return i < 0 ? ENOENT : 0;
+}
+
+/* the selected file's length (-1: none), and its bytes (up to max) */
+extern "C" int64_t
+sweet_qsee_file_out(void *dst, uint32_t max)
+{
+	int64_t n = -1;
+	if (q_lock == NULL) {
+		return -1;
+	}
+	IOLockLock(q_lock);
+	int i = q_file_sel[0] != 0 ? qf_find(q_file_sel) : -1;
+	if (i >= 0) {
+		n = q_files[i].len;
+		if (dst != NULL) {
+			n = MIN((uint32_t)n, max);
+			if (n > 0) {
+				memcpy(dst, q_files[i].data, (size_t)n);
+			}
+		}
+	}
+	IOLockUnlock(q_lock);
+	return n;
+}
+
+/* ---------------------------------------------------------------- 0261: fingerprint unlock */
+
+extern "C" int sweet_fod_press;                 /* bsd/dev/sweet_touch.c, kern.sweet_fod_press */
+extern "C" uint32_t sweet_aks_passcode_unlocks(void);   /* SweetKeyStore.cpp */
+extern "C" int sweet_aks_biometric_unlock(void);
+
+static volatile uint64_t q_match_abs;           /* mach_absolute_time of the last match (0: none) */
+static volatile uint32_t q_match_fid;
+static uint32_t q_fod_fails, q_fod_epoch;
+
+/* for SweetKeyStore: the last match if under 3 s old; consume: used up. No lock (op 27 holds q_lock). */
+extern "C" bool
+sweet_qsee_last_match(uint64_t *age_ms, uint32_t *fid, bool consume)
+{
+	uint64_t t = q_match_abs;
+	if (t == 0) {
+		return false;
+	}
+	uint64_t age = ms_since(t);
+	if (age >= 3000) {
+		return false;
+	}
+	*age_ms = age;
+	*fid = q_match_fid;
+	if (consume) {
+		q_match_abs = 0;
+	}
+	return true;
+}
+
+/*
+ * op 26: the spot lit (local HBM), then op 20's auth (type 1, UNTRUSTED_CFG 0, exposure 1, retries
+ * per SENSOR_INIT) again and again until a match, the finger off the spot for over 150 ms, or 3 s;
+ * the spot off on every exit. *value: the finger id (its 32 bits) on a match, -1008 no match,
+ * -EINTR the finger lifted first, else -error.
+ */
+static int
+fp_fod_auth(int *value)
+{
+	if (!q_inited || q_goodix_id == 0) {
+		LOGA("op 26: run op 10 first");
+		return EAGAIN;
+	}
+	uint32_t epoch = sweet_aks_passcode_unlocks();
+	if (epoch != q_fod_epoch) {
+		q_fod_epoch = epoch;
+		q_fod_fails = 0;
+	}
+	if (q_fod_fails >= 5) {
+		LOGA("op 26: %u failed fingerprint attempts: passcode required", q_fod_fails);
+		return EPERM;
+	}
+	const uint64_t t0 = mach_absolute_time();
+	unsigned tries = 0;
+	int v = -1008;
+	q_quiet = true;
+	(void)panel_seq(0);
+	IOSleep(50);
+	for (;;) {
+		int r1 = 0;
+		v = -1008;
+		int rr = fp_auth_retry(&r1, 0);
+		tries++;
+		if (rr != 0) {
+			v = -(rr > 0 ? rr : EIO);
+			break;
+		}
+		v = r1;
+		if (v != 0 && (v > 0 || v < -5000)) {
+			break;                              /* a finger id */
+		}
+		if (v == 0) {
+			v = -1008;
+		}
+		/* the finger still there? (lifted for over 150 ms: stop) */
+		unsigned off_ms = 0;
+		while (!sweet_fod_press && off_ms <= 150) {
+			IOSleep(10);
+			off_ms += 10;
+		}
+		if (!sweet_fod_press) {
+			v = -EINTR;
+			break;
+		}
+		if (ms_since(t0) >= 3000) {
+			break;
+		}
+	}
+	(void)panel_seq(1);
+	q_quiet = false;
+	bool match = v > 0 || v < -5000;
+	if (match) {
+		q_match_fid = (uint32_t)v;
+		q_match_abs = mach_absolute_time();
+		q_fod_fails = 0;
+	} else if (v == -1008 || v == -1011) {
+		q_fod_fails++;
+	}
+	*value = v;
+	LOGA("op 26: %s after %u tries, %llu ms (value %d, finger %u, %u failed attempts)", match ? "MATCH" :
+	    v == -EINTR ? "finger lifted" : v == -1008 ? "no match" : "error", tries, ms_since(t0), v,
+	    match ? (uint32_t)v : 0, q_fod_fails);
+	return 0;
+}
+
+/* op 27: unlock by the last match (SweetKeyStore decides) */
+static int
+fp_bio_unlock(void)
+{
+	int r = sweet_aks_biometric_unlock();
+	LOGA("op 27: fingerprint unlock: %s", r == 0 ? "UNLOCKED" : r == EAGAIN ? "no recent match" : "refused (see SWEET AKS)");
+	return r;
+}
+
+/* op 28: lock-screen unlock from external verifier (2D Face Unlock via fpd), sharing q_fod_fails */
+static int
+fp_face_unlock(void)
+{
+	if (q_fod_fails >= 5) {
+		LOGA("op 28: face unlock refused (locked out: %u failed attempts)", q_fod_fails);
+		return EPERM;
+	}
+	q_match_fid = 0xFA0E2D01u;
+	q_match_abs = mach_absolute_time();
+	int r = sweet_aks_biometric_unlock();
+	if (r == 0) {
+		q_fod_fails = 0;
+	}
+	LOGA("op 28: face unlock: %s", r == 0 ? "UNLOCKED" : "refused (see SWEET AKS)");
+	return r;
+}
+
+static int
+fp_face_fail(void)
+{
+	q_fod_fails++;
+	LOGA("op 29: face unlock fail (%u failed attempts)", q_fod_fails);
+	return q_fod_fails >= 5 ? EPERM : 0;
+}
+
+/* op 12: AUTH_CANCEL, sensor off */
+static int
+fp_stop(void)
+{
+	if (q_goodix_id != 0 && q_va != NULL) {
+		bzero(q_cmd, 0x1c);
+		(void)gf_cmd(1000, 8, 0x1c, "AUTH_CANCEL");
+	}
+	fp_power_off();
+	q_inited = false;
+	LOG("op 12: stopped (%u file requests served this boot)", q_fs_reqs);
+	return 0;
+}
+
+/* kern.sweet_qsee (bsd/dev/sweet_qsee_ctl.c); op < 0: the last result */
+extern "C" int
+sweet_qsee_op(int op)
+{
+	int r, value = INT32_MIN;
+
+	if (op < 0) {
+		return q_last;
+	}
+	if (!qsee_enabled()) {
+		return ENODEV;
+	}
+	qsee_lock_init();
+	IOLockLock(q_lock);
+	switch (op) {
+	case 1:
+		r = milestone(true, false);
+		break;
+	case 2:
+		fp_power_off();
+		r = 0;
+		break;
+	case 3:
+		r = qsee_up() ? shutdown_app() : EIO;
+		break;
+	case 4: {
+		/* the TA only: shutdown + start, no sensor commands */
+		r = EIO;
+		if (qsee_up()) {
+			int64_t id = ta_ready(true);
+			r = id > 0 ? 0 : ENOEXEC;
+			LOG("op 4: goodixfp restart: %s (app id %lld)", r == 0 ? "ok" : "FAILED", id);
+		}
+		break;
+	}
+	case 5:
+		r = milestone(false, false);
+		break;
+	case 6:
+		r = milestone(true, true);
+		break;
+	case 7:
+		r = l9_readback();
+		break;
+	case 8:
+		r = qsee_up() ? (tz_log_register(), q_log_ok ? 0 : EIO) : EIO;
+		break;
+	case 9:
+		r = tz_log_copy();
+		break;
+	case 10:
+		r = fp_init();
+		break;
+	case 11:
+		r = fp_capture(1, NULL);
+		break;
+	case 13:
+		r = fp_capture(5, NULL);
+		break;
+	case 14:
+		r = fp_enroll_begin();
+		break;
+	case 15:
+		{
+			bool lit = spot_on((uint32_t)sweet_qsee_arg);
+			r = fp_enroll_touch(&value);
+			spot_off(lit);
+		}
+		break;
+	case 16:
+		r = fp_enroll_finish();
+		break;
+	case 17:
+		r = fp_auth_untrusted(&value);
+		break;
+	case 18:
+		r = fp_auth_retry(&value, 0);
+		break;
+	case 19:
+		r = fp_enum("op 19");
+		break;
+	case 20:
+		{
+			bool lit = spot_on((uint32_t)sweet_qsee_arg);
+			r = fp_auth_retry(&value, (uint32_t)sweet_qsee_arg);
+			spot_off(lit);
+		}
+		break;
+	case 22:
+	case 23:
+	case 24:
+	case 25:
+		r = panel_seq(op - 22);
+		break;
+	case 26:
+		r = fp_fod_auth(&value);
+		break;
+	case 27:
+		r = fp_bio_unlock();
+		break;
+	case 28:
+		r = fp_face_unlock();
+		break;
+	case 29:
+		r = fp_face_fail();
+		break;
+	case 12:
+		r = fp_stop();
+		break;
+	default:
+		r = EINVAL;
+		break;
+	}
+	/* ops 15 and 17 leave a value (remaining samples / finger id, or -gf error) for the next read */
+	q_last = r == 0 && value != INT32_MIN ? value : r;
+	IOLockUnlock(q_lock);
+	return r;
+}
+
+#else
+extern "C" int sweet_qsee_op(int op) { (void)op; return 19; /* ENODEV */ }
+#endif
diff --git a/iokit/Kernel/arm/SweetSurface.cpp b/iokit/Kernel/arm/SweetSurface.cpp
new file mode 100644
index 0000000..a64e2e5
--- /dev/null
+++ b/iokit/Kernel/arm/SweetSurface.cpp
@@ -0,0 +1,1533 @@
+/*
+ * Built-in IOSurface for SWEET.
+ *
+ * Apple's IOSurface kext is closed. IOSurface.framework (iOS 16.7) finds
+ * IOServiceNameMatching("IOCoreSurfaceRoot"), opens it with type 0 and
+ * talks to the user client below:
+ *
+ *   sel 13  limits: struct out 0x18, u16 at +0x16 must be 1 (ABI version),
+ *           +0 offset alignment mask, +4 bytes-per-row alignment mask
+ *   sel 0   create: scalar [parent id], struct in = serialized property
+ *           dictionary (binary or XML), struct out = lock result (0xa68)
+ *   sel 4   lookup by id: scalar [id], struct out = lock result
+ *   sel 34  lookup by mach port: scalar [port name], struct out = lock result
+ *   sel 35  create mach port: scalars [id, options], scalar out [port name]
+ *   traps   0/1 use count +/- (id, category), 2 lock / 3 unlock
+ *           (id, options, &seed), 4/5 release (id)
+ *
+ * The lock result tells the library where the surface lives in the
+ * caller's address space: +0 pixels, +8 shared state page (registry id,
+ * seed at +0xc), +0x10 timestamps, then id, sizes and geometry (layout in
+ * sweet_surface_fill_result). Every surface is wired kernel memory mapped
+ * into each task that creates or looks it up; mappings are counted per
+ * client and dropped on release or close.
+ *
+ * Values (9/10/11) live in a dictionary per surface, their seed and size in
+ * the state page (+0x20/+0x28); bulk attachments (27: colour space, transfer
+ * function...) are kept at +0x30 of the state page, where the framework reads
+ * them; purgeability (20), accelerator binding (12) and the YCbCr matrix (5)
+ * are remembered. Notifications, ownership and timestamps are accepted and
+ * ignored (logged once per selector).
+ */
+#include "SweetSurface.h"
+
+#if defined(SWEET)
+#include <IOKit/IOService.h>
+#include <IOKit/IOUserClient.h>
+#include <IOKit/IOKitKeys.h>
+#include <IOKit/IOLib.h>
+#include <IOKit/IOLocks.h>
+#include <IOKit/system.h>
+#include <pexpert/pexpert.h>
+#include <libkern/c++/OSArray.h>
+#include <libkern/c++/OSDictionary.h>
+#include <libkern/c++/OSNumber.h>
+#include <libkern/c++/OSUnserialize.h>
+#include <libkern/c++/OSSerialize.h>
+#include <sys/proc.h>
+
+enum {
+	kSweetSurfaceCreate             = 0,
+	kSweetSurfaceLookup             = 4,
+	kSweetSurfaceSetYCbCrMatrix     = 5,
+	kSweetSurfaceWrapClientImage    = 6,
+	kSweetSurfaceWrapClientMemory   = 7,
+	kSweetSurfaceSetValue           = 9,
+	kSweetSurfaceCopyValue          = 10,
+	kSweetSurfaceRemoveValue        = 11,
+	kSweetSurfaceBindAccel          = 12,
+	kSweetSurfaceSetPurgeable       = 20,
+	kSweetSurfaceSetBulkAttachments = 27,
+	kSweetSurfaceLimits             = 13,
+	kSweetSurfaceLookupFromPort     = 34,
+	kSweetSurfaceCreatePort         = 35,
+};
+
+enum {
+	kSweetSurfaceTrapIncrementUse   = 0,
+	kSweetSurfaceTrapDecrementUse   = 1,
+	kSweetSurfaceTrapLock           = 2,
+	kSweetSurfaceTrapUnlock         = 3,
+	kSweetSurfaceTrapRelease        = 4,
+	kSweetSurfaceTrapReleaseFailed  = 5,
+};
+
+#define SWEET_SURFACE_RESULT_SIZE       0xa68
+#define SWEET_SURFACE_MAX_ID            4096
+#define SWEET_SURFACE_MAX_DIM           16384
+
+/*
+ * The page size user tasks see. A 4 KiB-page kernel (TOPAZ_4K) still gives
+ * 64-bit tasks 16 KiB VM pages: surface memory, the state page and wrapped
+ * client ranges are 16 KiB aligned and sized, or a task's mapping of one
+ * shows neighbouring memory (garbage in text textures).
+ */
+#if defined(TOPAZ_4K)
+#define SWEET_UPAGE                     16384ULL
+#else
+#define SWEET_UPAGE                     ((uint64_t)PAGE_SIZE)
+#endif
+#define sweet_round_upage(x)            (((uint64_t)(x) + SWEET_UPAGE - 1) & ~(SWEET_UPAGE - 1))
+#define SWEET_SURFACE_MAX_ALLOC         (256u << 20)
+#define SWEET_SURFACE_MAX_PROPS         (64u << 10)
+#define SWEET_SURFACE_ROW_ALIGN         64
+#define SWEET_SURFACE_TIMESTAMPS        0x800   /* offset in the state page */
+#define SWEET_SURFACE_STATE_SEED        0xc     /* u32 in the state page */
+#define SWEET_SURFACE_STATE_ACCEL       0x8     /* u16 accelerator id, u16 sub id */
+#define SWEET_SURFACE_STATE_VSEED       0x20    /* u32 values seed */
+#define SWEET_SURFACE_STATE_YCBCR       0x24    /* u32 */
+#define SWEET_SURFACE_STATE_VSIZE       0x28    /* u32 room the values need when fetched, 0: none */
+#define SWEET_SURFACE_STATE_BULK        0x30    /* 0x70 bytes of bulk attachments */
+#define SWEET_SURFACE_BULK_SIZE         0x70
+#define kIOSurfaceLockReadOnly          0x1
+
+static IOLock       *sweet_surface_lock;
+static SweetSurface *sweet_surface_table[SWEET_SURFACE_MAX_ID];
+static uint32_t      sweet_surface_users[SWEET_SURFACE_MAX_ID];
+static uint32_t      sweet_surface_next_id = 1;
+static uint32_t      sweet_surface_creates_logged;
+static uint64_t      sweet_surface_wired;       /* bytes of buffer surfaces */
+static SInt32        sweet_surface_objects;     /* SweetSurface objects alive */
+
+extern "C" void
+sweet_surface_counted(int delta)
+{
+	OSAddAtomic(delta, &sweet_surface_objects);
+}
+
+extern "C" void
+sweet_surface_census(uint32_t *objects, uint64_t *wired)
+{
+	*objects = (uint32_t)sweet_surface_objects;
+	*wired = sweet_surface_wired;
+}
+#define SWEET_SURFACE_WIRED_MAX         (3072ull << 20)   /* (0164: pageable now, so not all of it wired) */
+
+/* topaz scanout: at most 6 contiguous 16 MiB surfaces */
+#define SWEET_SCANOUT_SLOT      (16u << 20)
+#define SWEET_SCANOUT_SLOTS     6
+static uint32_t sweet_scanout_used;             /* bit per slot, sweet_surface_lock */
+static uint32_t sweet_scanout_w[2], sweet_scanout_h[2];
+static int      sweet_scanout_enabled = -1;
+
+void
+sweet_scanout_set_geometry(uint32_t w1, uint32_t h1, uint32_t w2, uint32_t h2)
+{
+	sweet_scanout_w[0] = w1;
+	sweet_scanout_h[0] = h1;
+	sweet_scanout_w[1] = w2;
+	sweet_scanout_h[1] = h2;
+}
+
+static bool
+sweet_scanout_eligible(const SweetSurface *s)
+{
+	if (sweet_scanout_enabled < 0) {
+		int on = 1;
+		PE_parse_boot_argn("sweetfb_direct", &on, sizeof(on));
+		sweet_scanout_enabled = on;
+	}
+	if (!sweet_scanout_enabled || s->bytesPerElement != 4 || s->planeCount > 1 ||
+	    s->elementWidth != 1 || s->elementHeight != 1 || s->allocSize > SWEET_SCANOUT_SLOT) {
+		return false;
+	}
+	for (int i = 0; i < 2; i++) {
+		if (sweet_scanout_w[i] && s->width == sweet_scanout_w[i] && s->height == sweet_scanout_h[i]) {
+			return true;
+		}
+	}
+	return false;
+}
+
+static int
+sweet_scanout_alloc_slot(void)
+{
+	int slot = -1;
+	IOLockLock(sweet_surface_lock);
+	for (int i = 0; i < SWEET_SCANOUT_SLOTS; i++) {
+		if (!(sweet_scanout_used & (1u << i))) {
+			sweet_scanout_used |= 1u << i;
+			slot = i;
+			break;
+		}
+	}
+	IOLockUnlock(sweet_surface_lock);
+	return slot;
+}
+
+static void
+sweet_scanout_free_slot(int slot)
+{
+	if (slot < 0) {
+		return;
+	}
+	IOLockLock(sweet_surface_lock);
+	sweet_scanout_used &= ~(1u << slot);
+	IOLockUnlock(sweet_surface_lock);
+}
+
+OSDefineMetaClassAndStructors(SweetSurface, OSObject);
+
+void
+SweetSurface::free()
+{
+	if (OSDynamicCast(IOBufferMemoryDescriptor, memory) != NULL) {
+		OSAddAtomic64(-(SInt64)allocSize, (volatile SInt64 *)&sweet_surface_wired);
+	}
+	OSSafeReleaseNULL(kernelMap);
+	OSSafeReleaseNULL(values);
+	if (wrapped && memory != NULL) {
+		memory->complete();
+	}
+	OSSafeReleaseNULL(memory);
+	OSSafeReleaseNULL(state);
+	sweet_scanout_free_slot(scanoutSlot);
+	scanoutSlot = -1;
+	sweet_surface_counted(-1);
+	OSObject::free();
+}
+
+uintptr_t
+SweetSurface::kernelAddress()
+{
+	IOBufferMemoryDescriptor *buffer = OSDynamicCast(IOBufferMemoryDescriptor, memory);
+	if (buffer != NULL) {
+		return (uintptr_t)buffer->getBytesNoCopy();
+	}
+	IOLockLock(sweet_surface_lock);
+	if (kernelMap == NULL && memory != NULL) {
+		kernelMap = memory->map(scanoutPhys || wrapped ? kIOMapDefaultCache : kIOMapWriteCombineCache);
+	}
+	IOLockUnlock(sweet_surface_lock);
+	return kernelMap != NULL ? (uintptr_t)kernelMap->getVirtualAddress() : 0;
+}
+
+static uint32_t *
+sweet_surface_seed(SweetSurface *s)
+{
+	return (uint32_t *)((uint8_t *)s->state->getBytesNoCopy() + SWEET_SURFACE_STATE_SEED);
+}
+
+/*
+ * Give the surface an id and a table slot; the table holds one retain and a
+ * user count (creators, client mappings, kernel holders). Lock held.
+ */
+static bool
+sweet_surface_insert_locked(SweetSurface *s)
+{
+	for (uint32_t n = 0; n < SWEET_SURFACE_MAX_ID - 1; n++) {
+		uint32_t id = sweet_surface_next_id;
+		sweet_surface_next_id = id + 1 < SWEET_SURFACE_MAX_ID ? id + 1 : 1;
+		if (sweet_surface_table[id] == NULL) {
+			s->id = id;
+			s->retain();
+			sweet_surface_table[id] = s;
+			sweet_surface_users[id] = 1;
+			*(uint64_t *)s->state->getBytesNoCopy() = id;   /* registry id */
+			return true;
+		}
+	}
+	return false;
+}
+
+/* Add a user to a surface that may have left the table (port lookups). */
+static bool
+sweet_surface_get(SweetSurface *s)
+{
+	bool ok = true;
+	IOLockLock(sweet_surface_lock);
+	if (sweet_surface_table[s->id] == s) {
+		sweet_surface_users[s->id]++;
+	} else if (sweet_surface_table[s->id] == NULL) {
+		s->retain();
+		sweet_surface_table[s->id] = s;
+		sweet_surface_users[s->id] = 1;
+	} else {
+		ok = false;
+	}
+	IOLockUnlock(sweet_surface_lock);
+	return ok;
+}
+
+/* Drop a user; the last one removes the surface from the table. */
+static void
+sweet_surface_put(SweetSurface *s)
+{
+	bool drop = false;
+	IOLockLock(sweet_surface_lock);
+	if (sweet_surface_table[s->id] == s && --sweet_surface_users[s->id] == 0) {
+		sweet_surface_table[s->id] = NULL;
+		drop = true;
+	}
+	IOLockUnlock(sweet_surface_lock);
+	if (drop) {
+		s->release();
+	}
+}
+
+SweetSurface *
+sweet_surface_copy(uint32_t id)
+{
+	SweetSurface *s = NULL;
+	if (id == 0 || id >= SWEET_SURFACE_MAX_ID || sweet_surface_lock == NULL) {
+		return NULL;
+	}
+	IOLockLock(sweet_surface_lock);
+	s = sweet_surface_table[id];
+	if (s != NULL) {
+		s->retain();
+	}
+	IOLockUnlock(sweet_surface_lock);
+	return s;
+}
+
+/* The table lock; the framebuffer may publish a surface before the root starts. */
+static void
+sweet_surface_init_lock(void)
+{
+	if (sweet_surface_lock == NULL) {
+		IOLock *lock = IOLockAlloc();
+		if (!OSCompareAndSwapPtr(NULL, lock, &sweet_surface_lock)) {
+			IOLockFree(lock);
+		}
+	}
+}
+
+static SweetSurface *
+sweet_surface_alloc(void)
+{
+	sweet_surface_init_lock();
+	SweetSurface *s = OSTypeAlloc(SweetSurface);
+	if (s == NULL || !s->init()) {
+		OSSafeReleaseNULL(s);
+		return NULL;
+	}
+	s->state = IOBufferMemoryDescriptor::inTaskWithOptions(kernel_task,
+	    kIODirectionInOut | kIOMemoryKernelUserShared, SWEET_UPAGE, SWEET_UPAGE);
+	if (s->state == NULL) {
+		s->release();
+		return NULL;
+	}
+	bzero(s->state->getBytesNoCopy(), SWEET_UPAGE);
+	return s;
+}
+
+static bool
+sweet_surface_publish(SweetSurface *s)
+{
+	bool ok;
+	IOLockLock(sweet_surface_lock);
+	ok = sweet_surface_insert_locked(s);
+	IOLockUnlock(sweet_surface_lock);
+	return ok;
+}
+
+SweetSurface *
+sweet_surface_create_physical(uint64_t phys, uint32_t width, uint32_t height,
+    uint32_t bytesPerRow, uint32_t pixelFormat)
+{
+	SweetSurface *s = sweet_surface_alloc();
+	if (s == NULL) {
+		return NULL;
+	}
+	s->width = width;
+	s->height = height;
+	s->bytesPerRow = bytesPerRow;
+	s->bytesPerElement = 4;
+	s->elementWidth = s->elementHeight = 1;
+	s->pixelFormat = pixelFormat;
+	s->allocSize = (uint32_t)sweet_round_upage(bytesPerRow * height);
+	s->memory = IOMemoryDescriptor::withPhysicalAddress(phys, s->allocSize, kIODirectionInOut);
+	s->mapCache = kIOMapWriteCombineCache;
+	if (s->memory == NULL || !sweet_surface_publish(s)) {
+		s->release();
+		return NULL;
+	}
+	return s;
+}
