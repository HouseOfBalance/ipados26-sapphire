+static bool
+sweet_emulate_lse(arm_saved_state_t *state, uint32_t instr)
+{
+	uint32_t size = instr >> 30;
+	uint32_t rs = (instr >> 16) & 31, rn = (instr >> 5) & 31, rt = instr & 31;
+	uint64_t mask = size == 3 ? ~0ULL : (1ULL << (8 << size)) - 1;
+	uint64_t operand = 0, compare = 0, old = 0;
+	uint32_t op, dst;
+	int err;
+
+	if ((instr & 0x3F200C00) == 0x38200000) {
+		uint32_t o3 = (instr >> 15) & 1, opc = (instr >> 12) & 7;
+		if (o3 == 0) {
+			op = opc;
+		} else if (opc == 0) {
+			op = 8;         /* SWP */
+		} else if (opc == 4 && rs == 31) {
+			op = 10;        /* LDAPR */
+		} else {
+			return false;
+		}
+		if (op != 10 && rs != 31) {
+			operand = get_saved_state_reg(state, rs) & mask;
+		}
+		dst = rt;
+	} else if ((instr & 0x3FA07C00) == 0x08A07C00) {
+		op = 9;                 /* CAS: Rs = compare and old value, Rt = new */
+		if (rs != 31) {
+			compare = get_saved_state_reg(state, rs) & mask;
+		}
+		if (rt != 31) {
+			operand = get_saved_state_reg(state, rt) & mask;
+		}
+		dst = rs;
+	} else if ((instr & 0xBFA07C00U) == 0x08207C00U) {
+		/* ARMv8.1 CASP / CASPA / CASPL / CASPAL Ws,Ws+1,[Xn] or Xs,Xs+1,[Xn] */
+		if ((rs & 1) || (rt & 1) || rs >= 30 || rt >= 30) {
+			return false;
+		}
+		bool is64 = ((instr >> 30) & 1) != 0;
+		user_addr_t caddr = (rn == 31 ? get_saved_state_sp(state) : get_saved_state_reg(state, rn)) & 0x0000FFFFFFFFFFFFULL;
+		uint64_t align_mask = is64 ? 15ULL : 7ULL;
+		if ((caddr & align_mask) != 0 || caddr >= MACH_VM_MAX_ADDRESS) {
+			return false;
+		}
+		if (is64) {
+			uint64_t cmp64[2] = { (uint64_t)get_saved_state_reg(state, rs), (uint64_t)get_saved_state_reg(state, rs + 1) };
+			uint64_t new64[2] = { (uint64_t)get_saved_state_reg(state, rt), (uint64_t)get_saved_state_reg(state, rt + 1) };
+			if (_sweet_casp_x(caddr, cmp64, new64) != 0) {
+				return false;
+			}
+			set_saved_state_reg(state, rs, (register_t)cmp64[0]);
+			set_saved_state_reg(state, rs + 1, (register_t)cmp64[1]);
+		} else {
+			uint32_t cmp32[2] = { (uint32_t)get_saved_state_reg(state, rs), (uint32_t)get_saved_state_reg(state, rs + 1) };
+			uint32_t new32[2] = { (uint32_t)get_saved_state_reg(state, rt), (uint32_t)get_saved_state_reg(state, rt + 1) };
+			if (_sweet_casp_w(caddr, cmp32, new32) != 0) {
+				return false;
+			}
+			set_saved_state_reg(state, rs, (register_t)cmp32[0]);
+			set_saved_state_reg(state, rs + 1, (register_t)cmp32[1]);
+		}
+		add_saved_state_pc(state, 4);
+		return true;
+	} else {
+		return false;
+	}
+
+	user_addr_t addr = rn == 31 ? get_saved_state_sp(state) : get_saved_state_reg(state, rn);
+	if ((addr & ((1ULL << size) - 1)) != 0 || addr >= MACH_VM_MAX_ADDRESS) {
+		return false;
+	}
+	switch (size) {
+	case 0: err = _sweet_lse_b(addr, op, operand, compare, &old); break;
+	case 1: err = _sweet_lse_h(addr, op, operand, compare, &old); break;
+	case 2: err = _sweet_lse_w(addr, op, operand, compare, &old); break;
+	default: err = _sweet_lse_x(addr, op, operand, compare, &old); break;
+	}
+	if (err != 0) {
+		return false;
+	}
+	if (dst != 31) {
+		set_saved_state_reg(state, dst, (register_t)old);
+	}
+	add_saved_state_pc(state, 4);
+	return true;
+}
