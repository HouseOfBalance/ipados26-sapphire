+/*
+ * sapphire 0270: camera bring-up, phase 1 (research/camera.md): the camss power domain and
+ * clocks, the CCI (camera I2C) and each sensor's power-up sequence, ending in a chip-id read.
+ * Nothing runs at boot; everything is a request through sysctls:
+ *   kern.sweet_cam = op: 1 camss on (GDSC, top_ahb/axi/rt_axi/nrt_axi/cci_0, CCI and CPAS
+ *     versions, CCI pins, reset, 400 kHz timings on both masters); 2..5 power slot 0..3 (main
+ *     S5KHM6, front OV16A1Q/GC16B3C, ultra wide S5K4H7, macro SC202PCS) with the DT sequence,
+ *     then its chip id and 16 bytes of its EEPROM; 9 everything off, in reverse order.
+ *     Reading it gives the last result (0 ok, else an errno).
+ *     0272 (phases 2/3, kern.sweet_cam_arg the argument): 10 sensor init + mode + stream on
+ *     (arg: slot | mode << 4: HM6 0x00/0x10/0x40, 4H7 0x02), 11 CSIPHY + PPI + CSID0 RDI0 and its
+ *     packet counters (arg settle << 8), 12 one frame through TFE0 RDI0 / write master 7 into the
+ *     pool 0xD7000000 (144 MB) with an identity SMMU bank for stream 0x400, 13 stop, 14 the pool's
+ *     pattern test (arg 1: check only); 0274: op 12 split into 20 (SMMU stage-1 bank mapping only
+ *     the pool), 21 (TFE registers read), 22 (WM7 written, not enabled), 23 (enable + one frame);
+ *     0276: kern.sweet_cam_exp (exposure), op 30 preview ring (kern.sweet_cam_latest,
+ *     kern.sweet_cam_sel), 31 preview off, 32 108 MP still; op 9 also stops the stream/capture path.
+ *     0277: op 6 bus check (CCI levels with every rail on); PMIC rail GPIOs get the DT's pull/drive;
+ *     a still waits for a whole frame; long exposures lengthen the frame (up to 65535 lines).
+ *     0278: op 10 slots 1 (OV16A1Q, CSIPHY2), 2 (S5K4H7, CSIPHY1) and 3 (SC202PCS, CSIPHY1 one lane);
+ *     op 11 restarts the sensor's stream after the receiver is set up.
+ *     0279: every mapping made once at op 1 (counted in each op's last line).
+ *     0288: op 30 takes a slot (arg slot | mode << 4): the front, ultra wide and macro sensors
+ *     stream into the same preview ring (their one mode); the receiver is set up again whenever
+ *     the slot differs from the one it was set up for. Op 32 is the HM6's only.
+ *     0287: the main lens's focus motor (GT9764 VCM driver, master 0 7-bit 0x0C, 8-bit registers):
+ *     VAF (TLMM GPIO101) on with slot 0, kern.sweet_cam_af = lens position 0..1023 (written: moves
+ *     the lens, the driver set up at the first move after power-up; read: the last position, -1
+ *     none); kern.sweet_cam_i2c takes m 10/11 for 8-bit register addresses.
+ *     kern.sweet_cam_seek + kern.sweet_cam_frame: the frame in
+ *     1 MB reads, kern.sweet_cam_frame_len its size.
+ *   kern.sweet_cam_log: the log of the last request (also in the kernel log, "SWEET CAM:").
+ *   kern.sweet_cam_i2c = "m addr reg" reads 2 bytes, "m addr reg val" writes val (1 byte if
+ *     <= 0xff, else 2), all hex, addr 7-bit, reg 16-bit; the answer goes to kern.sweet_cam_log.
+ * Rules (camera.md): nothing in 0x5C00000-0x5CFFFFF before the GDSC and top_ahb/axi are on,
+ * each block's clock before its registers, every wait bounded, stop at the first wrong-looking
+ * read. No CSIPHY/CSID/TFE/SMMU here. TLMM writes keep the eGPIO enable (bit 12) when bit 11
+ * says the pin has one; GPIO14-17 (the fingerprint's SPI, TZ-owned) are never touched.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/sysctl.h>
+#include <sys/errno.h>
+#include <kern/locks.h>
+#include <machine/machine_routines.h>
+#include <stdarg.h>
+#include "sweet_spmi.h"
+#include <kern/clock.h>
+#include <mach/mach_time.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+extern kern_return_t thread_terminate(thread_t);
+
+extern void IODelay(unsigned microseconds);
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+extern void IOSleep(unsigned milliseconds);
+int sweet_spmi_read_any(unsigned sid, unsigned addr, uint8_t *out);
+
+#define GCC_PA          0x01400000u
+#define GCC_SIZE        0x80000u
+#define GDSC_CAMSS      0x58004u
+#define CPAS_PA         0x05C11000u
+#define CCI_PA          0x05C1B000u
+
+/* RCG (CMD at +0, CFG at +4) and branch (CBCR) offsets in GCC */
+#define RCG_TOP_AHB     0x58010u
+#define CBCR_TOP_AHB    0x58028u
+#define RCG_AXI         0x5802Cu
+#define CBCR_AXI        0x58044u
+#define CBCR_RT_AXI     0x5805Cu
+#define CBCR_NRT_AXI    0x58054u
+#define RCG_CCI         0x56000u
+#define CBCR_CCI        0x56018u
+static const uint32_t rcg_mclk[4] = { 0x51000u, 0x5101Cu, 0x51038u, 0x51054u };
+static const uint32_t cbcr_mclk[4] = { 0x51018u, 0x51034u, 0x51050u, 0x5106Cu };
+
+/* CCI v1.2 (Linux i2c-qcom-cci) */
+#define CCI_HW_VERSION  0x000
+#define CCI_RESET_CMD   0x004
+#define CCI_QUEUE_START 0x008                 /* 0272: camera.ko cam_cci_read (0x00C was wrong) */
+#define CCI_M(m)        (0x100u + 0x100u * (m))
+#define CCI_Q(m, q)     (0x300u + 0x200u * (m) + 0x100u * (q))
+#define CCI_IRQ_GCLEAR  0xC00
+#define CCI_IRQ_MASK0   0xC04
+#define CCI_IRQ_CLEAR0  0xC08
+#define CCI_IRQ_STATUS0 0xC0C
+#define CCI_RST_DONE    (1u << 24)
+#define CCI_M0_ERROR    0x18000ee6u
+#define CCI_M1_ERROR    0x60ee6000u
+
+/* pins (camera.md, dtbo fragment@28/@29) */
+#define GPIO_VIO        54
+#define GPIO_CSI_MUX    34
+static const unsigned cci_pins[4] = { 22, 23, 29, 30 };
+static const unsigned mclk_pin[4] = { 20, 21, 27, 28 };
+static const unsigned reset_pin[4] = { 18, 24, 19, 68 };
+#define GPIO_MAIN_VANA  26
+#define GPIO_MAIN_VDIG  85
+#define GPIO_MAIN_VAF   101     /* 0287: the actuator's 2.8 V (DT cam_vaf for slot 0) */
+#define AF_ADDR         0x0C    /* GT9764, 8-bit 0x18 on master 0 */
+static int link_slot = -1;      /* 0288: the slot the CSIPHY/CSID were last set up for */
+static int af_pos = -1;         /* last lens position written, -1: none since power-up */
+static bool af_ready;           /* the GT9764 set up since power-up */
+
+/* PMIC GPIOs: PM6125 GPIO2 (SID 0, 0xC100) = front/UW/macro AVDD, PM7250B GPIO3 (SID 2, 0xC200) = DVDD */
+#define AVDD_SID        0
+#define AVDD_BASE       0xC100u
+#define DVDD_SID        2
+#define DVDD_BASE       0xC200u
+
+static LCK_GRP_DECLARE(sweet_cam_grp, "sweet_cam");
+static LCK_MTX_DECLARE(sweet_cam_mtx, &sweet_cam_grp);
+static vm_offset_t gcc, cci, cpas;
+static bool camss_up;
+/* 0272 */
+static int cam_arg;
+static int64_t cam_seek;
+static uint32_t cam_frame_len, cam_frame_off;
+static uint64_t cam_frame_ns;                   /* 0277: the HM6 frame time in use (exposure, frame length) */
+static uint8_t *cam_pool;
+static vm_offset_t cam_phy, cam_ppi, cam_csid, cam_smmu, cam_phys[3];
+static bool slot_up[4], cam_streaming, cam_csid_up;
+static struct { unsigned slot, mode, w, h, phy, settle, lanes; uint32_t rxcfg0; bool cphy; } cs;
+static int cam_last = -1;
+static char cam_log[8192];
+static size_t cam_log_len;
+
+static void
+camlog(const char *fmt, ...)
+{
+	char line[256];
+	va_list ap;
+	va_start(ap, fmt);
+	int n = vsnprintf(line, sizeof(line), fmt, ap);
+	va_end(ap);
+	if (n < 0) {
+		return;
+	}
+	printf("SWEET CAM: %s\n", line);
+	if (cam_log_len + strlen(line) + 2 < sizeof(cam_log)) {
+		cam_log_len += (size_t)snprintf(cam_log + cam_log_len, sizeof(cam_log) - cam_log_len, "%s\n", line);
+	}
+}
+
+static inline uint32_t rd(vm_offset_t b, uint32_t o) { return *(volatile uint32_t *)(b + o); }
+static inline void wr(vm_offset_t b, uint32_t o, uint32_t v)
+{
+	__asm__ volatile ("dsb sy" ::: "memory");
+	*(volatile uint32_t *)(b + o) = v;
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+/*
+ * 0279: every mapping is made once, at op 1, and kept (cam_premap); cam_io() counts them and
+ * every op's last log line shows the count, which must stay the same. 0278 mapped a CSIPHY on
+ * every op 11/30, and a late first mapping (a pin op 9 had not used yet) found the kernel's
+ * mapping space exhausted: "kmem_alloc(..., 16384): failed with 3" panic. GCC is no longer one
+ * 512 KB mapping but three windows: 0x17000 (camera AHB/XO), 0x51000-0x59fff (camss clocks,
+ * GDSC), 0x7D000 (TBU GDSC votes).
+ */
+static unsigned cam_maps;
+static uint64_t cam_map_bytes;
+
+static vm_offset_t
+cam_io(uint64_t pa, uint64_t size)
+{
+	vm_offset_t va = ml_io_map((vm_offset_t)pa, (vm_size_t)size);
+	if (va != 0) {
+		cam_maps++;
+		cam_map_bytes += size;
+	}
+	return va;
+}
+
+static vm_offset_t gcc_a, gcc_b, gcc_c;
+
+static inline vm_offset_t
+gcc_va(uint32_t o)
+{
+	if (o >= 0x51000 && o < 0x5A000 && gcc_b) {
+		return gcc_b + (o - 0x51000);
+	}
+	if (o >= 0x17000 && o < 0x18000 && gcc_a) {
+		return gcc_a + (o - 0x17000);
+	}
+	if (o >= 0x7D000 && o < 0x7E000 && gcc_c) {
+		return gcc_c + (o - 0x7D000);
+	}
+	return 0;
+}
+
+static inline uint32_t
+gccr(uint32_t o)
+{
+	vm_offset_t v = gcc_va(o);
+	return v ? *(volatile uint32_t *)v : 0xDEADDEADu;
+}
+
+static inline void
+gccw(uint32_t o, uint32_t val)
+{
+	vm_offset_t v = gcc_va(o);
+	if (v) {
+		__asm__ volatile ("dsb sy" ::: "memory");
+		*(volatile uint32_t *)v = val;
+		__asm__ volatile ("dsb sy" ::: "memory");
+	}
+}
+
+/* ---------------------------------------------------------------- GCC */
+
+static bool
+gdsc_on(void)
+{
+	uint32_t v = gccr(GDSC_CAMSS);
+	camlog("GDSC camss_top %#x: before %#x", GCC_PA + GDSC_CAMSS, v);
+	gccw(GDSC_CAMSS, v & ~1u);                   /* SW_COLLAPSE off */
+	for (int i = 0; i < 100; i++) {
+		if (gccr(GDSC_CAMSS) & (1u << 31)) {
+			camlog("GDSC camss_top: PWR_ON (%#x) after %d x 10 us", gccr(GDSC_CAMSS), i);
+			return true;
+		}
+		IODelay(10);
+	}
+	camlog("GDSC camss_top: NO PWR_ON after 1 ms (%#x): stop", gccr(GDSC_CAMSS));
+	return false;
+}
+
+static bool
+rcg_set(const char *name, uint32_t rcg, uint32_t cfg)
+{
+	gccw(rcg + 4, cfg);
+	gccw(rcg, gccr(rcg) | 1);                 /* UPDATE */
+	for (int i = 0; i < 100; i++) {
+		if ((gccr(rcg) & 1) == 0) {
+			camlog("RCG %s: cfg %#x, cmd %#x", name, gccr(rcg + 4), gccr(rcg));
+			return true;
+		}
+		IODelay(10);
+	}
+	camlog("RCG %s: update did not complete (cmd %#x cfg %#x): stop", name, gccr(rcg), gccr(rcg + 4));
+	return false;
+}
+
+static bool
+branch_on(const char *name, uint32_t cbcr)
+{
+	gccw(cbcr, gccr(cbcr) | 1);
+	for (int i = 0; i < 100; i++) {
+		if ((gccr(cbcr) & (1u << 31)) == 0) {
+			camlog("branch %s on (%#x)", name, gccr(cbcr));
+			return true;
+		}
+		IODelay(10);
+	}
+	camlog("branch %s: still off after 1 ms (%#x): stop", name, gccr(cbcr));
+	return false;
+}
+
+static void
+branch_off(const char *name, uint32_t cbcr)
+{
+	gccw(cbcr, gccr(cbcr) & ~1u);
+	camlog("branch %s off (%#x)", name, gccr(cbcr));
+}
+
+/* ---------------------------------------------------------------- TLMM and PMIC GPIOs */
+
+static volatile uint32_t *
+tlmm_pin(unsigned gpio)
+{
+	/* the TLMM tile of each GPIO (pinctrl-sm6115.c): S 0x900000, E 0xd00000, W 0x500000 */
+	static const char tile[] = "WWWWWWWWEEEEWWWWWWEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEWWWWWWWSSSSSSSSWWWWWWWEEWEEWWWWWWSSSSSSSSSSSSSSS";
+	static vm_offset_t map[sizeof(tile)];       /* mapped once per pin */
+	if (gpio >= sizeof(tile) - 1 || (gpio >= 14 && gpio <= 17)) {
+		return NULL;
+	}
+	if (map[gpio] == 0) {
+		uint64_t base = tile[gpio] == 'S' ? 0x00900000ull : tile[gpio] == 'E' ? 0x00D00000ull : 0x00500000ull;
+		map[gpio] = cam_io(base + gpio * 0x1000ull, 0x1000);
+	}
+	return (volatile uint32_t *)map[gpio];
+}
+
+/* func, pull (0 none, 1 down, 3 up), output enable + level; drive 2 mA; the eGPIO enable kept */
+static bool
+pin_cfg(unsigned gpio, unsigned func, unsigned pull, int out)
+{
+	volatile uint32_t *g = tlmm_pin(gpio);
+	if (g == NULL) {
+		camlog("gpio%u: not mapped (or off limits): stop", gpio);
+		return false;
+	}
+	uint32_t ctl = g[0], io = g[1];
+	uint32_t nv = (func << 2) | pull | (out >= 0 ? (1u << 9) : 0) | ((ctl & (1u << 11)) ? (1u << 12) : 0);
+	if (out >= 0) {
+		g[1] = out ? 2 : 0;
+		__asm__ volatile ("dsb sy" ::: "memory");
+	}
+	g[0] = nv;
+	__asm__ volatile ("dsb sy" ::: "memory");
+	camlog("gpio%u: ctl %#x io %#x -> ctl %#x io %#x", gpio, ctl, io, g[0], g[1]);
+	return true;
+}
+
+static bool pin_out(unsigned gpio, int high) { return pin_cfg(gpio, 0, 0, high); }
+
+/* a PM6125/PM7250B LV/MV GPIO as a plain output (pinctrl-spmi-gpio lv_mv layout) */
+static bool
+pmic_gpio(unsigned sid, unsigned base, int high, unsigned strength, const char *name)
+{
+	uint8_t type = 0, sub = 0, mode = 0, src = 0, en = 0, vin = 0, drv = 0, pull = 0;
+	if (sweet_spmi_init() != 0 || sweet_spmi_read_any(sid, base + 0x04, &type) != 0 ||
+	    sweet_spmi_read_any(sid, base + 0x05, &sub) != 0) {
+		camlog("%s (sid %u %#x): not readable: stop", name, sid, base);
+		return false;
+	}
+	(void)sweet_spmi_read_any(sid, base + 0x40, &mode);
+	(void)sweet_spmi_read_any(sid, base + 0x41, &vin);
+	(void)sweet_spmi_read_any(sid, base + 0x44, &src);
+	(void)sweet_spmi_read_any(sid, base + 0x46, &en);
+	(void)sweet_spmi_read_any(sid, base + 0x45, &drv);
+	(void)sweet_spmi_read_any(sid, base + 0x42, &pull);
+	if (type != 0x10 || sub < 0x10 || sub > 0x13) {
+		camlog("%s (sid %u %#x): type %#x subtype %#x is not an LV/MV GPIO: stop", name, sid, base, type, sub);
+		return false;
+	}
+	int r = sweet_spmi_write(sid, base + 0x41, 0x00);                       /* DIG_VIN_CTL: VIN0 */
+	r = r ? r : sweet_spmi_write(sid, base + 0x42, 0x05);                   /* 0277 DIG_PULL_CTL: no pull (bias-disable) */
+	r = r ? r : sweet_spmi_write(sid, base + 0x45, strength & 3);           /* 0277 DIG_OUT_CTL: CMOS, the DT's drive strength */
+	r = r ? r : sweet_spmi_write(sid, base + 0x40, 0x01);                   /* MODE_CTL: output */
+	r = r ? r : sweet_spmi_write(sid, base + 0x44, high ? 0x80 : 0x00);     /* DIG_OUT_SOURCE_CTL: level, normal */
+	r = r ? r : sweet_spmi_write(sid, base + 0x46, 0x80);                   /* EN_CTL: enabled */
+	uint8_t mode2 = 0, src2 = 0, en2 = 0, st = 0;
+	(void)sweet_spmi_read_any(sid, base + 0x40, &mode2);
+	(void)sweet_spmi_read_any(sid, base + 0x44, &src2);
+	(void)sweet_spmi_read_any(sid, base + 0x46, &en2);
+	(void)sweet_spmi_read_any(sid, base + 0x08, &st);
+	uint8_t drv2 = 0;
+	(void)sweet_spmi_read_any(sid, base + 0x45, &drv2);
+	camlog("%s (sid %u %#x, subtype %#x, vin %#x, pull %#x): mode %#x src %#x en %#x drive %#x -> mode %#x src %#x en %#x drive %#x status %#x: %s%s",
+	    name, sid, base, sub, vin, pull, mode, src, en, drv, mode2, src2, en2, drv2, st, high ? "high" : "low", r ? " WRITE FAILED" : "");
+	return r == 0;
+}
+
+/* ---------------------------------------------------------------- CCI */
+
+static void
+cci_clear(uint32_t bits)
+{
+	wr(cci, CCI_IRQ_CLEAR0, bits);
+	wr(cci, CCI_IRQ_GCLEAR, 1);
+}
+
+static bool
+cci_wait(uint32_t bit, uint32_t errmask, const char *what)
+{
+	uint32_t st = 0;
+	for (int i = 0; i < 500; i++) {                 /* 50 ms */
+		st = rd(cci, CCI_IRQ_STATUS0);
+		if (st & (bit | errmask)) {
+			break;
+		}
+		IODelay(100);
+	}
+	cci_clear(st);
+	if ((st & bit) && !(st & errmask)) {
+		return true;
+	}
+	camlog("CCI %s: status %#x (%s)", what, st, (st & errmask) ? "error/NACK" : "timeout");
+	return false;
+}
+
+/*
+ * 0272: as camera.ko's cam_cci_init: reset (0x0F73F3F7, then 1), wait for the reset done bit, then
+ * IRQ_MASK_0/CLEAR_0 = 0x7FFF7FF7, IRQ_MASK_1/CLEAR_1 (0xC10/0xC14) = 0x110000, global clear.
+ * The mask is also set before the reset so that its acknowledge shows.
+ */
+static void
+cci_timings(unsigned m)
+{
+	static const uint32_t t400[9] = { 0x26, 0x38, 0x28, 0x28, 0x16, 0x23, 0x3E, 6, 3 };
+	wr(cci, CCI_M(m) + 0x00, t400[0] << 16 | t400[1]);     /* SCL_CTL thigh, tlow */
+	wr(cci, CCI_M(m) + 0x04, t400[2] << 16 | t400[3]);     /* SDA_CTL_0 tsu_sto, tsu_sta */
+	wr(cci, CCI_M(m) + 0x08, t400[4] << 16 | t400[5]);     /* SDA_CTL_1 thd_dat, thd_sta */
+	wr(cci, CCI_M(m) + 0x0C, t400[6]);                      /* SDA_CTL_2 tbuf */
+	wr(cci, CCI_M(m) + 0x10, t400[7] << 4 | t400[8]);      /* MISC_CTL trdhld, tsp */
+}
+
+/*
+ * 0273: a reset also clears the masters' timing registers: 0272's recovery after a NACK reset
+ * the CCI without writing them again, so every later transfer on either master hung (status 0).
+ * The global reset now rewrites both masters' timings.
+ */
+static bool
+cci_reset(void)
+{
+	cci_clear(0xffffffffu);
+	wr(cci, CCI_IRQ_MASK0, 0x7FFF7FF7u);
+	wr(cci, CCI_RESET_CMD, 0x0F73F3F7u);
+	wr(cci, CCI_RESET_CMD, 0x1u);
+	bool ok = cci_wait(CCI_RST_DONE, 0, "reset");
+	wr(cci, CCI_IRQ_MASK0, 0x7FFF7FF7u);
+	wr(cci, CCI_IRQ_CLEAR0, 0x7FFF7FF7u);
+	wr(cci, 0xC10, 0x110000u);
+	wr(cci, 0xC14, 0x110000u);
+	wr(cci, CCI_IRQ_GCLEAR, 1);
+	cci_timings(0);
+	cci_timings(1);
+	return ok;
+}
+
+/*
+ * after a NACK or a timeout on master m (Linux i2c-qcom-cci / Android cam_cci_halt): HALT_REQ
+ * (0x034) for that master, its HALT_ACK (status bit 25 + m), the master's own reset
+ * (RESET_CMD 0x3F1 for M0, 0x3F001 for M1), reset done, then its timings again; the global reset
+ * if any of that does not answer.
+ */
+static void
+cci_recover(unsigned m)
+{
+	wr(cci, 0x034, 1u << m);
+	bool halted = cci_wait(1u << (25 + m), 0, "halt");
+	cci_clear(0xffffffffu);
+	wr(cci, CCI_RESET_CMD, m == 0 ? 0x3F1u : 0x3F001u);
+	bool reset = cci_wait(CCI_RST_DONE, 0, "master reset");
+	wr(cci, CCI_IRQ_MASK0, 0x7FFF7FF7u);
+	wr(cci, CCI_IRQ_GCLEAR, 1);
+	cci_timings(m);
+	camlog("CCI m%u recovered: halt %s, master reset %s, queues %u/%u words", m, halted ? "acked" : "NOT acked",
+	    reset ? "done" : "NOT done", rd(cci, CCI_Q(m, 0) + 0x4), rd(cci, CCI_Q(m, 1) + 0x4));
+	if (!halted || !reset) {
+		(void)cci_reset();
+		camlog("CCI: global reset after it (irq mask %#x)", rd(cci, CCI_IRQ_MASK0));
+	}
+}
+
+static bool
+cci_init(void)
+{
+	for (unsigned i = 0; i < 4; i++) {
+		if (!pin_cfg(cci_pins[i], 1, 3, -1)) {
+			return false;
+		}
+	}
+	if (!cci_reset()) {
+		camlog("CCI: no reset acknowledge: stop");
+		return false;
+	}
+	camlog("CCI m1 timings readback: scl %#x sda0 %#x sda1 %#x sda2 %#x misc %#x", rd(cci, CCI_M(1) + 0x0),
+	    rd(cci, CCI_M(1) + 0x4), rd(cci, CCI_M(1) + 0x8), rd(cci, CCI_M(1) + 0xC), rd(cci, CCI_M(1) + 0x10));
+	camlog("CCI: reset, both masters at 400 kHz (cci clock 37.5 MHz), irq mask %#x", rd(cci, CCI_IRQ_MASK0));
+	return true;
+}
+
+static bool
+cci_run(unsigned m, unsigned q, uint32_t donebit, const char *what)
+{
+	wr(cci, CCI_Q(m, q) + 0x0, rd(cci, CCI_Q(m, q) + 0x4));    /* EXEC_WORD_CNT = CUR_WORD_CNT */
+	wr(cci, CCI_QUEUE_START, 1u << (m * 2 + q));
+	if (!cci_wait(donebit, m == 0 ? CCI_M0_ERROR : CCI_M1_ERROR, what)) {
+		camlog("CCI m%u q%u: cur words %u, cur cmd %#x, report status %#x, irq mask %#x, read level %u", m, q,
+		    rd(cci, CCI_Q(m, q) + 0x4), rd(cci, CCI_Q(m, q) + 0x8), rd(cci, CCI_Q(m, q) + 0xC), rd(cci, CCI_IRQ_MASK0),
+		    rd(cci, CCI_M(m) + 0x1C));
+		{
+			volatile uint32_t *sda = tlmm_pin(cci_pins[2 * m]), *scl = tlmm_pin(cci_pins[2 * m + 1]);
+			camlog("CCI m%u pins: SDA gpio%u ctl %#x level %u, SCL gpio%u ctl %#x level %u", m, cci_pins[2 * m],
+			    sda ? sda[0] : 0, sda ? (sda[1] & 1) : 9, cci_pins[2 * m + 1], scl ? scl[0] : 0, scl ? (scl[1] & 1) : 9);
+		}
+		cci_recover(m);
+		return false;
+	}
+	return true;
+}
+
+/* n bytes from a 16-bit register of the 7-bit address addr on master m (queue 1) */
+static bool
+cci_read_w(unsigned m, unsigned addr, unsigned reg, unsigned regw, uint8_t *buf, unsigned n)
+{
+	unsigned q = 1;
+	if (n == 0 || n > 16) {
+		return false;
+	}
+	wr(cci, CCI_Q(m, q) + 0x10, 0x1u | (addr & 0x7f) << 4 | 3u << 16);              /* SET_PARAM, 3 retries */
+	wr(cci, CCI_Q(m, q) + 0x10, 0x6u);                                               /* LOCK */
+	if (regw == 1) {
+		wr(cci, CCI_Q(m, q) + 0x10, 0xBu | 1u << 4 | (reg & 0xff) << 8);         /* WRITE_DISABLE_P, 8-bit register */
+	} else {
+		wr(cci, CCI_Q(m, q) + 0x10, 0xBu | 2u << 4 | ((reg >> 8) & 0xff) << 8 | (reg & 0xff) << 16);   /* WRITE_DISABLE_P */
+	}
+	wr(cci, CCI_Q(m, q) + 0x10, 0xAu | n << 4);                                      /* READ */
+	wr(cci, CCI_Q(m, q) + 0x10, 0x7u);                                               /* UNLOCK */
+	if (!cci_run(m, q, m == 0 ? 1u << 0 : 1u << 12, "read")) {
+		return false;
+	}
+	uint32_t words = rd(cci, CCI_M(m) + 0x1C), got = 0;
+	bool first = true;
+	for (uint32_t w = 0; w < words && w < 8; w++) {
+		uint32_t v = rd(cci, CCI_M(m) + 0x18);
+		for (int i = 0; i < 4; i++, v >>= 8) {
+			if (first) {
+				first = false;                  /* the slave address echo */
+				continue;
+			}
+			if (got < n) {
+				buf[got++] = (uint8_t)v;
+			}
+		}
+	}
+	if (got < n) {
+		camlog("CCI m%u %#x reg %#x: %u of %u bytes (%u words)", m, addr, reg, got, n, words);
+		return false;
+	}
+	return true;
+}
+
+static bool
+cci_read(unsigned m, unsigned addr, unsigned reg, uint8_t *buf, unsigned n)
+{
+	return cci_read_w(m, addr, reg, 2, buf, n);
+}
+
+/* n (1..2) bytes to a 16-bit register (queue 0) */
+static bool
+cci_write_w(unsigned m, unsigned addr, unsigned reg, unsigned regw, uint32_t val, unsigned n)
+{
+	unsigned q = 0;
+	uint8_t b[4] = { (uint8_t)(reg >> 8), (uint8_t)reg, 0, 0 };
+	unsigned o = 2;
+	if (regw == 1) {
+		b[0] = (uint8_t)reg;
+		o = 1;
+	}
+	if (n == 1) {
+		b[o] = (uint8_t)val;
+	} else {
+		b[o] = (uint8_t)(val >> 8);
+		b[o + 1] = (uint8_t)val;
+	}
+	unsigned len = o + n;
+	wr(cci, CCI_Q(m, q) + 0x10, 0x1u | (addr & 0x7f) << 4 | 3u << 16);
+	wr(cci, CCI_Q(m, q) + 0x10, 0x6u);                                               /* LOCK */
+	wr(cci, CCI_Q(m, q) + 0x10, 0x9u | len << 4 | (uint32_t)b[0] << 8 | (uint32_t)b[1] << 16 | (uint32_t)b[2] << 24);
+	if (len > 3) {
+		wr(cci, CCI_Q(m, q) + 0x10, b[3]);
+	}
+	wr(cci, CCI_Q(m, q) + 0x10, 0x7u);                                               /* UNLOCK */
+	wr(cci, CCI_Q(m, q) + 0x10, 0x8u | 1u << 8);                                     /* REPORT, IRQ */
+	return cci_run(m, q, m == 0 ? 1u << 4 : 1u << 16, "write");
+}
+
+static bool
+cci_write(unsigned m, unsigned addr, unsigned reg, uint32_t val, unsigned n)
+{
+	return cci_write_w(m, addr, reg, 2, val, n);
+}
+
+/* ---------------------------------------------------------------- the requests */
+
+static bool
+cam_map(void)
+{
+	if (gcc == 0) {
+		gcc_a = cam_io(GCC_PA + 0x17000, 0x1000);
+		gcc_b = cam_io(GCC_PA + 0x51000, 0x9000);
+		gcc_c = cam_io(GCC_PA + 0x7D000, 0x1000);
+		gcc = gcc_a && gcc_b && gcc_c ? gcc_b : 0;
+	}
+	return gcc != 0;
+}
+
+static bool cam_pool_map(void);
+
+static bool cam_premap(void);
+
+/* op 1 */
+static int
+camss_on(void)
+{
+	if (!cam_map()) {
+		camlog("GCC not mapped");
+		return EIO;
+	}
+	if (!cam_premap()) {
+		return EIO;
+	}
+	/* the always-on camera AHB/XO branches gcc-khaje turns on at probe (nobody does here) */
+	camlog("gcc_camera_ahb_clk %#x, gcc_camera_xo_clk %#x", gccr(0x17008), gccr(0x17028));
+	/* their CLK_OFF bit only clears once the camss domain is powered: enable now, check after the GDSC */
+	gccw(0x17008, gccr(0x17008) | 1);
+	gccw(0x17028, gccr(0x17028) | 1);
+	if (!gdsc_on()) {
+		return EIO;
+	}
+	if (!rcg_set("top_ahb 80 MHz", RCG_TOP_AHB, 0x10E) || !branch_on("top_ahb", CBCR_TOP_AHB) ||
+	    !rcg_set("axi 300 MHz", RCG_AXI, 0x201) || !branch_on("axi", CBCR_AXI) || !branch_on("rt_axi", CBCR_RT_AXI) ||
+	    !branch_on("nrt_axi", CBCR_NRT_AXI) || !rcg_set("cci_0 37.5 MHz", RCG_CCI, 0x20F) || !branch_on("cci_0", CBCR_CCI)) {
+		return EIO;
+	}
+	camlog("after the GDSC and top clocks: gcc_camera_ahb_clk %#x, gcc_camera_xo_clk %#x", gccr(0x17008),
+	    gccr(0x17028));
+	if (!branch_on("camera_ahb", 0x17008)) {
+		return EIO;
+	}
+	if (cci == 0) {
+		cci = cam_io(CCI_PA, 0x1000);
+		cpas = cam_io(CPAS_PA, 0x1000);
+	}
+	if (cci == 0 || cpas == 0) {
+		camlog("CCI/CPAS not mapped");
+		return EIO;
+	}
+	uint32_t cv = rd(cci, CCI_HW_VERSION);
+	camlog("CCI hw version %#x", cv);
+	if (cv == 0 || cv == 0xffffffffu) {
+		camlog("CCI version looks wrong: stop");
+		return EIO;
+	}
+	uint32_t p0 = rd(cpas, 0x0), p4 = rd(cpas, 0x4);
+	camlog("CPAS top +0 %#x, +4 %#x", p0, p4);
+	if ((p0 == 0 && p4 == 0) || p0 == 0xffffffffu) {
+		camlog("CPAS version looks wrong: stop");
+		return EIO;
+	}
+	if (!cci_init()) {
+		return EIO;
+	}
+	camss_up = true;
+	camlog("camss up");
+	return 0;
+}
+
+static bool
+mclk_on(unsigned slot)
+{
+	static const char *const names[4] = { "mclk0", "mclk1", "mclk2", "mclk3" };
+	return rcg_set(names[slot], rcg_mclk[slot], 0x001) && branch_on(names[slot], cbcr_mclk[slot]) &&
+	       pin_cfg(mclk_pin[slot], 1, 0, -1);
+}
+
+static bool
+avdd(int on) { return pmic_gpio(AVDD_SID, AVDD_BASE, on, 2, "AVDD PM6125 GPIO2"); }
+static bool
+dvdd(int on) { return pmic_gpio(DVDD_SID, DVDD_BASE, on, 3, "DVDD PM7250B GPIO3"); }
+
+/* the chip id (and its alternative for the front slot), then 16 bytes of the EEPROM */
+static int
+slot_probe(unsigned slot)
+{
+	static const struct { unsigned m, addr, reg, id; const char *name; unsigned reg2, id2; const char *name2; unsigned eeprom; } t[4] = {
+		{ 0, 0x10, 0x0000, 0x1AD6, "S5KHM6", 0, 0, NULL, 0x51 },
+		{ 1, 0x10, 0x300B, 0x1641, "OV16A1Q", 0x03F0, 0x16B3, "GC16B3C", 0x51 },
+		{ 1, 0x2D, 0x0000, 0x487B, "S5K4H7", 0, 0, NULL, 0x50 },
+		{ 0, 0x36, 0x3107, 0xEB52, "SC202PCS", 0, 0, NULL, 0x52 },
+	};
+	uint8_t b[16];
+	int r = ENODEV;
+	if (cci_read(t[slot].m, t[slot].addr, t[slot].reg, b, 2)) {
+		unsigned id = (unsigned)b[0] << 8 | b[1];
+		camlog("slot %u: m%u %#x reg %#06x = %#06x (%s %#06x)%s", slot, t[slot].m, t[slot].addr, t[slot].reg, id,
+		    t[slot].name, t[slot].id, id == t[slot].id ? ": FOUND" : "");
+		r = id == t[slot].id ? 0 : ENODEV;
+	}
+	if (r != 0 && t[slot].name2 != NULL && cci_read(t[slot].m, t[slot].addr, t[slot].reg2, b, 2)) {
+		unsigned id = (unsigned)b[0] << 8 | b[1];
+		camlog("slot %u: m%u %#x reg %#06x = %#06x (%s %#06x)%s", slot, t[slot].m, t[slot].addr, t[slot].reg2, id,
+		    t[slot].name2, t[slot].id2, id == t[slot].id2 ? ": FOUND" : "");
+		r = id == t[slot].id2 ? 0 : ENODEV;
+	}
+	if (cci_read(t[slot].m, t[slot].eeprom, 0x0000, b, 16)) {
+		camlog("slot %u: EEPROM m%u %#x @0: %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x",
+		    slot, t[slot].m, t[slot].eeprom, b[0], b[1], b[2], b[3], b[4], b[5], b[6], b[7], b[8], b[9], b[10], b[11],
+		    b[12], b[13], b[14], b[15]);
+	} else {
+		camlog("slot %u: EEPROM m%u %#x not readable", slot, t[slot].m, t[slot].eeprom);
+	}
+	return r;
+}
+
+/* ops 2..5: power slot 0..3 with its sensormodule powerUpSequence, then probe it */
+static int
+slot_on(unsigned slot)
+{
+	if (!camss_up) {
+		int r = camss_on();
+		if (r != 0) {
+			return r;
+		}
+	}
+	unsigned rst = reset_pin[slot];
+	bool ok = true;
+	camlog("slot %u: power-up", slot);
+	switch (slot) {
+	case 0:     /* S5KHM6: RESET 0 (1), VIO (1), VANA (1), VDIG (1), RESET 1 (5), MCLK (20) */
+		ok = pin_out(rst, 0); IOSleep(1);
+		ok = ok && pin_out(GPIO_VIO, 1); IOSleep(1);
+		ok = ok && pin_out(GPIO_MAIN_VANA, 1); IOSleep(1);
+		ok = ok && pin_out(GPIO_MAIN_VDIG, 1); IOSleep(1);
+		ok = ok && pin_out(GPIO_MAIN_VAF, 1); IOSleep(1);   /* 0287 */
+		af_ready = false;
+		af_pos = -1;
+		ok = ok && pin_out(rst, 1); IOSleep(5);
+		ok = ok && mclk_on(0); IOSleep(25);
+		break;
+	case 1:     /* OV16A1Q / GC16B3C: RESET 0 (2), AVDD, VIO, DVDD, MCLK (5), RESET 1 (5) */
+		ok = pin_out(rst, 0); IOSleep(2);
+		ok = ok && avdd(1);
+		ok = ok && pin_out(GPIO_VIO, 1);
+		ok = ok && dvdd(1);
+		ok = ok && mclk_on(1); IOSleep(5);
+		ok = ok && pin_out(rst, 1); IOSleep(10);
+		break;
+	case 2:     /* S5K4H7: RESET 0 (1), DVDD (1), AVDD (1), VIO (1), RESET 1 (5), MCLK (10) */
+		ok = pin_out(GPIO_CSI_MUX, 0);    /* 0276: CSIPHY1 to the ultra wide */
+		ok = ok && pin_out(rst, 0); IOSleep(1);
+		ok = ok && dvdd(1); IOSleep(1);
+		ok = ok && avdd(1); IOSleep(1);
+		ok = ok && pin_out(GPIO_VIO, 1); IOSleep(1);
+		ok = ok && pin_out(rst, 1); IOSleep(5);
+		ok = ok && mclk_on(2); IOSleep(15);
+		break;
+	case 3:     /* SC202PCS: RESET 0 (5), CSI mux GPIO34 1 (5), VIO (5), AVDD (5), RESET 1 (5), MCLK (5) */
+		ok = pin_out(rst, 0); IOSleep(5);
+		ok = ok && pin_out(GPIO_CSI_MUX, 1); IOSleep(5);
+		ok = ok && pin_out(GPIO_VIO, 1); IOSleep(5);
+		ok = ok && avdd(1); IOSleep(5);
+		ok = ok && pin_out(rst, 1); IOSleep(5);
+		ok = ok && mclk_on(3); IOSleep(10);
+		break;
+	}
+	if (!ok) {
+		camlog("slot %u: power-up stopped", slot);
+		return EIO;
+	}
+	int pr = slot_probe(slot);
+	slot_up[slot] = pr == 0;
+	return pr;
+}
+
+/* op 9: everything off, in reverse order */
+static void cam_stream_off_all(void);
+
+static int
+cam_off(void)
+{
+	if (!cam_map()) {
+		return EIO;
+	}
+	cam_stream_off_all();
+	for (int s = 3; s >= 0; s--) {
+		branch_off("mclk", cbcr_mclk[s]);
+		(void)pin_out(mclk_pin[s], 0);
+		(void)pin_out(reset_pin[s], 0);
+	}
+	(void)pin_out(GPIO_CSI_MUX, 0);
+	(void)pin_out(GPIO_MAIN_VAF, 0);
+	af_ready = false;
+	af_pos = -1;
+	(void)pin_out(GPIO_MAIN_VDIG, 0);
+	(void)pin_out(GPIO_MAIN_VANA, 0);
+	(void)dvdd(0);
+	(void)avdd(0);
+	(void)pin_out(GPIO_VIO, 0);
+	for (int s2 = 0; s2 < 4; s2++) {
+		slot_up[s2] = false;
+	}
+	cam_streaming = false;
+	cam_csid_up = false;
+	link_slot = -1;
+	if (camss_up) {
+		branch_off("cci_0", CBCR_CCI);
+		branch_off("nrt_axi", CBCR_NRT_AXI);
+		branch_off("rt_axi", CBCR_RT_AXI);
+		branch_off("axi", CBCR_AXI);
+		branch_off("top_ahb", CBCR_TOP_AHB);
+		camss_up = false;
+	}
+	gccw(GDSC_CAMSS, gccr(GDSC_CAMSS) | 1);   /* SW_COLLAPSE */
+	camlog("everything off (GDSC %#x)", gccr(GDSC_CAMSS));
+	return 0;
+}
+
+/* ================================================================ 0272: phases 2 and 3 */
+
+/*
+ * camera.md sections 5-11: the sensor's init/mode/stream tables over CCI (op 10), CSIPHY + PPI +
+ * CSID0 RDI0 with the packet counters (op 11, no DMA), TFE0 RDI0 + bus write master 7 into the
+ * frame pool through an identity SMMU bank (op 12), stop (op 13), the pool's pattern test (op 14);
+ * kern.sweet_cam_seek + kern.sweet_cam_frame hand the frame to user space in 1 MB pieces.
+ * kern.sweet_cam_arg: op 10: bits 0-3 slot (0 main S5KHM6, 2 ultra wide S5K4H7), bits 4-7 mode
+ * (HM6 0/1/4, 4H7 0); op 11: bits 8-15 the CSIPHY settle count (0: the sensor's own); op 14: 1
+ * checks the pattern without writing it.
+ */
+#include "sweet_cam_tables.h"
+
+extern void *topaz_map_wc(uint64_t pa, uint64_t size);                                  /* TopazModem.cpp */
+extern int topaz_smmu_identity(uint32_t sid, uint32_t mask, const char *name);         /* TopazModem.cpp */
+extern int topaz_rpm_ldo(uint32_t id, uint32_t uv, uint32_t ma, uint32_t set);         /* TopazModem.cpp */
+extern unsigned long gPhysBase, gPhysSize;
+
+#define CAM_POOL_PA     0xD7000000ull
+#define CAM_POOL_SIZE   0x09000000ull           /* 144 MB, to the modem pool at 0xE0000000 */
+#define CSIPHY_PA(n)    (0x05C52000u + 0x2000u * (n))
+#define PPI_PA          0x05CB3000u             /* PPI n at +0x200 n */
+#define CSID0_PA        0x05C6E000u             /* CSID0 at +0, TFE0 at +0x1000 */
+#define SMMU_PA         0x0C600000u
+#define TFE_SID         0x400
+
+
+/* ---------------------------------------------------------------- CCI batches (queue 0) */
+
+struct cci_batch {
+	unsigned m, addr, n, cmds;
+	uint32_t w[64];
+	bool checked;
+};
+
+static bool
+cci_flush(struct cci_batch *b)
+{
+	if (b->n == 0) {
+		return true;
+	}
+	unsigned m = b->m, q = 0;
+	wr(cci, CCI_Q(m, q) + 0x10, 0x1u | (b->addr & 0x7f) << 4 | 3u << 16);          /* SET_PARAM */
+	wr(cci, CCI_Q(m, q) + 0x10, 0x6u);                                               /* LOCK */
+	for (unsigned i = 0; i < b->n; i++) {
+		wr(cci, CCI_Q(m, q) + 0x10, b->w[i]);
+	}
+	wr(cci, CCI_Q(m, q) + 0x10, 0x7u);                                               /* UNLOCK */
+	wr(cci, CCI_Q(m, q) + 0x10, 0x8u | 1u << 8);                                     /* REPORT */
+	if (!b->checked) {
+		uint32_t cnt = rd(cci, CCI_Q(m, q) + 0x4);
+		camlog("CCI m%u q0: %u words loaded, CUR_WORD_CNT %u", m, b->n + 4, cnt);
+		if (cnt != b->n + 4) {
+			camlog("CCI queue 0 does not hold them: stop");
+			(void)cci_reset();
+			return false;
+		}
+		b->checked = true;
+	}
+	bool ok = cci_run(m, q, m == 0 ? 1u << 4 : 1u << 16, "batch write");
+	b->n = 0;
+	return ok;
+}
+
+/* one I2C write: cmd byte 0x9|len<<4, then len bytes (2 address bytes first), packed LE in words */
+static bool
+cci_put(struct cci_batch *b, const uint8_t *bytes, unsigned len)
+{
+	uint8_t c[12];
+	c[0] = (uint8_t)(0x9u | len << 4);
+	memcpy(c + 1, bytes, len);
+	unsigned words = (len + 1 + 3) / 4;
+	if (b->n + words > 58 && !cci_flush(b)) {   /* + SET_PARAM, LOCK, UNLOCK, REPORT <= 64 */
+		return false;
+	}
+	for (unsigned i = 0; i < words; i++) {
+		uint32_t v = 0;
+		for (unsigned j = 0; j < 4; j++) {
+			unsigned k = i * 4 + j;
+			v |= (uint32_t)(k < len + 1 ? c[k] : 0) << (8 * j);
+		}
+		b->w[b->n++] = v;
+	}
+	b->cmds++;
+	return true;
+}
+
+static int
+cam_replay(unsigned m, unsigned addr, const struct cam_reg *t, unsigned n, const char *name)
+{
+	struct cci_batch b;
+	unsigned bursts = 0, bbytes = 0, i = 0;
+	uint64_t t0 = mach_absolute_time(), ns;
+	bzero(&b, sizeof(b));
+	b.m = m;
+	b.addr = addr;
+	for (i = 0; i < n; i++) {
+		uint8_t x[11];
+		x[0] = (uint8_t)(t[i].addr >> 8);
+		x[1] = (uint8_t)t[i].addr;
+		if (t[i].blen != 0) {
+			/* a burst: auto-increment, so 9-byte pieces at addr + k */
+			for (unsigned k = 0; k < t[i].blen; k += 9) {
+				unsigned c = t[i].blen - k < 9 ? t[i].blen - k : 9;
+				unsigned a = t[i].addr + k;
+				x[0] = (uint8_t)(a >> 8);
+				x[1] = (uint8_t)a;
+				memcpy(x + 2, cam_burst + t[i].boff + k, c);
+				if (!cci_put(&b, x, 2 + c)) {
+					goto fail;
+				}
+			}
+			bursts++;
+			bbytes += t[i].blen;
+		} else if (t[i].dt == 2) {
+			x[2] = (uint8_t)(t[i].val >> 8);
+			x[3] = (uint8_t)t[i].val;
+			if (!cci_put(&b, x, 4)) {
+				goto fail;
+			}
+		} else {
+			x[2] = (uint8_t)t[i].val;
+			if (!cci_put(&b, x, 3)) {
+				goto fail;
+			}
+		}
+		if (t[i].delay_ms != 0) {
+			if (!cci_flush(&b)) {
+				goto fail;
+			}
+			IOSleep(t[i].delay_ms);
+		}
+	}
+	if (!cci_flush(&b)) {
+		goto fail;
+	}
+	absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
+	camlog("%s: %u entries (%u bursts, %u bytes), %u I2C writes, %llu ms", name, n, bursts, bbytes, b.cmds, ns / 1000000);
+	return 0;
+fail:
+	camlog("%s: stopped at entry %u of %u (%u I2C writes done)", name, i, n, b.cmds);
+	return EIO;
+}
+
+/* ---------------------------------------------------------------- op 10: sensor init, mode, stream on */
+
+/*
+ * 0278: the D-PHY sensors. CSID RX_CFG0 = (lanes-1) | lane_cfg << 4 | (csiphy+1) << 20; the macro
+ * uses one lane (CSIPHY1, the CSI mux GPIO34 high), the ultra wide CSIPHY1 with the mux low, the
+ * front CSIPHY2 (DT csiphy-sd-index).
+ */
+#define NT(a) (unsigned)(sizeof(a) / sizeof((a)[0]))
+static const struct cam_sdesc {
+	const char *name;
+	unsigned m, addr, idreg, id;
+	const struct cam_reg *init, *mode, *on, *off;
+	unsigned ni, nm, non, noff, w, h, phy, lanes, settle;
+	uint32_t rxcfg0;
+} sdesc[4] = {
+	[1] = { "OV16A1Q", 1, 0x10, 0x300B, 0x1641, ov_init, ov_mode0, ov_on, ov_off, NT(ov_init), NT(ov_mode0), NT(ov_on),
+		NT(ov_off), 2304, 1728, 2, 4, 0x0E, 0x00332103 },
+	[2] = { "S5K4H7", 1, 0x2D, 0x0000, 0x487B, h7_init, h7_mode0, h7_on, h7_off, NT(h7_init), NT(h7_mode0), NT(h7_on),
+		NT(h7_off), 3264, 2448, 1, 4, 0x0E, 0x00232103 },
+	[3] = { "SC202PCS", 0, 0x36, 0x3107, 0xEB52, sc_init, sc_mode0, sc_on, sc_off, NT(sc_init), NT(sc_mode0), NT(sc_on),
+		NT(sc_off), 1600, 1200, 1, 1, 0x14, 0x00200000 },
+};
+
+/* the current sensor's stream on/off table */
+static int
+cam_stream_onoff(bool on)
+{
+	if (cs.slot == 0) {
+		return on ? cam_replay(0, 0x10, hm6_on, NT(hm6_on), "HM6 stream on") :
+		       cam_replay(0, 0x10, hm6_off, NT(hm6_off), "HM6 stream off");
+	}
+	const struct cam_sdesc *d = &sdesc[cs.slot];
+	return on ? cam_replay(d->m, d->addr, d->on, d->non, "stream on") : cam_replay(d->m, d->addr, d->off, d->noff, "stream off");
+}
+
+static int hm6_switch(unsigned mode);
+
+static int
+cam_sensor_on(void)
+{
+	unsigned slot = (unsigned)cam_arg & 0xF, mode = ((unsigned)cam_arg >> 4) & 0xF;
+	uint8_t id[2];
+	int r;
+
+	if (!camss_up || slot > 3 || !slot_up[slot]) {
+		camlog("op 10: slot %u is not powered (op 2..5 first)", slot);
+		return EAGAIN;
+	}
+	if (slot == 0) {
+		r = hm6_switch(mode);
+		cam_frame_off = 0;
+		return r;
+	} else {
+		const struct cam_sdesc *d = &sdesc[slot];
+		if (mode != 0) {
+			camlog("op 10: %s mode %u not built in (0)", d->name, mode);
+			return EINVAL;
+		}
+		cs.w = d->w; cs.h = d->h; cs.phy = d->phy; cs.cphy = false; cs.settle = d->settle; cs.lanes = d->lanes;
+		cs.rxcfg0 = d->rxcfg0;
+		if (!cci_read(d->m, d->addr, d->idreg, id, 2) || (unsigned)(id[0] << 8 | id[1]) != d->id) {
+			camlog("op 10: no %s at m%u %#x: stop", d->name, d->m, d->addr);
+			return ENODEV;
+		}
+		r = cam_replay(d->m, d->addr, d->init, d->ni, "init");
+		r = r ? r : cam_replay(d->m, d->addr, d->mode, d->nm, "mode 0");
+		r = r ? r : cam_replay(d->m, d->addr, d->on, d->non, "stream on");
+	}
+	cs.slot = slot;
+	cs.mode = mode;
+	cam_streaming = r == 0;
+	camlog("op 10: slot %u mode %u (%ux%u RAW10, %u bytes a frame): %s", slot, mode, cs.w, cs.h, cs.w * cs.h * 10 / 8,
+	    r == 0 ? "streaming" : "FAILED");
+	return r;
+}
+
+/* ---------------------------------------------------------------- op 11: CSIPHY, PPI, CSID0 RDI0 */
+
+static void
+phy_w(uint32_t off, uint32_t v, unsigned delay_ms)
+{
+	wr(cam_phy, off, v);
+	if (delay_ms) {
+		IOSleep(delay_ms);
+	}
+}
+
+static void
+phy_dphy_lane(uint32_t blk, uint32_t hi, unsigned settle)
+{
+	/* lane block blk (0x000/0x200/0x400/0x600), its 0x9xx-style registers at hi (0x900/0xA00/0xB00/0xC00) */
+	phy_w(blk + 0x030, 0x00, 0); phy_w(hi + 0x00, 0x05, 0); phy_w(hi + 0x08, 0x10, 0); phy_w(hi + 0x04, 0x00, 0);
+	phy_w(hi + 0x04, 0x07, 0); phy_w(blk + 0x004, 0x0C, 0); phy_w(blk + 0x02C, 0x01, 0); phy_w(blk + 0x034, 0x07, 0);
+	phy_w(blk + 0x010, 0x02, 0); phy_w(blk + 0x01C, 0x08, 0); phy_w(blk + 0x03C, 0xB8, 0); phy_w(blk + 0x008, settle, 0);
+	phy_w(blk + 0x000, 0x8D, 0); phy_w(blk + 0x038, 0xFE, 0); phy_w(blk + 0x014, 0x80, 0); phy_w(0x800, 0x02, 0);
+	phy_w(0x884, 0x01, 0);
+}
+
+static void
+phy_cphy_trio(uint32_t lo, uint32_t hi, unsigned settle)
+{
+	/* trio: 0x1xx registers at lo (0x100/0x300/0x500), 0x9xx at hi (0x900/0xA00/0xB00) */
+	phy_w(hi + 0x90, 0x00, 0); phy_w(hi + 0x94, 0x00, 0); phy_w(hi + 0x98, 0x00, 0); phy_w(hi + 0x90, 0x08, 0);
+	phy_w(hi + 0x94, 0x08, 0); phy_w(hi + 0x98, 0x1A, 0); phy_w(hi + 0x8C, 0xAF, 1);
+	phy_w(lo + 0x5C, 0x46, 0); phy_w(lo + 0x68, 0xA0, 0); phy_w(lo + 0x04, 0x06, 0); phy_w(lo + 0x0C, settle & 0xff, 0);
+	phy_w(lo + 0x08, (settle >> 8) & 0xff, 0); phy_w(lo + 0x14, 0x20, 0); phy_w(lo + 0x50, 0x00, 0);
+	phy_w(lo + 0x88, 0x00, 0); phy_w(lo + 0x8C, 0x7F, 0); phy_w(lo + 0x90, 0x7F, 0); phy_w(lo + 0x18, 0x3E, 0);
+	phy_w(lo + 0x1C, 0x41, 0); phy_w(lo + 0x20, 0x41, 0); phy_w(lo + 0x24, 0x7F, 0); phy_w(lo + 0x28, 0x00, 0);
+	phy_w(lo + 0x2C, 0x00, 0); phy_w(lo + 0x60, 0x02, 0); phy_w(lo + 0xCC, 0x41, 0); phy_w(lo + 0xDC, 0x50, 0);
+	phy_w(hi + 0x84, 0x20, 0); phy_w(hi + 0x88, 0x05, 0); phy_w(hi + 0x80, 0x60, 0); phy_w(hi + 0xAC, 0x35, 0);
+	phy_w(hi + 0xB0, 0x01, 0); phy_w(0x800, 0x0E, 0); phy_w(0x884, 0x01, 0);
+}
+
+static void
+phy_status(const char *when)
+{
+	uint32_t v[11];
+	for (unsigned i = 0; i < 11; i++) {
+		v[i] = rd(cam_phy, 0x8B0 + 4 * i);
+	}
+	camlog("CSIPHY%u status %s: %x %x %x %x %x %x %x %x %x %x %x", cs.phy, when, v[0], v[1], v[2], v[3], v[4], v[5], v[6],
+	    v[7], v[8], v[9], v[10]);
+	for (unsigned i = 0; i < 11; i++) {
+		wr(cam_phy, 0x858 + 4 * i, v[i]);
+	}
+	wr(cam_phy, 0x828, 1);
+	wr(cam_phy, 0x828, 0);
+}
+
+static void
+csid_counters(const char *when)
+{
+	uint32_t rx = rd(cam_csid, 0x020), rdi = rd(cam_csid, 0x040);
+	camlog("CSID %s: packets %u, ECC %u, CRC %u; rx irq %#x, rdi0 irq %#x (SOF %u EOF %u ovf %u), rdi0 bytes %u/%u, rdi0 status %#x",
+	    when, rd(cam_csid, 0x160), rd(cam_csid, 0x164), rd(cam_csid, 0x168), rx, rdi, (rdi >> 12) & 1, (rdi >> 9) & 1,
+	    (rdi >> 2) & 1, rd(cam_csid, 0x3E0), rd(cam_csid, 0x3E4), rd(cam_csid, 0x350));
+	wr(cam_csid, 0x028, rx);
+	wr(cam_csid, 0x048, rdi);
+	wr(cam_csid, 0x080, 1);
+}
+
+static int
+cam_link_on(void)
+{
+	unsigned n;
+	if (!cam_streaming) {
+		camlog("op 11: no stream (op 10 first)");
+		return EAGAIN;
+	}
+	n = cs.phy;
+	unsigned settle = ((unsigned)cam_arg >> 8) & 0xff;
+	settle = settle != 0 ? settle : cs.settle;
+	int l4 = topaz_rpm_ldo(4, 880000, 100, 0), l18 = topaz_rpm_ldo(18, 1232000, 100, 0);
+	camlog("CSIPHY rails: RPM ldoa4 0.88 V %d, ldoa18 1.232 V %d (0: taken)", l4, l18);
+	if (l4 != 0 || l18 != 0) {
+		return EIO;
+	}
+	static const uint32_t cbcr_cphy[3] = { 0x52088u, 0x5208Cu, 0x52090u };
+	if (!rcg_set("tfe_cphy_rx 300 MHz", 0x52064u, 0x103) || !branch_on("cphy", cbcr_cphy[n]) ||
+	    !rcg_set("csiphytimer 300 MHz", 0x59000u + 0x1Cu * n, 0x201) || !branch_on("csiphytimer", 0x59018u + 0x1Cu * n) ||
+	    !rcg_set("tfe_0_csid 300 MHz", 0x52094u, 0x103) || !branch_on("tfe_0_csid", 0x520ACu) ||
+	    !branch_on("tfe_0_cphy_rx", 0x5207Cu) || !rcg_set("tfe_0 300 MHz", 0x52004u, 0x103) ||
+	    !branch_on("tfe_0", 0x5201Cu)) {
+		return EIO;
+	}
+	cam_phy = cam_phys[n];                          /* 0279: mapped once at op 1 */
+	if (cam_phy == 0 || cam_ppi == 0 || cam_csid == 0) {
+		camlog("CSIPHY/PPI/CSID not mapped");
+		return EIO;
+	}
+	camlog("CSIPHY%u: %s %u %s, settle %#x", n, cs.cphy ? "C-PHY" : "D-PHY", cs.lanes, cs.cphy ? "trios" : "lanes + clock", settle);
+	/* reset, common */
+	phy_w(0x814, 0x00, 5); phy_w(0x818, 0x00, 0); phy_w(0x81C, 0x00, 0); phy_w(0x800, 0x01, 1); phy_w(0x800, 0x00, 0);
+	if (cs.cphy) {
+		phy_w(0x814, 0x2A, 0); phy_w(0x818, 0x01, 0); phy_w(0x81C, 0x52, 0); phy_w(0x800, 0x03, 1); phy_w(0x800, 0x0E, 0);
+		phy_cphy_trio(0x100, 0x900, settle);
+		phy_cphy_trio(0x300, 0xA00, settle);
+		phy_cphy_trio(0x500, 0xB00, settle);
+		/* data rate <= 10.26 Gbps */
+		phy_w(0x9B4, 0x02, 1); phy_w(0xAB4, 0x02, 1); phy_w(0xBB4, 0x02, 1);
+		for (uint32_t lo = 0x100; lo <= 0x500; lo += 0x200) {
+			phy_w(lo + 0x44, 0xB2, 0); phy_w(lo + 0x64, 0x33, 0); phy_w(lo + 0x6C, 0x25, 0);
+		}
+	} else {
+		phy_w(0x814, cs.lanes == 1 ? 0x81 : 0xD5, 0); phy_w(0x818, 0x01, 0); phy_w(0x81C, 0x02, 0); phy_w(0x800, 0x03, 1); phy_w(0x800, 0x02, 0);
+		phy_dphy_lane(0x000, 0x900, settle);
+		/* clock lane */
+		phy_w(0x730, 0x00, 0); phy_w(0xC80, 0x05, 0); phy_w(0xC88, 0x10, 0); phy_w(0xC84, 0x00, 0); phy_w(0xC84, 0x07, 0);
+		phy_w(0x704, 0x0C, 0); phy_w(0x72C, 0x01, 0); phy_w(0x734, 0x07, 0); phy_w(0x710, 0x02, 0); phy_w(0x71C, 0x08, 0);
+		phy_w(0x73C, 0xB8, 0); phy_w(0x708, settle, 0); phy_w(0x700, 0x80, 0); phy_w(0x70C, 0xA5, 0); phy_w(0x738, 0x1F, 0);
+		phy_w(0x714, 0x80, 0); phy_w(0x728, 0x04, 0); phy_w(0x800, 0x02, 0); phy_w(0x884, 0x01, 0);
+		if (cs.lanes == 4) {
+			phy_dphy_lane(0x200, 0xA00, settle);
+			phy_dphy_lane(0x400, 0xB00, settle);
+			phy_dphy_lane(0x600, 0xC00, settle);
+		}
+	}
+	static const uint8_t irqm[11] = { 0xFF, 0xFF, 0xFB, 0xFF, 0x7F, 0xFF, 0xFF, 0xEF, 0xFF, 0xFF, 0xFF };
+	for (unsigned i = 0; i < 11; i++) {
+		phy_w(0x82C + 4 * i, irqm[i], 0);
+	}
+	phy_status("after config");
+
+	/* PPI n */
+	vm_offset_t p = cam_ppi + 0x200u * n;
+	camlog("PPI%u hw version %#x", n, rd(p, 0x00));
+	wr(p, 0x6C, 0); wr(p, 0x70, 1); wr(p, 0x7C, 1); wr(p, 0x78, 2);
+	bool rst = false;
+	for (int i = 0; i < 100 && !rst; i++) {
+		rst = (rd(p, 0x68) & 1) != 0;
+		if (!rst) {
+			IODelay(100);
+		}
+	}
+	wr(p, 0x74, 1); wr(p, 0x78, 1);
+	wr(p, 0x6C, 0x0E); wr(p, 0x74, 1); wr(p, 0x78, 1); wr(p, 0x60, cs.cphy ? 0x73 : 0x70);
+	camlog("PPI%u: reset %s, module cfg %#x", n, rst ? "done" : "NOT acknowledged", rd(p, 0x60));
+
+	/* CSID0 */
+	camlog("CSID0 hw version %#x", rd(cam_csid, 0x000));
+	wr(cam_csid, 0x074, 0); wr(cam_csid, 0x078, 1); wr(cam_csid, 0x080, 1); wr(cam_csid, 0x010, 0x1E);
+	rst = false;
+	for (int i = 0; i < 1000 && !rst; i++) {
+		rst = (rd(cam_csid, 0x070) & 1) != 0;
+		if (!rst) {
+			IODelay(100);
+		}
+	}
+	wr(cam_csid, 0x078, 1); wr(cam_csid, 0x080, 1);
+	if (!rst) {
+		camlog("CSID0: no reset done in 100 ms (top irq %#x): stop", rd(cam_csid, 0x070));
+		return EIO;
+	}
+	wr(cam_csid, 0x028, 0x0FFFFFFF); wr(cam_csid, 0x048, 0x3FFFF); wr(cam_csid, 0x080, 1);
+	uint32_t cfg0 = cs.rxcfg0;
+	wr(cam_csid, 0x100, cfg0);
+	wr(cam_csid, 0x104, 0x41);
+	wr(cam_csid, 0x024, 0x09BFB8FF);
+	wr(cam_csid, 0x300, 0x002BF005); wr(cam_csid, 0x304, 0x2); wr(cam_csid, 0x3B0, 0x9); wr(cam_csid, 0x308, 0);
+	wr(cam_csid, 0x300, 0x802BF005);
+	wr(cam_csid, 0x108, 1);                         /* capture the first long packet */
+	wr(cam_csid, 0x308, 1);
+	wr(cam_csid, 0x044, 0x61206);
+	camlog("CSID0: rx cfg0 %#x cfg1 %#x, RDI0 cfg0 %#x, resumed", rd(cam_csid, 0x100), rd(cam_csid, 0x104), rd(cam_csid, 0x300));
+	cam_csid_up = true;
+	/*
+	 * 0278: the sensor started streaming (op 10) before the PHY was set up; a D-PHY receiver has to
+	 * see the clock lane's LP-11 -> HS start, so the stream is restarted now (Android: PHY first).
+	 */
+	int rs = cam_stream_onoff(false);
+	IOSleep(10);
+	rs = rs ? rs : cam_stream_onoff(true);
+	camlog("sensor stream restarted after the receiver: %d", rs);
+	for (int i = 0; i < 5; i++) {
+		IOSleep(100);
+		csid_counters(i == 0 ? "+100 ms" : i == 4 ? "+500 ms" : "...");
+	}
+	camlog("CSID0 long packet: %#x %#x %#x (word count = bytes a line: %u expected)", rd(cam_csid, 0x130),
+	    rd(cam_csid, 0x134), rd(cam_csid, 0x138), cs.w * 10 / 8);
+	phy_status("streaming");
+	return 0;
+}
+
+/* ---------------------------------------------------------------- op 12: TFE0 RDI0 + WM7, one frame */
+
+static void
+cam_smmu_report(const char *when)
+{
+	if (cam_smmu == 0) {
+		cam_smmu = cam_io(SMMU_PA, 0x80000);
+	}
+	if (cam_smmu == 0) {
+		return;
+	}
+	uint32_t id0 = rd(cam_smmu, 0x20), id1 = rd(cam_smmu, 0x24), nsmr = id0 & 0xFF;
+	uint32_t psize = (id1 & (1u << 31)) ? 0x10000 : 0x1000, npage = 1u << (((id1 >> 28) & 7) + 1);
+	for (uint32_t i = 0; i < nsmr && i < 128; i++) {
+		uint32_t smr = rd(cam_smmu, 0x800 + 4 * i);
+		if ((smr >> 31) != 0 && (smr & 0x7FFF) == TFE_SID) {
+			uint32_t s2cr = rd(cam_smmu, 0xC00 + 4 * i), cb = s2cr & 0x3F;
+			vm_offset_t cbp = cam_smmu + (vm_offset_t)npage * psize + (vm_offset_t)cb * psize;
+			if ((uint64_t)(npage + cb + 1) * psize > 0x80000) {
+				return;
+			}
+			camlog("SMMU %s: SMR%u %#x S2CR %#x CB%u SCTLR %#x FSR %#x FAR %#x%08x", when, i, smr, s2cr, cb, rd(cbp, 0x0),
+			    rd(cbp, 0x58), rd(cbp, 0x64), rd(cbp, 0x60));
+			return;
+		}
+	}
+	camlog("SMMU %s: no SMR for stream %#x", when, TFE_SID);
+}
+
+static bool
+cam_pool_map(void)
+{
+	if (cam_pool != NULL) {
+		return true;
+	}
+	if (CAM_POOL_PA < gPhysBase + gPhysSize && CAM_POOL_PA + CAM_POOL_SIZE > gPhysBase) {
+		camlog("pool %llx-%llx overlaps kernel RAM %lx-%lx: stop", CAM_POOL_PA, CAM_POOL_PA + CAM_POOL_SIZE, gPhysBase,
+		    gPhysBase + gPhysSize);
+		return false;
+	}
+	cam_pool = (uint8_t *)topaz_map_wc(CAM_POOL_PA, CAM_POOL_SIZE);
+	camlog("pool %llx-%llx (kernel RAM %lx-%lx): %s", CAM_POOL_PA, CAM_POOL_PA + CAM_POOL_SIZE, gPhysBase,
+	    gPhysBase + gPhysSize, cam_pool ? "mapped write-combined" : "NOT mapped");
+	return cam_pool != NULL;
+}
+
+static int __attribute__((unused))
+cam_capture(void)
+{
+	uint32_t bytes = cs.w * cs.h * 10 / 8;
+	if (!cam_csid_up) {
+		camlog("op 12: CSID not up (op 11 first)");
+		return EAGAIN;
+	}
+	if (!cam_pool_map() || bytes > CAM_POOL_SIZE) {
+		return ENOMEM;
+	}
+	memset(cam_pool, 0xA5, 4096);
+	memset(cam_pool + bytes - 4096, 0xA5, 4096);
+	__asm__ volatile ("dsb sy" ::: "memory");
+	cam_smmu_report("before");
+	if (!topaz_smmu_identity(TFE_SID, 0, "TFE")) {
+		camlog("op 12: the TFE's identity bank did not read back: stop");
+		return EIO;
+	}
+	cam_smmu_report("identity");
+	vm_offset_t t = cam_csid;
+	wr(t, 0x308, 0);                                /* RDI0 halt at the frame boundary while the TFE is set up */
+	camlog("TFE0 hw version %#x", rd(t, 0x1000));
+	wr(t, 0x1034, 0xFFFFFFFF); wr(t, 0x1038, 0xFFFFFFFF); wr(t, 0x103C, 0xFFFFFFFF);
+	wr(t, 0x1040, 0xFFFFFFFF); wr(t, 0x1044, 0xFFFFFFFF); wr(t, 0x1048, 0xFFFFFFFF); wr(t, 0x1030, 1);
+	wr(t, 0x1A18, 0xFFFFFFFF); wr(t, 0x1A1C, 0xFFFFFFFF);
+	wr(t, 0x1A20, 0xFFFFFFFF); wr(t, 0x1A24, 0xFFFFFFFF); wr(t, 0x1A30, 1);
+	/* write master 7 (RDI0), frame mode: packed RAW10 back to back */
+	wr(t, 0x231C, 0xF);
+	wr(t, 0x230C, 0x0000FFFF);
+	wr(t, 0x2318, 0xA);
+	wr(t, 0x2314, 0xFFFF);
+	wr(t, 0x2304, (uint32_t)CAM_POOL_PA);
+	wr(t, 0x2308, bytes);
+	wr(t, 0x2338, 0);
+	wr(t, 0x233C, 1);
+	wr(t, 0x2300, 0x00010001);
+	wr(t, 0x1460, 0x1);
+	wr(t, 0x1470, 0x00140014);
+	wr(t, 0x102C, 0x2);                             /* reg update: RDI0 */
+	camlog("TFE0: WM7 cfg %#x addr %#x size %u, RDI0 cfg %#x", rd(t, 0x2300), rd(t, 0x2304), rd(t, 0x2308), rd(t, 0x1460));
+	wr(t, 0x308, 1);                                /* RDI0 resume */
+	uint64_t t0 = mach_absolute_time(), ns = 0;
+	uint32_t last0 = 0, last1 = 0, b0 = 0, b1 = 0, logs = 0;
+	bool eof = false, done = false;
+	while (!done) {
+		uint32_t s0 = rd(t, 0x104C), s1 = rd(t, 0x1050), rdi = rd(t, 0x040);
+		b0 = rd(t, 0x1A28); b1 = rd(t, 0x1A2C);
+		if ((s0 != last0 || s1 != last1 || b0 != 0 || b1 != 0) && logs < 12) {
+			camlog("TFE top %#x %#x %#x, bus %#x %#x, overflow %#x, size violation %#x, rdi0 irq %#x", s0, s1,
+			    rd(t, 0x1054), b0, b1, rd(t, 0x1A68), rd(t, 0x1A70), rdi);
+			logs++;
+			last0 = s0;
+			last1 = s1;
+		}
+		if (s0 | s1) {
+			wr(t, 0x1040, s0); wr(t, 0x1044, s1); wr(t, 0x1030, 1);
+		}
+		if (b0 | b1) {
+			wr(t, 0x1A20, b0); wr(t, 0x1A24, b1); wr(t, 0x1A30, 1);
+		}
+		eof |= (rdi & (1u << 9)) != 0;
+		if (rdi) {
+			wr(t, 0x048, rdi); wr(t, 0x080, 1);
+		}
+		absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
+		done = (eof && (b0 | b1) != 0) || ns > 3000000000ull;
+		if (!done) {
+			IOSleep(2);
+		}
+	}
+	wr(t, 0x308, 0);                                /* halt the RDI at the frame boundary */
+	IOSleep(cs.w > 4000 ? 200 : 50);
+	wr(t, 0x2300, 0);
+	wr(t, 0x102C, 0x2);
+	__asm__ volatile ("dsb sy" ::: "memory");
+	unsigned changed = 0, tail = 0;
+	for (unsigned i = 0; i < 4096; i++) {
+		changed += cam_pool[i] != 0xA5;
+		tail += cam_pool[bytes - 4096 + i] != 0xA5;
+	}
+	camlog("frame: %s after %llu ms; WM7 addr status %#x; first 4 KB %u bytes written, last 4 KB %u", eof ? "EOF" : "NO EOF",
+	    ns / 1000000, rd(t, 0x2368), changed, tail);
+	camlog("frame +0: %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x", cam_pool[0],
+	    cam_pool[1], cam_pool[2], cam_pool[3], cam_pool[4], cam_pool[5], cam_pool[6], cam_pool[7], cam_pool[8], cam_pool[9],
+	    cam_pool[10], cam_pool[11], cam_pool[12], cam_pool[13], cam_pool[14], cam_pool[15]);
+	cam_smmu_report("after");
+	cam_frame_len = changed != 0 ? bytes : 0;
+	cam_seek = 0;
+	camlog("op 12: %s (%u bytes in kern.sweet_cam_frame)", changed ? "FRAME CAPTURED" : "nothing written", cam_frame_len);
+	return changed ? 0 : EIO;
+}
+
+/* ---------------------------------------------------------------- op 13: stop */
+
+static int
+cam_stop(void)
+{
+	if (cam_csid != 0 && cam_csid_up) {
+		wr(cam_csid, 0x308, 0);
+		wr(cam_csid, 0x2300, 0);
+		wr(cam_csid, 0x102C, 0x2);
+		csid_counters("at stop");
+		cam_csid_up = false;
+	}
+	if (cam_streaming) {
+		int r = cam_stream_onoff(false);
+		cam_streaming = false;
+		camlog("op 13: stream off %d", r);
+	}
+	return 0;
+}
+
+/* ---------------------------------------------------------------- op 14: the pool's pattern test */
+
+static int
+cam_pool_test(void)
+{
+	if (!cam_pool_map()) {
+		return ENOMEM;
+	}
+	volatile uint64_t *p = (volatile uint64_t *)(void *)cam_pool;
+	uint64_t n = CAM_POOL_SIZE / 8, bad = 0, first = ~0ull, got = 0, want = 0;
+	bool write = cam_arg != 1;
+	uint64_t t0 = mach_absolute_time(), ns;
+	if (write) {
+		for (uint64_t i = 0; i < n; i++) {
+			uint64_t pa = CAM_POOL_PA + i * 8;
+			p[i] = pa ^ 0xA5A55A5A00000000ull ^ (pa << 32);
+		}
+		__asm__ volatile ("dsb sy" ::: "memory");
+	}
+	for (uint64_t i = 0; i < n; i++) {
+		uint64_t pa = CAM_POOL_PA + i * 8, w = pa ^ 0xA5A55A5A00000000ull ^ (pa << 32), v = p[i];
+		if (v != w) {
+			if (bad++ == 0) {
+				first = pa;
+				got = v;
+				want = w;
+			}
+		}
+	}
+	absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
+	if (bad == 0) {
+		camlog("pool test (%s): 144 MB match the pattern (%llu ms)", write ? "written + read back" : "read back only", ns / 1000000);
+	} else {
+		camlog("pool test (%s): %llu mismatching words, the first at %#llx: %#llx, expected %#llx (%llu ms)",
+		    write ? "written + read back" : "read back only", bad, first, got, want, ns / 1000000);
+	}
+	cam_frame_len = 0;
+	return bad == 0 ? 0 : EIO;
+}
+
+/* ---------------------------------------------------------------- the frame for user space */
+
+static int
+sysctl_sweet_cam_frame SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	if (req->newptr != USER_ADDR_NULL) {
+		return EPERM;
+	}
+	lck_mtx_lock(&sweet_cam_mtx);
+	int err = 0;
+	if (cam_pool == NULL || cam_frame_len == 0) {
+		err = ENOENT;
+	} else if (cam_seek < 0 || cam_seek >= (int64_t)cam_frame_len) {
+		err = 0;                                /* the end: nothing more */
+	} else {
+		uint32_t n = cam_frame_len - (uint32_t)cam_seek;
+		n = n > (1u << 20) ? (1u << 20) : n;
+		err = SYSCTL_OUT(req, cam_pool + cam_frame_off + cam_seek, n);
+		if (err == 0 && req->oldptr != USER_ADDR_NULL) {
+			cam_seek += n;
+		}
+	}
+	lck_mtx_unlock(&sweet_cam_mtx);
+	return err;
+}
+
+SYSCTL_PROC(_kern, OID_AUTO, sweet_cam_frame, CTLTYPE_OPAQUE | CTLFLAG_RD | CTLFLAG_LOCKED,
+    0, 0, sysctl_sweet_cam_frame, "S", "the captured frame: up to 1 MB from kern.sweet_cam_seek, which advances");
+SYSCTL_QUAD(_kern, OID_AUTO, sweet_cam_seek, CTLFLAG_RW | CTLFLAG_LOCKED, &cam_seek, "offset of the next kern.sweet_cam_frame read");
+SYSCTL_UINT(_kern, OID_AUTO, sweet_cam_frame_len, CTLFLAG_RD | CTLFLAG_LOCKED, &cam_frame_len, 0, "bytes in the captured frame");
+SYSCTL_INT(_kern, OID_AUTO, sweet_cam_arg, CTLFLAG_RW | CTLFLAG_LOCKED, &cam_arg, 0,
+    "argument of the camera ops (op 10: slot | mode << 4; op 11: settle << 8; op 14: 1 = check only)");
+
+/* ================================================================ 0274: op 12 in stages */
+
+/*
+ * 0273's op 12 took the phone down at once (no log). Now four ops, each logging before every
+ * risky access and writing the console log to the partition first (sweet_log_sync()), so the
+ * last line read back from recovery names the step:
+ *   20 SMMU only: a stage-1 bank for stream 0x400 that maps only the frame pool (2 MB blocks,
+ *      identity), so a stray TFE write faults and is terminated (no stall) instead of landing
+ *      anywhere; nothing in the camera is touched.
+ *   21 TFE registers read only (hw version, top/bus status, WM7).
+ *   22 WM7 + TFE RDI0 written, nothing enabled; read back.
+ *   23 enable + one frame, the SMMU fault status polled throughout (any fault: everything
+ *      stops at once).
+ * op 12 now only says to use these.
+ */
+extern void sweet_log_sync(unsigned max_ms);     /* bsd/dev/sweet_ufs.c */
+
+#define CAM_TBL_PA      (CAM_POOL_PA + CAM_POOL_SIZE - 0x2000)   /* level 1 + level 2, in the pool's last 2 MB block */
+#define CAM_MAP_END     (CAM_POOL_PA + CAM_POOL_SIZE - 0x200000) /* mapped for the TFE: the pool but its last 2 MB */
+
+static vm_offset_t s_cbp;                       /* the bank op 20 programmed */
+static bool s_ready, w_ready;
+static void smmu_fsr_clear(const char *when);
+
+static void
+step(const char *fmt, ...)
+{
+	char line[200];
+	va_list ap;
+	va_start(ap, fmt);
+	(void)vsnprintf(line, sizeof(line), fmt, ap);
+	va_end(ap);
+	camlog("step: %s", line);
+	sweet_log_sync(500);
+}
+
+/* op 20 */
+static int
+cam_smmu_stage(void)
+{
+	if (!cam_pool_map()) {
+		return ENOMEM;
+	}
+	if (cam_smmu == 0) {
+		step("mapping the apps SMMU %#x (0x80000)", SMMU_PA);
+		cam_smmu = cam_io(SMMU_PA, 0x80000);
+	}
+	if (cam_smmu == 0 || !cam_map()) {
+		return EIO;
+	}
+	vm_offset_t s = cam_smmu;
+	step("reading the SMMU's ID and global state");
+	uint32_t id0 = rd(s, 0x20), id1 = rd(s, 0x24), nsmr = id0 & 0xFF, ncb = id1 & 0xFF;
+	uint32_t psize = (id1 & (1u << 31)) ? 0x10000 : 0x1000, npage = 1u << (((id1 >> 28) & 7) + 1);
+	camlog("SMMU %#x: sCR0 %#x ID0 %#x ID1 %#x: %u SMRs, %u banks, page %#x x %u; sGFSR %#x", SMMU_PA, rd(s, 0x0), id0, id1,
+	    nsmr, ncb, psize, npage, rd(s, 0x48));
+	camlog("GCC hlos1_vote_mm_snoc_mmu_tbu_rt_gdsc (0x147d074, the TBU of streams 0x400-0x7ff) %#x", gccr(0x7D074));
+	uint32_t slot = ~0u, cb = ~0u, valid = 0;
+	uint64_t used = 0;
+	for (uint32_t i = 0; i < nsmr && i < 128; i++) {
+		uint32_t smr = rd(s, 0x800 + 4 * i), s2cr = rd(s, 0xC00 + 4 * i);
+		if ((smr >> 31) == 0) {
+			if (slot == ~0u) {
+				slot = i;
+			}
+			continue;
+		}
+		valid++;
+		if (((s2cr >> 16) & 3) == 0) {
+			used |= 1ull << (s2cr & 0x3F);
+		}
+		camlog("SMR%u %#x (id %#x mask %#x) S2CR %#x (type %u, bank %u)", i, smr, smr & 0x7FFF, (smr >> 16) & 0x7FFF, s2cr,
+		    (s2cr >> 16) & 3, s2cr & 0x3F);
+		if ((smr & 0x7FFF) == TFE_SID) {
+			slot = i;
+		}
+	}
+	for (uint32_t i = 4; i < ncb && i < 64 && cb == ~0u; i++) {
+		if ((used & (1ull << i)) == 0) {
+			cb = i;
+		}
+	}
+	if (slot == ~0u || cb == ~0u || (uint64_t)(npage + cb + 1) * psize > 0x80000) {
+		camlog("SMMU: no free SMR/bank (slot %u bank %u): stop", slot, cb);
+		return EIO;
+	}
+	vm_offset_t gr1 = s + psize, cbp = s + (vm_offset_t)npage * psize + (vm_offset_t)cb * psize;
+	camlog("SMMU: %u valid SMRs; taking SMR%u and bank %u (no valid SMR points at it): SCTLR %#x CBAR %#x FSR %#x", valid,
+	    slot, cb, rd(cbp, 0x0), rd(gr1, 4 * cb), rd(cbp, 0x58));
+
+	/* tables in the pool's last 2 MB block: level 1 maps the 4th GB to level 2; 2 MB blocks for the pool */
+	uint64_t *l1 = (uint64_t *)(void *)(cam_pool + (CAM_TBL_PA - CAM_POOL_PA)), *l2 = l1 + 512;
+	bzero(l1, 0x2000);
+	l1[3] = (CAM_TBL_PA + 0x1000) | 3;
+	unsigned blocks = 0;
+	for (uint64_t pa = CAM_POOL_PA; pa < CAM_MAP_END; pa += 0x200000, blocks++) {
+		/* block, AF, AP read-write, attribute 0 (normal non-cacheable), non-shareable */
+		l2[(pa >> 21) & 511] = pa | (1u << 10) | (1u << 6) | 1;
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	camlog("SMMU: tables at %#llx: %u blocks of 2 MB, %#llx-%#llx identity", CAM_TBL_PA, blocks, CAM_POOL_PA, CAM_MAP_END);
+
+	step("programming bank %u (SCTLR off while it changes)", cb);
+	wr(cbp, 0x0, 0);
+	wr(cbp, 0x58, 0xFFFFFFFF);
+	wr(cbp, 0x20, (uint32_t)CAM_TBL_PA);
+	wr(cbp, 0x24, (uint32_t)(CAM_TBL_PA >> 32));
+	wr(cbp, 0x30, 32u | (1u << 23));                /* TCR: T0SZ 32, non-cacheable walks, 4 KB, EPD1 */
+	wr(cbp, 0x10, (7u << 15) | 2u);                 /* TCR2: 40-bit output */
+	wr(cbp, 0x38, 0x44);                            /* MAIR0: attribute 0 normal non-cacheable */
+	wr(cbp, 0x3C, 0);
+	wr(gr1, 0x800 + 4 * cb, 1);                     /* CBA2R: 64-bit */
+	wr(gr1, 4 * cb, 0x0001F000);                    /* CBAR: stage 1, stage 2 bypass */
+	wr(cbp, 0x610, 0);                              /* TLBIASID 0 */
+	wr(cbp, 0x7F0, 0);                              /* TLBSYNC */
+	for (uint32_t k = 0; k < 100000 && (rd(cbp, 0x7F4) & 1) != 0; k++) {
+		IODelay(1);
+	}
+	/* translate; faults reported and terminated, never stalled (CFCFG 0) */
+	wr(cbp, 0x0, (1u << 6) | (1u << 5) | 1u);
+	step("pointing stream %#x (SMR%u) at bank %u", TFE_SID, slot, cb);
+	wr(s, 0xC00 + 4 * slot, cb);
+	wr(s, 0x800 + 4 * slot, (1u << 31) | TFE_SID);
+	wr(s, 0x70, 0);
+	for (uint32_t k = 0; k < 100000 && (rd(s, 0x74) & 1) != 0; k++) {
+		IODelay(1);
+	}
+	uint32_t smr = rd(s, 0x800 + 4 * slot), s2cr = rd(s, 0xC00 + 4 * slot);
+	s_ready = (smr == ((1u << 31) | TFE_SID)) && s2cr == cb && (rd(cbp, 0x0) & 0x61) == 0x61;
+	camlog("SMMU: SMR%u %#x S2CR %#x; bank %u SCTLR %#x TTBR0 %#x TCR %#x CBAR %#x FSR %#x: %s", slot, smr, s2cr, cb,
+	    rd(cbp, 0x0), rd(cbp, 0x20), rd(cbp, 0x30), rd(gr1, 4 * cb), rd(cbp, 0x58), s_ready ? "as written" : "NOT as written");
+	s_cbp = s_ready ? cbp : 0;
+	smmu_fsr_clear("after programming");
+	sweet_log_sync(500);
+	return s_ready ? 0 : EIO;
+}
+
+/* op 21 */
+static int
+cam_tfe_read(void)
+{
+	if (!cam_csid_up || cam_csid == 0) {
+		camlog("op 21: CSID not up (op 11 first: it also turns on tfe_0)");
+		return EAGAIN;
+	}
+	camlog("TFE clocks: tfe_0 CBCR %#x, tfe_0_csid %#x, tfe_0_cphy_rx %#x, top_ahb %#x, axi %#x, rt_axi %#x", gccr(0x5201C),
+	    gccr(0x520AC), gccr(0x5207C), gccr(CBCR_TOP_AHB), gccr(CBCR_AXI), gccr(CBCR_RT_AXI));
+	if ((gccr(0x5201C) >> 31) != 0) {
+		camlog("op 21: tfe_0 is off: stop");
+		return EIO;
+	}
+	step("reading TFE0 hw version at %#x", CSID0_PA + 0x1000);
+	uint32_t v = rd(cam_csid, 0x1000);
+	camlog("TFE0 hw version %#x", v);
+	if (v == 0 || v == 0xffffffffu) {
+		camlog("op 21: TFE version looks wrong: stop");
+		return EIO;
+	}
+	step("reading TFE0 top and bus status");
+	camlog("TFE0 top irq status %#x %#x %#x, bus %#x %#x, overflow %#x, size violation %#x", rd(cam_csid, 0x104C),
+	    rd(cam_csid, 0x1050), rd(cam_csid, 0x1054), rd(cam_csid, 0x1A28), rd(cam_csid, 0x1A2C), rd(cam_csid, 0x1A68),
+	    rd(cam_csid, 0x1A70));
+	step("reading WM7 (0x2300)");
+	camlog("WM7 cfg %#x addr %#x incr %#x cfg0 %#x stride %#x packer %#x addr status %#x; TFE RDI0 cfg %#x status %#x",
+	    rd(cam_csid, 0x2300), rd(cam_csid, 0x2304), rd(cam_csid, 0x2308), rd(cam_csid, 0x230C), rd(cam_csid, 0x2314),
+	    rd(cam_csid, 0x2318), rd(cam_csid, 0x2368), rd(cam_csid, 0x1460), rd(cam_csid, 0x1404));
+	return 0;
+}
+
+/* op 22 */
+static int
+cam_wm_config(void)
+{
+	uint32_t bytes = cs.w * cs.h * 10 / 8;
+	if (!cam_csid_up || !s_ready) {
+		camlog("op 22: needs op 11 and op 20 first");
+		return EAGAIN;
+	}
+	if (CAM_POOL_PA + bytes > CAM_MAP_END) {
+		camlog("op 22: %u bytes do not fit the mapped pool", bytes);
+		return ENOMEM;
+	}
+	vm_offset_t t = cam_csid;
+	step("TFE0: IRQ masks and clears");
+	wr(t, 0x1034, 0xFFFFFFFF); wr(t, 0x1038, 0xFFFFFFFF); wr(t, 0x103C, 0xFFFFFFFF);
+	wr(t, 0x1040, 0xFFFFFFFF); wr(t, 0x1044, 0xFFFFFFFF); wr(t, 0x1048, 0xFFFFFFFF); wr(t, 0x1030, 1);
+	wr(t, 0x1A18, 0xFFFFFFFF); wr(t, 0x1A1C, 0xFFFFFFFF);
+	wr(t, 0x1A20, 0xFFFFFFFF); wr(t, 0x1A24, 0xFFFFFFFF); wr(t, 0x1A30, 1);
+	step("WM7: frame mode, %u bytes at %#llx, not enabled", bytes, CAM_POOL_PA);
+	wr(t, 0x231C, 0xF);
+	wr(t, 0x230C, 0x0000FFFF);
+	wr(t, 0x2318, 0xA);
+	wr(t, 0x2314, 0xFFFF);
+	wr(t, 0x2304, (uint32_t)CAM_POOL_PA);
+	wr(t, 0x2308, bytes);
+	wr(t, 0x2338, 0);
+	wr(t, 0x233C, 1);
+	camlog("WM7 read back: cfg %#x addr %#x incr %#x cfg0 %#x stride %#x packer %#x bw %#x drop %#x/%#x", rd(t, 0x2300),
+	    rd(t, 0x2304), rd(t, 0x2308), rd(t, 0x230C), rd(t, 0x2314), rd(t, 0x2318), rd(t, 0x231C), rd(t, 0x2338), rd(t, 0x233C));
+	w_ready = rd(t, 0x2304) == (uint32_t)CAM_POOL_PA && rd(t, 0x2308) == bytes;
+	if (!w_ready) {
+		camlog("op 22: WM7 address/size did not read back as written (address shifted?): stop");
+	}
+	sweet_log_sync(500);
+	return w_ready ? 0 : EIO;
+}
+
+/*
+ * 0275: FSR bits 10:9 are FORMAT (0b10: the AArch64 format of the record), not a fault: 0274 read
+ * 0x400 as one. The fault bits are MULTI, SS, UUT, ASF, TLBLKF, TLBMCF, EF, PF, AFF, TF
+ * (Linux ARM_SMMU_FSR_FAULT); they are cleared by writing them back.
+ */
+#define SMMU_FSR_FAULT  0xC00001FEu
+
+static void
+smmu_fsr_clear(const char *when)
+{
+	if (s_cbp == 0) {
+		return;
+	}
+	uint32_t fsr = rd(s_cbp, 0x58);
+	wr(s_cbp, 0x58, fsr);
+	camlog("SMMU FSR %s: %#x, cleared -> %#x", when, fsr, rd(s_cbp, 0x58));
+}
+
+static bool
+smmu_fault(const char *when)
+{
+	uint32_t fsr = s_cbp ? rd(s_cbp, 0x58) : 0;
+	if ((fsr & SMMU_FSR_FAULT) != 0) {
+		camlog("SMMU FAULT %s: FSR %#x FAR %#x%08x FSYNR0 %#x", when, fsr, rd(s_cbp, 0x64), rd(s_cbp, 0x60), rd(s_cbp, 0x68));
+	}
+	return (fsr & SMMU_FSR_FAULT) != 0;
+}
+
+/* op 23 */
+static int
+cam_capture_staged(void)
+{
+	uint32_t bytes = cs.w * cs.h * 10 / 8;
+	if (!w_ready || !s_ready || !cam_csid_up) {
+		camlog("op 23: needs ops 11, 20, 22 first");
+		return EAGAIN;
+	}
+	vm_offset_t t = cam_csid;
+	memset(cam_pool, 0xA5, 4096);
+	memset(cam_pool + bytes - 4096, 0xA5, 4096);
+	__asm__ volatile ("dsb sy" ::: "memory");
+	(void)smmu_fault("before (not fatal)");
+	smmu_fsr_clear("before the capture");
+	step("CSID RDI0 halt");
+	wr(t, 0x308, 0);
+	step("TFE RDI0 path on (0x1460=1, epoch 0x1470)");
+	wr(t, 0x1460, 0x1);
+	wr(t, 0x1470, 0x00140014);
+	step("WM7 enable (0x2300=0x10001) + reg update");
+	wr(t, 0x2300, 0x00010001);
+	wr(t, 0x102C, 0x2);
+	/* 0277: stale RDI/TFE/bus status cleared, then only an EOF after a SOF seen from now on counts */
+	wr(t, 0x048, 0x3FFFF); wr(t, 0x080, 1);
+	wr(t, 0x1040, 0xFFFFFFFF); wr(t, 0x1044, 0xFFFFFFFF); wr(t, 0x1048, 0xFFFFFFFF); wr(t, 0x1030, 1);
+	wr(t, 0x1A20, 0xFFFFFFFF); wr(t, 0x1A24, 0xFFFFFFFF); wr(t, 0x1A30, 1);
+	uint64_t limit = 3000000000ull;
+	if (cs.slot == 0 && cam_frame_ns * 3 > limit) {
+		limit = cam_frame_ns * 3;
+	}
+	step("CSID RDI0 resume: the TFE starts writing at the next frame (WM7 at %#x, wait up to %llu ms)", rd(t, 0x2304),
+	    limit / 1000000);
+	wr(t, 0x308, 1);
+	uint64_t t0 = mach_absolute_time(), ns = 0, sof_ns = 0;
+	uint32_t logs = 0, b0 = 0, b1 = 0;
+	bool eof = false, done = false, fault = false, sof = false;
+	while (!done) {
+		fault = smmu_fault("during the frame");
+		uint32_t s0 = rd(t, 0x104C), s1 = rd(t, 0x1050), rdi = rd(t, 0x040);
+		b0 = rd(t, 0x1A28);
+		b1 = rd(t, 0x1A2C);
+		if ((s0 | s1 | b0 | b1) && logs < 10) {
+			camlog("TFE top %#x %#x, bus %#x %#x, overflow %#x, size violation %#x, rdi0 irq %#x", s0, s1, b0, b1,
+			    rd(t, 0x1A68), rd(t, 0x1A70), rdi);
+			logs++;
+		}
+		if (s0 | s1) {
+			wr(t, 0x1040, s0); wr(t, 0x1044, s1); wr(t, 0x1030, 1);
+		}
+		if (b0 | b1) {
+			wr(t, 0x1A20, b0); wr(t, 0x1A24, b1); wr(t, 0x1A30, 1);
+		}
+		absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
+		if ((rdi & (1u << 9)) && sof) {
+			eof = true;                             /* the end of the frame that started after the resume */
+		}
+		if ((rdi & (1u << 12)) && !sof) {
+			sof = true;
+			sof_ns = ns;
+		}
+		if (rdi) {
+			wr(t, 0x048, rdi); wr(t, 0x080, 1);
+		}
+		done = fault || (eof && (b0 | b1) != 0) || ns > limit;
+		if (!done) {
+			IOSleep(2);
+		}
+	}
+	wr(t, 0x2300, 0);                               /* WM7 off first on a fault */
+	wr(t, 0x102C, 0x2);
+	wr(t, 0x308, 0);
+	sweet_log_sync(500);
+	unsigned changed = 0, tail = 0;
+	for (unsigned i = 0; i < 4096; i++) {
+		changed += cam_pool[i] != 0xA5;
+		tail += cam_pool[bytes - 4096 + i] != 0xA5;
+	}
+	camlog("frame: %s%s after %llu ms (SOF at %llu ms); WM7 addr status %#x (end %#llx expected); first 4 KB %u bytes written, last 4 KB %u",
+	    eof ? "EOF" : "NO EOF", fault ? ", SMMU FAULT" : "", ns / 1000000, sof_ns / 1000000, rd(t, 0x2368), CAM_POOL_PA + bytes,
+	    changed, tail);
+	camlog("frame +0: %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x", cam_pool[0],
+	    cam_pool[1], cam_pool[2], cam_pool[3], cam_pool[4], cam_pool[5], cam_pool[6], cam_pool[7], cam_pool[8], cam_pool[9],
+	    cam_pool[10], cam_pool[11], cam_pool[12], cam_pool[13], cam_pool[14], cam_pool[15]);
+	(void)smmu_fault("after");
+	cam_frame_len = changed != 0 ? bytes : 0;
+	cam_frame_off = 0;
+	cam_seek = 0;
+	camlog("op 23: %s (%u bytes in kern.sweet_cam_frame)", changed ? "FRAME CAPTURED" : "nothing written", cam_frame_len);
+	return changed && !fault ? 0 : EIO;
+}
+
+/* ================================================================ 0276: exposure, preview ring, still */
+
+/*
+ * kern.sweet_cam_exp: write "coarse_lines analog_gain_x1000 [frame_length_lines]" (decimal) ->
+ * HM6 0x0202 / 0x0204 (1x = 0x20, max 64x = 0x800) / 0x0340 inside a group hold (0x0104);
+ * read: the current mode, its line time and limits and the values in use.
+ * Op 30 preview: HM6 in mode (arg >> 4 & 0xF, default 1; 3 = 1280x720), frames into a ring of
+ * 4 buffers at the start of the pool; a kernel thread follows CSID RDI0 SOF/EOF: at each SOF
+ * it programs the next buffer into WM7 (latched at the next SOF), at each EOF it publishes the
+ * buffer just finished (kern.sweet_cam_latest). kern.sweet_cam_sel picks what
+ * kern.sweet_cam_frame reads: -1 the newest preview frame, 0-3 a ring buffer, 100 the still.
+ * Op 31 stops the preview. Op 32: preview off, mode 0 with the exposure time carried over, one
+ * 108 MP frame at the pool start (it overwrites the ring: op 30 again after reading it).
+ */
+#define PV_NBUF         4
+
+static const unsigned hm6_fps_x100[5] = { 704, 3004, 3004, 12000, 3000 };
+static struct { bool set; uint32_t coarse, gain_x1000, fll; } ex;
+static uint32_t m_fll, m_llp, m_line_ns;
+static volatile bool pv_run, pv_alive;
+static volatile int pv_latest = -1;
+static volatile uint64_t pv_seq, pv_ts_ns, pv_ovf;
+static volatile uint32_t pv_fault;
+static uint32_t pv_bytes, pv_stride, pv_mode, cam_still_len;
+static int cam_sel = 100;
+
+static uint16_t
+tbl_last(const struct cam_reg *t, unsigned n, uint16_t addr, uint16_t dflt)
+{
+	uint16_t v = dflt;
+	for (unsigned i = 0; i < n; i++) {
+		if (t[i].blen == 0 && t[i].dt == 2 && t[i].addr == addr) {
+			v = t[i].val;
+		}
+	}
+	return v;
+}
+
+static bool
+hm6_mode_table(unsigned mode, const struct cam_reg **t, unsigned *n)
+{
+	switch (mode) {
+	case 0: *t = hm6_mode0; *n = sizeof(hm6_mode0) / sizeof(hm6_mode0[0]); cs.w = 12000; cs.h = 9000; return true;
+	case 1: *t = hm6_mode1; *n = sizeof(hm6_mode1) / sizeof(hm6_mode1[0]); cs.w = 4000; cs.h = 3000; return true;
+	case 3: *t = hm6_mode3; *n = sizeof(hm6_mode3) / sizeof(hm6_mode3[0]); cs.w = 1280; cs.h = 720; return true;
+	case 4: *t = hm6_mode4; *n = sizeof(hm6_mode4) / sizeof(hm6_mode4[0]); cs.w = 4000; cs.h = 3000; return true;
+	default: return false;
+	}
+}
+
+static uint32_t
+exp_max_lines(void)
+{
+	uint32_t fll = ex.fll != 0 ? ex.fll : m_fll;
+	return fll > 16 ? fll - 16 : 12;
+}
+
+/* the exposure in ex to the sensor (page 0x4000, group hold) */
+static int
+hm6_apply_exposure(void)
+{
+	uint32_t code = ex.gain_x1000 * 32 / 1000;
+	code = code < 0x20 ? 0x20 : code > 0x800 ? 0x800 : code;
+	uint32_t lines = ex.coarse < 12 ? 12 : ex.coarse > exp_max_lines() ? exp_max_lines() : ex.coarse;
+	cam_frame_ns = (uint64_t)m_line_ns * (ex.fll ? ex.fll : m_fll);
+	bool ok = cci_write(0, 0x10, 0xFCFC, 0x4000, 2) && cci_write(0, 0x10, 0x0104, 0x0101, 2);
+	if (ok && ex.fll != 0) {
+		ok = cci_write(0, 0x10, 0x0340, ex.fll, 2);
+	}
+	ok = ok && cci_write(0, 0x10, 0x0202, lines, 2) && cci_write(0, 0x10, 0x0204, code, 2);
+	ok = ok && cci_write(0, 0x10, 0x0104, 0x0001, 2);
+	camlog("exposure: %u lines (%u us), gain code %#x (%u.%03ux), frame length %u: %s", lines,
+	    (uint32_t)((uint64_t)lines * m_line_ns / 1000), code, code / 32, (code % 32) * 1000 / 32, ex.fll ? ex.fll : m_fll,
+	    ok ? "written" : "FAILED");
+	return ok ? 0 : EIO;
+}
+
+/* HM6 into mode: init + mode + stream on the first time, else stream off + mode + stream on */
+static int
+hm6_switch(unsigned mode)
+{
+	const struct cam_reg *mt;
+	unsigned mn;
+	uint8_t id[2];
+	int r = 0;
+	uint32_t old_line_ns = m_line_ns;
+
+	if (!camss_up || !slot_up[0]) {
+		camlog("HM6: slot 0 is not powered (ops 1, 2 first)");
+		return EAGAIN;
+	}
+	if (!hm6_mode_table(mode, &mt, &mn)) {
+		camlog("HM6: mode %u not built in (0, 1, 3, 4)", mode);
+		return EINVAL;
+	}
+	if (cam_streaming && cs.slot == 0) {
+		r = cam_replay(0, 0x10, hm6_off, sizeof(hm6_off) / sizeof(hm6_off[0]), "HM6 stream off");
+	} else {
+		if (!cci_read(0, 0x10, 0x0000, id, 2) || (id[0] << 8 | id[1]) != 0x1AD6) {
+			camlog("HM6: no S5KHM6 at m0 0x10: stop");
+			return ENODEV;
+		}
+		r = cam_replay(0, 0x10, hm6_init, sizeof(hm6_init) / sizeof(hm6_init[0]), "HM6 init");
+	}
+	cam_streaming = false;
+	r = r ? r : cam_replay(0, 0x10, mt, mn, "HM6 mode");
+	if (r != 0) {
+		return r;
+	}
+	m_fll = tbl_last(mt, mn, 0x0340, 1);
+	m_llp = tbl_last(mt, mn, 0x0342, 0);
+	m_line_ns = (uint32_t)(100000000000ull / ((uint64_t)hm6_fps_x100[mode] * m_fll));
+	cam_frame_ns = (uint64_t)m_line_ns * m_fll;
+	if (ex.set) {
+		if (old_line_ns != 0 && old_line_ns != m_line_ns) {
+			/* the same exposure time in the new mode's lines; a longer frame only if the exposure needs it */
+			ex.coarse = (uint32_t)((uint64_t)ex.coarse * old_line_ns / m_line_ns);
+			ex.fll = ex.coarse + 16 > m_fll ? (ex.coarse + 16 > 65535 ? 65535 : ex.coarse + 16) : 0;
+		}
+		(void)hm6_apply_exposure();
+	}
+	r = cam_replay(0, 0x10, hm6_on, sizeof(hm6_on) / sizeof(hm6_on[0]), "HM6 stream on");
+	cs.slot = 0; cs.mode = mode; cs.phy = 0; cs.cphy = true; cs.settle = 0x32; cs.lanes = 3; cs.rxcfg0 = 0x01102102;
+	cam_streaming = r == 0;
+	camlog("HM6 mode %u: %ux%u, frame length %u lines, line length %u, line time %u ns: %s", mode, cs.w, cs.h, m_fll, m_llp,
+	    m_line_ns, r == 0 ? "streaming" : "FAILED");
+	return r;
+}
+
+static int
+sysctl_sweet_cam_exp SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	char buf[256];
+	snprintf(buf, sizeof(buf), "mode %u %ux%u fll %u llp %u line_ns %u coarse %u (min 12 max %u) gain_x1000 %u (1000-64000) "
+	    "fll_set %u set %u streaming %u", cs.mode, cs.w, cs.h, m_fll, m_llp, m_line_ns, ex.coarse, exp_max_lines(), ex.gain_x1000,
+	    ex.fll, ex.set, cam_streaming);
+	int err = sysctl_handle_string(oidp, buf, sizeof(buf), req);
+	if (err != 0 || req->newptr == USER_ADDR_NULL) {
+		return err;
+	}
+	uint32_t v[3] = { 0, 0, 0 };
+	unsigned k = 0;
+	for (const char *p = buf; *p != 0 && k < 3;) {
+		while (*p == ' ') {
+			p++;
+		}
+		if (*p < '0' || *p > '9') {
+			break;
+		}
+		while (*p >= '0' && *p <= '9') {
+			v[k] = v[k] * 10 + (uint32_t)(*p++ - '0');
+		}
+		k++;
+	}
+	if (k < 2 || v[1] < 1000 || v[1] > 64000 || (k > 2 && v[2] > 65535)) {
+		return EINVAL;
+	}
+	lck_mtx_lock(&sweet_cam_mtx);
+	cam_log_len = 0;
+	cam_log[0] = 0;
+	ex.set = true;
+	ex.coarse = v[0];
+	ex.gain_x1000 = v[1];
+	ex.fll = k > 2 ? v[2] : 0;
+	if (ex.fll == 0 && ex.coarse + 16 > m_fll && m_fll != 0) {
+		ex.fll = ex.coarse + 16 > 65535 ? 65535 : ex.coarse + 16;      /* 0277: a longer frame for a long exposure */
+	}
+	int r = 0;
+	if (cam_streaming && cs.slot == 0) {
+		r = hm6_apply_exposure();
+	} else {
+		camlog("exposure kept for the next HM6 stream");
+	}
+	lck_mtx_unlock(&sweet_cam_mtx);
+	return r;
+}
+
+SYSCTL_PROC(_kern, OID_AUTO, sweet_cam_exp, CTLTYPE_STRING | CTLFLAG_RW | CTLFLAG_LOCKED,
+    0, 0, sysctl_sweet_cam_exp, "A", "HM6 exposure: write \"lines gain_x1000 [frame_length]\"; read the state");
+
+/* ---------------------------------------------------------------- the preview thread */
+
+static void
+pv_thread(void *arg __unused, wait_result_t wres __unused)
+{
+	vm_offset_t t = cam_csid;
+	int cur = -1;
+	unsigned prog = 0, polls = 0;
+	while (pv_run) {
+		uint32_t rdi = rd(t, 0x040);
+		if (rdi != 0) {
+			wr(t, 0x048, rdi);
+			wr(t, 0x080, 1);
+		}
+		if ((rdi & (1u << 9)) && cur >= 0) {            /* EOF: buffer cur is complete */
+			pv_latest = cur;
+			uint64_t ns;
+			absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+			pv_ts_ns = ns;
+			pv_seq++;
+		}
+		if (rdi & (1u << 12)) {                         /* SOF: prog was latched; the next one now */
+			cur = (int)prog;
+			prog = (prog + 1) % PV_NBUF;
+			wr(t, 0x2304, (uint32_t)(CAM_POOL_PA + (uint64_t)prog * pv_stride));
+			wr(t, 0x102C, 0x2);
+		}
+		if (rdi & (1u << 2)) {
+			pv_ovf++;
+		}
+		if ((++polls & 63) == 0) {
+			uint32_t s0 = rd(t, 0x104C), s1 = rd(t, 0x1050), b0 = rd(t, 0x1A28), b1 = rd(t, 0x1A2C);
+			if (s0 | s1) {
+				wr(t, 0x1040, s0); wr(t, 0x1044, s1); wr(t, 0x1030, 1);
+			}
+			if (b0 | b1) {
+				wr(t, 0x1A20, b0); wr(t, 0x1A24, b1); wr(t, 0x1A30, 1);
+			}
+			uint32_t fsr = s_cbp ? rd(s_cbp, 0x58) : 0;
+			if (fsr & SMMU_FSR_FAULT) {
+				pv_fault = fsr;
+				wr(t, 0x2300, 0);                       /* stop writing at once */
+				wr(t, 0x102C, 0x2);
+				break;
+			}
+		}
+		IOSleep(1);
+	}
+	pv_alive = false;
+	thread_terminate(current_thread());
+}
+
+static void
+pv_stop(void)
+{
+	if (!pv_alive) {
+		return;
+	}
+	pv_run = false;
+	for (int i = 0; i < 200 && pv_alive; i++) {
+		IOSleep(1);
+	}
+	if (cam_csid != 0) {
+		wr(cam_csid, 0x308, 0);                         /* RDI0 halt at the frame boundary */
+		wr(cam_csid, 0x2300, 0);
+		wr(cam_csid, 0x102C, 0x2);
+	}
+	camlog("preview stopped after %llu frames (overflows %llu, SMMU fault %#x)", pv_seq, pv_ovf, pv_fault);
+}
+
+/* op 30 */
+static int
+pv_start(void)
+{
+	unsigned slot = (unsigned)cam_arg & 0xF, mode = ((unsigned)cam_arg >> 4) & 0xF;
+	int r;
+	if (slot > 3) {
+		camlog("op 30: slot %u", slot);
+		return EINVAL;
+	}
+	if (slot == 0) {
+		mode = mode == 0 ? 1 : mode;
+		if (mode != 1 && mode != 3 && mode != 4) {
+			camlog("op 30: preview modes are 1, 3, 4");
+			return EINVAL;
+		}
+	} else {
+		mode = 0;
+		if (!camss_up || !slot_up[slot]) {
+			camlog("op 30: slot %u is not powered (op %u first)", slot, slot + 2);
+			return EAGAIN;
+		}
+	}
+	pv_stop();
+	if (cam_streaming && cs.slot != slot) {
+		(void)cam_stream_onoff(false);          /* 0288: the other sensor stops talking first */
+		cam_streaming = false;
+	}
+	if (slot == 0) {
+		r = hm6_switch(mode);
+	} else {
+		const struct cam_sdesc *d = &sdesc[slot];
+		uint8_t id[2];
+		cs.w = d->w; cs.h = d->h; cs.phy = d->phy; cs.cphy = false; cs.settle = d->settle; cs.lanes = d->lanes;
+		cs.rxcfg0 = d->rxcfg0;
+		if (!cci_read(d->m, d->addr, d->idreg, id, 2) || (unsigned)(id[0] << 8 | id[1]) != d->id) {
+			camlog("op 30: no %s at m%u %#x", d->name, d->m, d->addr);
+			return ENODEV;
+		}
+		r = cam_replay(d->m, d->addr, d->init, d->ni, "init");
+		r = r ? r : cam_replay(d->m, d->addr, d->mode, d->nm, "mode 0");
+		r = r ? r : cam_replay(d->m, d->addr, d->on, d->non, "stream on");
+		cs.slot = slot;
+		cs.mode = 0;
+		cam_streaming = r == 0;
+		camlog("op 30: %s %ux%u: %s", d->name, cs.w, cs.h, r == 0 ? "streaming" : "FAILED");
+	}
+	if (r == 0 && (!cam_csid_up || link_slot != (int)slot)) {
+		r = cam_link_on();
+		link_slot = r == 0 ? (int)slot : -1;
+	}
+	if (r == 0 && !s_ready) {
+		r = cam_smmu_stage();
+	}
+	if (r != 0) {
+		return r;
+	}
+	pv_bytes = cs.w * cs.h * 10 / 8;
+	pv_stride = (pv_bytes + 0xFFF) & ~0xFFFu;
+	if (CAM_POOL_PA + (uint64_t)PV_NBUF * pv_stride > CAM_MAP_END) {
+		camlog("op 30: %u buffers of %u bytes do not fit", PV_NBUF, pv_stride);
+		return ENOMEM;
+	}
+	vm_offset_t t = cam_csid;
+	step("preview: WM7 frame mode, %u buffers of %u bytes from %#llx", PV_NBUF, pv_stride, CAM_POOL_PA);
+	wr(t, 0x308, 0);
+	wr(t, 0x1034, 0xFFFFFFFF); wr(t, 0x1038, 0xFFFFFFFF); wr(t, 0x103C, 0xFFFFFFFF);
+	wr(t, 0x1040, 0xFFFFFFFF); wr(t, 0x1044, 0xFFFFFFFF); wr(t, 0x1048, 0xFFFFFFFF); wr(t, 0x1030, 1);
+	wr(t, 0x1A18, 0xFFFFFFFF); wr(t, 0x1A1C, 0xFFFFFFFF);
+	wr(t, 0x1A20, 0xFFFFFFFF); wr(t, 0x1A24, 0xFFFFFFFF); wr(t, 0x1A30, 1);
+	wr(t, 0x231C, 0xF);
+	wr(t, 0x230C, 0x0000FFFF);
+	wr(t, 0x2318, 0xA);
+	wr(t, 0x2314, 0xFFFF);
+	wr(t, 0x2304, (uint32_t)CAM_POOL_PA);
+	wr(t, 0x2308, pv_bytes);
+	wr(t, 0x2338, 0);
+	wr(t, 0x233C, 1);
+	wr(t, 0x1460, 0x1);
+	wr(t, 0x1470, 0x00140014);
+	wr(t, 0x2300, 0x00010001);
+	wr(t, 0x102C, 0x2);
+	smmu_fsr_clear("before the preview");
+	w_ready = false;                                /* op 23 must configure WM7 again */
+	pv_seq = 0;
+	pv_ovf = 0;
+	pv_fault = 0;
+	pv_latest = -1;
+	pv_mode = mode;
+	pv_run = true;
+	pv_alive = true;
+	thread_t th;
+	if (kernel_thread_start(pv_thread, NULL, &th) != KERN_SUCCESS) {
+		pv_run = pv_alive = false;
+		camlog("op 30: no thread");
+		return ENOMEM;
+	}
+	thread_deallocate(th);
+	wr(t, 0x308, 1);                                /* RDI0 resume */
+	cam_sel = -1;
+	cam_frame_off = 0;
+	cam_frame_len = 0;
+	IOSleep(300);
+	camlog("op 30: preview mode %u (%ux%u, %u bytes a frame): %llu frames in 300 ms, latest buffer %d", mode, cs.w, cs.h,
+	    pv_bytes, pv_seq, pv_latest);
+	return pv_seq != 0 ? 0 : EIO;
+}
+
+/* op 32 */
+static int
+cam_still(void)
+{
+	pv_stop();
+	if (cam_streaming && cs.slot != 0) {
+		(void)cam_stream_onoff(false);
+		cam_streaming = false;
+	}
+	int r = hm6_switch(0);
+	if (r == 0 && (!cam_csid_up || link_slot != 0)) {
+		r = cam_link_on();
+		link_slot = r == 0 ? 0 : -1;
+	}
+	if (r == 0 && !s_ready) {
+		r = cam_smmu_stage();
+	}
+	IOSleep(300);                                   /* the first frames after a mode change */
+	r = r ? r : cam_wm_config();
+	r = r ? r : cam_capture_staged();
+	cam_still_len = r == 0 ? cs.w * cs.h * 10 / 8 : 0;
+	cam_sel = 100;
+	cam_frame_off = 0;
+	camlog("op 32: still %ux%u: %s (op 30 restarts the preview, which overwrites it)", cs.w, cs.h, r == 0 ? "CAPTURED" : "FAILED");
+	return r;
+}
+
+static int
+sysctl_sweet_cam_latest SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	char buf[200];
+	int n = snprintf(buf, sizeof(buf), "running %u seq %llu buf %d off %#x bytes %u w %u h %u mode %u t_ns %llu ovf %llu fault %#x",
+	    pv_alive, pv_seq, pv_latest, pv_latest >= 0 ? (uint32_t)pv_latest * pv_stride : 0, pv_bytes, cs.w, cs.h, pv_mode,
+	    pv_ts_ns, pv_ovf, pv_fault);
+	return SYSCTL_OUT(req, buf, (size_t)n + 1);
+}
+
+SYSCTL_PROC(_kern, OID_AUTO, sweet_cam_latest, CTLTYPE_STRING | CTLFLAG_RD | CTLFLAG_LOCKED,
+    0, 0, sysctl_sweet_cam_latest, "A", "the preview ring: newest complete frame");
+
+/* what kern.sweet_cam_frame reads: -1 the newest preview frame, 0..3 a ring buffer, 100 the still */
+static int
+sysctl_sweet_cam_sel SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	int v = cam_sel;
+	int err = sysctl_io_number(req, v, sizeof(v), &v, NULL);
+	if (err != 0 || req->newptr == USER_ADDR_NULL) {
+		return err;
+	}
+	lck_mtx_lock(&sweet_cam_mtx);
+	if (v == 100) {
+		cam_frame_off = 0;
+		cam_frame_len = cam_still_len;
+	} else if (v >= -1 && v < PV_NBUF && pv_stride != 0) {
+		int b = v < 0 ? pv_latest : v;
+		if (b < 0) {
+			err = EAGAIN;
+		} else {
+			cam_frame_off = (uint32_t)b * pv_stride;
+			cam_frame_len = pv_bytes;
+		}
+	} else {
+		err = EINVAL;
+	}
+	if (err == 0) {
+		cam_sel = v;
+		cam_seek = 0;
+	}
+	lck_mtx_unlock(&sweet_cam_mtx);
+	return err;
+}
