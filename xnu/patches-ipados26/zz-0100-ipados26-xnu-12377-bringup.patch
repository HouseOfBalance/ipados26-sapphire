+/* ops 15 / 20 with arg bit 8: the spot lit before, off after (onBeforeAuthCapture's 3 frames) */
+static bool
+spot_on(uint32_t arg)
+{
+	if ((arg & 0x100) == 0) {
+		return false;
+	}
+	(void)panel_seq(0);
+	IOSleep(50);
+	return true;
+}
+
+static void
+spot_off(bool on)
+{
+	if (on) {
+		(void)panel_seq(1);
+	}
+}
