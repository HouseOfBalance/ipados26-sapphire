+	}
+	/* never RAM the kernel manages */
+	if (QSEE_POOL_PA < gPhysBase + gPhysSize && QSEE_POOL_PA + QSEE_POOL_SIZE > gPhysBase) {
+		LOG("pool %llx-%llx overlaps kernel RAM %lx-%lx: stop", QSEE_POOL_PA, QSEE_POOL_PA + QSEE_POOL_SIZE,
+		    gPhysBase, gPhysBase + gPhysSize);
+		return false;
+	}
+	IOMemoryDescriptor *md = IOMemoryDescriptor::withPhysicalAddress(QSEE_POOL_PA, QSEE_POOL_SIZE, kIODirectionInOut);
+	if (md == NULL) {
+		LOG("pool: no descriptor");
+		return false;
+	}
+	q_map = md->map(kIOMapWriteCombineCache);
+	md->release();
+	if (q_map == NULL) {
+		LOG("pool: mapping %llx failed", QSEE_POOL_PA);
+		return false;
+	}
+	q_va = (uint8_t *)q_map->getVirtualAddress();
+	LOG("pool %llx-%llx mapped write-combined (kernel RAM %lx-%lx)", QSEE_POOL_PA, QSEE_POOL_PA + QSEE_POOL_SIZE,
+	    gPhysBase, gPhysBase + gPhysSize);
+	return true;
+}
+
+/* ---------------------------------------------------------------- SCM */
+
+static void
+smc8(uint64_t a[8])
+{
+	register uint64_t x0 __asm__("x0") = a[0], x1 __asm__("x1") = a[1], x2 __asm__("x2") = a[2],
+	    x3 __asm__("x3") = a[3], x4 __asm__("x4") = a[4], x5 __asm__("x5") = a[5], x6 __asm__("x6") = a[6],
+	    x7 __asm__("x7") = a[7];
+	__asm__ volatile ("smc #0"
+            : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3), "+r"(x4), "+r"(x5), "+r"(x6), "+r"(x7)
+            :
+            : "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15", "x16", "x17", "memory");
+	a[0] = x0; a[1] = x1; a[2] = x2; a[3] = x3; a[4] = x4; a[5] = x5; a[6] = x6; a[7] = x7;
+}
+
+/*
+ * One SCM call the way Linux's __scm_smc_call() makes it: x2..x5 the first four arguments, or with
+ * more than four x2..x4 the first three and x5 the physical address of the rest (u64 each).
+ * INTERRUPTED is resumed (x0 = 1, x6 the session), WAITQ sleep/wake answered, EBUSY and the
+ * QSEE "app busy" result retried 20 times 30 ms apart. Returns x0 (0 ok, < 0 an SCM error, or
+ * -1000 for a timeout); ret = x1..x3 = { result, resp_type, data }.
+ */
+static int64_t
+scm_call(uint32_t fn, uint32_t arginfo, const uint64_t *args, unsigned n, uint64_t ret[3])
+{
+	uint64_t a[8];
+	unsigned busy = 0, resumes = 0, waits = 0;
+	const uint64_t t0 = mach_absolute_time();
+
+	ret[0] = ret[1] = ret[2] = 0;
+	for (;;) {
+		bzero(a, sizeof(a));
+		a[0] = fn;
+		a[1] = arginfo;
+		if (n <= 4) {
+			for (unsigned i = 0; i < n; i++) {
+				a[2 + i] = args[i];
+			}
+		} else {
+			uint64_t *ext = (uint64_t *)(q_va + OFF_EXT);
+			bzero(ext, 7 * sizeof(uint64_t));
+			for (unsigned i = 0; i < 3; i++) {
+				a[2 + i] = args[i];
+			}
+			for (unsigned i = 3; i < n && i < 10; i++) {
+				ext[i - 3] = args[i];
+			}
+			mb();
+			a[5] = QSEE_POOL_PA + OFF_EXT;
+		}
+		const uint64_t orig[6] = { a[0], a[1], a[2], a[3], a[4], a[5] };
+		smc8(a);
+		while ((a[0] == SCM_INTERRUPTED || a[0] == SCM_WAITQ_SLEEP || a[0] == SCM_WAITQ_WAKE) &&
+		    ms_since(t0) < 30000) {
+			if (a[0] == SCM_INTERRUPTED) {
+				uint64_t s = a[6];
+				resumes++;
+				bzero(a, sizeof(a));
+				a[0] = SCM_INTERRUPTED;
+				for (unsigned i = 1; i < 6; i++) {
+					a[i] = orig[i];
+				}
+				a[6] = s;
+			} else {
+				/* x1 wq_ctx, x2 smc_call_ctx: nobody else waits here, so resume (or ack) at once */
+				uint64_t ctx = a[2];
+				bool sleep = a[0] == SCM_WAITQ_SLEEP;
+				if (waits++ < 4) {
+					LOG("  scm %08x: WAITQ %s (wq %llu, ctx %llu)", fn, sleep ? "sleep" : "wake", a[1], ctx);
+				}
+				if (sleep) {
+					IOSleep(1);
+				}
+				bzero(a, sizeof(a));
+				a[0] = sleep ? FN_WAITQ_RESUME : FN_WAITQ_ACK;
+				a[1] = 1;
+				a[2] = ctx;
+			}
+			smc8(a);
+		}
+		if (a[0] == SCM_INTERRUPTED || a[0] == SCM_WAITQ_SLEEP || a[0] == SCM_WAITQ_WAKE) {
+			LOG("  scm %08x: still x0=%lld after 30 s (%u resumes, %u waits): given up", fn, (int64_t)a[0], resumes, waits);
+			return -1000;
+		}
+		if (((int64_t)a[0] == SCM_EBUSY || (a[0] == 0 && (int32_t)a[1] == QSEE_APP_BUSY)) && busy < 20) {
+			busy++;
+			IOSleep(30);
+			continue;
+		}
+		break;
+	}
+	ret[0] = a[1];
+	ret[1] = a[2];
+	ret[2] = a[3];
+	if (resumes > 0 || busy > 0) {
+		LOG("  scm %08x: %u resumes, %u busy retries, %llu ms", fn, resumes, busy, ms_since(t0));
+	}
+	return (int64_t)a[0];
+}
+
+static const char *
+result_name(uint32_t r)
+{
+	return r == RES_SUCCESS ? "SUCCESS" : r == RES_INCOMPLETE ? "INCOMPLETE" : r == RES_BLOCKED ? "BLOCKED_ON_LISTENER" :
+	       r == 3 ? "CBACK_REQUEST" : r == RES_FAILURE ? "FAILURE" : "?";
+}
+
+/*
+ * After a QSEOS call: TrustZone may want a listener (file system 10, time 11, RPMB 0x2000...).
+ * Listener 10 (0253) is served from the RAM store and answered SUCCESS (its own result is in the
+ * message); any other one is answered "failure" (LISTENER_RSP status -1); a blocked session is
+ * told to continue. At most 2000 rounds (big files come in 20000-byte reads). True on SUCCESS.
+ */
+static bool
+qsee_finish(const char *what, int64_t x0, uint64_t ret[3], uint32_t app_id)
+{
+	unsigned served = 0;
+	for (unsigned round = 0; round < 2000; round++) {
+		uint32_t res = (uint32_t)ret[0], type = (uint32_t)ret[1], data = (uint32_t)ret[2];
+		if (x0 != 0) {
+			LOG("%s: SCM error %lld (x1 %llx x2 %llx x3 %llx)", what, x0, ret[0], ret[1], ret[2]);
+			return false;
+		}
+		if (res == RES_INCOMPLETE && data == FS_LISTENER && q_lsnr_ok) {
+			fs_serve();
+			served++;
+			uint64_t a[2] = { FS_LISTENER, RES_SUCCESS };
+			x0 = scm_call(FN_LISTENER_RSP, 0x2, a, 2, ret);
+			continue;
+		}
+		if (res == RES_INCOMPLETE && data == GPFS_LISTENER && q_gp_ok) {
+			gp_serve();
+			served++;
+			uint64_t a[2] = { GPFS_LISTENER, RES_SUCCESS };
+			x0 = scm_call(FN_LISTENER_RSP, 0x2, a, 2, ret);
+			continue;
+		}
+		LOG("%s: result %d %s, resp_type %x, data %u (0x%x)%s", what, (int32_t)res, result_name(res), type, data, data,
+		    served > 0 ? " (after file requests)" : "");
+		if (res == RES_SUCCESS) {
+			if (served > 0) {
+				LOG("%s: %u file requests served", what, served);
+			}
+			return true;
+		}
+		if (res == RES_INCOMPLETE) {
+			/* not registered here: TZ has no buffer of ours for it, so there is no request to show */
+			LOG("%s: TrustZone asks listener %u (0x%x)%s, not registered here (no request buffer to show): answered FAILURE",
+			    what, data, data, data == 10 ? " = file system" : data == 11 ? " = time" : data == 0x2000 ? " = RPMB" :
+			    data == 0x7000 ? " = GP fs" : data == 0x3000 ? " = SSD" : data == 0x2001 ? " = GPT" : "");
+			uint64_t a[2] = { data, RES_FAILURE };
+			x0 = scm_call(FN_LISTENER_RSP, 0x2, a, 2, ret);
+			continue;
+		}
+		if (res == RES_BLOCKED) {
+			LOG("%s: blocked on listener %u (session %u): CONTINUE_BLOCKED", what, data, type);
+			uint64_t a[1] = { type };
+			x0 = scm_call(FN_CONTINUE_SMCINV, 0x1, a, 1, ret);
+			if (x0 != 0) {
+				LOG("%s: CONTINUE_BLOCKED (smcinvoke) x0 %lld: the legacy one with app %u", what, x0, app_id);
+				a[0] = app_id;
+				x0 = scm_call(FN_CONTINUE_LEGACY, 0x1, a, 1, ret);
+			}
+			continue;
+		}
+		return false;
+	}
+	LOG("%s: still not done after 2000 listener rounds: given up", what);
+	return false;
+}
+
+/* SIP feature version (Linux: qseecom_init_control, qseecom_check_whitelist_feature) */
+static bool
+qsee_feature(uint32_t feature, uint64_t *version)
+{
+	uint64_t a[1] = { feature }, ret[3];
+	int64_t x0 = scm_call(FN_FEAT_VERSION, 0x1, a, 1, ret);
+	*version = ret[0];
+	LOG("feature %u: x0 %lld, version %llx (%llu.%llu.%llu)", feature, x0, ret[0], (ret[0] >> 22) & 0x3ff,
+	    (ret[0] >> 12) & 0x3ff, ret[0] & 0xfff);
+	return x0 == 0;
+}
+
+/* APP_LOOKUP: the app id, 0 when the app is not loaded, -1 on an error */
+static int64_t
+qsee_lookup(const char *name)
+{
+	char *buf = (char *)(q_va + OFF_NAME);
+	uint64_t ret[3];
+
+	bzero(buf, 0x1000);
+	strlcpy(buf, name, 0x100);
+	mb();
+	uint64_t a[2] = { QSEE_POOL_PA + OFF_NAME, strlen(name) };
+	int64_t x0 = scm_call(FN_APP_LOOKUP, 0x22, a, 2, ret);
+	if (x0 != 0) {
+		LOG("lookup %s: SCM error %lld", name, x0);
+		return -1;
+	}
+	if ((uint32_t)ret[0] == RES_FAILURE) {
+		LOG("lookup %s: not loaded (result FAILURE)", name);
+		return 0;
+	}
+	if ((uint32_t)ret[0] == RES_SUCCESS && (uint32_t)ret[1] == RESP_APP_ID) {
+		LOG("lookup %s: app id %u", name, (uint32_t)ret[2]);
+		return (uint32_t)ret[2];
+	}
+	LOG("lookup %s: unexpected result %d resp_type %x data %u", name, (int32_t)ret[0], (uint32_t)ret[1], (uint32_t)ret[2]);
+	return -1;
+}
+
+/* ---------------------------------------------------------------- the sensor's power */
+
+static volatile uint32_t *
+tlmm(unsigned gpio)
+{
+	/* the TLMM tile of each GPIO (pinctrl-sm6115.c, as TopazModem's tlmm_tile): S 0x900000, E 0xd00000, W 0x500000 */
+	static const char tile[] = "WWWWWWWWEEEEWWWWWWEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEWWWWWWWSSSSSSSSWWWWWWWEEWEEWWWWWWSSSSSSSSSSSSSSS";
+	if (gpio >= sizeof(tile) - 1) {
+		return NULL;
+	}
+	uint64_t base = tile[gpio] == 'S' ? 0x00900000ull : tile[gpio] == 'E' ? 0x00D00000ull : 0x00500000ull;
+	return (volatile uint32_t *)ml_io_map(base + gpio * 0x1000ull, 0x1000);
+}
+
+static bool
+gpio_out(unsigned gpio, bool high)
+{
+	volatile uint32_t *g = tlmm(gpio);
+	if (g == NULL) {
+		LOG("gpio%u: no mapping", gpio);
+		return false;
+	}
+	uint32_t ctl0 = g[0], io0 = g[1];
+	/* keep APPS the owner of an eGPIO (0x1a00 as Android's pinctrl leaves it), or the IO writes go nowhere */
+	uint32_t ctl = (ctl0 & ~0x3ffu) | TLMM_CTL_OE;
+	if (ctl0 & TLMM_EGPIO_PRESENT) {
+		ctl |= TLMM_EGPIO_ENABLE;
+	}
+	g[1] = high ? TLMM_IO_OUT : 0;              /* the level first, then the output enable */
+	mb();
+	g[0] = ctl;
+	mb();
+	LOG("gpio%u: ctl %08x io %08x -> ctl %08x io %08x (%s)", gpio, ctl0, io0, g[0], g[1], high ? "high" : "low");
+	return true;
+}
+
+/* read only: the presumed SPI pins, the reset pin, and the QUP clocks */
+static void
+fp_diag(const char *when)
+{
+	/* not gpio14..17 or the QUP clocks: TZ owns the sensor's SPI and touching them hangs the phone */
+	static const unsigned pins[] = { GPIO_RST, GPIO_IRQ };
+	for (unsigned i = 0; i < sizeof(pins) / sizeof(pins[0]); i++) {
+		volatile uint32_t *g = tlmm(pins[i]);
+		if (g != NULL) {
+			uint32_t ctl = g[0], io = g[1];
+			LOG("diag %s: gpio%u ctl %08x (func %u, drv %u mA, pull %u, oe %u) io %08x", when, pins[i], ctl,
+			    (ctl >> 2) & 0xf, (((ctl >> 6) & 7) + 1) * 2, ctl & 3, (ctl >> 9) & 1, io);
+		}
+	}
+}
+
+/* FP_IOC_RESET / fp_hw_reset(): reset low, 5 ms, high, then delay_ms */
+static bool
+fp_reset_pulse(unsigned delay_ms)
+{
+	if (!gpio_out(GPIO_RST, false)) {
+		return false;
+	}
+	IOSleep(5);
+	if (!gpio_out(GPIO_RST, true)) {
+		return false;
+	}
+	IOSleep(delay_ms);
+	return true;
+}
+
+static void
+fp_power_off(void)
+{
+	LOG("sensor off (it was %s)", q_powered ? "powered by this" : "not powered by this");
+	gpio_out(GPIO_RST, false);
+	gpio_out(GPIO_PWR, false);
+	q_powered = false;
+	/* L9 also feeds BT vdd-io, the codec's vddpx/rxtx and a vddio: it stays on */
+	LOG("sensor off: reset and power GPIOs low (L9 left on: shared with BT and the codec)");
+}
+
+static bool
+fp_power_on(void)
+{
+	int act = topaz_rpm_ldo(FP_LDO, FP_LDO_UV, FP_LDO_MA, 0);
+	LOG("sensor: RPM ldoa%u %u uV %u mA, active set: %d (0: taken)", FP_LDO, FP_LDO_UV, FP_LDO_MA, act);
+	if (act != 0) {
+		return false;
+	}
+	IOSleep(2);
+	if (!gpio_out(GPIO_PWR, true)) {
+		return false;
+	}
+	q_powered = true;
+	IOSleep(q_settle_ms);
+	/* HalContext::init: reset(true) = fp_hw_reset(60) */
+	LOG("sensor: gpio65 high %u ms, reset pulse, then %u ms", q_settle_ms, q_reset_ms);
+	if (!fp_reset_pulse(q_reset_ms)) {
+		return false;
+	}
+	volatile uint32_t *irq = tlmm(GPIO_IRQ);
+	if (irq != NULL) {
+		LOG("sensor: on; irq gpio%u ctl %08x io %08x (level %u)", GPIO_IRQ, irq[0], irq[1], irq[1] & 1);
+	}
+	return true;
+}
+
+/* ---------------------------------------------------------------- the QSEE log */
+
+/* once per boot (TZ keeps the buffer): the pool's 32 KB, zeroed */
+static void
+tz_log_register(void)
+{
+	uint64_t ret[3];
+
+	if (q_log_tried) {
+		return;
+	}
+	q_log_tried = true;
+	bzero(q_va + OFF_LOG, LOG_SIZE);
+	mb();
+	uint64_t a[2] = { QSEE_POOL_PA + OFF_LOG, LOG_SIZE };
+	int64_t x0 = scm_call(FN_REG_LOG_BUF, 0x22, a, 2, ret);
+	q_log_ok = x0 == 0 && (uint32_t)ret[0] != RES_FAILURE;
+	LOG("QSEE log buffer %llx (%u bytes): x0 %lld, result %d, resp_type %x, data %x: %s", QSEE_POOL_PA + OFF_LOG, LOG_SIZE,
+	    x0, (int32_t)ret[0], (uint32_t)ret[1], (uint32_t)ret[2], q_log_ok ? "registered" : "NOT registered, no TZ log");
+}
+
+/*
+ * op 9: the log buffer copied for kern.sweet_qsee_log. First the 8 header bytes one at a time,
+ * each logged before the next read (if a read stalls, the last line says where), then the rest
+ * in 4 KB memcpy steps, each logged. Nothing parses it here: user space does.
+ */
+static uint8_t *q_log_copy;
+static uint32_t q_log_copy_len;
+
+static int
+tz_log_copy(void)
+{
+	if (!q_log_ok) {
+		LOG("log copy: the buffer is not registered (op 8 first)");
+		return ENOENT;
+	}
+	if (q_log_copy == NULL) {
+		q_log_copy = (uint8_t *)IOMalloc(LOG_SIZE);
+		if (q_log_copy == NULL) {
+			return ENOMEM;
+		}
+	}
+	q_log_copy_len = 0;
+	const volatile uint8_t *b = q_va + OFF_LOG;
+	mb();
+	for (unsigned i = 0; i < 8; i++) {
+		LOG("log copy: reading header byte %u", i);
+		q_log_copy[i] = b[i];
+		LOG("log copy: header byte %u = %02x", i, q_log_copy[i]);
+	}
+	for (uint32_t off = 8; off < LOG_SIZE; off += 0x1000) {
+		uint32_t n = LOG_SIZE - off < 0x1000u ? LOG_SIZE - off : 0x1000u;
+		memcpy(q_log_copy + off, (const void *)(q_va + OFF_LOG + off), n);
+		LOG("log copy: %u bytes at +0x%x copied", n, off);
+	}
+	q_log_copy_len = LOG_SIZE;
+	LOG("log copy: %u bytes ready in kern.sweet_qsee_log", q_log_copy_len);
+	return 0;
+}
+
+/* kern.sweet_qsee_log (bsd/dev/sweet_qsee_ctl.c): the copy into dst, its length (0: none) */
+extern "C" uint32_t
+sweet_qsee_log_get(void *dst, uint32_t max)
+{
+	uint32_t n = 0;
+	if (q_lock == NULL) {
+		return 0;
+	}
+	IOLockLock(q_lock);
+	if (q_log_copy != NULL) {
+		n = q_log_copy_len < max ? q_log_copy_len : max;
+		memcpy(dst, q_log_copy, n);
+	}
+	IOLockUnlock(q_lock);
+	return n;
+}
+
+/* ---------------------------------------------------------------- the TA */
+
+static const char *const ta_files[] = {
+	"image/goodixfp.mdt", "image/goodixfp.b00", "image/goodixfp.b01", "image/goodixfp.b02", "image/goodixfp.b03",
+	"image/goodixfp.b04", "image/goodixfp.b05", "image/goodixfp.b06", "image/goodixfp.b07",
+};
+
+/* goodixfp.mdt â€– b00 â€– ... â€– b(e_phnum-1), back to back (qseecom.c __qseecom_get_fw_data) */
+static bool
+ta_image(uint32_t *mdt_len, uint32_t *img_len)
+{
+	uint8_t *img = q_va + OFF_IMG;
+	uint64_t off = 0;
+	const uint64_t t0 = mach_absolute_time();
+
+	*mdt_len = *img_len = 0;
+	int64_t sz = topaz_fw_file_size(ta_files[0]);
+	LOG("TA: firmware table %s, %s %lld bytes", topaz_fw_phone(), ta_files[0], sz);
+	if (sz <= 64 || sz > 0x10000) {
+		LOG("TA: no usable %s (-2: the partition is not readable yet)", ta_files[0]);
+		return false;
+	}
+	if (topaz_fw_file_read(ta_files[0], 0, img, (uint64_t)sz) != 0) {
+		LOG("TA: reading %s failed", ta_files[0]);
+		return false;
+	}
+	if (img[0] != 0x7f || img[1] != 'E' || img[2] != 'L' || img[3] != 'F' || img[4] != 2) {
+		LOG("TA: %s is not ELF64 (%02x %02x %02x %02x class %u)", ta_files[0], img[0], img[1], img[2], img[3], img[4]);
+		return false;
+	}
+	uint16_t phnum = *(uint16_t *)(img + 0x38);
+	LOG("TA: mdt ELF64, %u program headers", phnum);
+	if (phnum == 0 || phnum > sizeof(ta_files) / sizeof(ta_files[0]) - 1) {
+		LOG("TA: %u segments, this knows b00..b07", phnum);
+		return false;
+	}
+	*mdt_len = (uint32_t)sz;
+	off = (uint64_t)sz;
+	for (unsigned i = 1; i <= phnum; i++) {
+		sz = topaz_fw_file_size(ta_files[i]);
+		if (sz < 0 || off + (uint64_t)sz > IMG_MAX) {
+			LOG("TA: %s: size %lld at %llu does not fit %u", ta_files[i], sz, off, IMG_MAX);
+			return false;
+		}
+		if (sz > 0 && topaz_fw_file_read(ta_files[i], 0, img + off, (uint64_t)sz) != 0) {
+			LOG("TA: reading %s failed", ta_files[i]);
+			return false;
+		}
+		off += (uint64_t)sz;
+	}
+	mb();
+	*img_len = (uint32_t)off;
+	LOG("TA: image %u bytes (mdt %u) at %llx, read in %llu ms", *img_len, *mdt_len, QSEE_POOL_PA + OFF_IMG, ms_since(t0));
+	return true;
+}
+
+static int64_t
+ta_start(void)
+{
+	uint32_t mdt_len, img_len;
+	uint64_t ret[3];
+
+	if (!ta_image(&mdt_len, &img_len)) {
+		return -1;
+	}
+	uint64_t a[3] = { mdt_len, img_len, QSEE_POOL_PA + OFF_IMG };
+	const uint64_t t0 = mach_absolute_time();
+	int64_t x0 = scm_call(FN_APP_START, 0x3, a, 3, ret);
+	LOG("APP_START goodixfp: x0 %lld after %llu ms", x0, ms_since(t0));
+	bool started = qsee_finish("APP_START goodixfp", x0, ret, 0);
+	if (!started) {
+		return -1;
+	}
+	if ((uint32_t)ret[1] != RESP_APP_ID || (uint32_t)ret[2] == 0) {
+		LOG("APP_START goodixfp: no app id (resp_type %x data %u)", (uint32_t)ret[1], (uint32_t)ret[2]);
+		return -1;
+	}
+	return (uint32_t)ret[2];
+}
+
+/*
+ * One goodix command (CaEntry::sendCommand): the gf_cmd in the 2 MB buffer, the 64-byte envelope
+ * at the start of the sb, SEND_DATA with request = response = the envelope. The 32-bit PA at
+ * envelope +0 is what qseecom's modfd path patches in; the whitelist entry names it (offset 0,
+ * single buffer, 32-bit, the buffer's length), so the TA may map it.
+ */
+static bool
+gf_send(uint32_t app_id, uint8_t *cmd, uint32_t len, const char *name)
+{
+	uint8_t *buf = q_va + OFF_CMD, *sb = q_va + OFF_SB;
+	uint32_t *sgl = (uint32_t *)(q_va + OFF_SGL);
+	clock_sec_t sec;
+	clock_usec_t usec;
+	uint64_t ret[3];
+	int64_t x0;
+
+	clock_get_calendar_microtime(&sec, &usec);
+	memcpy(buf, cmd, len);
+	bzero(sb, 0x40);
+	*(uint32_t *)(sb + 0x00) = (uint32_t)(QSEE_POOL_PA + OFF_CMD);
+	*(uint32_t *)(sb + 0x08) = len;
+	*(uint32_t *)(sb + 0x0c) = ++q_seq;
+	*(uint64_t *)(sb + 0x10) = (uint64_t)sec * 1000 + usec / 1000;
+	bzero(sgl, 64);
+	sgl[0] = 0x80000000u | 0;                   /* single address, 32-bit, at offset 0 */
+	sgl[1] = CMD_SIZE;
+	mb();
+	const uint64_t t0 = mach_absolute_time();
+	if (q_whitelist) {
+		/* 0249: the table is 8 entries, 64 bytes (libQSEEComAPI's size) */
+		uint64_t a[7] = { app_id, QSEE_POOL_PA + OFF_SB, 0x40, QSEE_POOL_PA + OFF_SB, 0x40, QSEE_POOL_PA + OFF_SGL, 64 };
+		x0 = scm_call(FN_SEND_DATA_WL, 0x8887, a, 7, ret);
+	} else {
+		uint64_t a[5] = { app_id, QSEE_POOL_PA + OFF_SB, 0x40, QSEE_POOL_PA + OFF_SB, 0x40 };
+		x0 = scm_call(FN_SEND_DATA, 0x885, a, 5, ret);
+	}
+	LOG("%s: SEND_DATA%s x0 %lld after %llu ms", name, q_whitelist ? "_WHITELIST" : "", x0, ms_since(t0));
+	bool ok = qsee_finish(name, x0, ret, app_id);
+	mb();
+	memcpy(cmd, buf, len);
+	/* envelope +0x1c mirrors the gf result (0249): not a transport failure */
+	uint32_t status = *(uint32_t *)(sb + 0x1c), res = *(uint32_t *)(cmd + 0x0c);
+	LOG("%s: envelope TEE status %u, gf result %u (0x%x) %s, reset_flag %u, seq %u", name, status, res, res,
+	    gf_err_name(res), cmd[0], *(uint32_t *)(sb + 0x0c));
+	const uint32_t shown = len <= 0xc0u ? len : 0x40u;
+	if (shown < len) {
+		LOG("%s:   (%u bytes, the first %u shown)", name, len, shown);
+	}
+	for (uint32_t i = 0; i < shown; i += 16) {
+		char line[64] = "";
+		size_t n = 0;
+		for (uint32_t j = i; j + 4 <= len && j < i + 16; j += 4) {
+			n += snprintf(line + n, sizeof(line) - n, " %08x", *(uint32_t *)(cmd + j));
+		}
+		LOG("%s:   +%02x%s", name, i, line);
+	}
+	return ok;
+}
+
+static void
+gf_header(uint8_t *c, uint32_t len, uint32_t target, uint32_t cmd)
+{
+	bzero(c, len);
+	*(uint32_t *)(c + 0x04) = target;
+	*(uint32_t *)(c + 0x08) = cmd;
+}
+
+/* WAKEUP (1002,9), 0x20: +0x1d screen index 0xff, +0x1e reset-before-wakeup; out +0x1c "woken" */
+static bool
+gf_wakeup(uint32_t app_id, bool reset_first, uint32_t *res)
+{
+	uint8_t c[0x40];
+	const char *name = reset_first ? "WAKEUP(reset)" : "WAKEUP";
+
+	gf_header(c, 0x20, GF_TARGET_SENSOR, GF_SENSOR_WAKEUP);
+	c[0x1d] = 0xff;
+	c[0x1e] = reset_first ? 1 : 0;
+	if (!gf_send(app_id, c, 0x20, name)) {
+		LOG("%s: the call itself failed", name);
+		return false;
+	}
+	*res = *(uint32_t *)(c + 0x0c);
+	LOG("%s: gf result %u %s, woken byte +0x1c = %u", name, *res, gf_err_name(*res), c[0x1c]);
+	return true;
+}
+
+/* PRE_DETECT / DETECT_SENSOR: retried only on FAILED_AND_RETRY, as SensorDetector does */
+static bool
+gf_detect_step(uint32_t app_id, uint32_t cmd, uint32_t len, const char *name, uint8_t *c)
+{
+	clock_sec_t sec;
+	clock_usec_t usec;
+
+	for (unsigned i = 0; i < 4; i++) {
+		gf_header(c, len, GF_TARGET_SENSOR, cmd);
+		if (cmd == GF_SENSOR_PRE_DETECT) {
+			clock_get_calendar_microtime(&sec, &usec);
+			*(uint64_t *)(c + 0x20) = (uint64_t)sec;
+		}
+		if (!gf_send(app_id, c, len, name)) {
+			LOG("%s: the call itself failed: stop", name);
+			return false;
+		}
+		uint32_t r = *(uint32_t *)(c + 0x0c);
+		if (r == 0) {
+			return true;
+		}
+		if (r != GF_FAILED_AND_RETRY) {
+			LOG("%s: gf error %u %s: stop", name, r, gf_err_name(r));
+			return false;
+		}
+		LOG("%s: FAILED_AND_RETRY (try %u): again in 10 ms (no reset: 0250)", name, i + 1);
+		IOSleep(10);
+	}
+	LOG("%s: still FAILED_AND_RETRY after 4 tries: stop", name);
+	return false;
+}
+
+/* HalContext::init from step 7: doResetBeforeWakeup, doWakeup, PRE_DETECT, DETECT_SENSOR */
+static bool
+sensor_probe(uint32_t app_id)
+{
+	uint8_t c[0x40];
+	uint32_t r = 0;
+
+	fp_diag("before WAKEUP(reset)");
+	if (!gf_wakeup(app_id, true, &r)) {
+		return false;
+	}
+	if (r == 0) {
+		/* Device::reset(false): another hardware reset pulse */
+		LOG("WAKEUP(reset) ok: hardware reset pulse (then %u ms)", q_reset_ms);
+		if (!fp_reset_pulse(q_reset_ms)) {
+			return false;
+		}
+	}
+	fp_diag("after WAKEUP(reset)");
+	if (!gf_wakeup(app_id, false, &r)) {
+		return false;
+	}
+	if (r != 0) {
+		LOG("WAKEUP: gf error %u %s: going on to PRE_DETECT for the log", r, gf_err_name(r));
+	}
+	bool pre = gf_detect_step(app_id, GF_SENSOR_PRE_DETECT, 0x28, "PRE_DETECT", c);
+	fp_diag("after PRE_DETECT");
+	if (!pre) {
+		return false;
+	}
+	if (!gf_detect_step(app_id, GF_SENSOR_DETECT, 0x2c, "DETECT_SENSOR", c)) {
+		return false;
+	}
+	const uint32_t *info = (const uint32_t *)(c + 0x1c);
+	LOG("DETECT_SENSOR: sensor info %08x %08x %08x %08x: TZ talks to the sensor", info[0], info[1], info[2], info[3]);
+	return true;
+}
+
+/* APP_SHUTDOWN of a loaded goodixfp ("fingerprint" to TZ): 0 done or not loaded, else an errno */
+static int
+shutdown_app(void)
+{
+	uint64_t ret[3];
+
+	int64_t id = qsee_lookup(TA_NAME);
+	if (id <= 0) {
+		return id == 0 ? 0 : EIO;
+	}
+	uint64_t a[1] = { (uint64_t)id };
+	int64_t x0 = scm_call(FN_APP_SHUTDOWN, 0x1, a, 1, ret);
+	bool ok = qsee_finish("APP_SHUTDOWN " TA_NAME, x0, ret, (uint32_t)id);
+	LOG("APP_SHUTDOWN " TA_NAME " (app %lld): %s", id, ok ? "done" : "FAILED");
+	if (ok) {
+		q_goodix_id = 0;
+	}
+	return ok ? 0 : EIO;
+}
+
+/* the TA: restart = shutdown a loaded one first (a clean TA state), else reuse it */
+static int64_t
+ta_ready(bool restart)
+{
+	if (restart && shutdown_app() != 0) {
+		return -1;
+	}
+	int64_t id = qsee_lookup(TA_NAME);
+	if (id < 0) {
+		return -1;
+	}
+	if (id > 0) {
+		LOG(TA_NAME " (goodixfp) already loaded: app id %lld (reused)", id);
+		return id;
+	}
+	id = ta_start();
+	if (id > 0) {
+		LOG("goodixfp started: app id %lld", id);
+	}
+	return id;
+}
+
+static bool
+qsee_up(void)
+{
+	uint64_t wl = 0;
+
+	if (!pool_map()) {
+		return false;
+	}
+	if (q_version != 0) {
+		return true;
+	}
+	if (!qsee_feature(10, &q_version)) {
+		LOG("no QSEE version: stop");
+		q_version = 0;
+		return false;
+	}
+	q_whitelist = qsee_feature(15, &wl) && wl >= (1ull << 22);
+	LOG("QSEE version %llx, whitelist %s (%llx)", q_version, q_whitelist ? "supported" : "NOT supported", wl);
+	return true;
+}
+
+/*
+ * op 7: L9 as the PMIC has it (PM6125, SPMI SID 0, LDO9 at 0x4800: PMIC5 LDO STATUS1 0x08,
+ * VSET 0x40/0x41 mV, MODE_CTL 0x45, EN_CTL 0x46). Observer reads only, nothing written. (0193:
+ * an SPMI read once hung the audio thread, so this is an op of its own, never part of op 1.)
+ */
+static int
+l9_readback(void)
+{
+	static const uint8_t regs[] = { 0x04, 0x05, 0x08, 0x40, 0x41, 0x45, 0x46 };
+	uint8_t v[sizeof(regs)] = {};
+	int e = sweet_spmi_init();
+	if (e != 0) {
+		LOG("L9: SPMI not available (%d)", e);
+		return EIO;
+	}
+	for (unsigned i = 0; i < sizeof(regs); i++) {
+		e = sweet_spmi_read_any(0, 0x4800u + regs[i], &v[i]);
+		if (e != 0) {
+			LOG("L9: SPMI read 0x%x failed: %d", 0x4800u + regs[i], e);
+			return EIO;
+		}
+	}
+	LOG("L9 (PM6125 0x4800): type %02x subtype %02x status1 %02x (ready %u), vset %u mV, mode %02x, en_ctl %02x (%s)", v[0],
+	    v[1], v[2], v[2] >> 7, v[3] | (unsigned)v[4] << 8, v[5], v[6], (v[6] & 0x80) ? "enabled" : "not enabled by apps");
+	return 0;
+}
+
+/* op 1 (restart true) / op 5 (reuse a loaded goodixfp) / op 6 (restart, slow power timings) */
+static int
+milestone(bool restart, bool slow)
+{
+	const uint64_t t0 = mach_absolute_time();
+
+	q_settle_ms = slow ? 100 : 20;
+	q_reset_ms = slow ? 120 : 60;
+	LOG("milestone 1b begins (%s, %s timings: %u ms settle, %u ms after reset)", restart ? "clean TA restart" :
+	    "reusing a loaded TA", slow ? "slow" : "normal", q_settle_ms, q_reset_ms);
+	if (!qsee_up()) {
+		return EIO;
+	}
+	int64_t km = qsee_lookup("keymaster64");
+	LOG("keymaster64: %s %lld", km > 0 ? "loaded, app id" : km == 0 ? "not loaded" : "lookup failed", km);
+	if (km < 0) {
+		return EIO;
+	}
+
+	/* the crypto engine's clock, as qseecom votes it (core_clk_src: RPM "ce" 0, ce-opp-freq 192 MHz) */
+	int ce = topaz_rpm_vote(0, 0x00006563, 0, 0x007a484b, 192000);
+	LOG("RPM ce clock 192 MHz, active set: %d (0: taken)", ce);
+
+	if (!fp_power_on()) {
+		LOG("sensor power-up failed: stop");
+		fp_power_off();
+		return EIO;
+	}
+	int64_t id = ta_ready(restart);
+	if (id <= 0) {
+		LOG("goodixfp not available: stop");
+		fp_power_off();
+		return ENOEXEC;
+	}
+	q_goodix_id = (uint32_t)id;
+	if (!sensor_probe((uint32_t)id)) {
+		fp_power_off();
+		LOG("milestone 1b failed at the sensor (%llu ms); goodixfp stays loaded (op 3 unloads it)", ms_since(t0));
+		return EIO;
+	}
+	LOG("milestone 1b done in %llu ms: sensor powered, goodixfp app %u (op 2 powers the sensor off)", ms_since(t0), q_goodix_id);
+	return 0;
+}
+
+/* ---------------------------------------------------------------- 0253: files (listener 10) */
+
+/*
+ * The TA's files (persist/goodix/..., fpdata/...) come from a RAM store that user space fills through
+ * kern.sweet_qsee_file ("name\0bytes"; empty bytes clear it). The TA sees them by basename. All its
+ * writes, creates, removes and renames change the RAM copy only (an overlay, logged): nothing
+ * reaches any disk. kern.sweet_qsee_files lists the store.
+ */
+struct qfile {
+	char     name[64];
+	uint8_t *data;
+	uint32_t len, cap;
+	bool     used, dirty, from_user;
+};
+static struct qfile q_files[QF_MAX_FILES];
+static struct { int file; uint32_t pos; bool used; } q_fds[QF_NFD];
+static int q_errno;
+static uint32_t q_fs_reqs;
+static bool q_lsnr_tried, q_inited;
+static uint32_t q_auth_retries;                 /* 0258: SENSOR_INIT out +0x40 */
+static int fp_enum(const char *when);           /* 0259 */
+static char q_file_sel[64];                     /* 0258: kern.sweet_qsee_filesel */
+static uint8_t q_cmd[0x400];                    /* the biggest command here: SENSOR_INIT, 0x2c0 */
+
+static inline uint32_t get32(const uint8_t *p, uint32_t o) { uint32_t v; memcpy(&v, p + o, 4); return v; }
+static inline void put32(uint8_t *p, uint32_t o, uint32_t v) { memcpy(p + o, &v, 4); }
+static inline void put64(uint8_t *p, uint32_t o, uint64_t v) { memcpy(p + o, &v, 8); }
+
+static void
+qsee_lock_init(void)
+{
+	if (q_lock == NULL) {
+		IOLock *l = IOLockAlloc();
+		if (!OSCompareAndSwapPtr(NULL, l, (void * volatile *)&q_lock)) {
+			IOLockFree(l);
+		}
+	}
+}
+
+static bool
+qsee_enabled(void)
+{
+	static int enabled = -1;
+	if (enabled < 0) {
+		int v = 0;
+		enabled = PE_parse_boot_argn("qsee", &v, sizeof(v)) && v != 0;
+	}
+	return enabled != 0;
+}
+
+static uint32_t
+qf_total(void)
+{
+	uint32_t t = 0;
+	for (unsigned i = 0; i < QF_MAX_FILES; i++) {
+		t += q_files[i].used ? q_files[i].cap : 0;
+	}
+	return t;
+}
+
+/* the basename of a 256-byte path field (bounded: never reads past it) */
+static void
+qf_basename(const uint8_t *p, char out[64])
+{
+	char path[257];
+	memcpy(path, p, 256);
+	path[256] = 0;
+	const char *b = path;
+	for (const char *c = path; *c != 0; c++) {
+		if (*c == '/') {
+			b = c + 1;
+		}
+	}
+	strlcpy(out, b, 64);
+}
+
+static int
+qf_find(const char *name)
+{
+	for (int i = 0; i < QF_MAX_FILES; i++) {
+		if (q_files[i].used && strcmp(q_files[i].name, name) == 0) {
+			return i;
+		}
+	}
+	return -1;
+}
+
+static int
+qf_create(const char *name)
+{
+	if (name[0] == 0) {
+		return -1;
+	}
+	for (int i = 0; i < QF_MAX_FILES; i++) {
+		if (!q_files[i].used) {
+			bzero(&q_files[i], sizeof(q_files[i]));
+			strlcpy(q_files[i].name, name, sizeof(q_files[i].name));
+			q_files[i].used = true;
+			return i;
+		}
+	}
+	return -1;
+}
+
+/* room for need bytes (exact: what user space gives; else doubling from 64 KB), within the caps */
+static bool
+qf_reserve(int i, uint32_t need, bool exact)
+{
+	struct qfile *f = &q_files[i];
+	if (need <= f->cap) {
+		return true;
+	}
+	if (need > QF_FILE_MAX) {
+		return false;
+	}
+	uint32_t cap = exact ? need : MAX(MAX(need, f->cap * 2), 0x10000u);
+	cap = MIN(cap, QF_FILE_MAX);
+	if (qf_total() - f->cap + cap > QF_TOTAL_MAX) {
+		return false;
+	}
+	uint8_t *d = (uint8_t *)IOMalloc(cap);
+	if (d == NULL) {
+		return false;
+	}
+	if (f->data != NULL) {
+		memcpy(d, f->data, f->len);
+		IOFree(f->data, f->cap);
+	}
+	f->data = d;
+	f->cap = cap;
+	return true;
+}
+
+static void
+qf_free(int i)
+{
+	if (q_files[i].data != NULL) {
+		IOFree(q_files[i].data, q_files[i].cap);
+	}
+	bzero(&q_files[i], sizeof(q_files[i]));
+	for (unsigned k = 0; k < QF_NFD; k++) {
+		if (q_fds[k].used && q_fds[k].file == i) {
+			q_fds[k].file = -1;
+		}
+	}
+}
+
+static int
+qf_fd(int fd)
+{
+	int k = fd - QF_FD_BASE;
+	if (k < 0 || k >= QF_NFD || !q_fds[k].used || q_fds[k].file < 0 || !q_files[q_fds[k].file].used) {
+		return -1;
+	}
+	return k;
+}
+
+/* kern.sweet_qsee_file: "name\0bytes" from user space; no bytes: the file is dropped */
+extern "C" int
+sweet_qsee_file_put(const uint8_t *buf, uint32_t len)
+{
+	uint32_t nl = 0;
+
+	if (!qsee_enabled()) {
+		return ENODEV;
+	}
+	while (nl < len && nl < 64 && buf[nl] != 0) {
+		nl++;
+	}
+	if (nl == 0 || nl >= 64 || nl >= len) {
+		return EINVAL;
+	}
+	char name[64];
+	memcpy(name, buf, nl);
+	name[nl] = 0;
+	if (strchr(name, '/') != NULL) {
+		return EINVAL;
+	}
+	const uint8_t *data = buf + nl + 1;
+	uint32_t dlen = len - nl - 1;
+	if (dlen > QF_FILE_MAX) {
+		return EFBIG;
+	}
+	qsee_lock_init();
+	IOLockLock(q_lock);
+	int r = 0, i = qf_find(name);
+	if (dlen == 0) {
+		if (i >= 0) {
+			qf_free(i);
+		}
+		LOG("file %s: cleared", name);
+	} else {
+		if (i < 0) {
+			i = qf_create(name);
+		}
+		if (i < 0) {
+			r = ENOSPC;
+		} else {
+			q_files[i].len = 0;
+			if (!qf_reserve(i, dlen, true)) {
+				r = ENOSPC;
+			} else {
+				memcpy(q_files[i].data, data, dlen);
+				q_files[i].len = dlen;
+				q_files[i].dirty = false;
+				q_files[i].from_user = true;
+			}
+		}
+		LOG("file %s: %u bytes from user space: %s (store %u bytes)", name, dlen, r == 0 ? "kept" : "NO ROOM", qf_total());
+	}
+	IOLockUnlock(q_lock);
+	return r;
+}
+
+/* kern.sweet_qsee_files: "name size dirty user\n" per file; returns the length (always terminated) */
+extern "C" uint32_t
+sweet_qsee_files_list(char *out, uint32_t max)
+{
+	uint32_t n = 0;
+	if (max == 0) {
+		return 0;
+	}
+	out[0] = 0;
+	if (q_lock == NULL) {
+		return 0;
+	}
+	IOLockLock(q_lock);
+	for (unsigned i = 0; i < QF_MAX_FILES && n + 1 < max; i++) {
+		if (q_files[i].used) {
+			int w = snprintf(out + n, max - n, "%s %u %s %s\n", q_files[i].name, q_files[i].len,
+			    q_files[i].dirty ? "dirty" : "clean", q_files[i].from_user ? "user" : "ta");
+			if (w < 0) {
+				break;
+			}
+			n = MIN(n + (uint32_t)w, max - 1);
+		}
+	}
+	IOLockUnlock(q_lock);
+	return n;
+}
+
+static const char *
+fs_cmd_name(uint32_t c)
+{
+	static const char *const names[] = { "start", "open", "openat", "unlinkat", "fcntl", "creat", "read", "write",
+		                             "close", "lseek", "link", "unlink", "rmdir", "fstat", "lstat", "mkdir", "testdir",
+		                             "telldir", "remove", "chown_chmod", "unused", "sync", "rename", "par_free_size",
+		                             "dir_open", "dir_read", "dir_close", "get_errno" };
+	return c >= 0x201 && c < 0x201 + sizeof(names) / sizeof(names[0]) ? names[c - 0x201] : "?";
+}
+
+static int32_t
+fs_open(const char *name, uint32_t flags, int *e)
+{
+	int i = qf_find(name);
+	if (i < 0) {
+		if ((flags & 0x40) == 0) {             /* O_CREAT */
+			*e = ENOENT;
+			return -1;
+		}
+		i = qf_create(name);
+		if (i < 0) {
+			*e = ENOSPC;
+			return -1;
+		}
+		q_files[i].dirty = true;
+	}
+	if ((flags & 0x200) != 0 && (flags & 3) != 0) {  /* O_TRUNC, for writing */
+		q_files[i].len = 0;
+		q_files[i].dirty = true;
+	}
+	for (unsigned k = 0; k < QF_NFD; k++) {
+		if (!q_fds[k].used) {
+			q_fds[k].used = true;
+			q_fds[k].file = i;
+			q_fds[k].pos = (flags & 0x400) != 0 ? q_files[i].len : 0;   /* O_APPEND */
+			return QF_FD_BASE + (int32_t)k;
+		}
+	}
+	*e = EMFILE;
+	return -1;
+}
+
+static void
+fs_stat(uint8_t *b, int i)
+{
+	bzero(b + 4, 96);
+	put32(b, 4 + 16, 0x8180);                   /* st_mode: S_IFREG | 0600 */
+	put32(b, 4 + 20, 1);                        /* st_nlink */
+	put64(b, 4 + 44, q_files[i].len);           /* st_size */
+	put32(b, 4 + 52, 4096);                     /* st_blksize */
+	put64(b, 4 + 56, (q_files[i].len + 511) / 512);
+}
+
+/* one file-service request in the listener buffer, answered in place (minkipc fs_msg.h layouts) */
+static void
+fs_serve(void)
+{
+	uint8_t *b = q_va + OFF_LSB;
+	char name[64], name2[64];
+	int e = 0;
+	int32_t ret = -1;
+	uint32_t cmd = get32(b, 0);
+
+	mb();
+	q_fs_reqs++;
+	{
+		static uint32_t seen;
+		uint32_t bit = cmd >= 0x201 && cmd < 0x221 ? 1u << (cmd - 0x201) : 0;
+		if (bit != 0 && (seen & bit) == 0) {
+			seen |= bit;
+			LOG("fs first %s request: %08x %08x %08x %08x %08x %08x %08x %08x", fs_cmd_name(cmd), get32(b, 0), get32(b, 4),
+			    get32(b, 8), get32(b, 12), get32(b, 16), get32(b, 20), get32(b, 24), get32(b, 28));
+		}
+	}
+	static uint32_t last_cmd;
+	static int32_t last_fd = -1;
+	if (cmd == 0x209 && last_cmd == 0x202 && (int32_t)get32(b, 4) == last_fd) {
+		LOG("fs: fd %d closed right after its open: nothing (lseek/fstat/read) reached us in between", last_fd);
+	}
+	last_cmd = cmd;
+	switch (cmd) {
+	case 0x202:                                 /* OPEN {path[256]; flags} */
+	case 0x203:                                 /* OPENAT {dirfd; path[256]; flags} */
+	case 0x206: {                               /* CREAT {path[256]; mode} */
+		uint32_t po = cmd == 0x203 ? 8 : 4;
+		uint32_t flags = cmd == 0x206 ? 0x241u : get32(b, po + 256);
+		qf_basename(b + po, name);
+		ret = fs_open(name, flags, &e);
+		put32(b, 4, (uint32_t)ret);
+		last_fd = ret;
+		LOG("fs %s %s flags 0%o -> %d%s", fs_cmd_name(cmd), name, flags, ret, ret < 0 ? (e == ENOENT ? " (no such file)" : " (error)") : "");
+		break;
+	}
+	case 0x207: {                               /* READ {fd; count} -> {buf[20000]; ret@20004} */
+		int32_t fd = (int32_t)get32(b, 4);
+		uint32_t count = get32(b, 8), n = 0;
+		int k = qf_fd(fd);
+		if (k < 0) {
+			e = EBADF;
+		} else {
+			struct qfile *f = &q_files[q_fds[k].file];
+			uint32_t pos = q_fds[k].pos;
+			n = pos < f->len ? MIN(MIN(count, FS_MAX_DATA), f->len - pos) : 0;
+			if (n > 0) {
+				memcpy(b + 4, f->data + pos, n);
+			}
+			q_fds[k].pos = pos + n;
+			ret = (int32_t)n;
+			LOG("fs read %s @%u %u -> %u", f->name, pos, count, n);
+		}
+		put32(b, 4 + FS_MAX_DATA, (uint32_t)ret);
+		if (k < 0) {
+			LOG("fs read fd %d: bad fd", fd);
+		}
+		break;
+	}
+	case 0x208: {                               /* WRITE {fd; buf[20000]; count@20008} -> {ret} */
+		int32_t fd = (int32_t)get32(b, 4);
+		uint32_t count = get32(b, 8 + FS_MAX_DATA);
+		int k = qf_fd(fd);
+		if (k < 0 || count > FS_MAX_DATA) {
+			e = k < 0 ? EBADF : EINVAL;
+			LOG("fs write fd %d count %u: %s", fd, count, k < 0 ? "bad fd" : "too long");
+		} else {
+			int fi = q_fds[k].file;
+			struct qfile *f = &q_files[fi];
+			uint32_t pos = q_fds[k].pos;
+			if (!qf_reserve(fi, pos + count, false)) {
+				e = ENOSPC;
+				LOG("fs write %s @%u %u: NO ROOM in the RAM store", f->name, pos, count);
+			} else {
+				if (pos > f->len) {
+					bzero(f->data + f->len, pos - f->len);
+				}
+				memcpy(f->data + pos, b + 8, count);
+				q_fds[k].pos = pos + count;
+				f->len = MAX(f->len, pos + count);
+				f->dirty = true;
+				ret = (int32_t)count;
+				LOG("fs write %s @%u %u (now %u bytes; RAM only)", f->name, pos, count, f->len);
+			}
+		}
+		put32(b, 4, (uint32_t)ret);
+		break;
+	}
+	case 0x209: {                               /* CLOSE {fd} */
+		int32_t fd = (int32_t)get32(b, 4);
+		int k = fd - QF_FD_BASE;
+		if (k >= 0 && k < QF_NFD && q_fds[k].used) {
+			q_fds[k].used = false;
+			ret = 0;
+		} else {
+			e = EBADF;
+		}
+		put32(b, 4, (uint32_t)ret);
+		LOG("fs close %d -> %d", fd, ret);
+		break;
+	}
+	case 0x20A: {                               /* LSEEK {fd; off; whence} -> {ret} */
+		int32_t fd = (int32_t)get32(b, 4), off = (int32_t)get32(b, 8), whence = (int32_t)get32(b, 12);
+		int k = qf_fd(fd);
+		if (k < 0 || whence < 0 || whence > 2) {
+			e = k < 0 ? EBADF : EINVAL;
+		} else {
+			int64_t base = whence == 0 ? 0 : whence == 1 ? (int64_t)q_fds[k].pos : (int64_t)q_files[q_fds[k].file].len;
+			int64_t np = base + off;
+			if (np < 0 || np > (int64_t)QF_FILE_MAX) {
+				e = EINVAL;
+			} else {
+				q_fds[k].pos = (uint32_t)np;
+				ret = (int32_t)np;
+			}
+		}
+		put32(b, 4, (uint32_t)ret);
+		LOG("fs lseek %d %d whence %d -> %d", fd, off, whence, ret);
+		break;
+	}
+	case 0x204:                                 /* UNLINKAT {dirfd; path} */
+	case 0x20C:                                 /* UNLINK {path} */
+	case 0x213: {                               /* REMOVE {path} */
+		qf_basename(b + (cmd == 0x204 ? 8 : 4), name);
+		int i = qf_find(name);
+		if (i < 0) {
+			e = ENOENT;
+		} else {
+			qf_free(i);
+			ret = 0;
+		}
+		put32(b, 4, (uint32_t)ret);
+		LOG("fs %s %s -> %d (RAM only)", fs_cmd_name(cmd), name, ret);
+		break;
+	}
+	case 0x20E:                                 /* FSTAT {fd} -> {stat; ret@100} */
+	case 0x20F: {                               /* LSTAT {path} */
+		int i = -1;
+		if (cmd == 0x20E) {
+			int k = qf_fd((int32_t)get32(b, 4));
+			i = k < 0 ? -1 : q_fds[k].file;
+			strlcpy(name, i < 0 ? "(bad fd)" : q_files[i].name, sizeof(name));
+		} else {
+			qf_basename(b + 4, name);
+			i = qf_find(name);
+		}
+		if (i < 0) {
+			e = cmd == 0x20E ? EBADF : ENOENT;
+			bzero(b + 4, 96);
+		} else {
+			fs_stat(b, i);
+			ret = 0;
+		}
+		put32(b, 100, (uint32_t)ret);
+		LOG("fs %s %s -> %d (size %u)", fs_cmd_name(cmd), name, ret, i < 0 ? 0 : q_files[i].len);
+		break;
+	}
+	case 0x217: {                               /* RENAME {old[256]; new[256]} */
+		qf_basename(b + 4, name);
+		qf_basename(b + 260, name2);
+		int i = qf_find(name), j = qf_find(name2);
+		if (i < 0 || name2[0] == 0) {
+			e = ENOENT;
+		} else {
+			if (j >= 0 && j != i) {
+				qf_free(j);
+			}
+			strlcpy(q_files[i].name, name2, sizeof(q_files[i].name));
+			q_files[i].dirty = true;
+			ret = 0;
+		}
+		put32(b, 4, (uint32_t)ret);
+		LOG("fs rename %s -> %s: %d (RAM only)", name, name2, ret);
+		break;
+	}
+	case 0x205:                                 /* FCNTL */
+	case 0x20D:                                 /* RMDIR */
+	case 0x210:                                 /* MKDIR */
+	case 0x211:                                 /* TESTDIR: every directory "exists" */
+	case 0x214:                                 /* CHOWN_CHMOD */
+	case 0x216:                                 /* SYNC */
+		ret = 0;
+		if (cmd == 0x205 || cmd == 0x216) {
+			LOG("fs %s fd %d -> 0", fs_cmd_name(cmd), (int32_t)get32(b, 4));
+		} else {
+			char path[64];
+			memcpy(path, b + 4, sizeof(path) - 1);
+			path[sizeof(path) - 1] = 0;
+			LOG("fs %s %s -> 0", fs_cmd_name(cmd), path);
+		}
+		put32(b, 4, 0);
+		break;
+	case 0x218:                                 /* PAR_FR_SIZE -> {u64 size; ret} */
+		put64(b, 4, 64ull << 20);
+		put32(b, 12, 0);
+		ret = 0;
+		LOG("fs par_free_size -> 64 MB");
+		break;
+	case 0x219:                                 /* DIR_OPEN -> {u64 pdir; ret} */
+		put64(b, 4, 0);
+		put32(b, 12, (uint32_t)-1);
+		e = ENOENT;
+		LOG("fs dir_open: not supported -> -1");
+		break;
+	case 0x21A:                                 /* DIR_READ -> {dirent(275); ret} */
+		put32(b, 4 + 275, (uint32_t)-1);
+		LOG("fs dir_read: not supported -> -1");
+		break;
+	case 0x21B:                                 /* DIR_CLOSE */
+		put32(b, 4, 0);
+		ret = 0;
+		break;
+	case 0x21C:                                 /* GET_ERRNO -> {ret = errno} */
+		put32(b, 4, (uint32_t)q_errno);
+		LOG("fs get_errno -> %d", q_errno);
+		ret = 0;
+		e = q_errno;
+		break;
+	default:
+		put32(b, 4, (uint32_t)-1);
+		LOG("fs: unknown request %x -> -1", cmd);
+		break;
+	}
+	if (ret < 0) {
+		q_errno = e != 0 ? e : EIO;
+	}
+	mb();
+}
+
+/* listener 10 with its buffer in the pool (once per boot: TZ keeps it) */
+static bool
+fs_register(void)
+{
+	uint64_t ret[3];
+
+	if (q_lsnr_ok || q_lsnr_tried) {
+		return q_lsnr_ok;
+	}
+	q_lsnr_tried = true;
+	bzero(q_va + OFF_LSB, LSB_SIZE);
+	mb();
+	uint64_t a[3] = { FS_LISTENER, QSEE_POOL_PA + OFF_LSB, LSB_SIZE };
+	int64_t x0 = scm_call(FN_REG_LISTENER, 0x83, a, 3, ret);
+	LOG("listener %u: REGISTER (smcinvoke id) buffer %llx %u bytes: x0 %lld, result %d", FS_LISTENER, QSEE_POOL_PA + OFF_LSB,
+	    LSB_SIZE, x0, (int32_t)ret[0]);
+	if (x0 != 0) {
+		x0 = scm_call(FN_REG_LISTENER_OLD, 0x83, a, 3, ret);
+		LOG("listener %u: REGISTER (legacy id): x0 %lld, result %d", FS_LISTENER, x0, (int32_t)ret[0]);
+	}
+	q_lsnr_ok = x0 == 0 && (uint32_t)ret[0] == RES_SUCCESS;
+	LOG("listener %u (file service): %s", FS_LISTENER, q_lsnr_ok ? "registered" : "NOT registered");
+	return q_lsnr_ok;
+}
+
+/* listener 0x7000 (GP file service, minkipc gpfs_msg.h): requests answered in place */
+static void
+gp_serve(void)
+{
+	uint8_t *b = q_va + OFF_GSB;
+	char name[64], name2[64];
+	uint32_t cmd = get32(b, 0);
+	int32_t err = -1;
+	uint32_t n = 0;
+
+	mb();
+	q_fs_reqs++;
+	{
+		/* the first three requests of each command id raw, before anything is answered in place */
+		static uint8_t dumps[16];
+		if (cmd < 16 && dumps[cmd] < 3) {
+			dumps[cmd]++;
+			LOG("gpfs raw request, command %u:", cmd);
+			LOG("gpfs raw +000: %08x %08x %08x %08x %08x %08x %08x %08x", get32(b, 0), get32(b, 4), get32(b, 8),
+			    get32(b, 12), get32(b, 16), get32(b, 20), get32(b, 24), get32(b, 28));
+			LOG("gpfs raw +256: %08x %08x %08x %08x %08x %08x %08x %08x", get32(b, 256), get32(b, 260), get32(b, 264),
+			    get32(b, 268), get32(b, 272), get32(b, 276), get32(b, 280), get32(b, 284));
+		}
+	}
+	if (cmd == 0 && get32(b, 264) > 0 && get32(b, 264) <= GSB_SIZE - 12) {
+		/* this TZ sends its reads with command id 0: a {path; offset; count} read in every other respect */
+		LOG("gpfs: command 0 with a read's shape (offset %d count %u): served as PERSIST_FILE_READ", (int32_t)get32(b, 260),
+		    get32(b, 264));
+		cmd = 8;
+	} else if (cmd == 1 || cmd == 5 || cmd == 9) {
+		/* 0257: command 1 = the old DATA_FILE_WRITE ({path; offset; count; backup; data@272}) */
+		uint32_t count = get32(b, 264);
+		if (count > GSB_SIZE - 272) {
+			/* not a write's shape: take it, store nothing */
+			put32(b, 4, 0);
+			put32(b, 8, count);
+			LOG("gpfs: command %u with count %u does not fit: answered err 0, written %u, NOTHING stored", cmd, count, count);
+			mb();
+			return;
+		}
+		if (cmd == 1) {
+			LOG("gpfs: command 1 (old DATA_FILE_WRITE) served as a write");
+			cmd = 9;
+		}
+	} else if (cmd == 2 || cmd == 3) {
+		LOG("gpfs: command %u (old DATA_FILE_%s) served as such", cmd, cmd == 2 ? "REMOVE" : "RENAME");
+		cmd = cmd == 2 ? 10 : 11;
+	}
+	switch (cmd) {
+	case 4:                                     /* DATA_FILE_READ */
+	case 8: {                                   /* PERSIST_FILE_READ {path; off@260; count@264} -> {err@4; n@8; data@12} */
+		qf_basename(b + 4, name);
+		int32_t off = (int32_t)get32(b, 260);
+		uint32_t count = get32(b, 264);
+		int i = qf_find(name);
+		if (i < 0) {
+			err = -2;
+		} else if (off < 0) {
+			err = -22;
+		} else {
+			struct qfile *f = &q_files[i];
+			count = MIN(count, GSB_SIZE - 12);
+			n = (uint32_t)off < f->len ? MIN(count, f->len - (uint32_t)off) : 0;
+			if (n > 0) {
+				memcpy(b + 12, f->data + off, n);
+			}
+			err = 0;
+		}
+		put32(b, 4, (uint32_t)err);
+		put32(b, 8, n);
+		LOG("gpfs read(%u) %s @%d %u -> err %d, %u bytes", cmd, name, off, get32(b, 264), err, n);
+		break;
+	}
+	case 5:                                     /* DATA_FILE_WRITE */
+	case 9: {                                   /* PERSIST_FILE_WRITE {path; off@260; count@264; backup@268; data@272} */
+		qf_basename(b + 4, name);
+		int32_t off = (int32_t)get32(b, 260);
+		uint32_t count = get32(b, 264), backup = get32(b, 268);
+		int i = qf_find(name);
+		if (off < 0 || count > GSB_SIZE - 272) {
+			err = -22;
+		} else {
+			if (i < 0) {
+				i = qf_create(name);
+			}
+			if (i < 0 || !qf_reserve(i, (uint32_t)off + count, false)) {
+				err = -28;
+			} else {
+				struct qfile *f = &q_files[i];
+				if ((uint32_t)off > f->len) {
+					bzero(f->data + f->len, (uint32_t)off - f->len);
+				}
+				memcpy(f->data + off, b + 272, count);
+				f->len = MAX(f->len, (uint32_t)off + count);
+				f->dirty = true;
+				n = count;
+				err = 0;
+			}
+		}
+		put32(b, 4, (uint32_t)err);
+		put32(b, 8, n);
+		LOG("gpfs write(%u) %s @%d %u backup %u -> err %d, %u bytes (RAM only)", cmd, name, off, count, backup, err, n);
+		break;
+	}
+	case 6:                                     /* DATA_FILE_REMOVE */
+	case 10: {                                  /* PERSIST_FILE_REMOVE {path} -> {err} */
+		qf_basename(b + 4, name);
+		int i = qf_find(name);
+		if (i < 0) {
+			err = -2;
+		} else {
+			qf_free(i);
+			err = 0;
+		}
+		put32(b, 4, (uint32_t)err);
+		LOG("gpfs remove(%u) %s -> err %d (RAM only)", cmd, name, err);
+		break;
+	}
+	case 7:                                     /* DATA_FILE_RENAME */
+	case 11: {                                  /* PERSIST_FILE_RENAME {from[256]; to[256]} -> {err} */
+		qf_basename(b + 4, name);
+		qf_basename(b + 260, name2);
+		int i = qf_find(name), j = qf_find(name2);
+		if (i < 0 || name2[0] == 0) {
+			err = -2;
+		} else {
+			if (j >= 0 && j != i) {
+				qf_free(j);
+			}
+			strlcpy(q_files[i].name, name2, sizeof(q_files[i].name));
+			q_files[i].dirty = true;
+			err = 0;
+		}
+		put32(b, 4, (uint32_t)err);
+		LOG("gpfs rename(%u) %s -> %s: err %d (RAM only)", cmd, name, name2, err);
+		break;
+	}
+	case 12:                                    /* GPFS_VERSION -> {version; err} */
+		put32(b, 4, 2);                         /* GP_FS_VERSION */
+		put32(b, 8, 0);
+		err = 0;
+		LOG("gpfs version -> 2");
+		break;
+	default:
+		put32(b, 4, (uint32_t)-1);
+		LOG("gpfs: unknown request %u (%08x %08x %08x %08x) -> err -1", cmd, get32(b, 0), get32(b, 4), get32(b, 8),
+		    get32(b, 12));
+		break;
+	}
+	mb();
+}
+
+/* listener 0x7000 with its 0x7e000-byte buffer in the pool (once per boot) */
+static bool
+gp_register(void)
+{
+	static bool tried;
+	uint64_t ret[3];
+
+	if (q_gp_ok || tried) {
+		return q_gp_ok;
+	}
+	tried = true;
+	bzero(q_va + OFF_GSB, GSB_SIZE);
+	mb();
+	uint64_t a[3] = { GPFS_LISTENER, QSEE_POOL_PA + OFF_GSB, GSB_SIZE };
+	int64_t x0 = scm_call(FN_REG_LISTENER, 0x83, a, 3, ret);
+	LOG("listener 0x%x: REGISTER (smcinvoke id) buffer %llx %u bytes: x0 %lld, result %d", GPFS_LISTENER,
+	    QSEE_POOL_PA + OFF_GSB, GSB_SIZE, x0, (int32_t)ret[0]);
+	if (x0 != 0) {
+		x0 = scm_call(FN_REG_LISTENER_OLD, 0x83, a, 3, ret);
+		LOG("listener 0x%x: REGISTER (legacy id): x0 %lld, result %d", GPFS_LISTENER, x0, (int32_t)ret[0]);
+	}
+	q_gp_ok = x0 == 0 && (uint32_t)ret[0] == RES_SUCCESS;
+	LOG("listener 0x%x (GP file service): %s", GPFS_LISTENER, q_gp_ok ? "registered" : "NOT registered");
+	return q_gp_ok;
+}
+
+/* ---------------------------------------------------------------- 0253: init and one capture */
+
+/* q_cmd with the caller's fields; the gf result, or ~0u when the call itself failed */
+static uint32_t
+gf_cmd(uint32_t target, uint32_t cmd, uint32_t len, const char *name)
+{
+	q_cmd[0] = 0;
+	put32(q_cmd, 4, target);
+	put32(q_cmd, 8, cmd);
+	put32(q_cmd, 0x0c, 0);
+	if (!gf_send(q_goodix_id, q_cmd, len, name)) {
+		LOG("%s (%u,%u): the call itself failed", name, target, cmd);
+		return ~0u;
+	}
+	uint32_t r = get32(q_cmd, 0x0c);
+	LOG("%s (%u,%u): gf result %u %s", name, target, cmd, r, gf_err_name(r));
+	return r;
+}
+
+/* op 10: the TA restarted with the file listener up, then libgf_hal's init after DETECT */
+static int
+fp_init(void)
+{
+	uint32_t g;
+	const uint64_t t0 = mach_absolute_time();
+
+	q_inited = false;
+	if (!qsee_up()) {
+		return EIO;
+	}
+	if (!fs_register()) {
+		LOG("op 10: no file listener: stop");
+		return EIO;
+	}
+	if (!gp_register()) {
+		LOG("op 10: no GP file listener: stop");
+		return EIO;
+	}
+	int r = milestone(true, false);
+	if (r != 0) {
+		return r;
+	}
+	/* SENSOR_INIT: CustomizedSensor::createInitCmd, locked device, no panel white point, product 3 (sapphire) */
+	bzero(q_cmd, 0x2c0);
+	q_cmd[0x23c] = 0;
+	put32(q_cmd, 0x2a8, 0);
+	put32(q_cmd, 0x2b0, 3);
+	put32(q_cmd, 0x2b4, 12);
+	put32(q_cmd, 0x2b8, 0);
+	q_cmd[0x2bc] = 1;
+	q_cmd[0x2bd] = 0;
+	q_cmd[0x2be] = 1;
+	g = gf_cmd(1002, 2, 0x2c0, "SENSOR_INIT");
+	LOG("SENSOR_INIT: chip type %u (+0x238); config +0x20 %08x %08x %08x %08x crc %08x; +0x138 crc %08x; +0x23d crc %08x",
+	    get32(q_cmd, 0x238), get32(q_cmd, 0x20), get32(q_cmd, 0x24), get32(q_cmd, 0x28), get32(q_cmd, 0x2c),
+	    crc32(0, q_cmd + 0x20, 0x118), crc32(0, q_cmd + 0x138, 0x100), crc32(0, q_cmd + 0x23d, 0x2a));
+	q_auth_retries = get32(q_cmd, 0x40);
+	LOG("SENSOR_INIT: auth retries (+0x40) %u%s", q_auth_retries, q_auth_retries == 0 ? " (op 18 uses 2)" : "");
+	if (g != 0) {
+		goto fail;
+	}
+	/* ALGO_INIT: CustomizedAlgo::init */
+	bzero(q_cmd, 0x30);
+	put32(q_cmd, 0x24, 1);
+	g = gf_cmd(1001, 0, 0x30, "ALGO_INIT");
+	LOG("ALGO_INIT: SPMT flag (+0x24) %u%s, +0x28 %08x%08x", get32(q_cmd, 0x24),
+	    get32(q_cmd, 0x24) != 0 ? " (factory SPMT passed)" : " (NOT passed: the HAL would refuse to authenticate)",
+	    get32(q_cmd, 0x2c), get32(q_cmd, 0x28));
+	if (g != 0) {
+		goto fail;
+	}
+	bzero(q_cmd, 0x1c);
+	g = gf_cmd(1000, 13, 0x1c, "AUTH_INIT_FINISHED");
+	if (g != 0) {
+		goto fail;
+	}
+	bzero(q_cmd, 0x120);
+	put32(q_cmd, 0x1c, 0);
+	strlcpy((char *)q_cmd + 0x20, "/data/vendor_de/0/fpdata", 256);
+	g = gf_cmd(1000, 0, 0x120, "SET_ACTIVE_GROUP");
+	if (g != 0) {
+		goto fail;
+	}
+	q_inited = true;
+	(void)fp_enum("op 10");
+	LOG("op 10: init done in %llu ms (%u file requests so far; sensor awake, op 11 captures, op 12 stops)", ms_since(t0),
+	    q_fs_reqs);
+	return 0;
+fail:
+	LOG("op 10: stopped at gf %u %s after %llu ms (%u file requests); sensor off", g, g == ~0u ? "(call failed)" :
+	    gf_err_name(g), ms_since(t0), q_fs_reqs);
+	fp_power_off();
+	return EIO;
+}
