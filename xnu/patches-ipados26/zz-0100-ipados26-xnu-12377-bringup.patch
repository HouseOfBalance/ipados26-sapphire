+    kHIDUsage_KeyboardM    = 0x10,    /* m or M */
+    kHIDUsage_KeyboardN    = 0x11,    /* n or N */
+    kHIDUsage_KeyboardO    = 0x12,    /* o or O */
+    kHIDUsage_KeyboardP    = 0x13,    /* p or P */
