+/* generated by metal/tools/rd2replay.py from draw.rd: chip 6010001, do not edit */
+#define rp3d_VA_START 0x30000000u
+#define rp3d_VA_END 0x300f1000u
+static const struct { uint32_t va, size; } rp3d_bos[] = {
+	{ 0x30000000, 0x5000 },
+	{ 0x30005000, 0x20000 },
