+ * sapphire 0216: the Silver cluster too (freq-domain0 at 0xf521000), now
+ * that a 4 KiB-page kernel runs it as the E cluster.
+ * sapphire 0328: full 40-row LUT (Snapdragon 685 upper OPPs up to 2.80 GHz
+ * gold / 1.90 GHz silver sit past row 12) and kern.sweet_cpufreq sysctl.
+ * Nothing scales it down again: there is no XNU cpufreq driver yet.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/sysctl.h>
+#include <sys/errno.h>
+#include <kern/locks.h>
+#include <libkern/libkern.h>
+#include <pexpert/pexpert.h>
+#include <machine/machine_routines.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+int sweet_cpufreq_max(void);
+
+#define CPUFREQ_GOLD_PA         0x0f523000u
+#define CPUFREQ_SILVER_PA       0x0f521000u
+#define CPUFREQ_FREQ_LUT        0x110u
+#define CPUFREQ_LUT_ROW         0x20u
+#define CPUFREQ_PERF_STATE      0x920u
+#define CPUFREQ_LUT_MAX         40
+
+struct sweet_cpufreq_domain {
+	const char *name;
+	uint32_t pa;
+	vm_offset_t base;
+};
+
+static struct sweet_cpufreq_domain cpufreq_domains[] = {
+	{ "gold",   CPUFREQ_GOLD_PA,   0 },
+	{ "silver", CPUFREQ_SILVER_PA, 0 },
+};
+
+static LCK_GRP_DECLARE(sweet_cpufreq_grp, "sweet_cpufreq");
+static LCK_MTX_DECLARE(sweet_cpufreq_lock, &sweet_cpufreq_grp);
+
+static vm_offset_t
+sweet_cpufreq_map_locked(struct sweet_cpufreq_domain *dom)
+{
+	if (dom->base == 0) {
+		dom->base = ml_io_map(dom->pa, 0x1000);
+	}
+	return dom->base;
+}
+
+static uint32_t
+sweet_cpufreq_lut_khz(vm_offset_t base, uint32_t row)
+{
+	if (row >= (uint32_t)CPUFREQ_LUT_MAX) {
+		return 0;
+	}
+	uint32_t v = *(volatile uint32_t *)(base + CPUFREQ_FREQ_LUT + row * CPUFREQ_LUT_ROW);
+	uint32_t src = (v >> 30) & 3u, lval = v & 0xffu;
+	return src ? 19200u * lval : 300000u;
+}
+
+static int
+sweet_cpufreq_domain_max_locked(struct sweet_cpufreq_domain *dom)
+{
+	vm_offset_t b = sweet_cpufreq_map_locked(dom);
+	if (b == 0) {
+		return -1;
+	}
+	uint32_t best = 0, bestKHz = 0, prevKHz = 0;
+	for (uint32_t i = 0; i < (uint32_t)CPUFREQ_LUT_MAX; i++) {
+		uint32_t khz = sweet_cpufreq_lut_khz(b, i);
+		if (i > 0 && khz == prevKHz) {
+			break;          /* the LUT repeats its last entry */
+		}
+		prevKHz = khz;
+		if (khz > bestKHz) {
+			bestKHz = khz;
+			best = i;
+		}
+	}
+	uint32_t old = *(volatile uint32_t *)(b + CPUFREQ_PERF_STATE);
+	__asm__ volatile("dsb sy" ::: "memory");
+	*(volatile uint32_t *)(b + CPUFREQ_PERF_STATE) = best;
+	__asm__ volatile("dsb sy" ::: "memory");
+	printf("SWEET CPUFREQ: %s perf state %u -> %u (%u MHz)\n", dom->name, old, best, bestKHz / 1000u);
+	return 0;
+}
+
+static int
+sweet_cpufreq_domain_read_locked(struct sweet_cpufreq_domain *dom, uint32_t *state_out, uint32_t *mhz_out)
+{
+	vm_offset_t b = sweet_cpufreq_map_locked(dom);
+	if (b == 0) {
+		return -1;
+	}
+	uint32_t state = *(volatile uint32_t *)(b + CPUFREQ_PERF_STATE);
+	*state_out = state;
+	*mhz_out = sweet_cpufreq_lut_khz(b, state) / 1000u;
+	return 0;
+}
+
+static int
+sweet_cpufreq_format(char *buf, size_t len)
+{
+	if (len == 0) {
+		return EINVAL;
+	}
+	size_t off = 0;
+	int rc = 0;
+
+	lck_mtx_lock(&sweet_cpufreq_lock);
+	for (size_t i = 0; i < sizeof(cpufreq_domains) / sizeof(cpufreq_domains[0]); i++) {
+		uint32_t state = 0, mhz = 0;
+		if (sweet_cpufreq_domain_read_locked(&cpufreq_domains[i], &state, &mhz) != 0) {
+			rc = ENXIO;
+			break;
+		}
+		int n = snprintf(buf + off, len - off, "%s%s state %u (%u MHz)",
+		    i != 0 ? ", " : "", cpufreq_domains[i].name, state, mhz);
+		if (n < 0) {
+			rc = EIO;
+			break;
+		}
+		if ((size_t)n >= len - off) {
+			rc = ENOMEM;
+			break;
+		}
+		off += (size_t)n;
+	}
+	lck_mtx_unlock(&sweet_cpufreq_lock);
+	return rc;
+}
+
+int
+sweet_cpufreq_max(void)
+{
+	int on = 1;
+	PE_parse_boot_argn("sweetcpufreq", &on, sizeof(on));
+	if (!on) {
+		return 0;
+	}
+	lck_mtx_lock(&sweet_cpufreq_lock);
+	int rc = 0;
+	for (size_t i = 0; i < sizeof(cpufreq_domains) / sizeof(cpufreq_domains[0]); i++) {
+		int err = sweet_cpufreq_domain_max_locked(&cpufreq_domains[i]);
+		if (err != 0 && rc == 0) {
+			rc = err;
+		}
+	}
+	lck_mtx_unlock(&sweet_cpufreq_lock);
+	return rc;
+}
+
+static int
+sysctl_sweet_cpufreq SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	char out[128];
+	int error = sweet_cpufreq_format(out, sizeof(out));
+	if (error != 0) {
+		return error;
+	}
+	error = SYSCTL_OUT(req, out, strlen(out) + 1);
+	if (!error && req->newptr != USER_ADDR_NULL) {
+		if (sweet_cpufreq_max() != 0) {
+			return ENXIO;
+		}
+	}
+	return error;
+}
+
+SYSCTL_PROC(_kern, OID_AUTO, sweet_cpufreq, CTLTYPE_STRING | CTLFLAG_RW | CTLFLAG_LOCKED,
+    0, 0, sysctl_sweet_cpufreq, "A", "active CPU perf state and MHz per cluster (write: re-apply max)");
+#endif /* ARM64_BOARD_CONFIG_SWEET */
diff --git a/bsd/dev/sweet_gpr_dev.c b/bsd/dev/sweet_gpr_dev.c
new file mode 100644
index 0000000..a4fdee8
--- /dev/null
+++ b/bsd/dev/sweet_gpr_dev.c
@@ -0,0 +1,220 @@
+/*
+ * /dev/redwood-gpr: AudioReach packets to the audio DSP from user space, carried by TopazModem's
+ * ADSP thread (which owns the GLINK edge). What Android's GSL sends for a voice call (graph opens,
+ * calibration, VCPM's voice session) is too much and too varied to write out here; a tool replays
+ * it instead (userland/audio/arplay). With it comes 192 KB of memory the DSP reads (mapped to it
+ * once, by SWEET_GPR_SETUP): out-of-band payloads and calibration tables the DSP keeps using while
+ * a graph is open are written there (SWEET_GPR_WRITE) and named by their offset.
+ *
+ *   SWEET_GPR_CALL op 1 setup: the memory mapped to the DSP (info in got[]: handle, size)
+ *                  op 2 one packet: payload[len] in band; with flags & 1 its first 16 bytes are an
+ *                       apm_cmd_header the kernel fills in (address of oob_offset, the map's
+ *                       handle, oob_len). Waits up to wait_ms for GPR_IBASIC_RSP_RESULT naming the
+ *                       opcode (status: its result) or for rsp_opcode (status 0, its words in got[]);
+ *                       status -1: no answer, -3: the DSP crashed
+ *                  op 3 iOS's playback graph: arg 0 closed (it shares the codec DMA interface), 1 open again
+ *                  op 4 the RX macro's digital gains while iOS does not play: arg = EAR dB | AUX dB << 8 (signed)
+ *                  op 5 the record graph (open and prepared) that /dev/redwood-mic starts: dst_port its
+ *                       RD_SHARED_MEM_EP, src_port its client port, payload[len] the in-band
+ *                       GRAPH_START / STOP payload (its subgraph list), arg the buffers' offset
+ *                       (4 of 3840 bytes: 20 ms of 48 kHz 16-bit stereo); 0 bytes: none (stopped first)
+ *                  op 6 the codec's capture path (the handset microphones): arg 1 on, 0 off
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/conf.h>
+#include <sys/uio.h>
+#include <sys/errno.h>
+#include <sys/ioccom.h>
+#include <sys/proc.h>
+#include <miscfs/devfs/devfs.h>
+#include <kern/locks.h>
+
+extern void IOSleep(unsigned int milliseconds);
+
+struct sweet_gpr_cmd {
+	uint32_t op, arg;
+	uint32_t src_port, dst_port, opcode, token, rsp_opcode, wait_ms;
+	uint32_t flags, oob_offset, oob_len, len;
+	int32_t status;
+	uint32_t got_opcode, got_n, got[8];
+	uint8_t payload[512];
+};
+struct sweet_gpr_mem { uint32_t offset, len; uint64_t ptr; };
+
+#define SWEET_GPR_CALL  _IOWR('g', 1, struct sweet_gpr_cmd)
+#define SWEET_GPR_WRITE _IOW('g', 2, struct sweet_gpr_mem)
+#define SWEET_GPR_READ  _IOW('g', 3, struct sweet_gpr_mem)
+
+/* the request on its way to the ADSP thread (TopazModem.cpp gpr_request()) and the memory it mapped */
+struct sweet_gpr_cmd sweet_gpr_req;
+volatile uint32_t sweet_gpr_seq, sweet_gpr_done;
+uint8_t *volatile sweet_gpr_va;
+volatile uint32_t sweet_gpr_size;
+
+void sweet_gpr_dev_init(void);
+
+static LCK_GRP_DECLARE(sg_grp, "sweet_gpr");
+static LCK_MTX_DECLARE(sg_lock, &sg_grp);
+
+static int
+sg_open(__unused dev_t dev, __unused int flags, __unused int devtype, __unused struct proc *p)
+{
+	return 0;
+}
+
+static int
+sg_close(__unused dev_t dev, __unused int flags, __unused int devtype, __unused struct proc *p)
+{
+	return 0;
+}
+
+static int
+sg_ioctl(__unused dev_t dev, u_long cmd, caddr_t data, __unused int flag, __unused struct proc *p)
+{
+	int err = 0;
+
+	if (cmd == SWEET_GPR_WRITE || cmd == SWEET_GPR_READ) {
+		const struct sweet_gpr_mem *m = (const struct sweet_gpr_mem *)data;
+		uint8_t *va = sweet_gpr_va;
+		if (va == NULL) {
+			return ENXIO;
+		}
+		if (m->offset > sweet_gpr_size || m->len > sweet_gpr_size - m->offset) {
+			return EINVAL;
+		}
+		if (cmd == SWEET_GPR_WRITE) {
+			err = copyin((user_addr_t)m->ptr, va + m->offset, m->len);
+			__asm__ volatile("dsb sy" ::: "memory");
+		} else {
+			err = copyout(va + m->offset, (user_addr_t)m->ptr, m->len);
+		}
+		return err;
+	}
+	if (cmd != SWEET_GPR_CALL) {
+		return ENOTTY;
+	}
+	struct sweet_gpr_cmd *c = (struct sweet_gpr_cmd *)data;
+	if (c->len > sizeof(c->payload)) {
+		return EINVAL;
+	}
+	lck_mtx_lock(&sg_lock);
+	uint32_t seq = sweet_gpr_seq + 1;
+	sweet_gpr_req = *c;
+	__asm__ volatile("dmb ish" ::: "memory");
+	sweet_gpr_seq = seq;
+	for (int i = 0; i < 10000 && sweet_gpr_done != seq; i++) {
+		IOSleep(1);
+	}
+	if (sweet_gpr_done == seq) {
+		__asm__ volatile("dmb ish" ::: "memory");
+		*c = sweet_gpr_req;
+	} else {
+		err = ETIMEDOUT;
+	}
+	lck_mtx_unlock(&sg_lock);
+	return err;
+}
+
+/*
+ * /dev/redwood-mic: the main microphone, for RedwoodAudio.driver's "Codec" input (userland/audio
+ * audio_plugin.c codec_read()): 48 kHz 16-bit mono, read() never waits. Open, the DSP's record
+ * graph runs (TopazModem mic_service(), once arplay has set it up: SWEET_GPR_CALL op 5); closed,
+ * it stops.
+ */
+#define SM_RING 16384u                          /* samples, 341 ms */
+static int16_t sm_ring[SM_RING];
+static volatile uint32_t sm_head, sm_tail;
+volatile uint32_t sweet_mic_want;               /* readers open */
+void sweet_mic_put(const int16_t *s, uint32_t n);
+
+void
+sweet_mic_put(const int16_t *s, uint32_t n)
+{
+	uint32_t h = sm_head;
+	if (n > SM_RING - 1 - (h - sm_tail)) {
+		sm_tail = h + n - (SM_RING - 1);        /* the oldest go */
+	}
+	for (uint32_t i = 0; i < n; i++) {
+		sm_ring[(h + i) % SM_RING] = s[i];
+	}
+	__asm__ volatile("dmb ish" ::: "memory");
+	sm_head = h + n;
+}
+
+static int
+sm_open(__unused dev_t dev, __unused int flags, __unused int devtype, __unused struct proc *p)
+{
+	if (sweet_mic_want++ == 0) {
+		sm_tail = sm_head;
+	}
+	return 0;
+}
+
+static int
+sm_close(__unused dev_t dev, __unused int flags, __unused int devtype, __unused struct proc *p)
+{
+	sweet_mic_want = 0;                     /* (d_close: the last close) */
+	return 0;
+}
+
+static int
+sm_read(__unused dev_t dev, struct uio *uio, __unused int ioflag)
+{
+	int16_t buf[512];
+	while (uio_resid(uio) >= 2) {
+		uint32_t t = sm_tail, n = sm_head - t;
+		__asm__ volatile("dmb ish" ::: "memory");
+		if (n == 0) {
+			break;
+		}
+		if (n > 512) {
+			n = 512;
+		}
+		if (n > (uint32_t)(uio_resid(uio) / 2)) {
+			n = (uint32_t)(uio_resid(uio) / 2);
+		}
+		for (uint32_t i = 0; i < n; i++) {
+			buf[i] = sm_ring[(t + i) % SM_RING];
+		}
+		sm_tail = t + n;
+		int err = uiomove((char *)buf, (int)(n * 2), uio);
+		if (err != 0) {
+			return err;
+		}
+	}
+	return 0;
+}
+
+static const struct cdevsw sm_cdevsw = {
+	.d_open = sm_open, .d_close = sm_close, .d_read = sm_read, .d_write = eno_rdwrt, .d_ioctl = eno_ioctl,
+	.d_stop = eno_stop, .d_reset = eno_reset, .d_ttys = NULL, .d_select = eno_select, .d_mmap = eno_mmap,
+	.d_strategy = eno_strat, .d_type = 0,
+};
+
+static const struct cdevsw sg_cdevsw = {
+	.d_open = sg_open, .d_close = sg_close, .d_read = eno_rdwrt, .d_write = eno_rdwrt, .d_ioctl = sg_ioctl,
+	.d_stop = eno_stop, .d_reset = eno_reset, .d_ttys = NULL, .d_select = eno_select, .d_mmap = eno_mmap,
+	.d_strategy = eno_strat, .d_type = 0,
+};
+
+/* with /dev/redwood-audio, once the DSP's playback graph is up (TopazModem audio_test()) */
+void
+sweet_gpr_dev_init(void)
+{
+	static int major = -1;
+	if (major >= 0) {
+		return;
+	}
+	major = cdevsw_add(-1, &sg_cdevsw);
+	if (major < 0) {
+		printf("sweet gpr: no major\n");
+		return;
+	}
+	void *n = devfs_make_node(makedev(major, 0), DEVFS_CHAR, UID_ROOT, GID_WHEEL, 0600, "redwood-gpr");
+	int mmajor = cdevsw_add(-1, &sm_cdevsw);
+	void *m = mmajor >= 0 ? devfs_make_node(makedev(mmajor, 0), DEVFS_CHAR, UID_ROOT, GID_WHEEL, 0666, "redwood-mic") : NULL;
+	printf("sweet gpr: /dev/redwood-gpr %s, /dev/redwood-mic %s\n", n ? "ready" : "failed", m ? "ready" : "failed");
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
diff --git a/bsd/dev/sweet_i2c1.c b/bsd/dev/sweet_i2c1.c
new file mode 100644
index 0000000..d584166
--- /dev/null
+++ b/bsd/dev/sweet_i2c1.c
@@ -0,0 +1,242 @@
+/*
+ * topaz: polled FIFO I2C on QUP0 SE1 (battery bus: SM5602 fuel gauge 0x71,
+ * bq2589x-class charger 0x6a). Values from MakrSas/topaz-woa TopazBattery
+ * (hw.h, hwio.c) and Linux i2c-qcom-geni.c. Read-only use by SweetBattery.
+ * The SE1 RCG is not touched: DFS level 0 already runs from XO (TopazBattery).
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <kern/locks.h>
+#include <kern/clock.h>
+#include <machine/machine_routines.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+int sweet_i2c1_init(void);
+int sweet_i2c1_read(uint8_t addr, uint8_t reg, uint8_t *buf, unsigned len);
+int sweet_i2c1_write(uint8_t addr, const uint8_t *buf, unsigned len);
+
+#define I2C1_SE_PA      0x04a84000u
+#define I2C1_GCC_PA     0x01400000u
+#define I2C1_WEST_PA    0x00500000u     /* TLMM WEST tile: GPIO 4/5 */
+#define I2C1_GCC_VOTE   0x7900cu        /* QUP0 wrapper + SE1 vote, bits 0xbc0 */
+#define I2C1_CBCR       0x1f274u        /* qupv3_wrap0_s1 branch */
+
+#define SE_STATUS       0x040u
+#define SE_MCLK         0x048u
+#define SE_FW           0x068u
+#define SE_CLK_SEL      0x07cu
+#define SE_DMA          0x258u
+#define SE_TX_LEN       0x26cu
+#define SE_RX_LEN       0x270u
+#define SE_SCL          0x278u
+#define SE_CMD          0x600u
+#define SE_CTRL         0x604u
+#define SE_IRQ          0x610u
+#define SE_IRQ_EN       0x614u
+#define SE_IRQ_CLR      0x618u
+#define SE_TX           0x700u
+#define SE_RX           0x780u
+#define SE_TX_COUNT     0x800u
+#define SE_RX_COUNT     0x804u
+#define SE_TX_WM        0x80cu
+#define SE_HW_RX        0xe28u
+#define SE_DONE         (1u << 0)
+#define SE_NACK         (1u << 10)
+#define SE_TX_WM_IRQ    (1u << 30)
+#define SE_ERRORS       (0x3eu | (1u << 9) | (1u << 10) | (1u << 12) | (1u << 13))
+#define SE_PACK0        0x0007f8feu
+#define SE_PACK1        0x000ffefeu
+
+static vm_offset_t i2c1_se, i2c1_gcc, i2c1_west;
+static bool i2c1_ready;
+static LCK_GRP_DECLARE(sweet_i2c1_grp, "sweet_i2c1");
+static LCK_MTX_DECLARE(sweet_i2c1_lock, &sweet_i2c1_grp);
+
+static uint32_t
+rd(vm_offset_t b, uint32_t o)
+{
+	uint32_t v = *(volatile uint32_t *)(b + o);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+static void
+wr(vm_offset_t b, uint32_t o, uint32_t v)
+{
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(b + o) = v;
+	__asm__ volatile("dsb osh" ::: "memory");
+}
+
+static bool
+wait_clear(vm_offset_t b, uint32_t o, uint32_t m)
+{
+	for (unsigned i = 0; i < 5000; ++i) {
+		if (!(rd(b, o) & m)) {
+			return true;
+		}
+		delay(1);
+	}
+	return false;
+}
+
+static void
+i2c1_abort(void)
+{
+	wr(i2c1_se, SE_CTRL, 4);                /* cancel */
+	for (unsigned i = 0; i < 1000 && !(rd(i2c1_se, SE_IRQ) & (1u << 4)); ++i) {
+		delay(1);
+	}
+	if (!(rd(i2c1_se, SE_IRQ) & (1u << 4))) {
+		wr(i2c1_se, SE_CTRL, 2);        /* abort */
+		for (unsigned i = 0; i < 1000 && !(rd(i2c1_se, SE_IRQ) & (1u << 5)); ++i) {
+			delay(1);
+		}
+	}
+	for (unsigned i = 0; i < 64 && (rd(i2c1_se, SE_RX_COUNT) & 0x1ffffffu); ++i) {
+		(void)rd(i2c1_se, SE_RX);
+	}
+	wr(i2c1_se, SE_IRQ_CLR, 0xffffffffu);
+}
+
+/* One message: write nt (<= 3) bytes or read nr (<= 64) bytes. */
+static int
+i2c1_msg(uint8_t addr, const uint8_t *tx, unsigned nt, uint8_t *rx, unsigned nr, bool stretch)
+{
+	unsigned sent = 0, got = 0;
+	if (!wait_clear(i2c1_se, SE_STATUS, 1u)) {
+		return EBUSY;
+	}
+	wr(i2c1_se, SE_IRQ_CLR, 0xffffffffu);
+	wr(i2c1_se, SE_TX_WM, nt ? 1u : 0u);
+	wr(i2c1_se, nr ? SE_RX_LEN : SE_TX_LEN, nr ? nr : nt);
+	wr(i2c1_se, SE_CMD, ((nr ? 2u : 1u) << 27) | ((uint32_t)addr << 9) | (stretch ? 4u : 0u));
+	for (unsigned i = 0; i < 20000; ++i) {
+		uint32_t irq = rd(i2c1_se, SE_IRQ);
+		if (irq & SE_ERRORS) {
+			int err = (irq & SE_NACK) ? ENXIO : EIO;
+			for (unsigned j = 0; j < 2000 && !(irq & SE_DONE); ++j) {
+				delay(1);
+				irq = rd(i2c1_se, SE_IRQ);
+			}
+			if (!(irq & SE_DONE) || (rd(i2c1_se, SE_STATUS) & 1u)) {
+				i2c1_abort();
+			}
+			wr(i2c1_se, SE_IRQ_CLR, 0xffffffffu);
+			return err;
+		}
+		if (nt && !sent && (irq & SE_TX_WM_IRQ)) {
+			uint32_t word = 0;
+			for (unsigned j = 0; j < nt; ++j) {
+				word |= (uint32_t)tx[j] << (8u * j);
+			}
+			wr(i2c1_se, SE_TX, word);
+			sent = nt;
+			wr(i2c1_se, SE_TX_WM, 0);
+		}
+		uint32_t count = rd(i2c1_se, SE_RX_COUNT) & 0x1ffffffu;
+		if (count > 16) {
+			break;
+		}
+		while (count--) {
+			uint32_t word = rd(i2c1_se, SE_RX);
+			for (unsigned j = 0; j < 4 && got < nr; ++j) {
+				rx[got++] = (uint8_t)(word >> (8u * j));
+			}
+		}
+		if (irq & SE_DONE) {
+			wr(i2c1_se, SE_IRQ_CLR, 0xffffffffu);
+			return (got == nr && sent == nt) ? 0 : EIO;
+		}
+		wr(i2c1_se, SE_IRQ_CLR, irq & ~SE_DONE);
+		delay(1);
+	}
+	i2c1_abort();
+	return ETIMEDOUT;
+}
+
+int
+sweet_i2c1_read(uint8_t addr, uint8_t reg, uint8_t *buf, unsigned len)
+{
+	if (!i2c1_ready || len == 0 || len > 64) {
+		return ENXIO;
+	}
+	lck_mtx_lock(&sweet_i2c1_lock);
+	int err = i2c1_msg(addr, &reg, 1, NULL, 0, true);
+	if (!err) {
+		err = i2c1_msg(addr, NULL, 0, buf, len, false);
+	}
+	lck_mtx_unlock(&sweet_i2c1_lock);
+	return err;
+}
+
+/* One write of up to 3 bytes (register, then data): the speaker amplifiers (TopazModem audio). */
+int
+sweet_i2c1_write(uint8_t addr, const uint8_t *buf, unsigned len)
+{
+	if (!i2c1_ready || len == 0 || len > 3) {
+		return ENXIO;
+	}
+	lck_mtx_lock(&sweet_i2c1_lock);
+	int err = i2c1_msg(addr, buf, len, NULL, 0, false);
+	lck_mtx_unlock(&sweet_i2c1_lock);
+	return err;
+}
+
+int
+sweet_i2c1_init(void)
+{
+	if (i2c1_ready) {
+		return 0;
+	}
+	i2c1_gcc = ml_io_map(I2C1_GCC_PA, 0x80000);
+	i2c1_west = ml_io_map(I2C1_WEST_PA, 0x6000);
+	i2c1_se = ml_io_map(I2C1_SE_PA, 0x4000);
+	if (!i2c1_gcc || !i2c1_west || !i2c1_se) {
+		return ENOMEM;
+	}
+	/* OR our votes in: other bits of the shared register belong to others */
+	wr(i2c1_gcc, I2C1_GCC_VOTE, rd(i2c1_gcc, I2C1_GCC_VOTE) | 0xbc0u);
+	if (!wait_clear(i2c1_gcc, I2C1_CBCR, 1u << 31)) {
+		printf("SWEET I2C1: SE1 clock off (cbcr %#x)\n", rd(i2c1_gcc, I2C1_CBCR));
+		return EIO;
+	}
+	/* GPIO4/5: function 1 (qup1), 2 mA, no pull (TopazBattery CTL 0x4) */
+	wr(i2c1_west, 0x4000, (rd(i2c1_west, 0x4000) & ~0x3ffu) | 0x4u);
+	wr(i2c1_west, 0x5000, (rd(i2c1_west, 0x5000) & ~0x3ffu) | 0x4u);
+
+	uint32_t fw = rd(i2c1_se, SE_FW), rxp = rd(i2c1_se, SE_HW_RX);
+	if (((fw >> 8) & 0xffu) != 3u || (rd(i2c1_se, SE_STATUS) & 0x1001u)) {
+		printf("SWEET I2C1: SE1 not an idle I2C engine (fw %#x status %#x)\n",
+		    fw, rd(i2c1_se, SE_STATUS));
+		return EIO;
+	}
+	wr(i2c1_se, 0xe18, 0);
+	wr(i2c1_se, 0xe1c, 0);
+	wr(i2c1_se, 0x644, 0);
+	wr(i2c1_se, SE_IRQ_CLR, 0xffffffffu);
+	wr(i2c1_se, 0x648, 0xffffffffu);
+	wr(i2c1_se, SE_DMA, 0);
+	wr(i2c1_se, 0x28, rd(i2c1_se, 0x28) | 0x7fu);
+	wr(i2c1_se, 0xe30, rd(i2c1_se, 0xe30) | 0x0fu);
+	wr(i2c1_se, 0x24, 0x7f);
+	wr(i2c1_se, 0x20, 1);
+	wr(i2c1_se, SE_CLK_SEL, 0);
+	wr(i2c1_se, SE_MCLK, (2u << 4) | 1u);                  /* 400 kHz from 19.2 MHz */
+	wr(i2c1_se, SE_SCL, (5u << 20) | (11u << 10) | 22u);
+	wr(i2c1_se, 0x254, 0);
+	wr(i2c1_se, 0x260, SE_PACK0);
+	wr(i2c1_se, 0x264, SE_PACK1);
+	wr(i2c1_se, 0x284, SE_PACK0);
+	wr(i2c1_se, 0x288, SE_PACK1);
+	wr(i2c1_se, SE_TX_WM, 0);
+	wr(i2c1_se, 0x810, 0);
+	wr(i2c1_se, 0x814, ((rxp >> 16) & 0x3fu) - 1u);
+	wr(i2c1_se, SE_IRQ_EN, SE_DONE | SE_ERRORS | (3u << 26) | SE_TX_WM_IRQ);
+	i2c1_ready = true;
+	printf("SWEET I2C1: SE1 ready (fw %#x vote %#x)\n", fw, rd(i2c1_gcc, I2C1_GCC_VOTE));
+	return 0;
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
diff --git a/bsd/dev/sweet_inject.c b/bsd/dev/sweet_inject.c
new file mode 100644
index 0000000..9d07edc
--- /dev/null
+++ b/bsd/dev/sweet_inject.c
@@ -0,0 +1,66 @@
+/*
+ * sapphire 0237: touches and buttons written to a sysctl, into the same path as the panel's and
+ * the keys' own (SweetHID.cpp), for testing animations with no hand on the phone
+ * (userland/tests/hidtouch.c). kern.sweet_inject takes a string:
+ *   "t FINGER DOWN X Y"   a contact, in panel pixels (1080 x 2400), DOWN 1 or 0
+ *   "k KEY DOWN"          0 power, 1 volume up, 2 volume down, 3 home
+ * Root only (CTLFLAG_ANYBODY not set).
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/sysctl.h>
+#include <sys/errno.h>
+
+extern void sweet_hid_touch(int finger, int down, int x, int y);
+extern void sweet_hid_key(int key, int down);
+
+static int
+sweet_inject_int(const char **p, int *out)
+{
+	const char *s = *p;
+	int sign = 1, v = 0, digits = 0;
+
+	while (*s == ' ') {
+		s++;
+	}
+	if (*s == '-') {
+		sign = -1;
+		s++;
+	}
+	while (*s >= '0' && *s <= '9' && digits < 9) {
+		v = v * 10 + (*s++ - '0');
+		digits++;
+	}
+	*p = s;
+	*out = sign * v;
+	return digits > 0;
+}
+
+static int
+sysctl_sweet_inject SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	char buf[64] = "";
+	int changed = 0;
+	int error = sysctl_io_string(req, buf, sizeof(buf), 0, &changed);
+	if (error != 0 || !changed) {
+		return error;
+	}
+	const char *p = buf + 1;
+	int a, b, c, d;
+	if (buf[0] == 't' && sweet_inject_int(&p, &a) && sweet_inject_int(&p, &b) &&
+	    sweet_inject_int(&p, &c) && sweet_inject_int(&p, &d)) {
+		sweet_hid_touch(a, b, c, d);
+		return 0;
+	}
+	if (buf[0] == 'k' && sweet_inject_int(&p, &a) && sweet_inject_int(&p, &b)) {
+		sweet_hid_key(a, b);
+		return 0;
+	}
+	return EINVAL;
+}
+
+SYSCTL_PROC(_kern, OID_AUTO, sweet_inject, CTLTYPE_STRING | CTLFLAG_RW | CTLFLAG_LOCKED,
+    0, 0, sysctl_sweet_inject, "A", "a synthetic touch (t FINGER DOWN X Y) or button (k KEY DOWN)");
+#endif /* ARM64_BOARD_CONFIG_SWEET */
diff --git a/bsd/dev/sweet_keys.c b/bsd/dev/sweet_keys.c
new file mode 100644
index 0000000..82fa076
--- /dev/null
+++ b/bsd/dev/sweet_keys.c
@@ -0,0 +1,234 @@
+/*
+ * Minimal polled SWEET keys. Call once after the scheduler is running.
+ * See hw-report.md: volume-up is PM6150L SID 4, NOT PM6150 SID 0.
+ * PMIC access is READ ONLY: the sole MMIO write issues EXT_READL on an
+ * observer channel. No PMIC config, IRQ acknowledge or reset writes exist.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/sysctl.h>
+#include <sys/errno.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern void sweet_hid_key(int key, int down);
+extern int sweet_splash_active;         /* osfmk/console/video_console.c (0299): the boot screen is up */
+extern void sweet_reboot_mode_set(int mode);
+extern int reboot_kernel(int howto, char *message);
+void sweet_keys_init(void);
+
+/* topaz (SM6225, sm6125.dtsi spmi_bus; PM6125 USID 0): PON 0x800, Vol+ = GPIO5 */
+#define KEYS_CORE_PA     0x01c40000u
+#define KEYS_OBS_PA      0x03e00000u
+#define KEYS_CNFG_PA     0x01c0a000u
+#define KEYS_PON_RT      0x0810u
+#define KEYS_GPIO_RT     0xc410u
+#define KEYS_NO_APID     0xffffu
+
+static vm_offset_t keys_core, keys_obs, keys_cnfg;
+static uint16_t keys_pon_apid = KEYS_NO_APID, keys_gpio_apid = KEYS_NO_APID;
+static uint32_t keys_version, keys_last_status;
+static bool keys_started;
+static int keys_sleep_chan;
+
+static uint32_t
+keys_rd(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+/* v5 can map one PPID more than once; prefer the apps-owned entry. */
+static uint16_t
+keys_find_apid(uint16_t ppid, uint32_t count)
+{
+	uint16_t found = KEYS_NO_APID;
+	for (uint32_t i = 0; i < count; ++i) {
+		uint32_t map = keys_rd(keys_core, 0x900u + 4u * i);
+		if (map == 0 || ((map >> 8) & 0xfffu) != ppid) {
+			continue;
+		}
+		uint32_t owner = keys_rd(keys_cnfg, 0x700u + 4u * i) & 7u;
+		if (found == KEYS_NO_APID || owner == 0) {
+			found = (uint16_t)i;
+		}
+	}
+	return found;
+}
+
+void sweet_spmi_bus_lock(void);         /* sweet_spmi.c (0214): one reader of the observer at a time */
+void sweet_spmi_bus_unlock(void);
+static bool keys_read_locked(uint16_t apid, uint16_t addr, uint8_t *out);
+
+static bool
+keys_read(uint16_t apid, uint16_t addr, uint8_t *out)
+{
+	if (apid == KEYS_NO_APID) {
+		return false;
+	}
+	sweet_spmi_bus_lock();
+	bool ok = keys_read_locked(apid, addr, out);
+	sweet_spmi_bus_unlock();
+	return ok;
+}
+
+static bool
+keys_read_locked(uint16_t apid, uint16_t addr, uint8_t *out)
+{
+	uint32_t off = 0x80u * apid; /* obs + EE(0)*0x10000 */
+	uint32_t cmd = (1u << 27) | ((uint32_t)(addr & 0xffu) << 4);
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(keys_obs + off) = cmd; /* EXT_READL, one byte */
+	__asm__ volatile("dsb osh" ::: "memory");
+	for (unsigned i = 0; i < 1000; ++i) {
+		keys_last_status = keys_rd(keys_obs, off + 0x08u);
+		if (keys_last_status & 1u) {
+			if (keys_last_status & 0x0eu) {
+				return false;
+			}
+			*out = (uint8_t)keys_rd(keys_obs, off + 0x18u);
+			return true;
+		}
+		delay(1);
+	}
+	return false;
+}
+
+static void
+keys_wait(void)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(20, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&keys_sleep_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static void
+keys_thread(void *arg, wait_result_t result)
+{
+	int state[3] = {0, 0, 0}, seen[3] = {0, 0, 0};
+	unsigned errors = 0;
+	(void)arg;
+	(void)result;
+	for (;;) {
+		uint8_t pon = 0, gpio = 0;
+		bool pok = keys_read(keys_pon_apid, KEYS_PON_RT, &pon);
+		bool gok = keys_read(keys_gpio_apid, KEYS_GPIO_RT, &gpio);
+		int now[3] = {!!(pon & 1u), !(gpio & 1u), !!(pon & 2u)};
+		if (!pok || !gok) {
+			if ((errors++ % 250u) == 0) {
+				printf("SWEET KEYS: read error pon-ok=%d gpio-ok=%d arb-status=%#x\n",
+				    pok, gok, keys_last_status);
+			}
+		} else {
+			errors = 0;
+		}
+		for (int k = 0; k < 3; ++k) {
+			/* 0214: a change counts once two polls in a row (40 ms) agree on it */
+			bool ok = k == 1 ? gok : pok;
+			bool agreed = ok && now[k] == seen[k];
+			if (ok) {
+				seen[k] = now[k];
+			}
+			if (agreed && now[k] != state[k]) {
+				state[k] = now[k];
+				printf("SWEET KEYS: key=%d down=%d pon=%#x gpio4:c110=%#x\n",
+				    k, state[k], pon, gpio);
+				sweet_hid_key(k, state[k]);
+				/* 0299: Volume up during the boot screen restarts into recovery (as Power + Volume up) */
+				if (k == 1 && state[k] && sweet_splash_active) {
+					printf("SWEET KEYS: Volume up on the boot screen: restarting into recovery\n");
+					sweet_reboot_mode_set(1);
+					(void)reboot_kernel(0, (char *)"Volume up on the boot screen: recovery");
+				}
+			}
+		}
+		keys_wait();
+	}
+}
+
+void
+sweet_keys_init(void)
+{
+	int enabled = 1;
+	thread_t thread;
+	if (keys_started) {
+		return;
+	}
+	keys_started = true;
+	(void)PE_parse_boot_argn("sweetkeys", &enabled, sizeof(enabled));
+	if (!enabled) {
+		printf("SWEET KEYS: disabled (sweetkeys=0)\n");
+		return;
+	}
+	keys_core = ml_io_map(KEYS_CORE_PA, 0x2000);
+	keys_cnfg = ml_io_map(KEYS_CNFG_PA, 0x1000);
+	keys_obs = ml_io_map(KEYS_OBS_PA, 0x10000);
+	if (!keys_core || !keys_cnfg || !keys_obs) {
+		printf("SWEET KEYS: MMIO mapping failed\n");
+		return;
+	}
+	keys_version = keys_rd(keys_core, 0);
+	uint32_t count = keys_rd(keys_core, 4) & 0x7ffu;
+	if (keys_version < 0x50000000u || keys_version >= 0x70000000u ||
+	    count == 0 || count > 512) {
+		printf("SWEET KEYS: unsupported arbiter version=%#x apids=%u\n",
+		    keys_version, count);
+		return;
+	}
+	keys_pon_apid = keys_find_apid(0x008, count);
+	keys_gpio_apid = keys_find_apid(0x0c4, count);
+	uint8_t pon = 0, gpio = 0, mode = 0, en = 0, subtype = 0;
+	bool pok = keys_read(keys_pon_apid, KEYS_PON_RT, &pon);
+	bool gok = keys_read(keys_gpio_apid, KEYS_GPIO_RT, &gpio);
+	bool mok = keys_read(keys_gpio_apid, 0xc440, &mode);
+	bool eok = keys_read(keys_gpio_apid, 0xc446, &en);
+	bool sok = keys_read(keys_gpio_apid, 0xc405, &subtype);
+	printf("SWEET KEYS: arb=%#x apids=%u pon-apid=%u gpio4-apid=%u pon=%#x/%d gpio=%#x/%d mode=%#x/%d en=%#x/%d subtype=%#x/%d\n",
+	    keys_version, count, keys_pon_apid, keys_gpio_apid,
+	    pon, pok, gpio, gok, mode, mok, en, eok, subtype, sok);
+	/* GPIO configuration belongs to firmware. Diagnose, never repair it here. */
+	unsigned dir = subtype >= 0x10u && subtype <= 0x13u ?
+	    mode & 3u : (mode >> 4) & 7u;
+	if (!eok || !mok || !sok || !(en & 0x80u) || (dir != 0 && dir != 2)) {
+		printf("SWEET KEYS: GPIO5 not confirmed enabled as input; volume-up withheld, PMIC unchanged\n");
+		keys_gpio_apid = KEYS_NO_APID;
+	}
+	if (!pok && !gok) {
+		printf("SWEET KEYS: no readable keys; polling retained for recovery\n");
+	}
+	kern_return_t kr = kernel_thread_start(keys_thread, NULL, &thread);
+	if (kr == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		printf("SWEET KEYS: kernel_thread_start failed %d\n", kr);
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
+
+/* 0319: which Metal plug-in the accelerator names (SweetFramebuffer.cpp sweet_metal_plugin): 1 SapphireMetal, 2 HakiosMetal */
+extern int sweet_metal_plugin(int set);
+
+static int
+sysctl_sweet_metal SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	int v = sweet_metal_plugin(-1), changed = 0;
+	int error = sysctl_io_number(req, v, sizeof(v), &v, &changed);
+	if (error || !changed) {
+		return error;
+	}
+	if (v < 0 || v > 2) {
+		return EINVAL;
+	}
+	(void)sweet_metal_plugin(v);
+	return 0;
+}
+SYSCTL_PROC(_kern, OID_AUTO, sweet_metal, CTLTYPE_INT | CTLFLAG_RW | CTLFLAG_LOCKED,
+    0, 0, sysctl_sweet_metal, "I", "sapphire: the Metal plug-in the accelerator names: 0 none, 1 SapphireMetal, 2 HakiosMetal");
diff --git a/bsd/dev/sweet_pdp.c b/bsd/dev/sweet_pdp.c
new file mode 100644
index 0000000..2b23757
--- /dev/null
+++ b/bsd/dev/sweet_pdp.c
@@ -0,0 +1,219 @@
+/*
+ * sapphire 0232: pdp_ip0, the cellular data interface.
+ *
+ * A raw IP point-to-point interface (no link layer, like utun without its 4-byte family header)
+ * over the modem's data call: packets leaving through it go to the IPA's modem TX endpoint behind a
+ * QMAP header for mux 1 (topaz_ipa_send, TopazModem.cpp); IPv4/IPv6 packets the IPA delivers for
+ * mux 1 come in through sweet_pdp_input(). The address, the peer and the default route are set from
+ * user space (qmitool datacall: SIOCAIFADDR and a routing socket RTM_ADD), as for any interface.
+ * Apple names its cellular interfaces pdp_ipN, and parts of iOS look for that name.
+ */
+#include <stdbool.h>
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <sys/sockio.h>
+#include <sys/sysctl.h>
+#include <sys/kpi_mbuf.h>
+#include <net/if.h>
+#include <net/if_types.h>
+#include <net/kpi_interface.h>
+#include <net/kpi_protocol.h>
+#include <netinet/in.h>
+
+#define PDP_MUX         1
+#define PDP_MTU         1500
+
+extern int topaz_ipa_send(const uint8_t *pkt, uint32_t len, uint8_t mux);
+
+void sweet_pdp_create(void);
+void sweet_pdp_input(const uint8_t *pkt, uint32_t len);
+
+static ifnet_t pdp_ifp;
+static uint64_t pdp_in, pdp_out, pdp_drops;
+
+static errno_t
+pdp_output(ifnet_t ifp, mbuf_t m)
+{
+	uint8_t buf[PDP_MTU + 64];
+	size_t len = mbuf_pkthdr_len(m);
+
+	if (len == 0 || len > sizeof(buf) || mbuf_copydata(m, 0, len, buf) != 0) {
+		mbuf_freem(m);
+		ifnet_stat_increment_out(ifp, 0, 0, 1);
+		return 0;
+	}
+	mbuf_freem(m);
+	if (topaz_ipa_send(buf, (uint32_t)len, PDP_MUX) != 0) {
+		pdp_drops++;
+		ifnet_stat_increment_out(ifp, 0, 0, 1);
+		return 0;
+	}
+	pdp_out++;
+	ifnet_stat_increment_out(ifp, 1, (uint32_t)len, 0);
+	return 0;
+}
+
+static errno_t
+pdp_demux(ifnet_t ifp __unused, mbuf_t m, char *frame_header __unused, protocol_family_t *protocol)
+{
+	while (m != NULL && mbuf_len(m) < 1) {
+		m = mbuf_next(m);
+	}
+	if (m == NULL) {
+		return ENOENT;
+	}
+	uint8_t v = *(uint8_t *)mbuf_data(m) >> 4;
+	if (v == 4) {
+		*protocol = PF_INET;
+	} else if (v == 6) {
+		*protocol = PF_INET6;
+	} else {
+		return ENOENT;
+	}
+	return 0;
+}
+
+static errno_t
+pdp_add_proto(ifnet_t ifp __unused, protocol_family_t protocol, const struct ifnet_demux_desc *d __unused,
+    u_int32_t n __unused)
+{
+	return (protocol == PF_INET || protocol == PF_INET6) ? 0 : ENOPROTOOPT;
+}
+
+static errno_t
+pdp_del_proto(ifnet_t ifp __unused, protocol_family_t protocol __unused)
+{
+	return 0;
+}
+
+static errno_t
+pdp_ioctl(ifnet_t ifp, unsigned long cmd, void *data)
+{
+	switch (cmd) {
+	case SIOCSIFADDR:
+	case SIOCAIFADDR:
+	case SIOCSIFDSTADDR:
+		ifnet_set_flags(ifp, IFF_UP | IFF_RUNNING, IFF_UP | IFF_RUNNING);
+		return 0;
+	case SIOCSIFMTU:
+		ifnet_set_mtu(ifp, ((struct ifreq *)data)->ifr_mtu);
+		return 0;
+	case SIOCSIFFLAGS:
+	case SIOCADDMULTI:
+	case SIOCDELMULTI:
+		return 0;
+	default:
+		return EOPNOTSUPP;
+	}
+}
+
+static void
+pdp_detach(ifnet_t ifp __unused)
+{
+}
+
+static errno_t
+pdp_proto_input(ifnet_t ifp __unused, protocol_family_t protocol, mbuf_t m, char *frame_header __unused)
+{
+	if (proto_input(protocol, m) != 0) {
+		mbuf_freem(m);
+	}
+	return 0;
+}
+
+static errno_t
+pdp_pre_output(ifnet_t ifp __unused, protocol_family_t protocol __unused, mbuf_t *m __unused,
+    const struct sockaddr *dest __unused, void *route __unused, char *frame_type __unused, char *link_dest __unused)
+{
+	return 0;
+}
+
+/* TopazModem, once the IPA's modem endpoints run */
+void
+sweet_pdp_create(void)
+{
+	struct ifnet_init_eparams init;
+	struct ifnet_attach_proto_param proto;
+
+	if (pdp_ifp != NULL) {
+		return;
+	}
+	bzero(&init, sizeof(init));
+	init.ver = IFNET_INIT_CURRENT_VERSION;
+	init.len = sizeof(init);
+	init.flags = IFNET_INIT_LEGACY;
+	init.uniqueid = "sweet-pdp-ip0";
+	init.uniqueid_len = sizeof("sweet-pdp-ip0") - 1;
+	init.name = "pdp_ip";
+	init.unit = 0;
+	init.family = IFNET_FAMILY_CELLULAR;
+	init.type = IFT_CELLULAR;
+	init.output = pdp_output;
+	init.demux = pdp_demux;
+	init.add_proto = pdp_add_proto;
+	init.del_proto = pdp_del_proto;
+	init.ioctl = pdp_ioctl;
+	init.detach = pdp_detach;
+	if (ifnet_allocate_extended(&init, &pdp_ifp) != 0) {
+		printf("SWEET PDP: ifnet_allocate failed\n");
+		pdp_ifp = NULL;
+		return;
+	}
+	ifnet_set_mtu(pdp_ifp, PDP_MTU);
+	ifnet_set_flags(pdp_ifp, IFF_POINTOPOINT | IFF_MULTICAST, 0xffff);
+	if (ifnet_attach(pdp_ifp, NULL) != 0) {
+		printf("SWEET PDP: ifnet_attach failed\n");
+		ifnet_release(pdp_ifp);
+		pdp_ifp = NULL;
+		return;
+	}
+	bzero(&proto, sizeof(proto));
+	proto.input = pdp_proto_input;
+	proto.pre_output = pdp_pre_output;
+	errno_t e4 = ifnet_attach_protocol(pdp_ifp, PF_INET, &proto);
+	errno_t e6 = ifnet_attach_protocol(pdp_ifp, PF_INET6, &proto);
+	printf("SWEET PDP: pdp_ip0 attached (inet %d, inet6 %d)\n", e4, e6);
+}
+
+/* the modem thread: one IP packet the IPA delivered for our mux */
+void
+sweet_pdp_input(const uint8_t *pkt, uint32_t len)
+{
+	mbuf_t m = NULL;
+
+	if (pdp_ifp == NULL || len == 0 || len > PDP_MTU + 64) {
+		return;
+	}
+	if (mbuf_gethdr(MBUF_DONTWAIT, MBUF_TYPE_DATA, &m) != 0 ||
+	    mbuf_mclget(MBUF_DONTWAIT, MBUF_TYPE_DATA, &m) != 0 ||
+	    !(mbuf_flags(m) & MBUF_EXT) || mbuf_maxlen(m) < len) {
+		if (m != NULL) {
+			mbuf_freem(m);
+		}
+		pdp_drops++;
+		return;
+	}
+	struct ifnet_stat_increment_param stats = {};
+	memcpy(mbuf_data(m), pkt, len);
+	mbuf_setlen(m, len);
+	mbuf_pkthdr_setlen(m, len);
+	mbuf_pkthdr_setrcvif(m, pdp_ifp);
+	mbuf_pkthdr_setheader(m, mbuf_data(m));
+	stats.packets_in = 1;
+	stats.bytes_in = len;
+	pdp_in++;
+	ifnet_input(pdp_ifp, m, &stats);
+}
+
+static int
+sysctl_sweet_pdp_stats SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	char buf[128];
+	snprintf(buf, sizeof(buf), "pdp_ip0 %s: in %llu, out %llu, drops %llu", pdp_ifp != NULL ? "attached" : "absent",
+	    pdp_in, pdp_out, pdp_drops);
+	return SYSCTL_OUT(req, buf, strlen(buf) + 1);
+}
+SYSCTL_PROC(_kern, OID_AUTO, sweet_pdp_stats, CTLTYPE_STRING | CTLFLAG_RD | CTLFLAG_LOCKED,
+    0, 0, sysctl_sweet_pdp_stats, "A", "pdp_ip0 packet counts");
diff --git a/bsd/dev/sweet_qmi_dev.c b/bsd/dev/sweet_qmi_dev.c
new file mode 100644
index 0000000..abb1841
--- /dev/null
+++ b/bsd/dev/sweet_qmi_dev.c
@@ -0,0 +1,500 @@
+/*
+ * /dev/redwood-qmi0 .. /dev/redwood-qmi31: QMI to the modem for userland (IMEI, SIM, network,
+ * SMS), the way Linux's AF_QIPCRTR sockets give it to libqmi / rild. The kernel only carries
+ * messages: each node is one QRTR client port on the apps node (a fresh one from 0x3000..0x3fff at
+ * every open, 0222), opened by one process at a time.
+ *   write(): struct sweet_qmi_hdr {node, port} + one QMI message (type, txn, msg id, length,
+ *            TLVs), queued and sent by TopazModem's modem thread (it owns the GLINK FIFO).
+ *   read():  the next message for this port, with the sender's {node, port} in front; blocks
+ *            unless O_NONBLOCK; select() works.
+ *   ioctl SWEET_QMI_LOOKUP: the index-th server of a QMI service (inst ~0 = any instance), as
+ *            the modem announced it with QRTR NEW_SERVER.
+ * close() tells the modem the client is gone (QRTR DEL_CLIENT), so services drop its state.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <stdbool.h>
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/conf.h>
+#include <sys/uio.h>
+#include <sys/errno.h>
+#include <sys/fcntl.h>
+#include <sys/ioccom.h>
+#include <sys/proc.h>
+#include <sys/select.h>
+#include <sys/sysctl.h>
+#include <sys/vnode.h>
+#include <miscfs/devfs/devfs.h>
+#include <kern/locks.h>
+#include <kern/kalloc.h>
+
+#define SQ_SLOTS        32                      /* 0222: CommCenter opens one per QMI service and channel */
+#define SQ_PORT0        0x3000u
+#define SQ_MAX_MSG      0x4000u                 /* the modem's own intent size is 0x4400 */
+#define SQ_RXQ          64                      /* messages waiting per port */
+#define SQ_TXQ          64
+
+struct sweet_qmi_hdr { uint32_t node, port; };
+struct sweet_qmi_lookup { uint32_t svc, inst, index, node, port, found_inst; };
+#define SWEET_QMI_LOOKUP        _IOWR('q', 1, struct sweet_qmi_lookup)
+#define SWEET_QMI_PORT          _IOR('q', 2, uint32_t)
+
+struct sq_msg { uint32_t src, node, port, len, ctrl; uint8_t *data; };
+struct sq_slot {
+	bool open;
+	uint32_t port;                  /* 0222: a fresh QRTR port at every open, as Linux's sockets */
+	uint32_t head, tail;                    /* rx ring, wrapping counters */
+	struct sq_msg rx[SQ_RXQ];
+	struct selinfo sel;
+	uint64_t dropped;
+};
+
+static LCK_GRP_DECLARE(sq_grp, "sweet_qmi");
+static LCK_MTX_DECLARE(sq_mtx, &sq_grp);
+static struct sq_slot sq_slots[SQ_SLOTS];
+static struct sq_msg sq_tx[SQ_TXQ];
+static uint32_t sq_tx_head, sq_tx_tail;
+static uint32_t sq_next_port = SQ_PORT0;
+
+int sweet_qmi_deliver(uint32_t dst_port, uint32_t node, uint32_t port, const uint8_t *data, uint32_t len);
+void sweet_qmi_pump(void (*send)(uint32_t src_port, uint32_t node, uint32_t port, const void *data, uint32_t len, int ctrl));
+void sweet_qmi_dev_init(void);
+extern int topaz_qmi_lookup(uint32_t svc, uint32_t inst, uint32_t index, uint32_t *node, uint32_t *port, uint32_t *found_inst);
+
+static void
+sq_free(struct sq_msg *m)
+{
+	if (m->data != NULL) {
+		kfree_data(m->data, m->len);
+		m->data = NULL;
+	}
+}
+
+/* modem thread: a QRTR data message arrived for dst_port; true if it is one of ours */
+int
+sweet_qmi_deliver(uint32_t dst_port, uint32_t node, uint32_t port, const uint8_t *data, uint32_t len)
+{
+	if (dst_port < SQ_PORT0 || dst_port >= SQ_PORT0 + 0x1000) {
+		return 0;
+	}
+	if (len == 0 || len > SQ_MAX_MSG) {
+		return 1;
+	}
+	uint8_t *copy = kalloc_data(len, Z_WAITOK);
+	if (copy == NULL) {
+		return 1;
+	}
+	memcpy(copy, data, len);
+	lck_mtx_lock(&sq_mtx);
+	struct sq_slot *s = NULL;
+	for (int i = 0; i < SQ_SLOTS; i++) {
+		if (sq_slots[i].open && sq_slots[i].port == dst_port) {
+			s = &sq_slots[i];
+		}
+	}
+	if (s == NULL) {
+		lck_mtx_unlock(&sq_mtx);
+		kfree_data(copy, len);
+		return 1;               /* a closed client's port: dropped */
+	}
+	if (s->head - s->tail >= SQ_RXQ) {
+		s->dropped++;
+		lck_mtx_unlock(&sq_mtx);
+		kfree_data(copy, len);
+		return 1;
+	}
+	struct sq_msg *m = &s->rx[s->head % SQ_RXQ];
+	m->node = node;
+	m->port = port;
+	m->len = len;
+	m->data = copy;
+	s->head++;
+	wakeup(s);
+	selwakeup(&s->sel);
+	lck_mtx_unlock(&sq_mtx);
+	return 1;
+}
+
+/* modem thread, every loop: send what userland queued */
+void
+sweet_qmi_pump(void (*send)(uint32_t src_port, uint32_t node, uint32_t port, const void *data, uint32_t len, int ctrl))
+{
+	for (;;) {
+		struct sq_msg m;
+		lck_mtx_lock(&sq_mtx);
+		if (sq_tx_tail == sq_tx_head) {
+			lck_mtx_unlock(&sq_mtx);
+			return;
+		}
+		m = sq_tx[sq_tx_tail % SQ_TXQ];
+		sq_tx[sq_tx_tail % SQ_TXQ].data = NULL;
+		sq_tx_tail++;
+		lck_mtx_unlock(&sq_mtx);
+		send(m.src, m.node, m.port, m.data, m.len, (int)m.ctrl);
+		sq_free(&m);
+	}
+}
+
+static int
+sq_queue_tx(uint32_t src_port, uint32_t node, uint32_t port, uint8_t *data, uint32_t len, int ctrl)
+{
+	lck_mtx_lock(&sq_mtx);
+	if (sq_tx_head - sq_tx_tail >= SQ_TXQ) {
+		lck_mtx_unlock(&sq_mtx);
+		return EAGAIN;
+	}
+	struct sq_msg *m = &sq_tx[sq_tx_head % SQ_TXQ];
+	m->src = src_port;
+	m->node = node;
+	m->port = port;
+	m->len = len;
+	m->ctrl = (uint32_t)ctrl;
+	m->data = data;
+	sq_tx_head++;
+	lck_mtx_unlock(&sq_mtx);
+	return 0;
+}
+
+static int
+sq_open(dev_t dev, __unused int flags, __unused int devtype, __unused struct proc *p)
+{
+	int unit = minor(dev);
+	if (unit < 0 || unit >= SQ_SLOTS) {
+		return ENXIO;
+	}
+	lck_mtx_lock(&sq_mtx);
+	struct sq_slot *s = &sq_slots[unit];
+	if (s->open) {
+		lck_mtx_unlock(&sq_mtx);
+		return EBUSY;
+	}
+	s->open = true;
+	s->head = s->tail = 0;
+	/*
+	 * 0222: never the port the last owner had. The modem got QRTR DEL_CLIENT for it at close and
+	 * stopped answering a reused port (CommCenter restarted often: no answer at all after a while).
+	 */
+	s->port = sq_next_port;
+	sq_next_port = sq_next_port + 1 >= SQ_PORT0 + 0x1000 ? SQ_PORT0 : sq_next_port + 1;
+	lck_mtx_unlock(&sq_mtx);
+	return 0;
+}
+
+static int
+sq_close(dev_t dev, __unused int flags, __unused int devtype, __unused struct proc *p)
+{
+	int unit = minor(dev);
+	struct sq_slot *s = &sq_slots[unit];
+	lck_mtx_lock(&sq_mtx);
+	s->open = false;
+	wakeup(s);
+	while (s->tail != s->head) {
+		sq_free(&s->rx[s->tail % SQ_RXQ]);
+		s->tail++;
+	}
+	lck_mtx_unlock(&sq_mtx);
+	(void)sq_queue_tx(s->port, 0, 0, NULL, 0, 1);
+	return 0;
+}
+
+static int
+sq_read(dev_t dev, struct uio *uio, int ioflag)
+{
+	struct sq_slot *s = &sq_slots[minor(dev)];
+	lck_mtx_lock(&sq_mtx);
+	while (s->tail == s->head) {
+		if (ioflag & IO_NDELAY) {
+			lck_mtx_unlock(&sq_mtx);
+			return EWOULDBLOCK;
+		}
+		int err = msleep(s, &sq_mtx, PCATCH | PZERO, "sweetqmi", NULL);
+		if (err != 0) {
+			lck_mtx_unlock(&sq_mtx);
+			return err;
+		}
+		if (!s->open) {
+			lck_mtx_unlock(&sq_mtx);
+			return ENXIO;
+		}
+	}
+	struct sq_msg m = s->rx[s->tail % SQ_RXQ];
+	s->rx[s->tail % SQ_RXQ].data = NULL;
+	s->tail++;
+	lck_mtx_unlock(&sq_mtx);
+	struct sweet_qmi_hdr h = { m.node, m.port };
+	int err = uiomove((char *)&h, sizeof(h), uio);
+	if (err == 0) {
+		user_ssize_t n = uio_resid(uio);
+		err = uiomove((char *)m.data, (int)(n < (user_ssize_t)m.len ? n : m.len), uio);
+	}
+	sq_free(&m);
+	return err;
+}
+
+static int
+sq_write(dev_t dev, struct uio *uio, __unused int ioflag)
+{
+	struct sweet_qmi_hdr h;
+	user_ssize_t n = uio_resid(uio);
+	if (n < (user_ssize_t)sizeof(h) + 7 || n > (user_ssize_t)(sizeof(h) + SQ_MAX_MSG)) {
+		return EINVAL;
+	}
+	int err = uiomove((char *)&h, sizeof(h), uio);
+	if (err != 0) {
+		return err;
+	}
+	uint32_t len = (uint32_t)(n - (user_ssize_t)sizeof(h));
+	uint8_t *d = kalloc_data(len, Z_WAITOK);
+	if (d == NULL) {
+		return ENOMEM;
+	}
+	err = uiomove((char *)d, (int)len, uio);
+	if (err == 0) {
+		err = sq_queue_tx(sq_slots[minor(dev)].port, h.node, h.port, d, len, 0);
+	}
+	if (err != 0) {
+		kfree_data(d, len);
+	}
+	return err;
+}
+
+static int
+sq_ioctl(dev_t dev, u_long cmd, caddr_t data, __unused int flag, __unused struct proc *p)
+{
+	if (cmd == SWEET_QMI_PORT) {
+		*(uint32_t *)data = sq_slots[minor(dev)].port;
+		return 0;
+	}
+	if (cmd != SWEET_QMI_LOOKUP) {
+		return ENOTTY;
+	}
+	struct sweet_qmi_lookup *l = (struct sweet_qmi_lookup *)data;
+	return topaz_qmi_lookup(l->svc, l->inst, l->index, &l->node, &l->port, &l->found_inst) ? 0 : ENOENT;
+}
+
+static int
+sq_select(dev_t dev, int which, void *wql, struct proc *p)
+{
+	struct sq_slot *s = &sq_slots[minor(dev)];
+	if (which == FWRITE) {
+		return 1;
+	}
+	if (which != FREAD) {
+		return 0;
+	}
+	lck_mtx_lock(&sq_mtx);
+	int ready = s->tail != s->head;
+	if (!ready) {
+		selrecord(p, &s->sel, wql);
+	}
+	lck_mtx_unlock(&sq_mtx);
+	return ready;
+}
+
+static const struct cdevsw sq_cdevsw = {
+	.d_open = sq_open, .d_close = sq_close, .d_read = sq_read, .d_write = sq_write, .d_ioctl = sq_ioctl,
+	.d_stop = eno_stop, .d_reset = eno_reset, .d_ttys = NULL, .d_select = sq_select, .d_mmap = eno_mmap,
+	.d_strategy = eno_strat, .d_type = 0,
+};
+
+/* 0222: the modem link's counters, to see a stall instead of guessing */
+extern int topaz_modem_stats(char *buf, size_t len);
+static int
+sysctl_sweet_modem_stats SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	static char buf[640];
+	int n = topaz_modem_stats(buf, sizeof(buf));
+	if (n < 0) {
+		n = 0;
+	}
+	return SYSCTL_OUT(req, buf, strlen(buf) + 1);
+}
+SYSCTL_PROC(_kern, OID_AUTO, sweet_modem_stats, CTLTYPE_STRING | CTLFLAG_RD | CTLFLAG_LOCKED,
+    0, 0, sysctl_sweet_modem_stats, "A", "modem GLINK/QRTR counters");
+
+/*
+ * 0265: FastRPC to the ADSP's sensors PD (TopazModem.cpp): kern.sweet_frpc = 1 attaches and starts the
+ * reverse-call listener (EAGAIN: the GLINK channel is not up yet); reading it gives the state
+ * (0 idle, 1 running, 2 listening, negative: the step it stopped at). kern.sweet_frpc_log: its log.
+ */
+extern int topaz_frpc_start(void);
+extern int topaz_frpc_state(void);
+extern int topaz_frpc_log(char *buf, size_t len);
+static int
+sysctl_sweet_frpc SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	int v = topaz_frpc_state();
+	int err = sysctl_io_number(req, v, sizeof(v), &v, NULL);
+	if (err != 0 || req->newptr == USER_ADDR_NULL) {
+		return err;
+	}
+	return v == 1 ? topaz_frpc_start() : EINVAL;
+}
+SYSCTL_PROC(_kern, OID_AUTO, sweet_frpc, CTLTYPE_INT | CTLFLAG_RW | CTLFLAG_LOCKED,
+    0, 0, sysctl_sweet_frpc, "I", "FastRPC to the ADSP sensors PD: 1 starts; state");
+
+static int
+sysctl_sweet_frpc_log SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	static char buf[12288];
+	int n = topaz_frpc_log(buf, sizeof(buf));
+	return SYSCTL_OUT(req, buf, (size_t)(n > 0 ? n : 0) + 1);
+}
+SYSCTL_PROC(_kern, OID_AUTO, sweet_frpc_log, CTLTYPE_STRING | CTLFLAG_RD | CTLFLAG_LOCKED,
+    0, 0, sysctl_sweet_frpc_log, "A", "FastRPC log");
+
+/*
+ * 0267: the files the sensors PD reads (apps_std over FastRPC), RAM only: kern.sweet_frpc_file = "path\0bytes"
+ * (full path, e.g. /vendor/etc/sensors/sns_reg_config); kern.sweet_frpc_files lists them.
+ */
+extern int topaz_frpc_file_put(const uint8_t *buf, uint32_t len);
+extern int topaz_frpc_files(char *out, size_t max);
+static int
+sysctl_sweet_frpc_file SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	size_t len = req->newlen;
+	if (req->newptr == USER_ADDR_NULL) {
+		return 0;
+	}
+	if (len < 3 || len > (1u << 20)) {
+		return len < 3 ? EINVAL : EFBIG;
+	}
+	uint8_t *buf = kalloc_data(len, Z_WAITOK);
+	if (buf == NULL) {
+		return ENOMEM;
+	}
+	int err = SYSCTL_IN(req, buf, len);
+	if (err == 0) {
+		err = topaz_frpc_file_put(buf, (uint32_t)len);
+	}
+	kfree_data(buf, len);
+	return err;
+}
+SYSCTL_PROC(_kern, OID_AUTO, sweet_frpc_file, CTLTYPE_OPAQUE | CTLFLAG_WR | CTLFLAG_LOCKED,
+    0, 0, sysctl_sweet_frpc_file, "S", "a file for the sensors PD: write path\0bytes (RAM only)");
+
+static int
+sysctl_sweet_frpc_files SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	const size_t max = 128 * 1024;
+	char *buf = kalloc_data(max, Z_WAITOK);
+	if (buf == NULL) {
+		return ENOMEM;
+	}
+	int n = topaz_frpc_files(buf, max);
+	int err = SYSCTL_OUT(req, buf, (size_t)(n > 0 ? n : 0) + 1);
+	kfree_data(buf, max);
+	return err;
+}
+SYSCTL_PROC(_kern, OID_AUTO, sweet_frpc_files, CTLTYPE_STRING | CTLFLAG_RD | CTLFLAG_LOCKED,
+    0, 0, sysctl_sweet_frpc_files, "A", "the sensors PD's RAM files");
+
+/* 0226: IP packets to and from the modem through the IPA (qmitool ping) */
+extern int topaz_ipa_tx(const uint8_t *pkt, uint32_t len, uint8_t mux);
+extern int topaz_ipa_rx(uint8_t *out, uint32_t max);
+static int
+sysctl_sweet_ipa_tx SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	uint8_t buf[1601];
+	if (req->newptr == USER_ADDR_NULL) {
+		return 0;
+	}
+	if (req->newlen < 21 || req->newlen > sizeof(buf)) {
+		return EINVAL;
+	}
+	int err = SYSCTL_IN(req, buf, req->newlen);
+	if (err != 0) {
+		return err;
+	}
+	return topaz_ipa_tx(buf + 1, (uint32_t)req->newlen - 1, buf[0]);   /* mux id, then the packet */
+}
+SYSCTL_PROC(_kern, OID_AUTO, sweet_ipa_tx, CTLTYPE_OPAQUE | CTLFLAG_WR | CTLFLAG_LOCKED,
+    0, 0, sysctl_sweet_ipa_tx, "S", "one IP packet to the modem (mux id byte, then the packet)");
+static int
+sysctl_sweet_ipa_rx SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	uint8_t buf[2048];
+	int n = topaz_ipa_rx(buf, sizeof(buf));
+	return SYSCTL_OUT(req, buf, n > 0 ? (size_t)n : 0);
+}
+SYSCTL_PROC(_kern, OID_AUTO, sweet_ipa_rx, CTLTYPE_OPAQUE | CTLFLAG_RD | CTLFLAG_LOCKED,
+    0, 0, sysctl_sweet_ipa_rx, "S", "the last IP packets from the modem");
+
+extern int topaz_ipa_raw(uint8_t *out, uint32_t max);
+static int
+sysctl_sweet_ipa_raw SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	static uint8_t buf[1024];
+	int n = topaz_ipa_raw(buf, sizeof(buf));
+	return SYSCTL_OUT(req, buf, n > 0 ? (size_t)n : 0);
+}
+SYSCTL_PROC(_kern, OID_AUTO, sweet_ipa_raw, CTLTYPE_OPAQUE | CTLFLAG_RD | CTLFLAG_LOCKED,
+    0, 0, sysctl_sweet_ipa_raw, "S", "the last frames received from the IPA, raw");
+extern int topaz_ipa_peek(const char *req);
+extern const char *topaz_ipa_peek_out(void);
+static int
+sysctl_sweet_ipa_peek SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	if (req->newptr != USER_ADDR_NULL) {
+		char in[64];
+		if (req->newlen == 0 || req->newlen >= sizeof(in)) {
+			return EINVAL;
+		}
+		int err = SYSCTL_IN(req, in, req->newlen);
+		if (err != 0) {
+			return err;
+		}
+		in[req->newlen] = 0;
+		return topaz_ipa_peek(in);
+	}
+	const char *out = topaz_ipa_peek_out();
+	return SYSCTL_OUT(req, out, strlen(out) + 1);
+}
+SYSCTL_PROC(_kern, OID_AUTO, sweet_ipa_peek, CTLTYPE_STRING | CTLFLAG_RW | CTLFLAG_LOCKED,
+    0, 0, sysctl_sweet_ipa_peek, "A", "IPA/GSI registers and IPA memory: write a request, read the words");
+extern int topaz_ipa_stats(char *buf, size_t len);
+static int
+sysctl_sweet_ipa_stats SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	static char buf[2048];
+	int n = topaz_ipa_stats(buf, sizeof(buf));
+	if (n < 0) {
+		buf[0] = 0;
+	}
+	return SYSCTL_OUT(req, buf, strlen(buf) + 1);
+}
+SYSCTL_PROC(_kern, OID_AUTO, sweet_ipa_stats, CTLTYPE_STRING | CTLFLAG_RD | CTLFLAG_LOCKED,
+    0, 0, sysctl_sweet_ipa_stats, "A", "IPA channels and registers");
+
+/* TopazModem, once the modem's IPCRTR channel is up */
+void
+sweet_qmi_dev_init(void)
+{
+	static int major = -1;
+	if (major >= 0) {
+		return;
+	}
+	major = cdevsw_add(-1, &sq_cdevsw);
+	if (major < 0) {
+		printf("sweet qmi: no major\n");
+		return;
+	}
+	int made = 0;
+	for (int i = 0; i < SQ_SLOTS; i++) {
+		if (devfs_make_node(makedev(major, i), DEVFS_CHAR, UID_ROOT, 25 /* _wireless: CommCenter */, 0660, "redwood-qmi%d", i) != NULL) {
+			made++;
+		}
+	}
+	printf("sweet qmi: /dev/redwood-qmi0..%d ready (QRTR ports 0x%x..)\n", made - 1, SQ_PORT0);
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
diff --git a/bsd/dev/sweet_qsee_ctl.c b/bsd/dev/sweet_qsee_ctl.c
new file mode 100755
index 0000000..caf82bb
--- /dev/null
+++ b/bsd/dev/sweet_qsee_ctl.c
@@ -0,0 +1,174 @@
+/*
+ * kern.sweet_qsee: the QSEE / Goodix fingerprint probe (iokit/Kernel/arm/SweetQsee.cpp), only
+ * with boot-arg qsee=1 (otherwise every request answers ENODEV and nothing runs).
+ * Write an op, it runs in the writer's thread; reading gives the last result (0 ok, else an
+ * errno, -1 nothing run yet):
+ *   1 milestone 1 (QSEE version, whitelist, lookups, sensor power, goodixfp restarted,
+ *     WAKEUP(reset) + WAKEUP + PRE_DETECT + DETECT_SENSOR), 2 the sensor's GPIOs off,
+ *   3 APP_SHUTDOWN goodixfp, 4 goodixfp shutdown + start only, 5 op 1 reusing a loaded goodixfp,
+ *   6 op 1 with slow power timings, 7 L9's PMIC registers (read only), 8 register the QSEE log
+ *   buffer, 9 copy it for kern.sweet_qsee_log (read only, opaque: the raw 32 KB), 10 init with
+ *   the file listener, 11 one capture, 12 cancel and sensor off, 13 one capture at exposure 5,
+ *   14 enroll begin, 15 one enroll touch (then reads: samples remaining, or -gf error),
+ *   16 enroll finish, 17 untrusted auth (then reads: the matched finger id, or -gf error),
+ *   18 untrusted auth with retries (reads as 17), 19 enumerate + authenticator id, 20 = 18 with
+ *   kern.sweet_qsee_arg (bits 0-3 auth type, 4 no UNTRUSTED_CFG(auth), 5 UNTRUSTED_CFG(enroll)
+ *   first, 6 exposure 5, 7 no AUTHENTICATE, 8 the spot lit by the panel's local HBM; bit 8 also for
+ *   op 15), 22/23 local HBM on/off, 24/25 global HBM on/off, 26 lit auth while the finger is on the
+ *   spot (reads: finger id bits, -1008 no match, -4 lifted, -error; EPERM after 5 failures until a
+ *   passcode), 27 unlock by a match under 3 s old (0, EPERM, EAGAIN)
+ * kern.sweet_qsee_filesel (write a name) + kern.sweet_qsee_fileout (read: that store file's bytes)
+ * kern.sweet_qsee_file (write only): "name\0bytes" puts a file the TA may read into the kernel's
+ * RAM store (empty bytes drop it); kern.sweet_qsee_files lists the store.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/kernel.h>
+#include <sys/sysctl.h>
+#include <sys/errno.h>
+#include <kern/kalloc.h>
+
+int sweet_qsee_op(int op);
+
+static int
+sysctl_sweet_qsee SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	int v = sweet_qsee_op(-1);
+	int err = sysctl_io_number(req, v, sizeof(v), &v, NULL);
+	if (err != 0 || req->newptr == USER_ADDR_NULL) {
+		return err;
+	}
+	return v < 0 ? EINVAL : sweet_qsee_op(v);
+}
+
+SYSCTL_PROC(_kern, OID_AUTO, sweet_qsee, CTLTYPE_INT | CTLFLAG_RW | CTLFLAG_LOCKED,
+    0, 0, sysctl_sweet_qsee, "I", "QSEE / goodixfp probe: 1 run, 2 off, 3 unload, 4 TA restart, 5 reuse TA, 6 slow, 7 L9 (qsee=1)");
+
+/* 0251: the QSEE log buffer as op 9 copied it (empty until then) */
+uint32_t sweet_qsee_log_get(void *dst, uint32_t max);
+
+static int
+sysctl_sweet_qsee_log SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	const uint32_t max = 0x8000;
+	if (req->newptr != USER_ADDR_NULL) {
+		return EPERM;
+	}
+	uint8_t *buf = kalloc_data(max, Z_WAITOK);
+	if (buf == NULL) {
+		return ENOMEM;
+	}
+	uint32_t n = sweet_qsee_log_get(buf, max);
+	int err = n == 0 ? ENOENT : SYSCTL_OUT(req, buf, n);
+	kfree_data(buf, max);
+	return err;
+}
+
+SYSCTL_PROC(_kern, OID_AUTO, sweet_qsee_log, CTLTYPE_OPAQUE | CTLFLAG_RD | CTLFLAG_LOCKED,
+    0, 0, sysctl_sweet_qsee_log, "S", "the QSEE log buffer copied by kern.sweet_qsee=9 (raw)");
+
+/* 0253: the TA's files, RAM only (iokit/Kernel/arm/SweetQsee.cpp) */
+int sweet_qsee_file_put(const uint8_t *buf, uint32_t len);
+uint32_t sweet_qsee_files_list(char *out, uint32_t max);
+
+static int
+sysctl_sweet_qsee_file SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	size_t len = req->newlen;
+	if (req->newptr == USER_ADDR_NULL) {
+		return 0;
+	}
+	if (len < 2 || len > (5u << 20) + 64) {
+		return len < 2 ? EINVAL : EFBIG;
+	}
+	uint8_t *buf = kalloc_data(len, Z_WAITOK);
+	if (buf == NULL) {
+		return ENOMEM;
+	}
+	int err = SYSCTL_IN(req, buf, len);
+	if (err == 0) {
+		err = sweet_qsee_file_put(buf, (uint32_t)len);
+	}
+	kfree_data(buf, len);
+	return err;
+}
+
+SYSCTL_PROC(_kern, OID_AUTO, sweet_qsee_file, CTLTYPE_OPAQUE | CTLFLAG_WR | CTLFLAG_LOCKED,
+    0, 0, sysctl_sweet_qsee_file, "S", "a file for the goodix TA: write name\\0bytes (RAM only)");
+
+static int
+sysctl_sweet_qsee_files SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	const uint32_t max = 2048;
+	char *buf = kalloc_data(max, Z_WAITOK);
+	if (buf == NULL) {
+		return ENOMEM;
+	}
+	uint32_t n = sweet_qsee_files_list(buf, max);
+	int err = SYSCTL_OUT(req, buf, n + 1);
+	kfree_data(buf, max);
+	return err;
+}
+
+SYSCTL_PROC(_kern, OID_AUTO, sweet_qsee_files, CTLTYPE_STRING | CTLFLAG_RD | CTLFLAG_LOCKED,
+    0, 0, sysctl_sweet_qsee_files, "A", "the goodix TA's RAM file store: name size dirty source");
+
+/* 0259: kern.sweet_qsee_arg, an argument for the ops that take one (op 20) */
+int sweet_qsee_arg;
+SYSCTL_INT(_kern, OID_AUTO, sweet_qsee_arg, CTLFLAG_RW | CTLFLAG_LOCKED, &sweet_qsee_arg, 0,
+    "argument for kern.sweet_qsee ops (op 20: auth flags)");
+
+/* 0258: a store file back to user space (its templates, kept by user space across boots) */
+int sweet_qsee_file_select(const char *name);
+int64_t sweet_qsee_file_out(void *dst, uint32_t max);
+
+static int
+sysctl_sweet_qsee_filesel SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	char name[64];
+	if (req->newptr == USER_ADDR_NULL) {
+		return 0;
+	}
+	if (req->newlen == 0 || req->newlen >= sizeof(name)) {
+		return EINVAL;
+	}
+	bzero(name, sizeof(name));
+	int err = SYSCTL_IN(req, name, req->newlen);
+	return err != 0 ? err : sweet_qsee_file_select(name);
+}
+
+SYSCTL_PROC(_kern, OID_AUTO, sweet_qsee_filesel, CTLTYPE_STRING | CTLFLAG_WR | CTLFLAG_LOCKED,
+    0, 0, sysctl_sweet_qsee_filesel, "A", "select a goodix TA store file for kern.sweet_qsee_fileout");
+
+static int
+sysctl_sweet_qsee_fileout SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	if (req->newptr != USER_ADDR_NULL) {
+		return EPERM;
+	}
+	int64_t len = sweet_qsee_file_out(NULL, 0);
+	if (len < 0) {
+		return ENOENT;
+	}
+	if (len == 0) {
+		return 0;
+	}
+	uint8_t *buf = kalloc_data((vm_size_t)len, Z_WAITOK);
+	if (buf == NULL) {
+		return ENOMEM;
+	}
+	int64_t n = sweet_qsee_file_out(buf, (uint32_t)len);
+	int err = n < 0 ? ENOENT : SYSCTL_OUT(req, buf, (size_t)n);
+	kfree_data(buf, (vm_size_t)len);
+	return err;
+}
+
+SYSCTL_PROC(_kern, OID_AUTO, sweet_qsee_fileout, CTLTYPE_OPAQUE | CTLFLAG_RD | CTLFLAG_LOCKED,
+    0, 0, sysctl_sweet_qsee_fileout, "S", "the store file chosen by kern.sweet_qsee_filesel (raw bytes)");
+#endif /* ARM64_BOARD_CONFIG_SWEET */
diff --git a/bsd/dev/sweet_reboot.c b/bsd/dev/sweet_reboot.c
new file mode 100644
index 0000000..0628506
--- /dev/null
+++ b/bsd/dev/sweet_reboot.c
@@ -0,0 +1,56 @@
+/*
+ * sapphire 0221: where a restart goes (SweetPlatformExpert::haltRestart). sysctl
+ * kern.sweet_reboot_mode = 0 system (Android, from the boot partition), 1 recovery, 2 bootloader
+ * (fastboot, the default: iOS is only ever started with fastboot boot); boot-arg sweet_reboot=N
+ * sets the default.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/sysctl.h>
+#include <pexpert/pexpert.h>
+
+static int sweet_reboot_mode = -1;
+int sweet_reboot_mode_get(void);
+void sweet_reboot_mode_set(int mode);
+
+/* 0299: Volume up held during the boot screen (sweet_keys.c): the next restart goes to recovery */
+void
+sweet_reboot_mode_set(int mode)
+{
+	if (mode >= 0 && mode <= 2) {
+		sweet_reboot_mode = mode;
+	}
+}
+
+int
+sweet_reboot_mode_get(void)
+{
+	if (sweet_reboot_mode < 0) {
+		int mode = 2;
+		(void)PE_parse_boot_argn("sweet_reboot", &mode, sizeof(mode));
+		sweet_reboot_mode = (mode >= 0 && mode <= 2) ? mode : 2;
+	}
+	return sweet_reboot_mode;
+}
+
+static int
+sysctl_sweet_reboot_mode SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	int mode = sweet_reboot_mode_get();
+	int error = sysctl_io_number(req, mode, sizeof(mode), &mode, NULL);
+	if (error == 0 && req->newptr != USER_ADDR_NULL) {
+		if (mode < 0 || mode > 2) {
+			return EINVAL;
+		}
+		sweet_reboot_mode = mode;
+		printf("SWEET REBOOT: next restart goes to %s\n",
+		    mode == 2 ? "the bootloader" : mode == 1 ? "recovery" : "the system");
+	}
+	return error;
+}
+
+SYSCTL_PROC(_kern, OID_AUTO, sweet_reboot_mode, CTLTYPE_INT | CTLFLAG_RW | CTLFLAG_LOCKED,
+    0, 0, sysctl_sweet_reboot_mode, "I", "where a restart goes: 0 system, 1 recovery, 2 bootloader");
+#endif /* ARM64_BOARD_CONFIG_SWEET */
diff --git a/bsd/dev/sweet_rpmh.c b/bsd/dev/sweet_rpmh.c
new file mode 100644
index 0000000..4da50d8
--- /dev/null
+++ b/bsd/dev/sweet_rpmh.c
@@ -0,0 +1,358 @@
+/*
+ * SWEET PM6150L L11C bring-up; see report.md for DT and source evidence.
+ * Sole XNU apps-DRV owner, called from thread context with deep idle disabled.
+ * No sleep/wake programming, SPMI writes, GIC handler, or timeout recovery.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <kern/clock.h>
+#include <machine/machine_routines.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+int sweet_rpmh_vreg_enable(const char *res, unsigned mv);
+
+/* Live downstream DT has two positional reg entries, no reg-names. */
+#define RH_RSC_PA       0x18220000u
+#define RH_TCS_PA       0x18220d00u
+#define RH_TCS_SIZE     0x3000u
+#define RH_DICT_PA      0x0c3f000cu
+#define RH_DRV          2u
+#define RH_ACTIVE_N     2u       /* DT order: ACTIVE 2, SLEEP 3, WAKE 3 */
+#define RH_NORMAL_N     8u       /* hidden CONTROL TCS is not in this bank */
+#define RH_TCS_STRIDE   0x2a0u
+#define RH_CMD_STRIDE   0x14u
+#define RH_IRQ_EN       0x00u
+#define RH_IRQ_STATUS   0x04u
+#define RH_IRQ_CLEAR    0x08u
+#define RH_WAIT         0x10u
+#define RH_CONTROL      0x14u
+#define RH_STATUS       0x18u
+#define RH_ENABLE       0x1cu
+#define RH_MSGID        0x30u
+#define RH_ADDR         0x34u
+#define RH_DATA         0x38u
+#define RH_CMD_STATUS   0x3cu
+#define RH_AMC_EN       (1u << 16)
+#define RH_TRIGGER      (1u << 24)
+#define RH_ISSUED       (1u << 8)
+#define RH_COMPLETE     (1u << 16)
+#define RH_WRITE_ACK    (8u | (1u << 8) | (1u << 16))
+#define RH_DB_MAGIC     0x0c0330dbu
+#define RH_DB_HEADER    144u
+#define RH_DB_ENTRY     24u
+#define RH_DB_MAX       0x100000u /* policy bound, not a DT size */
+#define RH_VRM          4u
+#define RH_TIMEOUT_US   100000u
+
+static vm_offset_t rh_rsc, rh_tcs, rh_dict, rh_db;
+static uint32_t rh_db_size;
+static unsigned rh_ncpt;
+static unsigned rh_lock;
+static bool rh_poisoned;
+
+static uint32_t
+rh_read(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+static void
+rh_write(vm_offset_t base, uint32_t off, uint32_t value)
+{
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(base + off) = value;
+	__asm__ volatile("dsb osh" ::: "memory");
+}
+
+static bool
+rh_sync(uint32_t off, uint32_t value)
+{
+	rh_write(rh_tcs, off, value);
+	for (unsigned i = 0; i < 1000; ++i) {
+		if (rh_read(rh_tcs, off) == value) {
+			return true;
+		}
+		delay(1);
+	}
+	printf("SWEET RPMH: readback timeout off=%#x want=%#x got=%#x\n",
+	    off, value, rh_read(rh_tcs, off));
+	return false;
+}
+
+/* DB is little endian; avoid packed structs and unaligned Device loads. */
+static uint16_t
+rh_db16(uint32_t off)
+{
+	uint32_t v = rh_read(rh_db, off & ~3u);
+	return (uint16_t)(v >> (8u * (off & 3u)));
+}
+
+static bool
+rh_range(uint32_t off, uint32_t size)
+{
+	return off <= rh_db_size && size <= rh_db_size - off;
+}
+
+static int
+rh_map(void)
+{
+	if (!rh_rsc) {
+		rh_rsc = ml_io_map(RH_RSC_PA, 0x100);
+	}
+	if (!rh_tcs) {
+		rh_tcs = ml_io_map(RH_TCS_PA, RH_TCS_SIZE);
+	}
+	if (!rh_dict) {
+		rh_dict = ml_io_map(RH_DICT_PA, 8);
+	}
+	if (!rh_rsc || !rh_tcs || !rh_dict) {
+		printf("SWEET RPMH: RSC/locator mapping failed\n");
+		return ENOMEM;
+	}
+	uint32_t id = rh_read(rh_rsc, 0);
+	uint32_t solver = rh_read(rh_rsc, 4);
+	uint32_t config = rh_read(rh_rsc, 0x0c);
+	unsigned major = (id >> 16) & 0xffu;
+	unsigned count = (config >> (6u * RH_DRV)) & 0x3fu;
+	rh_ncpt = (config >> 27) & 0x1fu;
+	printf("SWEET RPMH: rsc=%#x tcs=%#x DRV=%u id=%#x solver=%#x config=%#x TCS=%u ncpt=%u\n",
+	    RH_RSC_PA, RH_TCS_PA, RH_DRV, id, solver, config, count, rh_ncpt);
+	/* This client implements the pre-v3 layout only; do not guess v3 offsets. */
+	if ((major != 1 && major != 2) || config == 0xffffffffu ||
+	    solver == 0xffffffffu || count < RH_NORMAL_N ||
+	    count > RH_TCS_SIZE / RH_TCS_STRIDE || rh_ncpt < 3 || rh_ncpt > 16) {
+		printf("SWEET RPMH: unsupported RSC geometry/revision\n");
+		return ENODEV;
+	}
+	if (!rh_db) {
+		uint32_t pa = rh_read(rh_dict, 0);
+		uint32_t size = rh_read(rh_dict, 4);
+		printf("SWEET RPMH: cmd-db locator=%#x pa=%#x size=%#x\n", RH_DICT_PA, pa, size);
+		/* Firmware supplies the reserved RAM address; never scan physical RAM. */
+		if (pa < 0x80000000u || (pa & 3u) || (size & 3u) ||
+		    size < RH_DB_HEADER || size > RH_DB_MAX ||
+		    (uint64_t)pa + size > 0x100000000ULL) {
+			printf("SWEET RPMH: invalid cmd-db locator\n");
+			return EINVAL;
+		}
+		rh_db = ml_io_map(pa, size);
+		if (!rh_db) {
+			return ENOMEM;
+		}
+		rh_db_size = size;
+	}
+	uint32_t db_version = rh_read(rh_db, 0);
+	uint32_t magic = rh_read(rh_db, 4);
+	uint32_t flags = rh_read(rh_db, 140);
+	printf("SWEET RPMH: cmd-db version=%#x magic=%#x checksum=%#x flags=%#x\n",
+	    db_version, magic, rh_read(rh_db, 136), flags);
+	/* Linux only checks magic; version 1 is an intentionally stricter policy. */
+	if (magic != RH_DB_MAGIC || db_version != 1 || (flags & 1u)) {
+		printf("SWEET RPMH: unsupported/standalone cmd-db\n");
+		return EINVAL;
+	}
+	return 0;
+}
+
+static int
+rh_lookup(const char *res, uint32_t *address)
+{
+	uint32_t key[2] = {0, 0};
+	for (unsigned i = 0; i < 8 && res[i]; ++i) {
+		key[i / 4] |= (uint32_t)(uint8_t)res[i] << (8u * (i % 4));
+	}
+	unsigned matches = 0;
+	for (unsigned i = 0; i < 8; ++i) {
+		uint32_t h = 8u + 16u * i;
+		unsigned slave = rh_db16(h);
+		if (!slave) {
+			break;
+		}
+		uint32_t entries = RH_DB_HEADER + rh_db16(h + 2);
+		uint32_t aux = RH_DB_HEADER + rh_db16(h + 4);
+		unsigned count = rh_db16(h + 6);
+		if (slave < 3 || slave > 5 || (entries & 3u) ||
+		    !rh_range(entries, count * RH_DB_ENTRY) || !rh_range(aux, 0)) {
+			printf("SWEET RPMH: malformed cmd-db slave header %u\n", i);
+			return EINVAL;
+		}
+		for (unsigned j = 0; j < count; ++j) {
+			uint32_t e = entries + RH_DB_ENTRY * j;
+			if (rh_read(rh_db, e) != key[0] || rh_read(rh_db, e + 4) != key[1]) {
+				continue;
+			}
+			uint32_t addr = rh_read(rh_db, e + 16);
+			if (slave != RH_VRM || (addr >> 16) != RH_VRM || (addr & 15u) ||
+			    !rh_range(aux + rh_db16(e + 22), rh_db16(e + 20))) {
+				printf("SWEET RPMH: invalid VRM entry for %s\n", res);
+				return EINVAL;
+			}
+			*address = addr;
+			++matches;
+			printf("SWEET RPMH: %s addr=%#x slave=%u aux-version=%#x priority=%#x:%#x\n",
+			    res, addr, slave, rh_db16(h + 8),
+			    rh_read(rh_db, e + 8), rh_read(rh_db, e + 12));
+		}
+	}
+	if (matches != 1) {
+		printf("SWEET RPMH: %s lookup matches=%u; refusing\n", res, matches);
+		return ENODEV;
+	}
+	return 0;
+}
+
+static bool
+rh_free(unsigned t)
+{
+	uint32_t b = t * RH_TCS_STRIDE;
+	/* Idle alone is insufficient: a sleep/wake payload can be armed and idle. */
+	return rh_read(rh_tcs, b + RH_STATUS) != 0 &&
+	    rh_read(rh_tcs, b + RH_STATUS) != 0xffffffffu &&
+	    rh_read(rh_tcs, b + RH_CONTROL) == 0 &&
+	    rh_read(rh_tcs, b + RH_ENABLE) == 0 &&
+	    rh_read(rh_tcs, b + RH_WAIT) == 0 &&
+	    !(rh_read(rh_tcs, RH_IRQ_STATUS) & (1u << t));
+}
+
+static int
+rh_send(uint32_t address, unsigned mv)
+{
+	int chosen = -1;
+	for (unsigned t = 0; t < RH_ACTIVE_N; ++t) {
+		uint32_t b = t * RH_TCS_STRIDE;
+		uint32_t enabled = rh_read(rh_tcs, b + RH_ENABLE);
+		printf("SWEET RPMH: ACTIVE TCS%u idle=%#x control=%#x enable=%#x wait=%#x\n",
+		    t, rh_read(rh_tcs, b + RH_STATUS), rh_read(rh_tcs, b + RH_CONTROL),
+		    enabled, rh_read(rh_tcs, b + RH_WAIT));
+		if (enabled & ~((1u << rh_ncpt) - 1u)) {
+			return EIO;
+		}
+		for (unsigned c = 0; c < rh_ncpt; ++c) {
+			if ((enabled & (1u << c)) &&
+			    (rh_read(rh_tcs, b + RH_ADDR + c * RH_CMD_STRIDE) & ~15u) == address) {
+				printf("SWEET RPMH: conflicting inherited L11C request in TCS%u\n", t);
+				return EBUSY;
+			}
+		}
+		if (chosen < 0 && rh_free(t)) {
+			chosen = (int)t;
+		}
+	}
+	if (chosen < 0) {
+		printf("SWEET RPMH: no empty idle ACTIVE TCS; leaving inherited state intact\n");
+		return EBUSY;
+	}
+	unsigned t = (unsigned)chosen;
+	uint32_t b = t * RH_TCS_STRIDE, bit = 1u << t;
+	uint32_t irq_en = rh_read(rh_tcs, RH_IRQ_EN);
+	if (irq_en == 0xffffffffu || !rh_free(t)) {
+		return EBUSY;
+	}
+	/* Only this TCS's source is masked. Other sources/CPU IRQs remain intact. */
+	if (!rh_sync(RH_IRQ_EN, irq_en & ~bit)) {
+		rh_poisoned = true;
+		return EIO;
+	}
+	if (!rh_free(t)) {
+		/* No payload was touched. Do not acknowledge somebody else's IRQ. */
+		if (!rh_sync(RH_IRQ_EN, (rh_read(rh_tcs, RH_IRQ_EN) & ~bit) | (irq_en & bit))) {
+			rh_poisoned = true;
+		}
+		return EBUSY;
+	}
+	/* From here an uncertain write/timeout quarantines our slot for this boot. */
+	rh_poisoned = true;
+	/* HPM (raw 7) is supported by this PMIC5 LDO; enable comes last. */
+	const uint32_t offsets[3] = {0, 8, 4};
+	const uint32_t values[3] = {mv, 7, 1};
+	printf("SWEET RPMH: TCS%u ACTIVE %u mV mode=7 enable=1 irq-enable=%#x\n", t, mv, irq_en);
+	for (unsigned c = 0; c < 3; ++c) {
+		uint32_t cmd = b + c * RH_CMD_STRIDE;
+		if (!rh_sync(cmd + RH_MSGID, RH_WRITE_ACK) ||
+		    !rh_sync(cmd + RH_ADDR, address + offsets[c]) ||
+		    !rh_sync(cmd + RH_DATA, values[c])) {
+			return EIO;
+		}
+	}
+	if (!rh_sync(b + RH_WAIT, 7) || !rh_sync(b + RH_ENABLE, 7) ||
+	    !rh_sync(b + RH_CONTROL, 0) || !rh_sync(b + RH_CONTROL, RH_AMC_EN)) {
+		return EIO;
+	}
+	rh_write(rh_tcs, b + RH_CONTROL, RH_AMC_EN | RH_TRIGGER);
+	uint32_t irq = 0, idle = 0, status[3] = {0, 0, 0};
+	bool done = false, progress = false;
+	for (unsigned us = 0; us < RH_TIMEOUT_US; ++us) {
+		irq = rh_read(rh_tcs, RH_IRQ_STATUS);
+		idle = rh_read(rh_tcs, b + RH_STATUS);
+		bool complete = true;
+		for (unsigned c = 0; c < 3; ++c) {
+			status[c] = rh_read(rh_tcs, b + RH_CMD_STATUS + c * RH_CMD_STRIDE);
+			complete &= status[c] != 0xffffffffu &&
+			    (status[c] & (RH_ISSUED | RH_COMPLETE)) == (RH_ISSUED | RH_COMPLETE);
+		}
+		/* A fresh IRQ or observed execution transition excludes stale CMD_STATUS. */
+		progress |= idle == 0 || !complete;
+		if (idle && idle != 0xffffffffu && irq != 0xffffffffu &&
+		    ((irq & bit) || progress) && complete) {
+			done = true;
+			break;
+		}
+		delay(1);
+	}
+	printf("SWEET RPMH: TCS%u done=%d irq=%#x idle=%#x control=%#x cmd-status=%#x/%#x/%#x\n",
+	    t, done, irq, idle, rh_read(rh_tcs, b + RH_CONTROL), status[0], status[1], status[2]);
+	if (!done) {
+		printf("SWEET RPMH: timeout; TCS quarantined, IRQ remains masked; no reset/retry\n");
+		return ETIMEDOUT;
+	}
+	/* Proven completion: clear trigger before mode, then free only our commands. */
+	if (!rh_sync(b + RH_CONTROL, RH_AMC_EN) || !rh_sync(b + RH_CONTROL, 0) ||
+	    !rh_sync(b + RH_ENABLE, 0) || !rh_sync(b + RH_WAIT, 0)) {
+		return EIO;
+	}
+	rh_write(rh_tcs, RH_IRQ_CLEAR, bit); /* W1C: never clear other TCS bits */
+	if ((rh_read(rh_tcs, RH_IRQ_STATUS) & bit) ||
+	    !rh_sync(RH_IRQ_EN, (rh_read(rh_tcs, RH_IRQ_EN) & ~bit) | (irq_en & bit))) {
+		return EIO;
+	}
+	rh_poisoned = false;
+	printf("SWEET RPMH: L11C ACTIVE vote complete (rail voltage requires hardware verification)\n");
+	return 0;
+}
+
+int
+sweet_rpmh_vreg_enable(const char *res, unsigned mv)
+{
+	/* Board-specific helper: do not apply PMIC5-LDO policy to arbitrary resources. */
+	if (!res || strcmp(res, "ldoc11") || mv < 2950 || mv > 3400) {
+		printf("SWEET RPMH: expected ldoc11 and 2950..3400 mV\n");
+		return EINVAL;
+	}
+	if (__atomic_exchange_n(&rh_lock, 1, __ATOMIC_ACQUIRE)) {
+		return EBUSY;
+	}
+	int error = EIO;
+	uint32_t address = 0;
+	if (rh_poisoned) {
+		printf("SWEET RPMH: previous uncertain transaction; refusing further access\n");
+		goto out;
+	}
+	error = rh_map();
+	if (!error) {
+		error = rh_lookup(res, &address);
+	}
+	if (!error) {
+		error = rh_send(address, mv);
+	}
+out:
+	if (error) {
+		printf("SWEET RPMH: enable failed errno=%d\n", error);
+	}
+	__atomic_store_n(&rh_lock, 0, __ATOMIC_RELEASE);
+	return error;
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
diff --git a/bsd/dev/sweet_sample.c b/bsd/dev/sweet_sample.c
new file mode 100644
index 0000000..b40eccd
--- /dev/null
+++ b/bsd/dev/sweet_sample.c
@@ -0,0 +1,88 @@
+/*
+ * SWEET process sampler: where is a daemon stuck?
+ *
+ * The phone has no debugger and daemons log nowhere readable. Every
+ * interval a kernel thread prints, for each process named in boot-arg
+ * sweetsample (comma separated, default "SpringBoard,backboardd"; "-" = off)
+ * and for each of its threads, the user pc/lr/sp and a frame-pointer
+ * backtrace as "SMP name[pid] tN pc ... lr ... bt ..." (header line with the
+ * shared region slide and the main binary's mach header, to symbolicate
+ * with tools/sweet-crash.py). A thread blocked in a syscall shows the
+ * syscall stub in pc and its caller in lr/bt.
+ *
+ * First sample 90 s after start, then every 120 s, 40 samples at most.
+ */
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/proc.h>
+#include <sys/proc_internal.h>
+#include <kern/task.h>
+#include <kern/thread.h>
+#include <pexpert/pexpert.h>
+
+extern task_t proc_task(proc_t);
+extern int hz;
+extern void sweet_sample_start(void);
+
+static char sweet_sample_names[128];
+
+static bool
+sweet_sample_wanted(const char *name)
+{
+	size_t n = strlen(name);
+	for (const char *t = sweet_sample_names; *t;) {
+		const char *end = strchr(t, ',');
+		size_t tl = end ? (size_t)(end - t) : strlen(t);
+		if (tl == n && n > 0 && strncmp(t, name, n) == 0) {
+			return true;
+		}
+		if (!end) {
+			break;
+		}
+		t = end + 1;
+	}
+	return false;
+}
+
+extern void sweet_sample_task(const char *name, int pid, task_t task);  /* osfmk/kern/exception.c */
+
+static int
+sweet_sample_proc(proc_t p, __unused void *arg)
+{
+	char name[32];
+	proc_name(proc_pid(p), name, sizeof(name));
+	if (sweet_sample_wanted(name)) {
+		task_t task = proc_task(p);
+		if (task != TASK_NULL) {
+			sweet_sample_task(name, proc_pid(p), task);
+		}
+	}
+	return PROC_RETURNED;
+}
+
+static void
+sweet_sample_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	static int chan;
+	if (!PE_parse_boot_argn("sweetsample", sweet_sample_names, sizeof(sweet_sample_names))) {
+		strlcpy(sweet_sample_names, "SpringBoard,backboardd", sizeof(sweet_sample_names));
+	}
+	if (sweet_sample_names[0] == '-') {
+		return;
+	}
+	(void)tsleep(&chan, PZERO, "sweetsmp", 90 * hz);
+	for (int i = 0; i < 40; i++) {
+		printf("SMP --- sample %d\n", i);
+		proc_iterate(PROC_ALLPROCLIST, sweet_sample_proc, NULL, NULL, NULL);
+		(void)tsleep(&chan, PZERO, "sweetsmp", 120 * hz);
+	}
+}
+
+void
+sweet_sample_start(void)
+{
+	thread_t thread;
+	if (kernel_thread_start(sweet_sample_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
diff --git a/bsd/dev/sweet_slot.c b/bsd/dev/sweet_slot.c
new file mode 100644
index 0000000..3b77a50
--- /dev/null
+++ b/bsd/dev/sweet_slot.c
@@ -0,0 +1,276 @@
+/*
+ * sweet_slot.c: the A/B slot switch of Qualcomm's bootloader, on the GPT copies of the LUN that holds
+ * boot_a/boot_b (sde on sapphire). No I/O here: the caller reads the primary and backup headers and
+ * entry arrays, this checks and changes them, the caller writes them back (backup first). Shared by
+ * xnu (kern.sweet_boot_android, patch 0305) and the PC-side test (test_slot.c), which checks it against
+ * what this phone's ABL wrote itself after `fastboot set_active` (backup-persist/gpt/sde-*).
+ *
+ * What fastboot set_active does here (QcomModulePkg SetActiveSlot, confirmed on the phone): the type GUIDs
+ * of every X_a/X_b pair swapped (the active slot's partitions carry the real types, the inactive slot's a
+ * parked one; ValidateSlotGuids refuses to load anything when they disagree with the active bits: Device
+ * Error for every image, even fastboot boot), bit 50 (active) moved, the new slot's boot given priority 3
+ * and 7 retries and cleared of unbootable, the old slot's boot priority 2 and 7 retries.
+ */
+#include "sweet_slot.h"
+
+#define ACTIVE          (1ull << 50)
+#define SUCCESSFUL      (1ull << 54)
+#define UNBOOTABLE      (1ull << 55)
+#define RETRY_MASK      (7ull << 51)
+#define PRIORITY_MASK   (3ull << 48)
+
+uint32_t
+sweet_slot_crc32(const uint8_t *p, size_t n)
+{
+	uint32_t c = 0xffffffffu;
+	for (size_t i = 0; i < n; i++) {
+		c ^= p[i];
+		for (int k = 0; k < 8; k++) {
+			c = (c >> 1) ^ (0xedb88320u & (0u - (c & 1)));
+		}
+	}
+	return ~c;
+}
+
+static uint32_t
+le32(const uint8_t *p)
+{
+	return (uint32_t)p[0] | (uint32_t)p[1] << 8 | (uint32_t)p[2] << 16 | (uint32_t)p[3] << 24;
+}
+
+static uint64_t
+le64(const uint8_t *p)
+{
+	return (uint64_t)le32(p) | (uint64_t)le32(p + 4) << 32;
+}
+
+static void
+put32(uint8_t *p, uint32_t v)
+{
+	for (int i = 0; i < 4; i++) {
+		p[i] = (uint8_t)(v >> (8 * i));
+	}
+}
+
+static void
+put64(uint8_t *p, uint64_t v)
+{
+	put32(p, (uint32_t)v);
+	put32(p + 4, (uint32_t)(v >> 32));
+}
+
+/* The entry's name, ASCII only (GPT names are UTF-16LE), into out[36+1]. */
+static void
+name_of(const uint8_t *e, char *out)
+{
+	int i;
+	for (i = 0; i < 36; i++) {
+		uint16_t ch = (uint16_t)(e[56 + 2 * i] | e[57 + 2 * i] << 8);
+		if (ch == 0 || ch > 0x7e) {
+			break;
+		}
+		out[i] = (char)ch;
+	}
+	out[i] = 0;
+}
+
+static int
+find(const uint8_t *ents, uint32_t n, const char *want)
+{
+	char nm[37];
+	for (uint32_t i = 0; i < n; i++) {
+		name_of(ents + i * 128, nm);
+		const char *a = nm, *b = want;
+		while (*a && *a == *b) {
+			a++, b++;
+		}
+		if (*a == 0 && *b == 0) {
+			return (int)i;
+		}
+	}
+	return -1;
+}
+
+int
+sweet_slot_check_header(const uint8_t *hdr, uint64_t my_lba, struct sweet_slot_gpt *g)
+{
+	static const char sig[8] = { 'E', 'F', 'I', ' ', 'P', 'A', 'R', 'T' };
+	for (int i = 0; i < 8; i++) {
+		if (hdr[i] != (uint8_t)sig[i]) {
+			return SWEET_SLOT_EBADHDR;
+		}
+	}
+	uint32_t hs = le32(hdr + 12);
+	if (hs < 92 || hs > 512 || le64(hdr + 24) != my_lba) {
+		return SWEET_SLOT_EBADHDR;
+	}
+	uint8_t tmp[512];
+	for (uint32_t i = 0; i < hs; i++) {
+		tmp[i] = hdr[i];
+	}
+	put32(tmp + 16, 0);
+	if (sweet_slot_crc32(tmp, hs) != le32(hdr + 16)) {
+		return SWEET_SLOT_EHDRCRC;
+	}
+	g->alt_lba = le64(hdr + 32);
+	g->entries_lba = le64(hdr + 72);
+	g->count = le32(hdr + 80);
+	g->size = le32(hdr + 84);
+	g->entries_crc = le32(hdr + 88);
+	if (g->size != 128 || g->count == 0 || g->count > SWEET_SLOT_MAX_ENTRIES) {
+		return SWEET_SLOT_EBADHDR;
+	}
+	return 0;
+}
+
+int
+sweet_slot_active(const uint8_t *ents, uint32_t n)
+{
+	int a = find(ents, n, "boot_a"), b = find(ents, n, "boot_b");
+	if (a < 0 || b < 0) {
+		return -1;
+	}
+	bool aa = (le64(ents + a * 128 + 48) & ACTIVE) != 0, ba = (le64(ents + b * 128 + 48) & ACTIVE) != 0;
+	return aa == ba ? -1 : aa ? 'a' : 'b';
+}
+
+/* both headers' entry CRC and header CRC recomputed after ENTS changed (and copied to BENTS) */
+static void
+sweet_slot_reseal(uint8_t *hdr, uint8_t *ents, uint8_t *bhdr, uint8_t *bents, uint32_t n)
+{
+	uint32_t bytes = n * 128;
+	for (uint32_t i = 0; i < bytes; i++) {
+		bents[i] = ents[i];
+	}
+	uint32_t crc = sweet_slot_crc32(ents, bytes);
+	uint8_t *hs[2] = { hdr, bhdr };
+	for (int h = 0; h < 2; h++) {
+		uint32_t size = le32(hs[h] + 12);
+		put32(hs[h] + 88, crc);
+		put32(hs[h] + 16, 0);
+		put32(hs[h] + 16, sweet_slot_crc32(hs[h], size));
+	}
+}
+
+int
+sweet_slot_mark_good(uint8_t *hdr, uint8_t *ents, uint8_t *bhdr, uint8_t *bents, uint64_t backup_lba, char slot)
+{
+	struct sweet_slot_gpt p, b;
+	int err;
+
+	if ((err = sweet_slot_check_header(hdr, 1, &p)) != 0 || (err = sweet_slot_check_header(bhdr, backup_lba, &b)) != 0) {
+		return err;
+	}
+	uint32_t bytes = p.count * 128;
+	if (p.alt_lba != backup_lba || p.count != b.count || sweet_slot_crc32(ents, bytes) != p.entries_crc ||
+	    sweet_slot_crc32(bents, bytes) != b.entries_crc) {
+		return SWEET_SLOT_EENTCRC;
+	}
+	if (sweet_slot_active(ents, p.count) != slot) {
+		return SWEET_SLOT_EUNCLEAR;
+	}
+	char boot[7] = { 'b', 'o', 'o', 't', '_', slot, 0 };
+	int i = find(ents, p.count, boot);
+	if (i < 0) {
+		return SWEET_SLOT_EUNCLEAR;
+	}
+	uint64_t at = le64(ents + i * 128 + 48);
+	if ((at & SUCCESSFUL) && !(at & UNBOOTABLE) && (at & RETRY_MASK) == RETRY_MASK) {
+		return SWEET_SLOT_ALREADY;
+	}
+	put64(ents + i * 128 + 48, (at & ~UNBOOTABLE & ~RETRY_MASK) | SUCCESSFUL | (7ull << 51));
+	sweet_slot_reseal(hdr, ents, bhdr, bents, p.count);
+	return 0;
+}
+
+int
+sweet_slot_switch(uint8_t *hdr, uint8_t *ents, uint8_t *bhdr, uint8_t *bents, uint64_t backup_lba,
+    char slot, bool successful)
+{
+	struct sweet_slot_gpt p, b;
+	int err;
+
+	if (slot != 'a' && slot != 'b') {
+		return SWEET_SLOT_EINVAL;
+	}
+	if ((err = sweet_slot_check_header(hdr, 1, &p)) != 0 ||
+	    (err = sweet_slot_check_header(bhdr, backup_lba, &b)) != 0) {
+		return err;
+	}
+	if (p.alt_lba != backup_lba || p.count != b.count || p.entries_crc != b.entries_crc) {
+		return SWEET_SLOT_EMISMATCH;
+	}
+	uint32_t n = p.count, bytes = n * 128;
+	if (sweet_slot_crc32(ents, bytes) != p.entries_crc || sweet_slot_crc32(bents, bytes) != b.entries_crc) {
+		return SWEET_SLOT_EENTCRC;
+	}
+	for (uint32_t i = 0; i < bytes; i++) {
+		if (ents[i] != bents[i]) {
+			return SWEET_SLOT_EMISMATCH;
+		}
+	}
+	int now = sweet_slot_active(ents, n);
+	if (now < 0) {
+		return SWEET_SLOT_EUNCLEAR;
+	}
+	for (int pass = 0; now != slot && pass < 2; pass++) {
+		/* pass 0 counts the pairs, pass 1 swaps them: nothing is changed if there are too few */
+		int pairs = 0;
+		char nm[37], other[37];
+		for (uint32_t i = 0; i < n; i++) {
+			name_of(ents + i * 128, nm);
+			size_t l = 0;
+			while (nm[l]) {
+				l++;
+			}
+			if (l < 3 || nm[l - 2] != '_' || nm[l - 1] != 'a') {
+				continue;
+			}
+			for (size_t k = 0; k <= l; k++) {
+				other[k] = nm[k];
+			}
+			other[l - 1] = 'b';
+			int j = find(ents, n, other);
+			if (j < 0) {
+				continue;
+			}
+			for (int k = 0; pass == 1 && k < 16; k++) {
+				uint8_t t = ents[i * 128 + k];
+				ents[i * 128 + k] = ents[j * 128 + k];
+				ents[j * 128 + k] = t;
+			}
+			pairs++;
+		}
+		if (pass == 0 && pairs < 10) {
+			return SWEET_SLOT_EPAIRS;
+		}
+	}
+	char nm[37], mine_boot[7] = { 'b', 'o', 'o', 't', '_', slot, 0 };
+	char old_boot[7] = { 'b', 'o', 'o', 't', '_', slot == 'a' ? 'b' : 'a', 0 };
+	for (uint32_t i = 0; i < n; i++) {
+		name_of(ents + i * 128, nm);
+		size_t l = 0;
+		while (nm[l]) {
+			l++;
+		}
+		if (l < 3 || nm[l - 2] != '_' || (nm[l - 1] != 'a' && nm[l - 1] != 'b')) {
+			continue;
+		}
+		uint64_t at = le64(ents + i * 128 + 48);
+		at = nm[l - 1] == slot ? at | ACTIVE : at & ~ACTIVE;
+		bool is_mine = true, is_old = true;
+		for (int k = 0; k < 7; k++) {
+			is_mine &= nm[k] == mine_boot[k];
+			is_old &= nm[k] == old_boot[k];
+		}
+		if (is_mine) {
+			at = (at & ~UNBOOTABLE & ~RETRY_MASK & ~PRIORITY_MASK) | (7ull << 51) | (3ull << 48);
+			at = successful ? at | SUCCESSFUL : at & ~SUCCESSFUL;
+		} else if (is_old && now != slot) {
+			at = (at & ~PRIORITY_MASK & ~RETRY_MASK) | (2ull << 48) | (7ull << 51);
+		}
+		put64(ents + i * 128 + 48, at);
+	}
+	sweet_slot_reseal(hdr, ents, bhdr, bents, n);
+	return 0;
+}
diff --git a/bsd/dev/sweet_slot.h b/bsd/dev/sweet_slot.h
new file mode 100644
index 0000000..1b51a8e
--- /dev/null
+++ b/bsd/dev/sweet_slot.h
@@ -0,0 +1,52 @@
+/* sweet_slot.h: Qualcomm A/B slot switch on a GPT held in memory (see sweet_slot.c). */
+#ifndef SWEET_SLOT_H
+#define SWEET_SLOT_H
+
+#ifdef KERNEL
+#include <sys/types.h>
+#include <stdbool.h>
+#else
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+#endif
+
+#define SWEET_SLOT_MAX_ENTRIES  256
+
+enum {
+	SWEET_SLOT_EINVAL = 1,          /* slot is not 'a' or 'b' */
+	SWEET_SLOT_EBADHDR,             /* not a GPT header, or one with odd fields */
+	SWEET_SLOT_EHDRCRC,             /* header CRC wrong */
+	SWEET_SLOT_EENTCRC,             /* entry array CRC wrong */
+	SWEET_SLOT_EMISMATCH,           /* the two copies differ */
+	SWEET_SLOT_EUNCLEAR,            /* boot_a/boot_b do not say which slot is active */
+	SWEET_SLOT_EPAIRS,              /* too few X_a/X_b pairs: not the A/B LUN */
+	SWEET_SLOT_ALREADY,             /* sweet_slot_mark_good: nothing to do */
+};
+
+/*
+ * boot_SLOT marked successful (7 retries, not unbootable) when SLOT is the active one -- what Android's
+ * update_verifier/boot HAL markBootSuccessful does for Android; the bootloader then stops counting the
+ * slot's retries down. 0, SWEET_SLOT_ALREADY, or an error (nothing changed).
+ */
+int sweet_slot_mark_good(uint8_t *hdr, uint8_t *ents, uint8_t *bhdr, uint8_t *bents, uint64_t backup_lba, char slot);
+
+struct sweet_slot_gpt {
+	uint64_t alt_lba, entries_lba;
+	uint32_t count, size, entries_crc;
+};
+
+uint32_t sweet_slot_crc32(const uint8_t *p, size_t n);
+int sweet_slot_check_header(const uint8_t *hdr, uint64_t my_lba, struct sweet_slot_gpt *g);
+/* 'a', 'b', or -1 */
+int sweet_slot_active(const uint8_t *ents, uint32_t n);
+/*
+ * HDR/BHDR: the primary (LBA 1) and backup (BACKUP_LBA) headers, a sector each; ENTS/BENTS: the two entry
+ * arrays (count * 128 bytes). Checked, then changed in place to make SLOT active; SUCCESSFUL also marks
+ * boot_SLOT successful (its retries are then not counted down). 0 or SWEET_SLOT_E*; nothing is changed on
+ * an error. Already active: only boot_SLOT's attributes are refreshed.
+ */
+int sweet_slot_switch(uint8_t *hdr, uint8_t *ents, uint8_t *bhdr, uint8_t *bents, uint64_t backup_lba,
+    char slot, bool successful);
+
+#endif
diff --git a/bsd/dev/sweet_spmi.c b/bsd/dev/sweet_spmi.c
new file mode 100644
index 0000000..4cd8ce2
--- /dev/null
+++ b/bsd/dev/sweet_spmi.c
@@ -0,0 +1,302 @@
+/*
+ * Battery-only adaptation of input/sweet_keys.c, observer EXT_READL.
+ * PMIC reads, plus one write: the reboot reason (sweet_spmi_set_reboot_reason, 0221).
+ * No interrupt clear, peripheral enable or charger config.
+ * Init is serialized by the single built-in SweetBattery personality.
+ * Battery APIDs are disjoint from the existing keys' 008/4c1 APIDs.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/sysctl.h>
+#include <machine/machine_routines.h>
+#include <IOKit/IOLocks.h>
+#include <kern/locks.h>
+#include "sweet_spmi.h"
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+
+/*
+ * sapphire (bengal/khaje): the arbiter at core 0x1c40000, obsrvr 0x3e00000, cnfg 0x1c0a000 (its
+ * device tree; sweet_keys.c has the same). The addresses here were sweet's (0x0c440000 / 0x0e600000 /
+ * 0x0c40a000): on this SoC a read there never comes back -- the boot stopped in SweetBattery (0206)
+ * and the audio thread in 0193.
+ */
+#define SP_CORE_PA 0x01c40000u
+#define SP_OBS_PA  0x03e00000u
+#define SP_CFG_PA  0x01c0a000u
+#define SP_NO_APID 0xffffu
+
+static vm_offset_t sp_core, sp_obs, sp_cfg;
+static IOLock *sp_lock;
+/*
+ * 0214: one lock for every reader of the arbiter's observer, this file's and sweet_keys.c's.
+ * Reads from the two at once crossed: the key thread got the battery's registers (pon=0xc3, the
+ * QG's "present"; 0x95, the charger's path) and iOS saw volume keys nobody pressed.
+ */
+static LCK_GRP_DECLARE(sweet_spmi_grp, "sweet_spmi");
+static LCK_MTX_DECLARE(sweet_spmi_mtx, &sweet_spmi_grp);
+void sweet_spmi_bus_lock(void);
+void sweet_spmi_bus_unlock(void);
+void
+sweet_spmi_bus_lock(void)
+{
+	lck_mtx_lock(&sweet_spmi_mtx);
+}
+void
+sweet_spmi_bus_unlock(void)
+{
+	lck_mtx_unlock(&sweet_spmi_mtx);
+}
+static unsigned sp_count;
+static bool sp_attempted, sp_ready;
+/* A timed-out command may complete late: never reuse that lane this boot. */
+static bool sp_poisoned[512];
+
+static uint32_t
+sp_rd(vm_offset_t base, unsigned off)
+{
+	uint32_t value = *(volatile uint32_t *)(base + off);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return value;
+}
+
+static uint16_t
+sp_find_apid(unsigned ppid)
+{
+	uint16_t found = SP_NO_APID;
+	for (unsigned i = 0; i < sp_count; ++i) {
+		uint32_t map = sp_rd(sp_core, 0x900u + 4u * i);
+		if (!map || ((map >> 8) & 0xfffu) != ppid) {
+			continue;
+		}
+		unsigned owner = sp_rd(sp_cfg, 0x700u + 4u * i) & 7u;
+		if (found == SP_NO_APID || owner == 0) {
+			found = (uint16_t)i;
+		}
+	}
+	return found;
+}
+
+int
+sweet_spmi_init(void)
+{
+	if (sp_attempted) {
+		return sp_ready ? 0 : -1;
+	}
+	sp_attempted = true;
+	sp_lock = IOLockAlloc();
+	if (!sp_lock) {
+		return -1;
+	}
+	sp_core = ml_io_map(SP_CORE_PA, 0x2000);
+	sp_cfg = ml_io_map(SP_CFG_PA, 0x1000);
+	sp_obs = ml_io_map(SP_OBS_PA, 0x10000); /* EE 0, 512 * 0x80 */
+	if (!sp_core || !sp_cfg || !sp_obs) {
+		printf("SWEET BATTERY: SPMI mapping failed\n");
+		return -1;
+	}
+	uint32_t arb_version = sp_rd(sp_core, 0);
+	sp_count = sp_rd(sp_core, 4) & 0x7ffu;
+	if (arb_version < 0x50000000u || arb_version >= 0x70000000u ||
+	    !sp_count || sp_count > 512) {
+		printf("SWEET BATTERY: unsupported SPMI arb=%#x APIDs=%u\n",
+		    arb_version, sp_count);
+		return -1;
+	}
+	sp_ready = true;
+	printf("SWEET BATTERY: SPMI arb=%#x APIDs=%u, observer reads only\n",
+	    arb_version, sp_count);
+	return 0;
+}
+
+/* Any PMIC register, read only (the audio test looks at regulators the RPM owns). */
+int sweet_spmi_read_any(unsigned sid, unsigned addr, uint8_t *out);
+int
+sweet_spmi_read_any(unsigned sid, unsigned addr, uint8_t *out)
+{
+	if (!sp_ready || !out || sid > 15 || addr > 0xffffu) {
+		return -1;
+	}
+	lck_mtx_lock(&sweet_spmi_mtx);
+	uint16_t apid = sp_find_apid((sid << 8) | (addr >> 8));
+	if (apid == SP_NO_APID || sp_poisoned[apid]) {
+		lck_mtx_unlock(&sweet_spmi_mtx);
+		return -2;
+	}
+	unsigned off = 0x80u * apid;
+	uint32_t cmd = (1u << 27) | ((addr & 0xffu) << 4);
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(sp_obs + off) = cmd;
+	__asm__ volatile("dsb osh" ::: "memory");
+	for (unsigned i = 0; i < 1000; ++i) {
+		uint32_t status = sp_rd(sp_obs, off + 0x08u);
+		if (status & 1u) {
+			int r = (status & 0x0eu) ? -3 : 0;
+			*out = (uint8_t)sp_rd(sp_obs, off + 0x18u);
+			lck_mtx_unlock(&sweet_spmi_mtx);
+			return r;
+		}
+		delay(1);
+	}
+	sp_poisoned[apid] = true;
+	lck_mtx_unlock(&sweet_spmi_mtx);
+	return -4;
+}
+
+/*
+ * sapphire 0221: the one PMIC write this file makes, the reboot reason ABL reads. PM6125's PON
+ * at SID 0 0x800, PON_SOFT_RB_SPARE = +0x8f, bits 7:1 = mode (Linux qcom-pon, pm8998 layout,
+ * reason_shift 1; the device tree's mode-bootloader = 2, mode-recovery = 1). Written through the
+ * arbiter's RW channel of that peripheral (chnls 0x1e00000 + 0x10000 * APID), only if the channel
+ * is ours (owner EE 0), then read back through the observer.
+ */
+#define SP_CHNLS_PA     0x01e00000u
+#define PON_SPARE       0x088fu
+
+/*
+ * 0242: one register written through its peripheral's RW channel, only if the channel is ours (owner
+ * EE 0) and only where this file writes: PM6125's PON (sid 0, 0x800) and PM7250B's charger (sid 2,
+ * SMB5 0x1000-0x16ff). The channel pages are mapped once. 0 when the write completed without error.
+ */
+static vm_offset_t sp_chmap[512];
+int sweet_spmi_write(unsigned sid, unsigned addr, uint8_t val);
+int
+sweet_spmi_write(unsigned sid, unsigned addr, uint8_t val)
+{
+	unsigned peripheral = addr >> 8;
+	/* 0263: + SID 3 0x5300-0x53ff, the PM7250B LDO vibrator (sweet_vibrate.c) */
+	if (!(sid == 0 && peripheral == 0x08) && !(sid == 2 && peripheral >= 0x10 && peripheral <= 0x16) &&
+	    !(sid == 3 && peripheral == 0x53) &&
+	    !(sid == 0 && peripheral == 0xC1) && !(sid == 2 && peripheral == 0xC2)) {   /* 0270: camera AVDD/DVDD GPIOs */
+		return -1;
+	}
+	if (!sp_ready && sweet_spmi_init() != 0) {
+		return -1;
+	}
+	lck_mtx_lock(&sweet_spmi_mtx);
+	uint16_t apid = sp_find_apid((sid << 8) | peripheral);
+	if (apid == SP_NO_APID || apid >= 512 || (sp_rd(sp_cfg, 0x700u + 4u * apid) & 7u) != 0) {
+		lck_mtx_unlock(&sweet_spmi_mtx);
+		printf("SWEET SPMI: sid %u %#x: channel APID %u is not ours\n", sid, addr, apid);
+		return -3;
+	}
+	if (sp_chmap[apid] == 0) {
+		sp_chmap[apid] = ml_io_map(SP_CHNLS_PA + 0x10000u * apid, 0x1000);
+	}
+	vm_offset_t ch = sp_chmap[apid];
+	if (ch == 0) {
+		lck_mtx_unlock(&sweet_spmi_mtx);
+		return -4;
+	}
+	*(volatile uint32_t *)(ch + 0x10u) = val;                       /* WDATA0 */
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(ch + 0x00u) = ((addr & 0xffu) << 4);     /* EXT_WRITEL (0), BC=0 */
+	__asm__ volatile("dsb osh" ::: "memory");
+	uint32_t status = 0;
+	for (unsigned i = 0; i < 1000 && !((status = sp_rd(ch, 0x08u)) & 1u); ++i) {
+		delay(1);
+	}
+	lck_mtx_unlock(&sweet_spmi_mtx);
+	return (status & 0x0eu) || !(status & 1u) ? -5 : 0;
+}
+
+int sweet_spmi_set_reboot_reason(unsigned mode);
+int
+sweet_spmi_set_reboot_reason(unsigned mode)
+{
+	if (mode > 0x7f || (!sp_ready && sweet_spmi_init() != 0)) {
+		return -1;
+	}
+	uint8_t old = 0;
+	if (sweet_spmi_read_any(0, PON_SPARE, &old) != 0) {
+		return -2;
+	}
+	uint8_t val = (uint8_t)((old & 1u) | (mode << 1));
+	int r = sweet_spmi_write(0, PON_SPARE, val);
+	uint8_t now = 0;
+	(void)sweet_spmi_read_any(0, PON_SPARE, &now);
+	printf("SWEET REBOOT: PON spare %#x -> %#x (mode %u, write %d)\n", old, now, mode, r);
+	return r != 0 || now != val ? -5 : 0;
+}
+
+/*
+ * 0242: kern.sweet_spmi, a PMIC register from ssh. Write op << 56 | sid << 48 | addr << 32 | value, read
+ * the answer: op 1 read (any register; the answer is its value, or 0x100 + the error), op 2 write
+ * (sweet_spmi_write's registers only; the answer is the value read back, or 0x100 + the error).
+ */
+static uint64_t sweet_spmi_answer;
+static int
+sysctl_sweet_spmi SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	uint64_t v = sweet_spmi_answer;
+	int err = sysctl_io_number(req, (long long)v, sizeof(v), &v, NULL);
+	if (err != 0 || req->newptr == USER_ADDR_NULL) {
+		return err;
+	}
+	unsigned op = (unsigned)(v >> 56), sid = (unsigned)(v >> 48) & 0xffu, addr = (unsigned)(v >> 32) & 0xffffu;
+	if (!sp_ready && sweet_spmi_init() != 0) {
+		return ENXIO;
+	}
+	uint8_t val = 0;
+	int r;
+	if (op == 1) {
+		r = sweet_spmi_read_any(sid, addr, &val);
+	} else if (op == 2) {
+		r = sweet_spmi_write(sid, addr, (uint8_t)v);
+		if (r == 0) {
+			r = sweet_spmi_read_any(sid, addr, &val);
+		}
+		printf("SWEET SPMI: write sid %u %#x = %#x: %d, now %#x\n", sid, addr, (unsigned)(uint8_t)v, r, val);
+	} else {
+		return EINVAL;
+	}
+	sweet_spmi_answer = r == 0 ? val : 0x100u + (unsigned)(-r);
+	return 0;
+}
+SYSCTL_PROC(_kern, OID_AUTO, sweet_spmi, CTLTYPE_QUAD | CTLFLAG_RW | CTLFLAG_LOCKED, NULL, 0,
+    sysctl_sweet_spmi, "Q", "PMIC register: op<<56|sid<<48|addr<<32|value; op 1 read, 2 write");
+
+int
+sweet_spmi_read(unsigned sid, unsigned addr, uint8_t *out)
+{
+	/* Restrict access to the battery blocks; keys retain their own lanes. */
+	unsigned peripheral = addr >> 8;
+	/* sid 0: PM6150 (sweet); sid 2: PM7250B, sapphire's charger (SMB5) and gauge (QG) */
+	if (!sp_ready || !out || (sid != 0 && sid != 2) || addr > 0xffffu ||
+	    (peripheral != 0x10 && peripheral != 0x11 && peripheral != 0x12 &&
+	    peripheral != 0x13 && peripheral != 0x48)) {
+		return -1;
+	}
+	lck_mtx_lock(&sweet_spmi_mtx);
+	uint16_t apid = sp_find_apid((sid << 8) | peripheral);
+	if (apid == SP_NO_APID || sp_poisoned[apid]) {
+		lck_mtx_unlock(&sweet_spmi_mtx);
+		return -1;
+	}
+	unsigned off = 0x80u * apid;
+	uint32_t cmd = (1u << 27) | ((addr & 0xffu) << 4);
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(sp_obs + off) = cmd; /* EXT_READL, BC=0 */
+	__asm__ volatile("dsb osh" ::: "memory");
+	for (unsigned i = 0; i < 1000; ++i) {
+		uint32_t status = sp_rd(sp_obs, off + 0x08u);
+		if (status & 1u) {
+			if (status & 0x0eu) {
+				lck_mtx_unlock(&sweet_spmi_mtx);
+				return -1;
+			}
+			*out = (uint8_t)sp_rd(sp_obs, off + 0x18u);
+			lck_mtx_unlock(&sweet_spmi_mtx);
+			return 0;
+		}
+		delay(1);
+	}
+	sp_poisoned[apid] = true;
+	printf("SWEET BATTERY: SPMI timeout sid=%u addr=%#x APID=%u disabled\n",
+	    sid, addr, apid);
+	lck_mtx_unlock(&sweet_spmi_mtx);
+	return -1;
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
diff --git a/bsd/dev/sweet_spmi.h b/bsd/dev/sweet_spmi.h
new file mode 100644
index 0000000..510743a
--- /dev/null
+++ b/bsd/dev/sweet_spmi.h
@@ -0,0 +1,16 @@
+/* Shared C/C++ interface. Init once, on the SweetBattery start thread. */
+#ifndef SWEET_BATTERY_SPMI_H
+#define SWEET_BATTERY_SPMI_H
+#include <stdint.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+int sweet_spmi_init(void);
+/* Thread context only; 0 success, -1 failure; *out unchanged on failure. */
+int sweet_spmi_read(unsigned sid, unsigned addr, uint8_t *out);
+/* 0242: PON (sid 0, 0x800) and the PM7250B's charger (sid 2, 0x1000-0x16ff) only; 0 success. */
+int sweet_spmi_write(unsigned sid, unsigned addr, uint8_t val);
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/bsd/dev/sweet_touch.c b/bsd/dev/sweet_touch.c
new file mode 100644
index 0000000..8eb9701
--- /dev/null
+++ b/bsd/dev/sweet_touch.c
@@ -0,0 +1,1221 @@
+/*
+ * SWEET SE7 FIFO I2C / GT9896 Yellowstone / Focaltech 54:52 bring-up.
+ * topaz (SM6225): FocalTech FT5452 at 0x38 on QUP0 SE2, IRQ GPIO80, reset
+ * GPIO86, AVDD enable GPIO36 (no regulator), values from topaz-woa
+ * TopazTouch. Call once after the scheduler is running; all work runs on one
+ * thread. Requires ABL-loaded GENI I2C firmware.
+ * No firmware/config upload or direct PMIC writes. Only IC data write:
+ * zero to GT9896's event status after reading a report. See touch2/report.md.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+#include <sys/sysctl.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+/* Mach MIG declaration is not included by BSD's exported thread.h. */
+extern kern_return_t thread_terminate(thread_t);
+extern int sweet_rpmh_vreg_enable(const char *res, unsigned mv);
+extern void sweet_hid_touch(int finger, int down, int x, int y);
+void sweet_touch_init(void);
+
+#define TOUCH_SE_PA      0x04a88000u /* QUP0 SE2 */
+#define TOUCH_GCC_PA     0x01400000u
+#define TOUCH_WEST_PA    0x00500000u /* TLMM 0x400000 + WEST tile: GPIO 6/7/80/86 */
+#define TOUCH_EAST_PA    0x00d00000u /* TLMM 0x400000 + EAST tile: GPIO 36 */
+#define TOUCH_GCC_VOTE   0x7900cu    /* QUP0 wrapper + SE2 vote, bits 0x13c0 */
+#define TOUCH_RCG       0x1f3a8u    /* QUP0 S2 CMD; CFG +4, CBCR -4 (gcc-khaje.c) */
+#define TOUCH_PIN_RESET  86u
+#define TOUCH_PIN_IRQ    80u
+#define TOUCH_PIN_AVDD   36u
+#define TOUCH_GPIO_CFG(n) ((uint32_t)(n) * 0x1000u)
+#define TOUCH_GPIO_IO(n)  (TOUCH_GPIO_CFG(n) + 4u)
+#define TOUCH_MAX        10u
+#define TOUCH_GOODIX     1
+#define TOUCH_FTS        2
+/* GT9896 is Yellowstone in Xiaomi sweet-r-oss, not the Berlin protocol. */
+#define GOODIX_PID_REG   0x4022u
+#define GOODIX_EVENT_REG 0x4180u
+#define GOODIX_HEAD_LEN  8u
+#define GOODIX_POINT_LEN 8u
+
+#define SE_STATUS       0x040u
+#define SE_MCLK         0x048u
+#define SE_FW           0x068u
+#define SE_CLK_SEL      0x07cu
+#define SE_DMA          0x258u
+#define SE_TX_LEN       0x26cu
+#define SE_RX_LEN       0x270u
+#define SE_SCL          0x278u
+#define SE_CMD          0x600u
+#define SE_CTRL         0x604u
+#define SE_IRQ          0x610u
+#define SE_IRQ_EN       0x614u
+#define SE_IRQ_CLR      0x618u
+#define SE_TX           0x700u
+#define SE_RX           0x780u
+#define SE_TX_COUNT     0x800u
+#define SE_RX_COUNT     0x804u
+#define SE_HW_TX        0xe24u
+#define SE_HW_RX        0xe28u
+#define SE_TX_WM        0x80cu
+#define SE_RX_WM_IRQ    (1u << 26)
+#define SE_RX_LAST      (1u << 27)
+#define SE_TX_WM_IRQ    (1u << 30)
+#define SE_DONE         (1u << 0)
+#define SE_NACK         (1u << 10)
+#define SE_ERRORS       (0x3eu | (1u << 9) | (1u << 10) | (1u << 12) | \
+                         (1u << 13) | (3u << 24) | (3u << 28))
+#define SE_EVENTS       (SE_DONE | SE_ERRORS | SE_RX_WM_IRQ | SE_RX_LAST | SE_TX_WM_IRQ)
+/* geni_se_config_packing(8, 4, true, true, true): start bits 7/15/23/31,
+ * MSB-to-LSB, length 8, STOP only on vector 3. FIFO bytes remain LSB first. */
+#define SE_PACK0        0x0007f8feu
+#define SE_PACK1        0x000ffefeu
+
+static struct {
+	vm_offset_t se, gcc, west, east;
+	bool started, dead, probing;
+	int kind, irq_hint;
+	uint32_t irq_status, irq_last, active;
+	unsigned sent, got;
+	int x[TOUCH_MAX], y[TOUCH_MAX];
+	/* sweettouchdiag: last step reached and the values seen on the way */
+	int diag;
+	const char *stage;
+	uint32_t d_vote, d_cfg, d_cbcr, d_fw, d_status, d_hwtx, d_hwrx;
+	int d_fe1, d_fe2, d_ge;
+	uint8_t d_fid1, d_fid2;
+	/* sweettouchdiag=2: polling statistics */
+	unsigned s_frames, s_errs, s_down, s_up, s_maxn;
+	int s_lasterr, s_lastx, s_lasty;
+	uint8_t s_raw[12];
+	/* Focaltech raw format and range (boot-args sweettouch_fbits/_rx/_ry) */
+	unsigned fbits, rx, ry, rawlog;
+} st;
+static int touch_sleep_chan;
+
+static uint32_t
+touch_rd(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+static void
+touch_wr(vm_offset_t base, uint32_t off, uint32_t val)
+{
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(base + off) = val;
+	__asm__ volatile("dsb osh" ::: "memory");
+}
+
+static void
+touch_wait(unsigned ms)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&touch_sleep_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static void
+touch_wait_until(uint64_t deadline)
+{
+	(void)assert_wait_deadline(&touch_sleep_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static void
+touch_wait_us(unsigned us)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(us, NSEC_PER_USEC, &deadline);
+	touch_wait_until(deadline);
+}
+
+static bool
+touch_wait_clear(vm_offset_t base, uint32_t off, uint32_t mask)
+{
+	for (unsigned i = 0; i < 5000; ++i) {
+		if (!(touch_rd(base, off) & mask)) {
+			return true;
+		}
+		delay(1);
+	}
+	return false;
+}
+
+/* topaz: GPIO 36 is on the EAST tile, the touch pins otherwise on WEST. */
+static vm_offset_t
+touch_tile(unsigned pin)
+{
+	return pin == TOUCH_PIN_AVDD ? st.east : st.west;
+}
+
+static void
+touch_gpio(unsigned pin, unsigned mux, unsigned pull, unsigned drive, bool out, bool high)
+{
+	vm_offset_t tile = touch_tile(pin);
+	uint32_t off = TOUCH_GPIO_CFG(pin);
+	uint32_t cfg = touch_rd(tile, off);
+	if (out) {
+		/* Set the desired latch before enabling output (reset is active low). */
+		touch_wr(tile, TOUCH_GPIO_IO(pin),
+		    (touch_rd(tile, TOUCH_GPIO_IO(pin)) & ~2u) | (high ? 2u : 0u));
+	}
+	cfg &= ~0x3ffu;
+	cfg |= (mux << 2) | pull | (drive << 6) | (out ? 0x200u : 0u);
+	touch_wr(tile, off, cfg);
+}
+
+static bool
+touch_clocks(void)
+{
+	/*
+	 * topaz (TopazTouch hwio.c): OR the QUP0 wrapper/SE2 votes into the
+	 * shared vote register (other bits belong to other clients), XO parent
+	 * with divider 1 = 19.2 MHz, no PLL or voltage change.
+	 */
+	touch_wr(st.gcc, TOUCH_GCC_VOTE, touch_rd(st.gcc, TOUCH_GCC_VOTE) | 0x13c0u);
+	printf("SWEET TOUCH: gcc vote=%#x rcg=%#x cfg=%#x cbcr=%#x\n",
+	    touch_rd(st.gcc, TOUCH_GCC_VOTE), touch_rd(st.gcc, TOUCH_RCG),
+	    touch_rd(st.gcc, TOUCH_RCG + 4u), touch_rd(st.gcc, TOUCH_RCG - 4u));
+	st.d_vote = touch_rd(st.gcc, TOUCH_GCC_VOTE);
+	touch_wr(st.gcc, TOUCH_RCG + 4u, 1u);
+	touch_wr(st.gcc, TOUCH_RCG, touch_rd(st.gcc, TOUCH_RCG) | 1u);
+	if (!touch_wait_clear(st.gcc, TOUCH_RCG, 1u)) {
+		printf("SWEET TOUCH: RCG update timeout\n");
+		return false;
+	}
+	st.d_cfg = touch_rd(st.gcc, TOUCH_RCG + 4u);
+	st.d_cbcr = touch_rd(st.gcc, TOUCH_RCG - 4u);
+	if (!touch_wait_clear(st.gcc, TOUCH_RCG - 4u, 1u << 31)) {
+		printf("SWEET TOUCH: SE2 branch halted (%#x)\n", touch_rd(st.gcc, TOUCH_RCG - 4u));
+		return false;
+	}
+	return true;
+}
+
+/* Called only for a transfer started by this driver, including a stretched TX. */
+static void
+touch_abort(void)
+{
+	/* i2c-qcom-geni.c: M_GENI_CMD_CANCEL, then ABORT if cancel does not finish */
+	bool done = false;
+	touch_wr(st.se, SE_CTRL, 4);
+	for (unsigned i = 0; i < 1000; ++i) {
+		if (touch_rd(st.se, SE_IRQ) & (1u << 4)) {
+			done = true;
+			break;
+		}
+		delay(1);
+	}
+	if (!done) {
+		touch_wr(st.se, SE_CTRL, 2); /* abort M command, release held bus */
+		for (unsigned i = 0; i < 1000; ++i) {
+			if (touch_rd(st.se, SE_IRQ) & (1u << 5)) {
+				done = true;
+				break;
+			}
+			delay(1);
+		}
+	}
+	if (!done || !touch_wait_clear(st.se, SE_STATUS, 1u)) {
+		st.dead = true;
+		printf("SWEET TOUCH: abort failed status=%#x irq=%#x; stopping\n",
+		    touch_rd(st.se, SE_STATUS), touch_rd(st.se, SE_IRQ));
+	}
+	/* Bound drain even if the hardware reports an impossible FIFO count. */
+	for (unsigned i = 0; i < 64 && (touch_rd(st.se, SE_RX_COUNT) & 0x1ffffffu); ++i) {
+		(void)touch_rd(st.se, SE_RX);
+	}
+	touch_wr(st.se, SE_IRQ_CLR, 0xffffffffu);
+	if (touch_rd(st.se, SE_TX_COUNT) & 0xfffffffu) {
+		st.dead = true;
+		printf("SWEET TOUCH: TX FIFO not empty after abort; stopping\n");
+	}
+}
+
+/* Keep all observed bits for diagnostics, even if a watermark was cleared. */
+static uint32_t
+touch_irq(void)
+{
+	st.irq_last = touch_rd(st.se, SE_IRQ);
+	st.irq_status |= st.irq_last;
+	return st.irq_last;
+}
+
+/* One Linux-style FIFO message. TX is at most 3 bytes; RX at most 90. */
+static int
+touch_msg_run(uint8_t addr, const uint8_t *tx, unsigned nt, uint8_t *rx,
+    unsigned nr, bool stretch)
+{
+	if (st.dead || nt > 3 || nr > 90 || (nt && nr) || (!nt && !nr)) {
+		return EIO;
+	}
+	if (!touch_wait_clear(st.se, SE_STATUS, 1u)) {
+		st.dead = true; /* no other SE7 owner is supported */
+		return EBUSY;
+	}
+	touch_wr(st.se, SE_IRQ_CLR, 0xffffffffu);
+	touch_wr(st.se, SE_TX_WM, nt ? 1u : 0u);
+	touch_wr(st.se, nr ? SE_RX_LEN : SE_TX_LEN, nr ? nr : nt);
+	touch_wr(st.se, SE_CMD, ((nr ? 2u : 1u) << 27) |
+	    ((uint32_t)addr << 9) | (stretch ? 4u : 0u));
+	if (nr > 8 && !st.probing) {
+		/*
+		 * Sleep, do not spin, through most of the transfer: ~22 us a byte at 400 kHz. It was
+		 * a flat 2 ms -- for the 10 bytes of one contact, 0.25 ms of bus -- in every poll.
+		 */
+		touch_wait_us(nr * 18u);
+	}
+	int err = ETIMEDOUT;
+	for (unsigned i = 0; i < 5000; ++i) {
+		uint32_t irq = touch_irq();
+		if (irq & SE_ERRORS) {
+			err = (irq & SE_NACK) ? ENXIO : EIO;
+			/* A completed NACK is normal during address probing. Aborting an
+			 * idle sequencer may never produce ABORT_DONE. Wait for completion
+			 * and leave a clean idle engine available for the other IC. */
+			for (unsigned j = 0; j < 5000 && !(irq & SE_DONE); ++j) {
+				delay(1);
+				irq = touch_irq();
+			}
+			if ((irq & SE_DONE) && !(touch_rd(st.se, SE_STATUS) & 1u) &&
+			    !(touch_rd(st.se, SE_TX_COUNT) & 0xfffffffu) &&
+			    !(touch_rd(st.se, SE_RX_COUNT) & 0x1ffffffu)) {
+				touch_wr(st.se, SE_IRQ_CLR, irq);
+				return err;
+			}
+			break;
+		}
+		if (nt && !st.sent && (irq & SE_TX_WM_IRQ)) {
+			uint32_t word = 0;
+			for (unsigned j = 0; j < nt; ++j) {
+				word |= (uint32_t)tx[j] << (8u * j);
+			}
+			touch_wr(st.se, SE_TX, word);
+			st.sent = nt;
+			touch_wr(st.se, SE_TX_WM, 0);
+		}
+		uint32_t count = touch_rd(st.se, SE_RX_COUNT) & 0x1ffffffu;
+		if (count > 64 || count > (nr - st.got + 3u) / 4u) {
+			err = EIO;
+			break;
+		}
+		while (count--) {
+			uint32_t word = touch_rd(st.se, SE_RX);
+			for (unsigned j = 0; j < 4 && st.got < nr; ++j) {
+				rx[st.got++] = (uint8_t)(word >> (8u * j));
+			}
+		}
+		/* DONE is checked after draining RX, so final short words aren't lost. */
+		if (irq & SE_DONE) {
+			/* Re-sample after the final drain; a late error must beat DONE. */
+			irq = touch_irq();
+			if (irq & SE_ERRORS) {
+				continue;
+			}
+			touch_wr(st.se, SE_IRQ_CLR, irq);
+			if (st.got == nr && st.sent == nt) {
+				return 0;
+			}
+			err = EIO;
+			break;
+		}
+		/* Preserve DONE/errors if they arrive during this iteration. */
+		touch_wr(st.se, SE_IRQ_CLR, irq & (SE_RX_WM_IRQ | SE_RX_LAST | SE_TX_WM_IRQ));
+		delay(1);
+	}
+	touch_abort();
+	return err;
+}
+
+static int
+touch_msg(uint8_t addr, const uint8_t *tx, unsigned nt, uint8_t *rx,
+    unsigned nr, bool stretch)
+{
+	st.irq_status = st.irq_last = 0;
+	st.sent = st.got = 0;
+	int err = touch_msg_run(addr, tx, nt, rx, nr, stretch);
+	if (st.probing) {
+		printf("SWEET TOUCH: probe xfer addr=%#x %s len=%u stretch=%u err=%d irq=%#x seen=%#x tx=%u rx=%u status=%#x\n",
+		    addr, nr ? "read" : "write", nr ? nr : nt, stretch ? 1u : 0u,
+		    err, st.irq_last, st.irq_status, st.sent, st.got,
+		    touch_rd(st.se, SE_STATUS));
+	}
+	return err;
+}
+
+static int
+touch_read(uint8_t addr, uint16_t reg, bool wide, uint8_t *buf, unsigned len)
+{
+	uint8_t ptr[2] = {(uint8_t)(reg >> 8), (uint8_t)reg};
+	int err = touch_msg(addr, wide ? ptr : ptr + 1, wide ? 2u : 1u,
+	    NULL, 0, true);
+	if (err) {
+		return err;
+	}
+	/* STOP_STRETCH on the pointer write retains the bus for a repeated START. */
+	return touch_msg(addr, NULL, 0, buf, len, false);
+}
+
+static int
+touch_goodix_ack(void)
+{
+	const uint8_t ack[3] = {GOODIX_EVENT_REG >> 8, GOODIX_EVENT_REG & 0xffu, 0};
+	return touch_msg(0x5d, ack, sizeof(ack), NULL, 0, false);
+}
+
+/* Raw read only: 0x8240 is the vendor's generic/older VERSION candidate,
+ * not a second accepted GT9896 identity. Never try a four-byte Berlin pointer:
+ * on this 16-bit IC the extra bytes would be register data writes. */
+static int
+touch_probe_info(uint16_t reg, uint8_t *buf)
+{
+	memset(buf, 0xa5, 32);
+	int err = touch_read(0x5d, reg, true, buf, 32);
+	printf("SWEET TOUCH: probe info reg=%#x len=32 err=%d irq=%#x seen=%#x\n",
+	    reg, err, st.irq_last, st.irq_status);
+	if (!err) {
+		for (unsigned off = 0; off < 32; off += 16) {
+			char line[49];
+			for (unsigned j = 0; j < 16; ++j) {
+				(void)snprintf(line + j * 3u, 4, "%02x ", buf[off + j]);
+			}
+			printf("SWEET TOUCH: probe raw %#x: %s\n", reg + off, line);
+		}
+	}
+	return err;
+}
+
+static unsigned
+touch_be16(const uint8_t *p)
+{
+	return ((unsigned)p[0] << 8) | p[1];
+}
+
+static bool
+touch_checksum(const uint8_t *buf, unsigned len)
+{
+	if (len < 2) {
+		return false;
+	}
+	unsigned sum = 0;
+	for (unsigned i = 0; i + 2 < len; ++i) {
+		sum += buf[i];
+	}
+	return (sum & 0xffffu) == touch_be16(buf + len - 2);
+}
+
+/*
+ * 0261: the fingerprint spot (sapphire FOD: centre 540,2109, radius 105 in the 1080x2400 panel
+ * pixels the reports are mapped to). kern.sweet_fod_press: 1 while a touch is inside it;
+ * kern.sweet_fod_seq: +1 at every press inside it.
+ */
+#define FOD_X   540
+#define FOD_Y   2109
+#define FOD_R   105
+int sweet_fod_press, sweet_fod_seq;
+SYSCTL_INT(_kern, OID_AUTO, sweet_fod_press, CTLFLAG_RD | CTLFLAG_LOCKED, &sweet_fod_press, 0,
+    "1 while a touch is inside the fingerprint circle");
+SYSCTL_INT(_kern, OID_AUTO, sweet_fod_seq, CTLFLAG_RD | CTLFLAG_LOCKED, &sweet_fod_seq, 0,
+    "presses inside the fingerprint circle so far");
+
+static void
+touch_fod(uint32_t mask, const int *x, const int *y)
+{
+	static bool logged;
+	int in = 0, fx = 0, fy = 0;
+	for (unsigned id = 0; id < TOUCH_MAX; ++id) {
+		if (mask & (1u << id)) {
+			int dx = x[id] - FOD_X, dy = y[id] - FOD_Y;
+			if (dx * dx + dy * dy <= FOD_R * FOD_R) {
+				in = 1;
+				fx = x[id];
+				fy = y[id];
+			}
+		}
+	}
+	if (in && !sweet_fod_press) {
+		sweet_fod_seq++;
+		if (!logged) {
+			logged = true;
+			printf("SWEET TOUCH: first press in the fingerprint circle at %d,%d (panel pixels 1080x2400, raw range %ux%u)\n",
+			    fx, fy, st.rx, st.ry);
+		}
+	}
+	sweet_fod_press = in;
+}
+
+/*
+ * sapphire 0300: a finger left "down" after it was lifted (now and then an icon stayed pressed, or
+ * a page kept being held). A real finger never gives the same bytes for long: its positions carry
+ * fraction bits and its area byte, and they move. When, with a contact down, the IC returns a frame
+ * identical byte for byte for sweettouch_stale_ms (default 1000), it is taken as stuck: every
+ * contact is released, and that frame is not acted on again until a different one comes.
+ * kern.sweet_touch_stale: releases so far; kern.sweet_touch_same_ms: the longest identical run seen
+ * with a contact down (to tune the threshold against long presses).
+ */
+/*
+ * 0312: 6 s. A finger held still on the in-display fingerprint sensor (or a long press) gives the
+ * FocalTech IC's very same frame for a second and more: at 1 s it was released mid-scan.
+ */
+static unsigned touch_stale_ms = 6000;
+static int sweet_touch_stale, sweet_touch_same_ms;
+/*
+ * 0314: at 6 s a finger that the IC never reported lifted stayed "down" for 6 s (animations held,
+ * the next touches odd). What tells a still finger from a stuck frame is the IRQ line (GPIO80, low
+ * while the IC has a frame for us): with a finger on the glass the IC keeps scanning and
+ * interrupting even when the frame comes out the same; stuck, it has gone quiet. So: the same frame
+ * with a contact down AND no IRQ for touch_quiet_ms (30) is a stuck one; 6 s stays as the last
+ * resort (and the only rule with sweettouchirq=0). kern.sweet_touch_quiet_ms / _stale_ms set both;
+ * kern.sweet_touch_quiet: releases by this rule; kern.sweet_touch_irq_gap_ms: the longest time
+ * without IRQ seen inside an identical run that ended on its own (a held finger: should stay small).
+ */
+static unsigned touch_quiet_ms = 0;       /* 0360: off (irq_gap_ms > 1000 ms seen on held fingers on FT5452) */
+static int sweet_touch_quiet, sweet_touch_irq_gap_ms;
+static uint64_t touch_irq_last;         /* when the IRQ line was last seen low */
+static uint64_t touch_rate_down_abs;
+static unsigned touch_rate_new, touch_rate_reads, touch_irq_reads, touch_late_reads;
+/*
+ * 0313: with a finger down the FocalTech IC has a new frame every 4.17 ms (240 Hz, register 0x88 = 24) and
+ * the IC was read every 4.00 ms on a fixed grid: the two drift past each other ~10 times a second, a read
+ * finds nothing new and the next one a frame up to 4 ms old, so iOS got positions in uneven steps (a
+ * finger's drag stuttered where the injected, perfectly even, touches did not). Now, with a finger down,
+ * the IRQ line (GPIO80, low when the IC has a frame) is looked at every 0.5 ms and the frame read as soon
+ * as it is there (time-stamped within 0.5 ms of the IC's), or after 6 ms anyway. Boot-arg
+ * sweettouchfast=0: the fixed 4 ms grid as before.
+ */
+static unsigned touch_fast = 1;
+
+/* kern.sweet_touch_rate: new frames per second of contact since the last write of 0 (0312) */
+static int
+sysctl_sweet_touch_rate SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	char out[128];
+	uint64_t ns = 0;
+	absolutetime_to_nanoseconds(touch_rate_down_abs, &ns);
+	unsigned ms = (unsigned)(ns / NSEC_PER_MSEC);
+	snprintf(out, sizeof(out), "%u new frames in %u ms of contact (%u per s); reads on IRQ %u, late %u; fast %u",
+	    touch_rate_new, ms, ms ? (unsigned)((uint64_t)touch_rate_new * 1000 / ms) : 0, touch_irq_reads,
+	    touch_late_reads, touch_fast);
+	int error = SYSCTL_OUT(req, out, strlen(out) + 1);
+	if (!error && req->newptr != USER_ADDR_NULL) {
+		touch_rate_down_abs = 0;
+		touch_rate_new = touch_rate_reads = touch_irq_reads = touch_late_reads = 0;
+	}
+	return error;
+}
+SYSCTL_PROC(_kern, OID_AUTO, sweet_touch_rate, CTLTYPE_STRING | CTLFLAG_RW | CTLFLAG_LOCKED, 0, 0,
+    sysctl_sweet_touch_rate, "A", "touch: new IC frames per second of contact (write anything: reset) (0312)");
+SYSCTL_UINT(_kern, OID_AUTO, sweet_touch_quiet_ms, CTLFLAG_RW | CTLFLAG_LOCKED, &touch_quiet_ms, 0,
+    "touch: same frame + no IRQ this long with a contact down = stuck (0314; 0 off)");
+SYSCTL_UINT(_kern, OID_AUTO, sweet_touch_stale_ms, CTLFLAG_RW | CTLFLAG_LOCKED, &touch_stale_ms, 0,
+    "touch: same frame this long with a contact down = stuck, IRQ or not (0314)");
+SYSCTL_INT(_kern, OID_AUTO, sweet_touch_quiet, CTLFLAG_RD | CTLFLAG_LOCKED, &sweet_touch_quiet, 0,
+    "touch: contacts released because the IC went quiet (0314)");
+SYSCTL_INT(_kern, OID_AUTO, sweet_touch_irq_gap_ms, CTLFLAG_RD | CTLFLAG_LOCKED, &sweet_touch_irq_gap_ms, 0,
+    "touch: longest IRQ gap inside an identical run that ended by itself (0314)");
+SYSCTL_INT(_kern, OID_AUTO, sweet_touch_stale, CTLFLAG_RD | CTLFLAG_LOCKED, &sweet_touch_stale, 0,
+    "contacts released because the touch IC repeated one frame (0300)");
+SYSCTL_INT(_kern, OID_AUTO, sweet_touch_same_ms, CTLFLAG_RD | CTLFLAG_LOCKED, &sweet_touch_same_ms, 0,
+    "longest run of identical touch frames with a contact down, ms (0300)");
+
+/*
+ * 0324: tap to wake (tester bug 5). The IC keeps scanning while backboardd has the panel off and
+ * those touches reach iOS, which ignores them. Here taps while the panel is off become a press of
+ * the side button (sweet_hid_key(0, ...), what sweet_keys.c sends for the real one: iOS lights the
+ * lock screen). A tap: one finger, lifted within 250 ms, moved under 40 px, not within 60 px of an
+ * edge (grip) nor in the fingerprint circle (touch_fod's). There is no proximity sensor yet, so the
+ * default asks for two: the second down within 400 ms of the first one's lift, within 120 px of it.
+ * Not before the panel has been off 1 s (a press racing backboardd's off would turn it on again),
+ * and 1.5 s of nothing after a wake. Filter after telegdyd's hakios inject.c (dd78da76, MIT).
+ * kern.sweet_tap_wake (boot-arg sweettapwake): 0 off, 1 single tap, 2 double tap (default);
+ * kern.sweet_tap_wakes: wakes so far.
+ */
+extern volatile int sweet_fb_panel_off;           /* iokit/Kernel/arm/SweetFramebuffer.cpp (0324) */
+extern volatile uint64_t sweet_fb_panel_off_abs;
+extern void sweet_hid_key(int key, int down);     /* iokit/Kernel/arm/hid/SweetHID.cpp: 0 = side button */
+#define TAPW_MAX_MS     250
+#define TAPW_MOVE_PX    40
+#define TAPW_EDGE_PX    60
+#define TAPW_GAP_MS     400
+#define TAPW_NEAR_PX    120
+#define TAPW_OFF_MS     1000
+#define TAPW_COOL_MS    1500
+static unsigned touch_tap_wake = 2;
+static int sweet_tap_wakes;
+SYSCTL_UINT(_kern, OID_AUTO, sweet_tap_wake, CTLFLAG_RW | CTLFLAG_LOCKED, &touch_tap_wake, 0,
+    "touch: tapping the panel while off wakes it: 0 off, 1 single tap, 2 double tap (0324)");
+SYSCTL_INT(_kern, OID_AUTO, sweet_tap_wakes, CTLFLAG_RD | CTLFLAG_LOCKED, &sweet_tap_wakes, 0,
+    "touch: wakes by tapping so far (0324)");
+static struct {
+	bool tracking, bad, have_first;
+	unsigned id;
+	int x0, y0, fx, fy;
+	uint64_t down_abs, first_up_abs, cool_until;
+} tapw;
+
+static uint64_t
+tapw_abs(unsigned ms)
+{
+	uint64_t abs = 0;
+	nanoseconds_to_absolutetime((uint64_t)ms * NSEC_PER_MSEC, &abs);
+	return abs;
+}
+
+static bool
+tapw_bad_spot(int x, int y)
+{
+	int dx = x - FOD_X, dy = y - FOD_Y;
+	return x < TAPW_EDGE_PX || x > 1080 - TAPW_EDGE_PX || y < TAPW_EDGE_PX || y > 2400 - TAPW_EDGE_PX ||
+	       dx * dx + dy * dy <= FOD_R * FOD_R;
+}
+
+/* From touch_report() before it updates st.active: st.active is still the previous frame's contacts. */
+static void
+touch_tap_wake_check(uint32_t mask, const int *x, const int *y)
+{
+	uint64_t now = mach_absolute_time();
+	if (touch_tap_wake == 0 || !sweet_fb_panel_off || now < tapw.cool_until ||
+	    now - sweet_fb_panel_off_abs < tapw_abs(TAPW_OFF_MS)) {
+		tapw.tracking = false;
+		tapw.have_first = false;
+		return;
+	}
+	if (!tapw.tracking) {
+		if (mask == 0 || st.active != 0) {
+			return;         /* nothing down, or a touch that began before taps counted: wait for its lift */
+		}
+		tapw.tracking = true;
+		tapw.id = (unsigned)__builtin_ctz(mask);
+		tapw.x0 = x[tapw.id];
+		tapw.y0 = y[tapw.id];
+		tapw.bad = (mask & (mask - 1u)) != 0 || tapw_bad_spot(tapw.x0, tapw.y0);
+		tapw.down_abs = now;
+		if (tapw.have_first && now - tapw.first_up_abs > tapw_abs(TAPW_GAP_MS)) {
+			tapw.have_first = false;        /* too late for a second tap: this may be a new first one */
+		}
+		return;
+	}
+	if (mask != 0) {
+		if (mask != (1u << tapw.id)) {
+			tapw.bad = true;                /* a second finger or another contact: grip, palm */
+		} else {
+			int dx = x[tapw.id] - tapw.x0, dy = y[tapw.id] - tapw.y0;
+			if (dx * dx + dy * dy > TAPW_MOVE_PX * TAPW_MOVE_PX) {
+				tapw.bad = true;        /* a swipe or a brush, not a tap */
+			}
+		}
+		return;
+	}
+	/* every contact lifted */
+	tapw.tracking = false;
+	if (tapw.bad || now - tapw.down_abs > tapw_abs(TAPW_MAX_MS)) {
+		tapw.have_first = false;
+		return;
+	}
+	if (touch_tap_wake >= 2) {
+		int dx = tapw.x0 - tapw.fx, dy = tapw.y0 - tapw.fy;
+		if (!tapw.have_first || dx * dx + dy * dy > TAPW_NEAR_PX * TAPW_NEAR_PX) {
+			tapw.have_first = true;         /* the first tap: wait for the second */
+			tapw.first_up_abs = now;
+			tapw.fx = tapw.x0;
+			tapw.fy = tapw.y0;
+			return;
+		}
+	}
+	tapw.have_first = false;
+	tapw.cool_until = now + tapw_abs(TAPW_COOL_MS);
+	sweet_tap_wakes++;
+	printf("SWEET TOUCH: tap to wake (%s at %d,%d): side button press\n",
+	    touch_tap_wake >= 2 ? "double tap" : "tap", tapw.x0, tapw.y0);
+	sweet_hid_key(0, 1);
+	delay(50 * 1000);       /* 50 ms down, like a short real press (sweet_keys.c debounces 40 ms) */
+	sweet_hid_key(0, 0);
+}
+
+/*
+ * HakiOS 2.3.4 (a3975b6): stroke latency summary, logged every 8 strokes (first move after down,
+ * inter-move gaps, and lift after last move).
+ */
+static struct {
+	uint64_t last;
+	uint32_t strokes, moves, firsts, slow_moves, longest_move, first_sum, first_longest, lift_sum, lift_longest;
+	unsigned finger;
+	bool down, moved;
+} touch_feel;
+
+static void
+touch_feel_add(bool is_down, bool is_up, unsigned finger, uint64_t now)
+{
+	uint64_t nanos;
+	uint32_t ms;
+
+	if (is_down && !touch_feel.down) {
+		touch_feel.down = true;
+		touch_feel.moved = false;
+		touch_feel.finger = finger;
+		touch_feel.last = now;
+		return;
+	}
+	if (!touch_feel.down || finger != touch_feel.finger) {
+		return;
+	}
+	absolutetime_to_nanoseconds(now - touch_feel.last, &nanos);
+	ms = (uint32_t)(nanos / NSEC_PER_MSEC);
+	touch_feel.last = now;
+	if (is_up) {
+		touch_feel.down = false;
+		touch_feel.strokes++;
+		touch_feel.lift_sum += ms;
+		touch_feel.lift_longest = ms > touch_feel.lift_longest ? ms : touch_feel.lift_longest;
+		if ((touch_feel.strokes % 8u) == 0) {
+			printf("SWEET TOUCH: %u strokes: first move after %u ms on average, %u at most; %u moves, %u of them over 13 ms apart, %u at most; "
+			    "the lift %u ms after the last move on average, %u at most\n", touch_feel.strokes,
+			    touch_feel.firsts != 0 ? touch_feel.first_sum / touch_feel.firsts : 0, touch_feel.first_longest, touch_feel.moves,
+			    touch_feel.slow_moves, touch_feel.longest_move, touch_feel.lift_sum / touch_feel.strokes, touch_feel.lift_longest);
+		}
+	} else if (!touch_feel.moved) {
+		touch_feel.moved = true;
+		touch_feel.firsts++;
+		touch_feel.first_sum += ms;
+		touch_feel.first_longest = ms > touch_feel.first_longest ? ms : touch_feel.first_longest;
+	} else {
+		touch_feel.moves++;
+		touch_feel.slow_moves += ms > 13;
+		touch_feel.longest_move = ms > touch_feel.longest_move ? ms : touch_feel.longest_move;
+	}
+}
+
+static void
+touch_report(uint32_t mask, const int *x, const int *y)
+{
+	uint64_t now = mach_absolute_time();
+	touch_fod(mask, x, y);
+	touch_tap_wake_check(mask, x, y);
+	for (unsigned id = 0; id < TOUCH_MAX; ++id) {
+		uint32_t bit = 1u << id;
+		if (mask & bit) {
+			if (!(st.active & bit) || x[id] != st.x[id] || y[id] != st.y[id]) {
+				touch_feel_add(!(st.active & bit), false, id, now);
+				sweet_hid_touch((int)id, 1, x[id], y[id]);
+				st.s_down++;
+				st.s_lastx = x[id];
+				st.s_lasty = y[id];
+			}
+			st.x[id] = x[id];
+			st.y[id] = y[id];
+		} else if (st.active & bit) {
+			touch_feel_add(false, true, id, now);
+			sweet_hid_touch((int)id, 0, st.x[id], st.y[id]);
+			st.s_up++;
+		}
+	}
+	st.active = mask;
+}
+
+static int
+touch_goodix(void)
+{
+	uint8_t buf[90];
+	int x[TOUCH_MAX] = {0}, y[TOUCH_MAX] = {0};
+	uint32_t mask = 0;
+	int err = touch_read(0x5d, GOODIX_EVENT_REG, true, buf, GOODIX_HEAD_LEN);
+	if (err) {
+		return err;
+	}
+	if (!(buf[0] & 0x80u)) {
+		/* Do not acknowledge firmware/config requests that we cannot service. */
+		if (buf[0] & 0x40u) {
+			return ENOTSUP;
+		}
+		return 0; /* no new touch frame: retain current contacts */
+	}
+	if (!touch_checksum(buf, GOODIX_HEAD_LEN)) {
+		return EIO; /* header untrusted: no write to the IC */
+	}
+	unsigned n = buf[2] & 15u;
+	if (n > TOUCH_MAX) {
+		(void)touch_goodix_ack();
+		return EIO;
+	}
+	if (n) {
+		err = touch_read(0x5d, GOODIX_EVENT_REG + GOODIX_HEAD_LEN, true,
+		    buf + GOODIX_HEAD_LEN, n * GOODIX_POINT_LEN + 2u);
+		if (err) {
+			return err;
+		}
+		if (!touch_checksum(buf + GOODIX_HEAD_LEN, n * GOODIX_POINT_LEN + 2u)) {
+			(void)touch_goodix_ack();
+			return EIO;
+		}
+	}
+	for (unsigned i = 0; i < n; ++i) {
+		const uint8_t *p = buf + GOODIX_HEAD_LEN + i * GOODIX_POINT_LEN;
+		unsigned id = p[0] >> 4;
+		unsigned px = touch_be16(p + 2), py = touch_be16(p + 4);
+		/* Low nibble 1/3 denotes pen data in the vendor parser. */
+		if ((p[0] & 15u) == 1u || (p[0] & 15u) == 3u || id >= TOUCH_MAX ||
+		    (mask & (1u << id)) || px > 1079 || py > 2399) {
+			(void)touch_goodix_ack();
+			return EIO;
+		}
+		mask |= 1u << id;
+		x[id] = (int)px;
+		y[id] = (int)py;
+	}
+	err = touch_goodix_ack();
+	if (!err) {
+		touch_report(mask, x, y);
+	}
+	return err;
+}
+
+static int
+touch_focaltech(void)
+{
+	uint8_t buf[63];
+	int x[TOUCH_MAX] = {0}, y[TOUCH_MAX] = {0};
+	uint32_t mask = 0, seen = 0;
+	int err = touch_read(0x38, 0, false, buf, sizeof(buf));
+	if (err) {
+		return err;
+	}
+	/* 0312: how often the IC really has a new frame while a contact is down (kern.sweet_touch_rate) */
+	{
+		static uint64_t prev;
+		uint64_t t = mach_absolute_time();
+		if (st.active && prev != 0) {
+			touch_rate_down_abs += t - prev;
+		}
+		prev = t;
+	}
+	/* 0300: a frame repeated for too long with a contact down is a stuck one */
+	static uint8_t last[sizeof(buf)];
+	static uint64_t same_since;
+	static bool stale;
+	static uint64_t run_gap_max;            /* 0314: the longest IRQ gap inside this identical run */
+	uint64_t now = mach_absolute_time();
+	if (memcmp(buf, last, sizeof(buf)) != 0) {
+		if (!stale && run_gap_max != 0) {
+			uint64_t gns;
+			absolutetime_to_nanoseconds(run_gap_max, &gns);
+			if ((int)(gns / NSEC_PER_MSEC) > sweet_touch_irq_gap_ms) {
+				sweet_touch_irq_gap_ms = (int)(gns / NSEC_PER_MSEC);
+				uint64_t rns;
+				absolutetime_to_nanoseconds(now - same_since, &rns);
+				printf("SWEET TOUCH: an identical run of %u ms ended by itself; longest IRQ gap in it %d ms\n",
+				    (unsigned)(rns / NSEC_PER_MSEC), sweet_touch_irq_gap_ms);
+			}
+		}
+		run_gap_max = 0;
+		memcpy(last, buf, sizeof(buf));
+		same_since = now;
+		stale = false;
+		if (st.active) {
+			touch_rate_new++;
+		}
+		touch_rate_reads++;
+	} else if (stale) {
+		return 0;               /* the stuck frame again: nothing new */
+	} else if (st.active) {
+		uint64_t ns;
+		absolutetime_to_nanoseconds(now - same_since, &ns);
+		unsigned ms = (unsigned)(ns / NSEC_PER_MSEC);
+		if ((int)ms > sweet_touch_same_ms) {
+			sweet_touch_same_ms = (int)ms;
+		}
+		/* 0314: the IC quiet as well as the frame the same */
+		uint64_t gap = touch_irq_last != 0 && now > touch_irq_last ? now - touch_irq_last : 0, gns;
+		if (gap > run_gap_max) {
+			run_gap_max = gap;
+		}
+		absolutetime_to_nanoseconds(gap, &gns);
+		unsigned quiet = (unsigned)(gns / NSEC_PER_MSEC);
+		if (st.irq_hint && touch_quiet_ms != 0 && touch_irq_last != 0 && ms >= touch_quiet_ms &&
+		    quiet >= touch_quiet_ms) {
+			stale = true;
+			sweet_touch_quiet++;
+			printf("SWEET TOUCH: same frame for %u ms and no IRQ for %u ms with contacts %#x down: released (IC quiet)\n",
+			    ms, quiet, st.active);
+			touch_report(0, x, y);
+			return 0;
+		}
+		if (touch_stale_ms != 0 && ms >= touch_stale_ms) {
+			stale = true;
+			sweet_touch_stale++;
+			printf("SWEET TOUCH: one frame for %u ms with contacts %#x down: released (stuck) | "
+			    "%02x %02x %02x | %02x %02x %02x %02x %02x %02x\n", ms, st.active,
+			    buf[0], buf[1], buf[2], buf[3], buf[4], buf[5], buf[6], buf[7], buf[8]);
+			touch_report(0, x, y);
+			return 0;
+		}
+	} else {
+		same_since = now;
+	}
+	unsigned n = buf[2] & 15u, active = 0;
+	if (n || !st.s_frames) {
+		memcpy(st.s_raw, buf, sizeof(st.s_raw)); /* keep the last frame with contacts */
+	}
+	st.s_frames++;
+	if (n > st.s_maxn) {
+		st.s_maxn = n;
+	}
+	if (n > TOUCH_MAX && buf[3] == 0xffu) {
+		/*
+		 * topaz: with no contact the FT5452 (firmware as updated by HyperOS
+		 * 2.0.208) reports TD_STATUS 0xff and 0xff records. TopazTouch: a count
+		 * of 0 or > 10 means "release all", not an error.
+		 */
+		touch_report(0, x, y);
+		return 0;
+	}
+	if (n > TOUCH_MAX) {
+		/* topaz: show what the IC actually sends (rate-limited) */
+		static uint64_t last_dump;
+		uint64_t now = mach_absolute_time(), gap;
+		nanoseconds_to_absolutetime(NSEC_PER_SEC, &gap);
+		if (now - last_dump > gap) {
+			last_dump = now;
+			printf("SWEET TOUCH: bad frame n=%u raw %02x %02x %02x | %02x %02x %02x %02x %02x %02x | %02x %02x %02x %02x %02x %02x %02x\n",
+			    n, buf[0], buf[1], buf[2], buf[3], buf[4], buf[5], buf[6], buf[7], buf[8],
+			    buf[9], buf[10], buf[11], buf[12], buf[13], buf[14], buf[15]);
+		}
+		return EIO;
+	}
+	for (unsigned i = 0; i < TOUCH_MAX; ++i) {
+		const uint8_t *p = buf + 3u + 6u * i;
+		unsigned id = p[2] >> 4, event = p[0] >> 6;
+		if (id >= TOUCH_MAX) {
+			break; /* vendor's unused-record sentinel */
+		}
+		if (seen & (1u << id)) {
+			return EIO;
+		}
+		seen |= 1u << id;
+		if (event == 1u) {
+			continue; /* UP record */
+		}
+		if (event == 3u) {
+			continue; /* topaz: "no event" slot (TopazTouch) */
+		}
+		unsigned hx = ((unsigned)(p[0] & 15u) << 8) | p[1];
+		unsigned hy = ((unsigned)(p[2] & 15u) << 8) | p[3];
+		/*
+		 * Raw position = 12-bit coordinate plus st.fbits fraction bits from
+		 * byte 4: topaz 2 bits each (x 7:6, y 5:4) over 0..1349 x 0..2999
+		 * (1.25x the panel); Focaltech hi-res firmware 4 bits each (x 7:4,
+		 * y 3:0). st.rx/st.ry are the raw ranges mapped onto 1080x2400.
+		 */
+		uint64_t fx, fy;
+		if (st.fbits == 4u) {
+			fx = (uint64_t)hx << 4 | (p[4] >> 4);
+			fy = (uint64_t)hy << 4 | (p[4] & 15u);
+		} else {
+			fx = (uint64_t)hx << 2 | (p[4] >> 6);
+			fy = (uint64_t)hy << 2 | ((p[4] >> 4) & 3u);
+		}
+		unsigned px = (unsigned)(fx * 1080u / st.rx);
+		unsigned py = (unsigned)(fy * 2400u / st.ry);
+		if (st.rawlog && !(st.active & (1u << id))) {
+			st.rawlog--;
+			printf("SWEET TOUCH: raw id %u x %u.%x y %u.%x -> %u,%u\n",
+			    id, hx, p[4] >> 4, hy, p[4] & 15u, px, py);
+		}
+		px = px > 1079 ? 1079 : px;
+		py = py > 2399 ? 2399 : py;
+		mask |= 1u << id;
+		x[id] = (int)px;
+		y[id] = (int)py;
+		++active;
+	}
+	(void)active;   /* topaz: byte 2 does not always match the records */
+	touch_report(mask, x, y);
+	return 0;
+}
+
+static bool
+touch_se_init(void)
+{
+	uint32_t fw = touch_rd(st.se, SE_FW);
+	uint32_t tx = touch_rd(st.se, SE_HW_TX), rx = touch_rd(st.se, SE_HW_RX);
+	st.d_fw = fw;
+	st.d_status = touch_rd(st.se, SE_STATUS);
+	st.d_hwtx = tx;
+	st.d_hwrx = rx;
+	printf("SWEET TOUCH: se2 fw=%#x proto=%u status=%#x tx=%#x rx=%#x ios=%#x\n",
+	    fw, (fw >> 8) & 0xffu, touch_rd(st.se, SE_STATUS), tx, rx,
+	    touch_rd(st.se, 0x908));
+	if (((fw >> 8) & 0xffu) != 3u || (touch_rd(st.se, 0x64) & 1u) ||
+	    ((tx >> 24) & 0x3fu) != 32u || ((rx >> 24) & 0x3fu) != 32u ||
+	    ((tx >> 16) & 0x3fu) < 2u || ((rx >> 16) & 0x3fu) < 2u) {
+		printf("SWEET TOUCH: need ABL-loaded I2C firmware and 32-bit FIFOs; probes skipped\n");
+		return false;
+	}
+	if (touch_rd(st.se, SE_STATUS) & 0x1001u) {
+		printf("SWEET TOUCH: SE2 already busy; probes skipped\n");
+		return false;
+	}
+	touch_wr(st.se, 0xe18, 0); /* no GSI events */
+	touch_wr(st.se, 0xe1c, 0); /* mask external IRQ routing; poll local status */
+	touch_wr(st.se, 0x644, 0);
+	touch_wr(st.se, SE_IRQ_CLR, 0xffffffffu);
+	touch_wr(st.se, 0x648, 0xffffffffu);
+	touch_wr(st.se, SE_DMA, 0);
+	touch_wr(st.se, 0x28, touch_rd(st.se, 0x28) | 0x7fu);
+	touch_wr(st.se, 0xe30, touch_rd(st.se, 0xe30) | 0x0fu);
+	touch_wr(st.se, 0x24, 0x7f);
+	touch_wr(st.se, 0x20, 1);
+	touch_wr(st.se, SE_CLK_SEL, 0);
+	touch_wr(st.se, SE_MCLK, (2u << 4) | 1u);
+	touch_wr(st.se, SE_SCL, (5u << 20) | (11u << 10) | 22u); /* 400 kHz */
+	/* Linux 8-bit I2C packing: MSB on the wire, LSB byte first in FIFO. */
+	touch_wr(st.se, 0x254, 0);
+	touch_wr(st.se, 0x260, SE_PACK0);
+	touch_wr(st.se, 0x264, SE_PACK1);
+	touch_wr(st.se, 0x284, SE_PACK0);
+	touch_wr(st.se, 0x288, SE_PACK1);
+	touch_wr(st.se, SE_TX_WM, 0);
+	touch_wr(st.se, 0x810, 0);
+	touch_wr(st.se, 0x814, ((rx >> 16) & 0x3fu) - 1u);
+	touch_wr(st.se, SE_IRQ_EN, SE_EVENTS);
+	printf("SWEET TOUCH: packing tx=%#x/%#x rx=%#x/%#x gran=%#x\n",
+	    touch_rd(st.se, 0x260), touch_rd(st.se, 0x264),
+	    touch_rd(st.se, 0x284), touch_rd(st.se, 0x288), touch_rd(st.se, 0x254));
+	if (touch_rd(st.se, 0x260) != SE_PACK0 || touch_rd(st.se, 0x264) != SE_PACK1 ||
+	    touch_rd(st.se, 0x284) != SE_PACK0 || touch_rd(st.se, 0x288) != SE_PACK1 ||
+	    touch_rd(st.se, 0x254) != 0) {
+		printf("SWEET TOUCH: packing readback mismatch; probes skipped\n");
+		return false;
+	}
+	if ((touch_rd(st.se, SE_TX_COUNT) & 0xfffffffu) ||
+	    (touch_rd(st.se, SE_RX_COUNT) & 0x1ffffffu)) {
+		printf("SWEET TOUCH: inherited FIFO data; probes skipped\n");
+		return false;
+	}
+	return true;
+}
+
+static void
+touch_thread(void *arg, wait_result_t result)
+{
+	unsigned delay_s = 45;
+	(void)arg;
+	(void)result;
+	/*
+	 * Start late (boot-arg sweettouchdelay, seconds): if the bus access
+	 * below hangs the SoC, the persistent log and the GUI got there first.
+	 */
+	(void)PE_parse_boot_argn("sweettouchdelay", &delay_s, sizeof(delay_s));
+	printf("SWEET TOUCH: starting in %u s\n", delay_s);
+	touch_wait(delay_s * 1000u);
+	st.stage = "map";
+	printf("SWEET TOUCH: mapping GCC/TLMM/SE2\n");
+	st.gcc = ml_io_map(TOUCH_GCC_PA, 0x80000);
+	st.west = ml_io_map(TOUCH_WEST_PA, 0x58000);
+	st.east = ml_io_map(TOUCH_EAST_PA, 0x25000);
+	st.se = ml_io_map(TOUCH_SE_PA, 0x4000);
+	if (!st.gcc || !st.west || !st.east || !st.se) {
+		printf("SWEET TOUCH: MMIO mapping failed\n");
+		goto out;
+	}
+	st.stage = "clocks";
+	if (!touch_clocks()) {
+		goto out;
+	}
+	st.stage = "se2 init";
+	if (!touch_se_init()) {
+		goto out;
+	}
+	st.stage = "power/reset";
+	printf("SWEET TOUCH: TLMM reset=%#x irq=%#x avdd=%#x\n",
+	    touch_rd(st.west, TOUCH_GPIO_IO(TOUCH_PIN_RESET)),
+	    touch_rd(st.west, TOUCH_GPIO_IO(TOUCH_PIN_IRQ)),
+	    touch_rd(st.east, TOUCH_GPIO_IO(TOUCH_PIN_AVDD)));
+	/* TopazTouch touch.c: IRQ input, AVDD on, I2C pins, then the reset pulse. */
+	touch_gpio(TOUCH_PIN_IRQ, 0, 3, 3, false, false);       /* CTL 0xc3 */
+	touch_gpio(TOUCH_PIN_AVDD, 0, 3, 3, true, true);        /* CTL 0x2c3, high */
+	touch_gpio(6, 1, 0, 0, false, false);                   /* qup2 SDA, CTL 0x4 */
+	touch_gpio(7, 1, 0, 0, false, false);                   /* qup2 SCL */
+	touch_gpio(TOUCH_PIN_RESET, 0, 3, 3, true, false);      /* CTL 0x2c3, low */
+	touch_wait(20);
+	touch_gpio(TOUCH_PIN_RESET, 0, 3, 3, true, true);
+	touch_wait(250);
+	st.stage = "probe";
+	uint8_t gid[32], legacy[32], fid1 = 0, fid2 = 0;
+	st.probing = true;
+	int ge = touch_probe_info(GOODIX_PID_REG, gid);
+	printf("SWEET TOUCH: probe 0x5d err=%d pid=%02x%02x%02x%02x fw=%02x.%02x.%02x.%02x irq=%#x\n",
+	    ge, gid[0], gid[1], gid[2], gid[3], gid[8], gid[9], gid[10], gid[11], st.irq_status);
+	(void)touch_probe_info(0x8240, legacy);
+	int fe1 = touch_read(0x38, 0xa3, false, &fid1, 1);
+	int fe2 = touch_read(0x38, 0x9f, false, &fid2, 1);
+	printf("SWEET TOUCH: probe 0x38 err=%d/%d chip-id=%02x:%02x irq=%#x\n",
+	    fe1, fe2, fid1, fid2, st.irq_status);
+	{
+		uint8_t fw = 0, vendor = 0, mode = 0, pmode = 0, lib[2] = {0, 0};
+		int e1 = touch_read(0x38, 0xa6, false, &fw, 1);
+		int e2 = touch_read(0x38, 0xa8, false, &vendor, 1);
+		int e3 = touch_read(0x38, 0x00, false, &mode, 1);
+		int e4 = touch_read(0x38, 0xa5, false, &pmode, 1);
+		int e5 = touch_read(0x38, 0xa1, false, lib, 2);
+		printf("SWEET TOUCH: ft fw=%02x/%d vendor=%02x/%d devmode=%02x/%d pmode=%02x/%d lib=%02x%02x/%d\n",
+		    fw, e1, vendor, e2, mode, e3, pmode, e4, lib[0], lib[1], e5);
+		/* 0312: the active report period/rate registers (FocalTech: 0x88 ID_G_PERIODACTIVE, 0x89 monitor) */
+		uint8_t r88 = 0, r89 = 0, r8b = 0;
+		int e6 = touch_read(0x38, 0x88, false, &r88, 1);
+		int e7 = touch_read(0x38, 0x89, false, &r89, 1);
+		int e8 = touch_read(0x38, 0x8b, false, &r8b, 1);
+		printf("SWEET TOUCH: ft 0x88=%02x/%d 0x89=%02x/%d 0x8b=%02x/%d\n", r88, e6, r89, e7, r8b, e8);
+	}
+	st.probing = false;
+	st.d_ge = ge;
+	st.d_fe1 = fe1;
+	st.d_fe2 = fe2;
+	st.d_fid1 = fid1;
+	st.d_fid2 = fid2;
+	bool goodix = !ge && gid[0] == '9' && gid[1] == '8' && gid[2] == '9' && gid[3] == '6';
+	bool fts = !fe1 && !fe2 && fid1 == 0x54 && fid2 == 0x52;
+	if (st.dead || goodix == fts) {
+		printf("SWEET TOUCH: no unique supported IC (goodix=%d fts=%d dead=%d); stopping\n",
+		    goodix, fts, st.dead);
+		goto out;
+	}
+	st.kind = goodix ? TOUCH_GOODIX : TOUCH_FTS;
+	st.stage = "polling";
+	printf("SWEET TOUCH: selected %s, 1080x2400, poll=10ms irq-hint=%d\n",
+	    goodix ? "GT9896 Yellowstone" : "Focaltech 54:52", st.irq_hint);
+	unsigned errors = 0, ticks = 0, polls = 0;
+	uint64_t next = 0, period_down, period_up;
+	/*
+	 * While a finger is down the IC is read every 4 ms on an absolute grid (250 Hz; a read that
+	 * finds no new frame is the 8-byte header alone). It was 10 ms after the read, ~13 ms a poll
+	 * in all (~75 Hz, irregular): a page dragged on the 120 Hz panel moved in uneven steps.
+	 * With no finger down, 10 ms as before.
+	 */
+	nanoseconds_to_absolutetime(4 * NSEC_PER_MSEC, &period_down);
+	nanoseconds_to_absolutetime(10 * NSEC_PER_MSEC, &period_up);
+	uint64_t period_fast, late_after, last_read = 0;
+	nanoseconds_to_absolutetime(500 * NSEC_PER_USEC, &period_fast);
+	nanoseconds_to_absolutetime(25 * NSEC_PER_MSEC, &late_after);
+	while (!st.dead) {
+		if (st.diag == 2 && ++polls == 3000) {  /* ~30 s at 10 ms */
+			panic("SWEET TOUCH stats: frames=%u errs=%u lasterr=%d maxn=%u hid down=%u up=%u last=%d,%d | "
+			    "raw %02x %02x %02x | %02x %02x %02x %02x %02x %02x | %02x %02x %02x",
+			    st.s_frames, st.s_errs, st.s_lasterr, st.s_maxn, st.s_down, st.s_up,
+			    st.s_lastx, st.s_lasty, st.s_raw[0], st.s_raw[1], st.s_raw[2],
+			    st.s_raw[3], st.s_raw[4], st.s_raw[5], st.s_raw[6], st.s_raw[7],
+			    st.s_raw[8], st.s_raw[9], st.s_raw[10], st.s_raw[11]);
+		}
+		/*
+		 * HakiOS 2.3.4 (81b5dd2): while a finger is down, read on every 4 ms tick regardless of
+		 * GPIO80 IRQ so finger lift is detected in ~4-5 ms instead of waiting 30-169 ms for
+		 * touch_quiet_ms. When idle, read on IRQ or every 16 ms (2 ticks of 8 ms).
+		 */
+		bool fast = touch_fast && st.irq_hint && st.kind == TOUCH_FTS && st.active;
+		bool irq_low = st.irq_hint && !(touch_rd(st.west, TOUCH_GPIO_IO(TOUCH_PIN_IRQ)) & 1u);
+		if (irq_low) {
+			touch_irq_last = mach_absolute_time();  /* 0314 */
+		}
+		bool want;
+		if (fast) {
+			uint64_t t = mach_absolute_time();
+			want = irq_low || t - last_read >= late_after;
+			if (want) {
+				if (irq_low) {
+					touch_irq_reads++;
+				} else {
+					touch_late_reads++;
+				}
+			}
+		} else {
+			want = !st.irq_hint || st.active || irq_low || (++ticks % 10u) == 0;
+		}
+		if (want) {
+			last_read = mach_absolute_time();
+			int err = st.kind == TOUCH_GOODIX ? touch_goodix() : touch_focaltech();
+			if (err) {
+				st.s_errs++;
+				st.s_lasterr = err;
+				if ((errors++ % 100u) == 0) {
+					printf("SWEET TOUCH: report err=%d irq=%#x\n", err, st.irq_status);
+				}
+				if (errors == 10) {
+					touch_report(0, st.x, st.y); /* release after persistent bad reads */
+				}
+			} else {
+				errors = 0;
+			}
+		}
+		uint64_t period = st.active ? (fast ? period_fast : period_down) : period_up, now = mach_absolute_time();
+		next = (next == 0 || now > next + period) ? now + period : next + period;
+		touch_wait_until(next);
+	}
+	touch_report(0, st.x, st.y);
+out:
+	if (st.diag) {
+		panic("SWEET TOUCH diag: stopped at '%s' dead=%d | gcc vote=%#x cfg=%#x cbcr=%#x | "
+		    "se2 fw=%#x status=%#x hwtx=%#x hwrx=%#x | goodix err=%d | ft 0x38 err=%d/%d id=%02x:%02x | irq=%#x",
+		    st.stage ? st.stage : "?", st.dead, st.d_vote, st.d_cfg, st.d_cbcr,
+		    st.d_fw, st.d_status, st.d_hwtx, st.d_hwrx, st.d_ge,
+		    st.d_fe1, st.d_fe2, st.d_fid1, st.d_fid2, st.irq_status);
+	}
+	(void)thread_terminate(current_thread());
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+void
+sweet_touch_init(void)
+{
+	int enabled = 1;
+	thread_t thread;
+	if (st.started) {
+		return;
+	}
+	st.started = true;
+	(void)PE_parse_boot_argn("sweettouch", &enabled, sizeof(enabled));
+	st.irq_hint = 1; /* topaz: read on IRQ GPIO80 low, while touching, else every 100 ms */
+	(void)PE_parse_boot_argn("sweettouchirq", &st.irq_hint, sizeof(st.irq_hint));
+	(void)PE_parse_boot_argn("sweettouchfast", &touch_fast, sizeof(touch_fast));
+	(void)PE_parse_boot_argn("sweettouchdiag", &st.diag, sizeof(st.diag));
+	/* topaz defaults; sapphire's FT3519T is set from its boot image */
+	st.fbits = 2;
+	st.rx = 1350u * 4u;
+	st.ry = 3000u * 4u;
+	st.rawlog = 40;
+	(void)PE_parse_boot_argn("sweettouch_fbits", &st.fbits, sizeof(st.fbits));
+	(void)PE_parse_boot_argn("sweettouch_rx", &st.rx, sizeof(st.rx));
+	(void)PE_parse_boot_argn("sweettouch_ry", &st.ry, sizeof(st.ry));
+	(void)PE_parse_boot_argn("sweettouch_rawlog", &st.rawlog, sizeof(st.rawlog));
+	(void)PE_parse_boot_argn("sweettouch_stale_ms", &touch_stale_ms, sizeof(touch_stale_ms));
+	(void)PE_parse_boot_argn("sweettapwake", &touch_tap_wake, sizeof(touch_tap_wake));      /* 0324 */
+	if (st.fbits != 4u) {
+		st.fbits = 2;
+	}
+	if (!st.rx || !st.ry) {
+		st.rx = 1350u * 4u;
+		st.ry = 3000u * 4u;
+	}
+	printf("SWEET TOUCH: raw range %ux%u, %u fraction bits\n", st.rx, st.ry, st.fbits);
+	if (!enabled) {
+		printf("SWEET TOUCH: disabled (sweettouch=0)\n");
+		return;
+	}
+	kern_return_t kr = kernel_thread_start(touch_thread, NULL, &thread);
+	if (kr == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		printf("SWEET TOUCH: kernel_thread_start failed %d\n", kr);
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
diff --git a/bsd/dev/sweet_ufs.c b/bsd/dev/sweet_ufs.c
new file mode 100644
index 0000000..c454116
--- /dev/null
+++ b/bsd/dev/sweet_ufs.c
@@ -0,0 +1,1514 @@
+/*
+ * SWEET internal UFS root device.
+ *
+ * The Qualcomm UFS host (UFSHCI 2.1) is left enabled with the link up by the
+ * bootloader, which loaded our boot image from it. This driver reuses that
+ * state: it points the transfer request list at its own memory (verifying the
+ * host took it before ringing any doorbell) and issues polled SCSI commands,
+ * one at a time, to LUN 0. It finds one GPT partition by name (boot-arg
+ * ufsroot=, default "userdata") and exposes it as the BSD disk ufsroot0
+ * (rufsroot0), with 512-byte logical sectors over the device's 4 KiB blocks.
+ * Root on it with rd=ufsroot0.
+ *
+ * All DMA goes through one physically contiguous allocation (descriptors and
+ * a 1 MiB bounce buffer); the host is not cache coherent, so caches are
+ * cleaned/invalidated around each command.
+ *
+ * Writes are refused unless boot-arg ufsrw=1 is set. Every write is checked
+ * against the partition bounds again right before it is issued, so nothing
+ * outside the named partition can be written.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/buf.h>
+#include <sys/conf.h>
+#include <sys/disk.h>
+#include <sys/errno.h>
+#include <sys/proc.h>
+#include <sys/uio.h>
+#include <miscfs/devfs/devfs.h>
+#include <kern/locks.h>
+#include <kern/clock.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <arm/caches_internal.h>
+#include <vm/pmap.h>
+#include <vm/vm_kern.h>
+#include <pexpert/pexpert.h>
+#include <pexpert/device_tree.h>
+#include <libkern/libkern.h>
+#include <machine/atomic.h>
+#include <sys/sysctl.h>
+#include <sys/kauth.h>
+#include "sweet_slot.h"
+
+extern ppnum_t pmap_find_phys(pmap_t pmap, addr64_t va);
+/* osfmk/arm/machine_routines.h, not exported to the BSD layer */
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+/* osfmk/arm/cpu_data.h, not exported to the BSD layer */
+extern int get_preemption_level(void);
+extern kern_return_t kernel_thread_start(thread_continue_t, void *, thread_t *);
+extern void thread_deallocate(thread_t);
+extern int hz;
+static void sweet_log_start(void);
+extern void sweet_sample_start(void);
+extern void sweet_keys_init(void);
+extern void sweet_touch_init(void);
+extern void sweet_bt_boot_init(void);   /* bsd/dev/sweet_bt.c: device nodes only */
+extern void sweet_usb_probe(void);
+
+#define REG_CAP         0x00
+#define REG_IS          0x20
+#define REG_IE          0x24
+#define REG_HCS         0x30
+#define REG_HCE         0x34
+#define REG_UTRLBA      0x50
+#define REG_UTRLBAU     0x54
+#define REG_UTRLDBR     0x58
+#define REG_UTRLCLR     0x5c
+#define REG_UTRLRSR     0x60
+
+#define HCS_DP          (1u << 0)
+#define HCS_UTRLRDY     (1u << 1)
+#define CAP_64AS        (1u << 24)              /* 64-bit DMA addressing */
+
+#define UFS_BLOCK       4096u
+#define BOUNCE_SIZE     (1u << 20)
+#define PRDT_CHUNK      (256u << 10)            /* PRDT byte count field: 18 bits */
+#define PRDT_MAX        (BOUNCE_SIZE / PRDT_CHUNK)
+#define CMD_TIMEOUT_NS  (5ull * NSEC_PER_SEC)
+#define CMD_SPIN_NS     (50ull * NSEC_PER_USEC)
+#define CMD_SLEEP_NS    (200ull * NSEC_PER_USEC)
+
+struct utrd {
+	uint32_t dw0, dw1, dw2, dw3;
+	uint32_t ucdba, ucdbau;
+	uint32_t resp;          /* [31:16] response UPIU offset, [15:0] length, DWORDs */
+	uint32_t prdt;          /* [31:16] PRDT offset (DWORDs), [15:0] entries */
+};
+
+struct ucd {
+	uint8_t cmd[512];
+	uint8_t resp[512];
+	struct {
+		uint32_t addr_lo, addr_hi, rsvd, dbc;
+	} prdt[PRDT_MAX];
+};
+
+/* Layout of the contiguous DMA allocation. */
+#define DMA_UTRL        0x0000                  /* 1 KiB aligned */
+#define DMA_UCD         0x1000                  /* 128 byte aligned */
+#define DMA_BOUNCE      0x4000
+#define DMA_SIZE        (DMA_BOUNCE + BOUNCE_SIZE)
+
+static struct {
+	vm_offset_t regs;
+	vm_offset_t dma;                        /* kernel VA of the DMA allocation */
+	uint64_t dma_pa;
+	uint8_t lun;
+	uint8_t tag;
+	uint64_t first_block, nblocks;          /* partition, in 4 KiB device blocks */
+	uint32_t secsize;                       /* logical sector size for the BSD layer */
+	bool writable;                          /* boot-arg ufsrw=1 */
+	bool cache;                             /* boot-arg ufscache=1 */
+	bool wait;                              /* boot-arg ufswait=1 */
+	int bmajor, cmajor;
+	dev_t bdev;
+	bool ready;
+} su;
+
+static LCK_GRP_DECLARE(sweet_ufs_grp, "sweet_ufs");
+static LCK_MTX_DECLARE(sweet_ufs_lock, &sweet_ufs_grp);
+
+static inline uint32_t
+ufs_rd(uint32_t off)
+{
+	return *(volatile uint32_t *)(su.regs + off);
+}
+
+static inline void
+ufs_wr(uint32_t off, uint32_t v)
+{
+	*(volatile uint32_t *)(su.regs + off) = v;
+}
+
+static void
+dma_sync(uint32_t off, uint32_t len)
+{
+	flush_dcache64((addr64_t)(su.dma_pa + off), len, TRUE);
+}
+
+static void
+dma_clean(uint32_t off, uint32_t len)
+{
+	clean_dcache64((addr64_t)(su.dma_pa + off), len, TRUE);
+}
+
+/*
+ * One SCSI command in slot 0, data (if any) to/from the bounce buffer
+ * (to the device when write is set). Returns 0 or an errno.
+ */
+static int
+ufs_scsi(const uint8_t *cdb, unsigned cdb_len, uint32_t len, bool write)
+{
+	struct utrd *utrd = (struct utrd *)(su.dma + DMA_UTRL);
+	struct ucd *ucd = (struct ucd *)(su.dma + DMA_UCD);
+	uint64_t ucd_pa = su.dma_pa + DMA_UCD, bounce_pa = su.dma_pa + DMA_BOUNCE;
+
+	assert(len <= BOUNCE_SIZE);
+	bzero(utrd, sizeof(*utrd));
+	bzero(ucd, sizeof(*ucd));
+
+	ucd->cmd[0] = 0x01;                     /* COMMAND UPIU */
+	ucd->cmd[1] = len ? (write ? 0x20 : 0x40) : 0x00;      /* W: data out, R: data in */
+	ucd->cmd[2] = su.lun;
+	ucd->cmd[3] = ++su.tag;
+	ucd->cmd[12] = (uint8_t)(len >> 24);
+	ucd->cmd[13] = (uint8_t)(len >> 16);
+	ucd->cmd[14] = (uint8_t)(len >> 8);
+	ucd->cmd[15] = (uint8_t)len;
+	memcpy(&ucd->cmd[16], cdb, cdb_len);
+
+	/* DD: 1 = memory to device, 2 = device to memory. */
+	utrd->dw0 = (1u << 28) | ((len ? (write ? 1u : 2u) : 0u) << 25) | (1u << 24);
+	utrd->dw2 = 0x0f;                       /* OCS invalid until updated */
+	utrd->ucdba = (uint32_t)ucd_pa;
+	utrd->ucdbau = (uint32_t)(ucd_pa >> 32);
+	utrd->resp = (512u / 4) << 16 | (512u / 4);
+	if (len) {
+		uint32_t n = 0;
+		for (uint32_t done = 0; done < len; done += PRDT_CHUNK, n++) {
+			uint32_t chunk = MIN(PRDT_CHUNK, len - done);
+			ucd->prdt[n].addr_lo = (uint32_t)(bounce_pa + done);
+			ucd->prdt[n].addr_hi = (uint32_t)((bounce_pa + done) >> 32);
+			ucd->prdt[n].dbc = chunk - 1;
+		}
+		utrd->prdt = (1024u / 4) << 16 | n;
+	}
+
+	if (su.cache) {
+		dma_clean(DMA_UTRL, sizeof(*utrd));
+		dma_clean(DMA_UCD, 16 + cdb_len);
+		dma_sync(DMA_UCD + offsetof(struct ucd, resp), sizeof(ucd->resp));
+		if (len) {
+			dma_clean(DMA_UCD + offsetof(struct ucd, prdt),
+			    (utrd->prdt & 0xffff) * sizeof(ucd->prdt[0]));
+		}
+	} else {
+		dma_sync(DMA_UTRL, sizeof(*utrd));
+		dma_sync(DMA_UCD, sizeof(*ucd));
+	}
+	if (len) {
+		if (su.cache && write) {
+			dma_clean(DMA_BOUNCE, len);
+		} else {
+			dma_sync(DMA_BOUNCE, len);
+		}
+	}
+	__builtin_arm_dsb(0xf);
+
+	ufs_wr(REG_UTRLDBR, 1);
+	uint64_t deadline;
+	nanoseconds_to_absolutetime(CMD_TIMEOUT_NS, &deadline);
+	deadline += mach_absolute_time();
+	bool sleepable = su.wait && su.ready && ml_get_interrupts_enabled() &&
+	    !ml_at_interrupt_context() && get_preemption_level() == 0;
+	uint64_t spin_until = 0, sleep_interval = 0;
+	if (sleepable) {
+		nanoseconds_to_absolutetime(CMD_SPIN_NS, &spin_until);
+		spin_until += mach_absolute_time();
+		nanoseconds_to_absolutetime(CMD_SLEEP_NS, &sleep_interval);
+	}
+	while (ufs_rd(REG_UTRLDBR) & 1) {
+		uint64_t now = mach_absolute_time();
+		if (now > deadline) {
+			ufs_wr(REG_UTRLCLR, ~1u);
+			printf("SWEET UFS: command 0x%02x timed out\n", cdb[0]);
+			return ETIMEDOUT;
+		}
+		if (sleepable && now >= spin_until) {
+			uint64_t wake = now + MIN(sleep_interval, deadline - now);
+			/* Keep the mutex: slot 0 and the bounce buffer are still owned. */
+			if (assert_wait_deadline_with_leeway((event_t)&su.wait, THREAD_UNINT,
+			    TIMEOUT_URGENCY_SYS_CRITICAL, wake, 0) == THREAD_WAITING) {
+				thread_block(THREAD_CONTINUE_NULL);
+			}
+		} else {
+			delay(1);
+		}
+	}
+	__builtin_arm_dsb(0xf);
+	ufs_wr(REG_IS, ufs_rd(REG_IS));         /* acknowledge completion status */
+
+	dma_sync(DMA_UTRL, sizeof(*utrd));
+	if (su.cache) {
+		dma_sync(DMA_UCD + offsetof(struct ucd, resp), sizeof(ucd->resp));
+	} else {
+		dma_sync(DMA_UCD, sizeof(*ucd));
+	}
+	if (len && !(su.cache && write)) {
+		dma_sync(DMA_BOUNCE, len);
+	}
+
+	uint32_t ocs = utrd->dw2 & 0xff;
+	if (ocs || ucd->resp[0] != 0x21 || ucd->resp[6] || ucd->resp[7]) {
+		printf("SWEET UFS: command 0x%02x failed: ocs 0x%x upiu 0x%x response 0x%x status 0x%x\n",
+		    cdb[0], ocs, ucd->resp[0], ucd->resp[6], ucd->resp[7]);
+		return EIO;
+	}
+	return 0;
+}
+
+/* READ(10) of count device blocks at lba into the bounce buffer. */
+static int
+ufs_read_blocks(uint64_t lba, uint32_t count)
+{
+	if (lba > UINT32_MAX || count > BOUNCE_SIZE / UFS_BLOCK) {
+		return EINVAL;
+	}
+	uint8_t cdb[10] = {
+		0x28, 0,
+		(uint8_t)(lba >> 24), (uint8_t)(lba >> 16), (uint8_t)(lba >> 8), (uint8_t)lba,
+		0, (uint8_t)(count >> 8), (uint8_t)count, 0
+	};
+	return ufs_scsi(cdb, sizeof(cdb), count * UFS_BLOCK, false);
+}
+
+/*
+ * topaz: on 2026-10-19 the LUN0 GPT (super, userdata, esp, win, ...) was found
+ * destroyed after iOS sessions. Remember both GPT copies and fence them off;
+ * a watchdog thread re-reads them and panics the moment they change.
+ */
+static uint64_t gpt_alt;                /* backup header LBA (last LBA of LUN0) */
+static uint32_t gpt_hcrc, gpt_ecrc, gpt_bhcrc;
+static int gpt_chan;
+
+/*
+ * WRITE(10) of count device blocks from the bounce buffer to lba. The range
+ * must lie inside the partition: this is the only place data goes out.
+ */
+static int
+ufs_write_blocks(uint64_t lba, uint32_t count)
+{
+	if (!su.writable || !su.nblocks || count == 0 || count > BOUNCE_SIZE / UFS_BLOCK ||
+	    lba < su.first_block || lba - su.first_block >= su.nblocks ||
+	    count > su.nblocks - (lba - su.first_block) || lba + count - 1 > UINT32_MAX ||
+	    lba < 6 || (gpt_alt && lba + count - 1 >= gpt_alt - 4)) {
+		printf("SWEET UFS: refusing write of %u blocks at 0x%llx\n", count, lba);
+		return EPERM;
+	}
+	uint8_t cdb[10] = {
+		0x2a, 0,
+		(uint8_t)(lba >> 24), (uint8_t)(lba >> 16), (uint8_t)(lba >> 8), (uint8_t)lba,
+		0, (uint8_t)(count >> 8), (uint8_t)count, 0
+	};
+	return ufs_scsi(cdb, sizeof(cdb), count * UFS_BLOCK, true);
+}
+
+static int
+ufs_sync_cache(void)
+{
+	static const uint8_t cdb[10] = { 0x35 };       /* SYNCHRONIZE CACHE(10), whole LUN */
+	return ufs_scsi(cdb, sizeof(cdb), 0, false);
+}
+
+static int
+ufs_find_partition(const char *want)
+{
+	const uint8_t *b = (const uint8_t *)(su.dma + DMA_BOUNCE);
+	int error = ufs_read_blocks(1, 1);
+	if (error) {
+		return error;
+	}
+	if (memcmp(b, "EFI PART", 8) != 0) {
+		printf("SWEET UFS: LUN %u has no GPT\n", su.lun);
+		return ENXIO;
+	}
+	uint64_t entry_lba;
+	uint32_t nent, esz;
+	memcpy(&gpt_hcrc, b + 16, 4);
+	memcpy(&gpt_alt, b + 32, 8);
+	memcpy(&gpt_ecrc, b + 88, 4);
+	memcpy(&entry_lba, b + 72, 8);
+	memcpy(&nent, b + 80, 4);
+	memcpy(&esz, b + 84, 4);
+	if (esz != 128 || nent == 0 || nent * esz > BOUNCE_SIZE) {
+		printf("SWEET UFS: unsupported GPT entries %u x %u\n", nent, esz);
+		return ENXIO;
+	}
+	error = ufs_read_blocks(entry_lba, (nent * esz + UFS_BLOCK - 1) / UFS_BLOCK);
+	if (error) {
+		return error;
+	}
+	for (uint32_t i = 0; i < nent; i++) {
+		const uint8_t *e = b + i * esz;
+		char name[37];
+		unsigned c;
+		for (c = 0; c < 36; c++) {
+			uint16_t ch = (uint16_t)(e[56 + 2 * c] | e[57 + 2 * c] << 8);
+			if (ch == 0 || ch > 0x7f) {
+				break;
+			}
+			name[c] = (char)ch;
+		}
+		name[c] = 0;
+		if (strcmp(name, want) != 0) {
+			continue;
+		}
+		uint64_t first, last;
+		memcpy(&first, e + 32, 8);
+		memcpy(&last, e + 40, 8);
+		if (last < first) {
+			return ENXIO;
+		}
+		su.first_block = first;
+		su.nblocks = last - first + 1;
+		if (ufs_read_blocks(gpt_alt, 1) == 0 && memcmp(b, "EFI PART", 8) == 0) {
+			memcpy(&gpt_bhcrc, b + 16, 4);
+		}
+		printf("SWEET UFS: GPT LUN0 hcrc %#x ecrc %#x backup@%#llx hcrc %#x\n",
+		    gpt_hcrc, gpt_ecrc, gpt_alt, gpt_bhcrc);
+		return 0;
+	}
+	printf("SWEET UFS: no GPT partition named \"%s\"\n", want);
+	return ENOENT;
+}
+
+/*
+ * topaz: read-only access to other GPT partitions on LUNs 0-5 (modem firmware in
+ * modem_a, later the EFS copies). Never writes; the LUN0 GPT fence state is untouched.
+ */
+static struct { char name[37]; uint8_t lun; uint64_t first, nblocks; } part_cache[8];
+static unsigned part_cached;
+
+static int
+ufs_lookup_part(const char *want, unsigned *slot)
+{
+	const uint8_t *b = (const uint8_t *)(su.dma + DMA_BOUNCE);
+
+	for (unsigned i = 0; i < part_cached; i++) {
+		if (strcmp(part_cache[i].name, want) == 0) {
+			*slot = i;
+			return 0;
+		}
+	}
+	if (part_cached == sizeof(part_cache) / sizeof(part_cache[0]) || strlen(want) > 36) {
+		return ENOSPC;
+	}
+	for (uint8_t lun = 0; lun < 6; lun++) {
+		su.lun = lun;
+		if (ufs_read_blocks(1, 1) != 0 || memcmp(b, "EFI PART", 8) != 0) {
+			continue;
+		}
+		uint64_t entry_lba;
+		uint32_t nent, esz;
+		memcpy(&entry_lba, b + 72, 8);
+		memcpy(&nent, b + 80, 4);
+		memcpy(&esz, b + 84, 4);
+		if (esz != 128 || nent == 0 || nent * esz > BOUNCE_SIZE ||
+		    ufs_read_blocks(entry_lba, (nent * esz + UFS_BLOCK - 1) / UFS_BLOCK) != 0) {
+			continue;
+		}
+		for (uint32_t i = 0; i < nent; i++) {
+			const uint8_t *e = b + i * esz;
+			char name[37];
+			unsigned c;
+			for (c = 0; c < 36; c++) {
+				uint16_t ch = (uint16_t)(e[56 + 2 * c] | e[57 + 2 * c] << 8);
+				if (ch == 0 || ch > 0x7f) {
+					break;
+				}
+				name[c] = (char)ch;
+			}
+			name[c] = 0;
+			uint64_t first, last;
+			memcpy(&first, e + 32, 8);
+			memcpy(&last, e + 40, 8);
+			if (strcmp(name, want) != 0 || last < first) {
+				continue;
+			}
+			unsigned k = part_cached++;
+			strlcpy(part_cache[k].name, want, sizeof(part_cache[k].name));
+			part_cache[k].lun = lun;
+			part_cache[k].first = first;
+			part_cache[k].nblocks = last - first + 1;
+			printf("SWEET UFS: partition %s: LUN %u blocks 0x%llx+0x%llx (read-only)\n",
+			    want, lun, first, last - first + 1);
+			*slot = k;
+			return 0;
+		}
+	}
+	return ENOENT;
+}
+
+int sweet_ufs_read_part(const char *want, uint64_t off, void *dst, uint64_t len);
+int
+sweet_ufs_read_part(const char *want, uint64_t off, void *dst, uint64_t len)
+{
+	unsigned slot = 0;
+	int error;
+
+	if (!su.ready) {
+		return EAGAIN;
+	}
+	lck_mtx_lock(&sweet_ufs_lock);
+	uint8_t saved = su.lun;
+	error = ufs_lookup_part(want, &slot);
+	uint64_t bytes = error ? 0 : part_cache[slot].nblocks * UFS_BLOCK;
+	if (!error && (off > bytes || len > bytes - off)) {
+		error = EINVAL;
+	}
+	for (uint64_t done = 0; !error && done < len;) {
+		uint64_t pos = off + done;
+		uint32_t skip = (uint32_t)(pos % UFS_BLOCK);
+		uint32_t want_b = (uint32_t)MIN(len - done, (uint64_t)(BOUNCE_SIZE - skip));
+		uint32_t blocks = (skip + want_b + UFS_BLOCK - 1) / UFS_BLOCK;
+		su.lun = part_cache[slot].lun;
+		error = ufs_read_blocks(part_cache[slot].first + pos / UFS_BLOCK, blocks);
+		if (!error) {
+			memcpy((uint8_t *)dst + done, (const uint8_t *)(su.dma + DMA_BOUNCE) + skip, want_b);
+			done += want_b;
+		}
+	}
+	su.lun = saved;
+	lck_mtx_unlock(&sweet_ufs_lock);
+	return error;
+}
+
+static int
+ufs_take_over_host(void)
+{
+	uint32_t hce = ufs_rd(REG_HCE), hcs = ufs_rd(REG_HCS);
+	if (!(hce & 1) || !(hcs & HCS_DP) || !(hcs & HCS_UTRLRDY)) {
+		printf("SWEET UFS: host not ready (hce 0x%x hcs 0x%x)\n", hce, hcs);
+		return ENXIO;
+	}
+	if (ufs_rd(REG_UTRLDBR)) {
+		printf("SWEET UFS: requests outstanding from the bootloader\n");
+		return EBUSY;
+	}
+	/* With RAM above 4 GiB (mkadt.py --highmem) the DMA memory can be there too. */
+	if (((su.dma_pa + DMA_SIZE - 1) >> 32) && !(ufs_rd(REG_CAP) & CAP_64AS)) {
+		printf("SWEET UFS: DMA memory at 0x%llx but the host has no 64-bit addressing\n",
+		    su.dma_pa);
+		return ENXIO;
+	}
+	ufs_wr(REG_IE, 0);                      /* polled operation */
+	ufs_wr(REG_IS, ufs_rd(REG_IS));
+	ufs_wr(REG_UTRLRSR, 0);
+	uint64_t list = su.dma_pa + DMA_UTRL;
+	ufs_wr(REG_UTRLBA, (uint32_t)list);
+	ufs_wr(REG_UTRLBAU, (uint32_t)(list >> 32));
+	ufs_wr(REG_UTRLRSR, 1);
+	/* Never ring a doorbell unless the host uses our list. */
+	if (ufs_rd(REG_UTRLBA) != (uint32_t)list || ufs_rd(REG_UTRLBAU) != (uint32_t)(list >> 32) ||
+	    !(ufs_rd(REG_UTRLRSR) & 1)) {
+		printf("SWEET UFS: host did not take our request list\n");
+		return EIO;
+	}
+	return 0;
+}
+
+static int
+sweet_ufs_open(__unused dev_t dev, int flags, __unused int devtype, __unused struct proc *p)
+{
+	if (!su.ready) {
+		return ENXIO;
+	}
+	return ((flags & FWRITE) && !su.writable) ? EROFS : 0;
+}
+
+static int
+sweet_ufs_close(__unused dev_t dev, __unused int flags, __unused int devtype, __unused struct proc *p)
+{
+	return 0;
+}
+
+static void
+sweet_ufs_strategy(buf_t bp)
+{
+	int error = 0;
+	caddr_t vaddr = NULL;
+	uint64_t off = (uint64_t)buf_blkno(bp) * su.secsize;
+	uint32_t count = buf_count(bp);
+	uint64_t part_bytes = su.nblocks * UFS_BLOCK;
+
+	bool rd = buf_flags(bp) & B_READ;
+
+	buf_setresid(bp, count);
+	if (!rd && !su.writable) {
+		error = EROFS;
+		goto done;
+	}
+	if (off > part_bytes || count > part_bytes - off) {
+		error = EINVAL;
+		goto done;
+	}
+	if (count == 0) {
+		goto done;
+	}
+	if (buf_map(bp, &vaddr)) {
+		error = EIO;
+		goto done;
+	}
+
+	lck_mtx_lock(&sweet_ufs_lock);
+	for (uint32_t done = 0; done < count;) {
+		uint64_t pos = off + done;
+		uint64_t lba = pos / UFS_BLOCK;
+		uint32_t skip = (uint32_t)(pos % UFS_BLOCK);
+		uint32_t want = MIN(count - done, BOUNCE_SIZE - skip);
+		uint32_t blocks = (skip + want + UFS_BLOCK - 1) / UFS_BLOCK;
+		void *bounce = (void *)(su.dma + DMA_BOUNCE);
+		if (rd) {
+			error = ufs_read_blocks(su.first_block + lba, blocks);
+			if (!error) {
+				memcpy(vaddr + done, (const char *)bounce + skip, want);
+			}
+		} else {
+			/* Partial device blocks at either end: read, merge, write back. */
+			if (skip || (want % UFS_BLOCK)) {
+				error = ufs_read_blocks(su.first_block + lba, blocks);
+			}
+			if (!error) {
+				memcpy((char *)bounce + skip, vaddr + done, want);
+				error = ufs_write_blocks(su.first_block + lba, blocks);
+			}
+		}
+		if (error) {
+			break;
+		}
+		done += want;
+		buf_setresid(bp, count - done);
+	}
+	lck_mtx_unlock(&sweet_ufs_lock);
+	buf_unmap(bp);
+
+done:
+	if (error) {
+		buf_seterror(bp, error);
+	}
+	buf_biodone(bp);
+}
+
+static int
+sweet_ufs_ioctl(__unused dev_t dev, u_long cmd, caddr_t data, __unused int flag,
+    __unused struct proc *p, int is_char)
+{
+	uint32_t *f = (uint32_t *)data;
+	uint64_t *o = (uint64_t *)data;
+
+	switch (cmd) {
+	case DKIOCGETBLOCKSIZE:
+		*f = su.secsize;
+		return 0;
+	case DKIOCSETBLOCKSIZE:
+		if (is_char) {
+			return ENODEV;
+		}
+		if (*f < DEV_BSIZE || *f > UFS_BLOCK || (*f & (*f - 1))) {
+			return EINVAL;
+		}
+		su.secsize = *f;
+		return 0;
+	case DKIOCGETPHYSICALBLOCKSIZE:
+		*f = UFS_BLOCK;
+		return 0;
+	case DKIOCGETBLOCKCOUNT:
+		*o = su.nblocks * UFS_BLOCK / su.secsize;
+		return 0;
+	case DKIOCISWRITABLE:
+		*f = su.writable;
+		return 0;
+	case DKIOCSYNCHRONIZE:
+	case DKIOCSYNCHRONIZECACHE: {
+		if (!su.writable) {
+			return 0;
+		}
+		lck_mtx_lock(&sweet_ufs_lock);
+		int error = ufs_sync_cache();
+		lck_mtx_unlock(&sweet_ufs_lock);
+		return error;
+	}
+	case DKIOCGETMAXBLOCKCOUNTREAD:
+		*o = BOUNCE_SIZE / su.secsize;
+		return 0;
+	case DKIOCGETMAXBLOCKCOUNTWRITE:
+		*o = su.writable ? BOUNCE_SIZE / su.secsize : 0;
+		return 0;
+	case DKIOCGETMAXSEGMENTCOUNTREAD:
+	case DKIOCGETMAXSEGMENTCOUNTWRITE:
+		*o = 1;
+		return 0;
+	default:
+		return ENOTTY;
+	}
+}
+
+static int
+sweet_ufs_bioctl(dev_t dev, u_long cmd, caddr_t data, int flag, struct proc *p)
+{
+	return sweet_ufs_ioctl(dev, cmd, data, flag, p, 0);
+}
+
+static int
+sweet_ufs_cioctl(dev_t dev, u_long cmd, caddr_t data, int flag, struct proc *p)
+{
+	return sweet_ufs_ioctl(dev, cmd, data, flag, p, 1);
+}
+
+static int
+sweet_ufs_psize(__unused dev_t dev)
+{
+	return su.ready ? (int)MIN(su.nblocks * UFS_BLOCK / su.secsize, INT_MAX) : -1;
+}
+
+static int
+sweet_ufs_read(dev_t dev, struct uio *uio, __unused int ioflag)
+{
+	return physio(sweet_ufs_strategy, NULL, dev, B_READ, minphys, uio, (int)su.secsize);
+}
+
+static int
+sweet_ufs_write(dev_t dev, struct uio *uio, __unused int ioflag)
+{
+	if (!su.writable) {
+		return EROFS;
+	}
+	return physio(sweet_ufs_strategy, NULL, dev, B_WRITE, minphys, uio, (int)su.secsize);
+}
+
+static const struct bdevsw sweet_ufs_bdevsw = {
+	.d_open     = sweet_ufs_open,
+	.d_close    = sweet_ufs_close,
+	.d_strategy = sweet_ufs_strategy,
+	.d_ioctl    = sweet_ufs_bioctl,
+	.d_dump     = eno_dump,
+	.d_psize    = sweet_ufs_psize,
+	.d_type     = D_DISK,
+};
+
+static const struct cdevsw sweet_ufs_cdevsw = {
+	.d_open       = sweet_ufs_open,
+	.d_close      = sweet_ufs_close,
+	.d_read       = sweet_ufs_read,
+	.d_write      = sweet_ufs_write,
+	.d_ioctl      = sweet_ufs_cioctl,
+	.d_stop       = eno_stop,
+	.d_reset      = eno_reset,
+	.d_ttys       = NULL,
+	.d_select     = eno_select,
+	.d_mmap       = eno_mmap,
+	.d_strategy   = eno_strat,
+	.d_reserved_1 = eno_getc,
+	.d_reserved_2 = eno_putc,
+	.d_type       = D_DISK,
+};
+
+static void
+sweet_gpt_watch(__unused void *arg, __unused wait_result_t wr)
+{
+	const uint8_t *b = (const uint8_t *)(su.dma + DMA_BOUNCE);
+	uint64_t start = mach_absolute_time();
+	for (;;) {
+		uint64_t deadline;
+		clock_interval_to_deadline(10, NSEC_PER_SEC, &deadline);
+		(void)assert_wait_deadline(&gpt_chan, THREAD_UNINT, deadline);
+		thread_block(THREAD_CONTINUE_NULL);
+
+		uint32_t h = 0, e = 0, bh = 0;
+		bool ok;
+		lck_mtx_lock(&sweet_ufs_lock);
+		ok = ufs_read_blocks(1, 1) == 0 && memcmp(b, "EFI PART", 8) == 0;
+		if (ok) {
+			memcpy(&h, b + 16, 4);
+			memcpy(&e, b + 88, 4);
+		}
+		if (ok && gpt_bhcrc && ufs_read_blocks(gpt_alt, 1) == 0) {
+			if (memcmp(b, "EFI PART", 8) == 0) {
+				memcpy(&bh, b + 16, 4);
+			}
+		}
+		lck_mtx_unlock(&sweet_ufs_lock);
+		if (!ok || h != gpt_hcrc || e != gpt_ecrc || (gpt_bhcrc && bh != gpt_bhcrc)) {
+			uint64_t ns;
+			absolutetime_to_nanoseconds(mach_absolute_time() - start, &ns);
+			panic("SWEET UFS: GPT LUN0 CHANGED after %llu s: primary %s hcrc %#x/%#x ecrc %#x/%#x backup hcrc %#x/%#x",
+			    ns / NSEC_PER_SEC, ok ? "present" : "MISSING", h, gpt_hcrc, e, gpt_ecrc, bh, gpt_bhcrc);
+		}
+	}
+}
+
+static int
+sweet_ufs_init(void)
+{
+	DTEntry node;
+	uintptr_t const *reg = NULL;
+	unsigned int size = 0;
+	char want[64] = "userdata";
+	int error;
+
+	if (SecureDTLookupEntry(NULL, "/sweet-ufs", &node) != kSuccess ||
+	    SecureDTGetProperty(node, "reg", (void const **)&reg, &size) != kSuccess ||
+	    size < 2 * sizeof(uintptr_t)) {
+		printf("SWEET UFS: no /sweet-ufs node in the device tree\n");
+		return ENXIO;
+	}
+	PE_parse_boot_argn("ufsroot", want, sizeof(want));
+	uint32_t rw = 0;
+	PE_parse_boot_argn("ufsrw", &rw, sizeof(rw));
+	uint32_t cache = 0, wait = 0;
+	PE_parse_boot_argn("ufscache", &cache, sizeof(cache));
+	PE_parse_boot_argn("ufswait", &wait, sizeof(wait));
+	su.cache = (cache == 1);
+	su.wait = (wait == 1);
+
+	su.regs = ml_io_map(reg[0], reg[1]);
+	if (kmem_alloc_contig(kernel_map, &su.dma, DMA_SIZE, PAGE_MASK, 0, 0,
+	    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		printf("SWEET UFS: no contiguous DMA memory\n");
+		return ENOMEM;
+	}
+	ppnum_t pn = pmap_find_phys(kernel_pmap, (addr64_t)su.dma);
+	if (!pn) {
+		return ENOMEM;
+	}
+	su.dma_pa = ptoa_64(pn);
+	su.lun = 0;
+	su.secsize = DEV_BSIZE;
+
+	lck_mtx_lock(&sweet_ufs_lock);
+	error = ufs_take_over_host();
+	if (!error) {
+		static const uint8_t tur[6] = { 0x00 };
+		/* The first command after the bootloader may report a unit attention. */
+		for (int i = 0; i < 3 && (error = ufs_scsi(tur, sizeof(tur), 0, false)); i++) {
+		}
+	}
+	if (!error) {
+		error = ufs_find_partition(want);
+	}
+	lck_mtx_unlock(&sweet_ufs_lock);
+	if (error) {
+		return error;
+	}
+
+	su.bmajor = bdevsw_add(-1, &sweet_ufs_bdevsw);
+	if (su.bmajor < 0) {
+		return ENXIO;
+	}
+	su.cmajor = cdevsw_add_with_bdev(-1, &sweet_ufs_cdevsw, su.bmajor);
+	if (su.cmajor < 0) {
+		return ENXIO;
+	}
+	su.bdev = makedev(su.bmajor, 0);
+	devfs_make_node(su.bdev, DEVFS_BLOCK, UID_ROOT, GID_OPERATOR, 0640, "ufsroot0");
+	devfs_make_node(makedev(su.cmajor, 0), DEVFS_CHAR, UID_ROOT, GID_OPERATOR, 0640, "rufsroot0");
+	/* Only now, with the partition bounds known, can writes be allowed. */
+	su.writable = (rw != 0);
+	su.ready = true;
+	printf("SWEET UFS: \"%s\" on LUN %u: first block 0x%llx, %llu MiB, %s, DMA at 0x%llx\n",
+	    want, su.lun, su.first_block, su.nblocks * UFS_BLOCK >> 20,
+	    su.writable ? "read-write" : "read-only", su.dma_pa);
+	sweet_log_start();
+	sweet_sample_start();
+	thread_t gpt_thread;
+	if (kernel_thread_start(sweet_gpt_watch, NULL, &gpt_thread) == KERN_SUCCESS) {
+		thread_deallocate(gpt_thread);
+	}
+	/*
+	 * Input drivers (HID services in iokit/Kernel/arm/hid/SweetHID.cpp).
+	 * Touch (FT5452 on QUP0 SE2) and keys (PM6125 over SPMI) are ported to
+	 * topaz; sweettouch=0 / sweetkeys=0 disable them. USB (ported to SM6225)
+	 * is opt-in: sweetusb=1 reports its state, sweetusb=2 starts the device.
+	 */
+	sweet_touch_init();
+	sweet_keys_init();
+	sweet_bt_boot_init();
+	sweet_usb_probe();
+	return 0;
+}
+
+/*
+ * Persistent console log ("sweetlog"). Filming the phone screen is the only
+ * other way to see the console, so every character that reaches the
+ * console (kernel printf and /dev/console writes of daemons, both through
+ * _cnputs) is also kept in a 4 MiB ring, and once the partition is known
+ * and writable a thread copies new ring blocks to the LAST 4 MiB + 4 KiB of
+ * the partition every ufslogsecs seconds (default 10), far behind the HFS
+ * image at its start. Device block 0 of that area is a header:
+ *   "SWEETLOG" | u32 version 1 | u32 ring size | u64 total bytes written
+ *   | u64 flush sequence
+ * ring offset of byte n = n % ring size. Read it from a recovery with
+ * tools/sweet-log-pull.sh. Disabled with boot-arg sweetlog=0.
+ */
+#define SWEET_LOG_SIZE          (4u << 20)
+#define SWEET_LOG_BLOCKS        (1 + SWEET_LOG_SIZE / UFS_BLOCK)
+#define SWEET_LOG_SECS          10u
+
+static char sweet_log_ring[SWEET_LOG_SIZE];
+static uint64_t _Atomic sweet_log_total;
+static int sweet_log_chan;
+static uint64_t _Atomic sweet_log_flushed;      /* 0274: what the log thread has written */
+static uint32_t sweet_log_secs = SWEET_LOG_SECS;
+
+/* Called for all console output, any context: never blocks. */
+void sweet_log_append(const char *c, int size);
+
+void
+sweet_log_append(const char *c, int size)
+{
+	if (size <= 0) {
+		return;
+	}
+	uint64_t at = os_atomic_add_orig(&sweet_log_total, (uint64_t)size, relaxed);
+	for (int i = 0; i < size; i++) {
+		sweet_log_ring[(at + (uint64_t)i) % SWEET_LOG_SIZE] = c[i];
+	}
+}
+
+/*
+ * Copy console bytes [*pos, total) (at most max) for live log streaming
+ * (sweet_usb.c). A reader that fell more than the ring behind skips ahead.
+ * Returns the byte count; *pos advances.
+ */
+uint32_t sweet_log_copy(uint64_t *pos, char *out, uint32_t max);
+
+uint32_t
+sweet_log_copy(uint64_t *pos, char *out, uint32_t max)
+{
+	uint64_t total = os_atomic_load(&sweet_log_total, relaxed);
+	if (total - *pos > SWEET_LOG_SIZE) {
+		*pos = total - SWEET_LOG_SIZE;
+	}
+	uint32_t n = (uint32_t)MIN((uint64_t)max, total - *pos);
+	for (uint32_t i = 0; i < n; i++) {
+		out[i] = sweet_log_ring[(*pos + i) % SWEET_LOG_SIZE];
+	}
+	*pos += n;
+	return n;
+}
+
+uint64_t sweet_log_position(void);
+
+uint64_t
+sweet_log_position(void)
+{
+	return os_atomic_load(&sweet_log_total, relaxed);
+}
+
+struct sweet_log_header {
+	char magic[8];
+	uint32_t version, size;
+	uint64_t total, seq;
+};
+
+static void
+sweet_log_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	uint64_t base = su.first_block + su.nblocks - SWEET_LOG_BLOCKS;
+	uint64_t flushed = 0, seq = 0;
+	extern void IOSleep(unsigned int);
+	void *bounce = (void *)(su.dma + DMA_BOUNCE);
+
+	printf("SWEET LOG: console log to the last %u KiB of the partition (block 0x%llx)\n",
+	    SWEET_LOG_BLOCKS * UFS_BLOCK >> 10, base);
+	for (;;) {
+		(void)tsleep(&sweet_log_chan, PZERO, "sweetlog", hz * (int)sweet_log_secs);
+		uint64_t total = os_atomic_load(&sweet_log_total, relaxed);
+		if (total == flushed) {
+			continue;
+		}
+		uint64_t pos = total - flushed >= SWEET_LOG_SIZE ? total - SWEET_LOG_SIZE : flushed;
+		int error = 0;
+
+		lck_mtx_lock(&sweet_ufs_lock);
+		while (pos < total && !error) {
+			uint32_t off = (uint32_t)(pos % SWEET_LOG_SIZE);
+			uint32_t blk = off / UFS_BLOCK;
+			uint64_t need = ((uint64_t)off % UFS_BLOCK + (total - pos) + UFS_BLOCK - 1) / UFS_BLOCK;
+			uint32_t n = (uint32_t)MIN(MIN(need, (uint64_t)(SWEET_LOG_SIZE / UFS_BLOCK - blk)),
+			    (uint64_t)(BOUNCE_SIZE / UFS_BLOCK));
+			memcpy(bounce, sweet_log_ring + (uint64_t)blk * UFS_BLOCK, n * UFS_BLOCK);
+			error = ufs_write_blocks(base + 1 + blk, n);
+			pos += (uint64_t)(blk + n) * UFS_BLOCK - off;
+		}
+		if (!error) {
+			struct sweet_log_header h = {
+				.magic = { 'S', 'W', 'E', 'E', 'T', 'L', 'O', 'G' },
+				.version = 1, .size = SWEET_LOG_SIZE, .total = total, .seq = ++seq,
+			};
+			bzero(bounce, UFS_BLOCK);
+			memcpy(bounce, &h, sizeof(h));
+			error = ufs_write_blocks(base, 1);
+		}
+		if (!error) {
+			error = ufs_sync_cache();
+		}
+		lck_mtx_unlock(&sweet_ufs_lock);
+		if (error) {
+			printf("SWEET LOG: write failed (%d), stopping\n", error);
+			return;
+		}
+		flushed = total;
+		os_atomic_store(&sweet_log_flushed, total, relaxed);
+	}
+}
+
+static bool sweet_log_on;
+
+/*
+ * 0274: write the console log to the partition now and wait (up to max_ms) until it is there,
+ * so that the last lines before a risky step survive a hang (sweet_cam.c).
+ */
+void sweet_log_sync(unsigned max_ms);
+void
+sweet_log_sync(unsigned max_ms)
+{
+	extern void IOSleep(unsigned int);
+	if (!sweet_log_on) {
+		return;
+	}
+	uint64_t want = os_atomic_load(&sweet_log_total, relaxed);
+	wakeup(&sweet_log_chan);
+	for (unsigned ms = 0; ms < max_ms && os_atomic_load(&sweet_log_flushed, relaxed) < want; ms += 5) {
+		IOSleep(5);
+	}
+}
+
+/*
+ * Black box. Called from SavePanicInfo() (osfmk/arm/model_dep.c): the panic string has
+ * already gone through the console into the ring, every other CPU is halted and
+ * interrupts are off. The thread above cannot run any more, so this writes the ring the
+ * same way without its mutex (whoever holds it is never coming back) and without
+ * sleeping (ufs_scsi spins when interrupts are off). A command that thread left in
+ * flight gets a bounded wait for its doorbell first. The header's seq is all ones so the
+ * reader knows this flush came from a panic. Without this the only trace of a panic
+ * is the screen, and the last ufslogsecs of console before it are gone.
+ */
+void sweet_log_panic_flush(void);
+
+void
+sweet_log_panic_flush(void)
+{
+	static bool done;
+	uint64_t base = su.first_block + su.nblocks - SWEET_LOG_BLOCKS;
+	void *bounce = (void *)(su.dma + DMA_BOUNCE);
+	int error = 0;
+
+	if (done || !sweet_log_on) {
+		return;
+	}
+	done = true;
+	for (int i = 0; i < 3000 && (ufs_rd(REG_UTRLDBR) & 1); i++) {
+		delay(1000);
+	}
+	uint64_t total = os_atomic_load(&sweet_log_total, relaxed);
+	uint64_t pos = total >= SWEET_LOG_SIZE ? total - SWEET_LOG_SIZE : 0;
+
+	while (pos < total && !error) {
+		uint32_t off = (uint32_t)(pos % SWEET_LOG_SIZE);
+		uint32_t blk = off / UFS_BLOCK;
+		uint64_t need = ((uint64_t)off % UFS_BLOCK + (total - pos) + UFS_BLOCK - 1) / UFS_BLOCK;
+		uint32_t n = (uint32_t)MIN(MIN(need, (uint64_t)(SWEET_LOG_SIZE / UFS_BLOCK - blk)),
+		    (uint64_t)(BOUNCE_SIZE / UFS_BLOCK));
+		memcpy(bounce, sweet_log_ring + (uint64_t)blk * UFS_BLOCK, n * UFS_BLOCK);
+		error = ufs_write_blocks(base + 1 + blk, n);
+		pos += (uint64_t)(blk + n) * UFS_BLOCK - off;
+	}
+	if (!error) {
+		struct sweet_log_header h = {
+			.magic = { 'S', 'W', 'E', 'E', 'T', 'L', 'O', 'G' },
+			.version = 1, .size = SWEET_LOG_SIZE, .total = total, .seq = ~0ull,
+		};
+		bzero(bounce, UFS_BLOCK);
+		memcpy(bounce, &h, sizeof(h));
+		error = ufs_write_blocks(base, 1);
+	}
+	if (!error) {
+		error = ufs_sync_cache();
+	}
+	printf("SWEET PANIC: console log %s to the partition (%llu bytes)\n",
+	    error ? "NOT written" : "written", total);
+}
+
+void sweet_slot_mark_start(void);
+
+static void
+sweet_log_start(void)
+{
+	sweet_slot_mark_start();
+	uint32_t on = 1;
+	thread_t thread;
+
+	PE_parse_boot_argn("sweetlog", &on, sizeof(on));
+	if (!on || !su.writable || su.nblocks < 2 * SWEET_LOG_BLOCKS) {
+		return;
+	}
+	PE_parse_boot_argn("ufslogsecs", &sweet_log_secs, sizeof(sweet_log_secs));
+	if (sweet_log_secs == 0 || sweet_log_secs > 60) {
+		sweet_log_secs = SWEET_LOG_SECS;
+	}
+	if (kernel_thread_start(sweet_log_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+		sweet_log_on = true;
+	}
+}
+
+/* Root device for rd=ufsroot0 (IOFindBSDRoot). */
+int sweet_ufs_rootdev(dev_t *dev);
+
+int
+sweet_ufs_rootdev(dev_t *dev)
+{
+	if (!su.ready) {
+		int error = sweet_ufs_init();
+		if (error) {
+			return error;
+		}
+	}
+	*dev = su.bdev;
+	return 0;
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
+
+/*
+ * sapphire 0305: the phone handed back to Android. The A/B slot that is booted is kept in the GPT of the
+ * LUN holding boot_a/boot_b (sde): the active bit of every _a/_b partition and the type GUIDs, which
+ * Qualcomm's bootloader swaps between each X_a/X_b pair when it changes slots (fastboot set_active) and
+ * checks before it loads anything. sweet_slot_switch() does what it does (checked against the GPTs this
+ * phone's ABL wrote, userland/dualboot/test_slot.c); here both copies are read, checked, changed, written
+ * back -- backup first, primary last, only those sectors, only on that LUN -- and read again.
+ *
+ * kern.sweet_boot_android (anybody may write it; the iOS app does): 1 = the other slot (Android's) active,
+ * then reboot; 2 = the same without the reboot (a test). Reads: 'a' or 'b', the active slot, 0 unknown.
+ */
+static int
+ufs_write_slot_blocks(uint8_t lun, uint64_t lba, uint32_t count)
+{
+	if (!su.writable || su.lun != lun || count == 0 || count > 8 || lba > UINT32_MAX) {
+		return EPERM;
+	}
+	uint8_t cdb[10] = {
+		0x2a, 0,
+		(uint8_t)(lba >> 24), (uint8_t)(lba >> 16), (uint8_t)(lba >> 8), (uint8_t)lba,
+		0, (uint8_t)(count >> 8), (uint8_t)count, 0
+	};
+	return ufs_scsi(cdb, sizeof(cdb), count * UFS_BLOCK, true);
+}
+
+/* LBA's COUNT blocks into DST (COUNT * UFS_BLOCK bytes), on the current LUN */
+static int
+ufs_read_into(uint64_t lba, uint32_t count, uint8_t *dst)
+{
+	int error = ufs_read_blocks(lba, count);
+	if (!error) {
+		memcpy(dst, (const void *)(su.dma + DMA_BOUNCE), count * UFS_BLOCK);
+	}
+	return error;
+}
+
+static int
+ufs_write_from(uint8_t lun, uint64_t lba, uint32_t count, const uint8_t *src)
+{
+	memcpy((void *)(su.dma + DMA_BOUNCE), src, count * UFS_BLOCK);
+	return ufs_write_slot_blocks(lun, lba, count);
+}
+
+static int sweet_slot_active_cached;
+
+/*
+ * sapphire 0306: UFS QUERY REQUEST for a device attribute (UFS 2.1 10.7.8): opcode 3 read, 4 write.
+ * IDN 0 is bBootLunEn, the boot well-known LUN the primary boot loader (XBL) is read from: 1 = Boot LU A
+ * (xbl_a, slot a), 2 = Boot LU B. Qualcomm's bootloader checks it against the GPT's active slot
+ * (FindBootableSlot: "Boot lun ... and BootableSlot ... do not match") and loads nothing when they
+ * differ; fastboot set_active and Android's boot HAL change both. With sweet_ufs_lock held.
+ */
+static int
+ufs_query_attr(bool write, uint8_t idn, uint32_t *value)
+{
+	struct utrd *utrd = (struct utrd *)(su.dma + DMA_UTRL);
+	struct ucd *ucd = (struct ucd *)(su.dma + DMA_UCD);
+	uint64_t ucd_pa = su.dma_pa + DMA_UCD;
+
+	bzero(utrd, sizeof(*utrd));
+	bzero(ucd, sizeof(*ucd));
+	ucd->cmd[0] = 0x16;                             /* QUERY REQUEST UPIU */
+	ucd->cmd[3] = ++su.tag;
+	ucd->cmd[5] = write ? 0x81 : 0x01;              /* standard write / read request */
+	ucd->cmd[12] = write ? 0x04 : 0x03;             /* WRITE / READ ATTRIBUTE */
+	ucd->cmd[13] = idn;
+	if (write) {
+		ucd->cmd[20] = (uint8_t)(*value >> 24);
+		ucd->cmd[21] = (uint8_t)(*value >> 16);
+		ucd->cmd[22] = (uint8_t)(*value >> 8);
+		ucd->cmd[23] = (uint8_t)*value;
+	}
+	utrd->dw0 = (1u << 28) | (1u << 24);            /* UFS storage command type, interrupt; no data */
+	utrd->dw2 = 0x0f;
+	utrd->ucdba = (uint32_t)ucd_pa;
+	utrd->ucdbau = (uint32_t)(ucd_pa >> 32);
+	utrd->resp = (512u / 4) << 16 | (512u / 4);
+	dma_clean(DMA_UTRL, sizeof(*utrd));
+	dma_clean(DMA_UCD, 32);
+	dma_sync(DMA_UCD + offsetof(struct ucd, resp), sizeof(ucd->resp));
+	__builtin_arm_dsb(0xf);
+	ufs_wr(REG_UTRLDBR, 1);
+	uint64_t deadline;
+	nanoseconds_to_absolutetime(CMD_TIMEOUT_NS, &deadline);
+	deadline += mach_absolute_time();
+	while (ufs_rd(REG_UTRLDBR) & 1) {
+		if (mach_absolute_time() > deadline) {
+			ufs_wr(REG_UTRLCLR, ~1u);
+			printf("SWEET UFS: query %s attribute %u timed out\n", write ? "write" : "read", idn);
+			return ETIMEDOUT;
+		}
+		delay(10);
+	}
+	__builtin_arm_dsb(0xf);
+	ufs_wr(REG_IS, ufs_rd(REG_IS));
+	dma_sync(DMA_UTRL, sizeof(*utrd));
+	dma_sync(DMA_UCD + offsetof(struct ucd, resp), sizeof(ucd->resp));
+	uint32_t ocs = utrd->dw2 & 0xff;
+	if (ocs || ucd->resp[0] != 0x36 || ucd->resp[6] != 0) {
+		printf("SWEET UFS: query %s attribute %u failed: ocs 0x%x upiu 0x%x response 0x%x\n",
+		    write ? "write" : "read", idn, ocs, ucd->resp[0], ucd->resp[6]);
+		return EIO;
+	}
+	if (!write) {
+		*value = (uint32_t)ucd->resp[20] << 24 | (uint32_t)ucd->resp[21] << 16 | (uint32_t)ucd->resp[22] << 8 | ucd->resp[23];
+	}
+	return 0;
+}
+
+static int
+ufs_boot_lun(uint32_t *lun)
+{
+	return ufs_query_attr(false, 0x00, lun);
+}
+
+static int
+sweet_ufs_slot(int target, bool successful, int *active_out)
+{
+	unsigned ps = 0;
+	int error;
+	const uint32_t blk = UFS_BLOCK;
+	uint8_t *hdr = kalloc_data(blk, Z_WAITOK | Z_ZERO), *bhdr = kalloc_data(blk, Z_WAITOK | Z_ZERO);
+	uint8_t *ents = kalloc_data(8 * blk, Z_WAITOK | Z_ZERO), *bents = kalloc_data(8 * blk, Z_WAITOK | Z_ZERO);
+	uint8_t *check = kalloc_data(8 * blk, Z_WAITOK | Z_ZERO);
+
+	if (!su.ready || !hdr || !bhdr || !ents || !bents || !check) {
+		error = EAGAIN;
+		goto out_free;
+	}
+	lck_mtx_lock(&sweet_ufs_lock);
+	uint8_t saved = su.lun;
+	error = ufs_lookup_part("boot_a", &ps);
+	if (error) {
+		goto out;
+	}
+	uint8_t lun = part_cache[ps].lun;
+	su.lun = lun;
+	struct sweet_slot_gpt g, bg;
+	if ((error = ufs_read_into(1, 1, hdr)) != 0) {
+		goto out;
+	}
+	if (sweet_slot_check_header(hdr, 1, &g) != 0) {
+		error = EFTYPE;
+		goto out;
+	}
+	uint32_t span = (g.count * 128 + blk - 1) / blk;
+	if (span > 8 || g.entries_lba < 2 || g.alt_lba <= g.entries_lba + span) {
+		error = EFTYPE;
+		goto out;
+	}
+	if ((error = ufs_read_into(g.entries_lba, span, ents)) != 0 || (error = ufs_read_into(g.alt_lba, 1, bhdr)) != 0) {
+		goto out;
+	}
+	if (sweet_slot_check_header(bhdr, g.alt_lba, &bg) != 0 || bg.entries_lba + span > g.alt_lba ||
+	    bg.entries_lba <= g.entries_lba + span) {
+		error = EFTYPE;
+		goto out;
+	}
+	if ((error = ufs_read_into(bg.entries_lba, span, bents)) != 0) {
+		goto out;
+	}
+	int now = sweet_slot_active(ents, g.count);
+	sweet_slot_active_cached = now > 0 ? now : 0;
+	if (active_out) {
+		*active_out = sweet_slot_active_cached;
+	}
+	if (target == 0) {
+		goto out;                       /* only asked which slot is active */
+	}
+	int r = sweet_slot_switch(hdr, ents, bhdr, bents, g.alt_lba, (char)target, successful);
+	if (r != 0) {
+		printf("SWEET SLOT: GPT of LUN %u refused (%d): nothing written\n", lun, r);
+		error = EFTYPE;
+		goto out;
+	}
+	printf("SWEET SLOT: LUN %u: slot %c -> %c (entries %llu+%u, backup %llu+%u, header %llu)\n", lun, now, target,
+	    g.entries_lba, span, bg.entries_lba, span, g.alt_lba);
+	/* 0306: the boot LUN first (the bootloader loads nothing while it and the GPT disagree), read back */
+	uint32_t boot_lun_old = 0, boot_lun_new = target == 'a' ? 1 : 2, boot_lun_now = 0;
+	if ((error = ufs_boot_lun(&boot_lun_old)) != 0) {
+		printf("SWEET SLOT: boot LUN unreadable (%d): nothing written\n", error);
+		goto out;
+	}
+	if (boot_lun_old != boot_lun_new) {
+		if ((error = ufs_query_attr(true, 0x00, &boot_lun_new)) != 0 ||
+		    (error = ufs_boot_lun(&boot_lun_now)) != 0 || boot_lun_now != boot_lun_new) {
+			printf("SWEET SLOT: boot LUN %u -> %u failed (%d, reads %u): GPT not written\n", boot_lun_old,
+			    boot_lun_new, error, boot_lun_now);
+			if (boot_lun_now != boot_lun_old) {
+				(void)ufs_query_attr(true, 0x00, &boot_lun_old);
+			}
+			error = error ? error : EIO;
+			goto out;
+		}
+	}
+	printf("SWEET SLOT: boot LUN %u -> %u\n", boot_lun_old, boot_lun_new);
+	if ((error = ufs_write_from(lun, bg.entries_lba, span, bents)) != 0 ||
+	    (error = ufs_write_from(lun, g.alt_lba, 1, bhdr)) != 0 ||
+	    (error = ufs_write_from(lun, g.entries_lba, span, ents)) != 0 ||
+	    (error = ufs_write_from(lun, 1, 1, hdr)) != 0) {
+		printf("SWEET SLOT: write failed (%d)\n", error);
+		goto out;
+	}
+	(void)ufs_sync_cache();
+	if ((error = ufs_read_into(g.entries_lba, span, check)) == 0 && memcmp(check, ents, span * blk) != 0) {
+		error = EIO;
+	}
+	if (!error && (error = ufs_read_into(1, 1, check)) == 0 && memcmp(check, hdr, blk) != 0) {
+		error = EIO;
+	}
+	if (!error) {
+		sweet_slot_active_cached = target;
+		if (active_out) {
+			*active_out = target;
+		}
+	}
+	printf("SWEET SLOT: %s\n", error ? "read back DIFFERS" : "written and read back");
+out:
+	su.lun = saved;
+	lck_mtx_unlock(&sweet_ufs_lock);
+out_free:
+	if (hdr) kfree_data(hdr, blk);
+	if (bhdr) kfree_data(bhdr, blk);
+	if (ents) kfree_data(ents, 8 * blk);
+	if (bents) kfree_data(bents, 8 * blk);
+	if (check) kfree_data(check, 8 * blk);
+	return error;
+}
+
+extern int reboot_kernel(int howto, char *message);
+extern void sweet_reboot_mode_set(int mode);
+
+static int
+sysctl_sweet_boot_android SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	int active = 0;
+	(void)sweet_ufs_slot(0, false, &active);
+	int v = active, changed = 0;
+	int error = sysctl_io_number(req, v, sizeof(v), &v, &changed);
+	if (error || !changed) {
+		return error;
+	}
+	if (v != 1 && v != 2 && v != 3) {
+		return EINVAL;
+	}
+	if (active != 'a' && active != 'b') {
+		return EFTYPE;
+	}
+	error = sweet_ufs_slot(active == 'a' ? 'b' : 'a', false, NULL);
+	if (!error && v == 1) {
+		/* 0307: a restart to the system (the slot just made active), not the default bootloader (0221) */
+		sweet_reboot_mode_set(0);
+		(void)reboot_kernel(0, (char *)"sweet: to Android");
+	}
+	if (!error && v == 3) {
+		/* 0311: to Android slot recovery (OrangeFox), where the installers apply Sapphire updates */
+		sweet_reboot_mode_set(1);
+		(void)reboot_kernel(0, (char *)"sweet: to recovery");
+	}
+	return error;
+}
+SYSCTL_PROC(_kern, OID_AUTO, sweet_boot_android, CTLTYPE_INT | CTLFLAG_RW | CTLFLAG_ANYBODY | CTLFLAG_LOCKED,
+    0, 0, sysctl_sweet_boot_android, "I", "sapphire: 1 = make the other A/B slot (Android) active and reboot, 2 = without the reboot, 3 = and reboot into its recovery");
+
+/*
+ * sapphire 0306: iOS marks its slot good, as Android's update_verifier does: 90 s after the UFS driver is up
+ * (iOS running), if the GPT's active slot is the one the boot LUN says the bootloader came from, boot_X is
+ * given its 7 retries and marked successful -- the bootloader then stops counting them down, so iOS stays
+ * the system booted (without it, the 7th boot would have fallen back to Android). Boot-arg sweetmarkgood=0
+ * leaves it.
+ */
+static void
+sweet_slot_mark_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	extern void IOSleep(unsigned int);
+	IOSleep(90 * 1000);
+	unsigned ps = 0;
+	uint32_t blun = 0;
+	const uint32_t blk = UFS_BLOCK;
+	uint8_t *hdr = kalloc_data(blk, Z_WAITOK | Z_ZERO), *bhdr = kalloc_data(blk, Z_WAITOK | Z_ZERO);
+	uint8_t *ents = kalloc_data(8 * blk, Z_WAITOK | Z_ZERO), *bents = kalloc_data(8 * blk, Z_WAITOK | Z_ZERO);
+	if (!hdr || !bhdr || !ents || !bents) {
+		goto free;
+	}
+	lck_mtx_lock(&sweet_ufs_lock);
+	uint8_t saved = su.lun;
+	struct sweet_slot_gpt g, bg;
+	int r = -1;
+	if (ufs_lookup_part("boot_a", &ps) != 0) {
+		goto out;
+	}
+	uint8_t lun = part_cache[ps].lun;
+	su.lun = lun;
+	if (ufs_boot_lun(&blun) != 0 || ufs_read_into(1, 1, hdr) != 0 || sweet_slot_check_header(hdr, 1, &g) != 0) {
+		goto out;
+	}
+	uint32_t span = (g.count * 128 + blk - 1) / blk;
+	if (span > 8 || ufs_read_into(g.entries_lba, span, ents) != 0 || ufs_read_into(g.alt_lba, 1, bhdr) != 0 ||
+	    sweet_slot_check_header(bhdr, g.alt_lba, &bg) != 0 || bg.entries_lba + span > g.alt_lba ||
+	    ufs_read_into(bg.entries_lba, span, bents) != 0) {
+		goto out;
+	}
+	int act = sweet_slot_active(ents, g.count);
+	if (act != (blun == 1 ? 'a' : blun == 2 ? 'b' : 0)) {
+		printf("SWEET SLOT: not marking: active slot %c, boot LUN %u\n", act > 0 ? act : '?', blun);
+		goto out;
+	}
+	r = sweet_slot_mark_good(hdr, ents, bhdr, bents, g.alt_lba, (char)act);
+	if (r == 0) {
+		int e = 0;
+		if ((e = ufs_write_from(lun, bg.entries_lba, span, bents)) == 0 &&
+		    (e = ufs_write_from(lun, g.alt_lba, 1, bhdr)) == 0 &&
+		    (e = ufs_write_from(lun, g.entries_lba, span, ents)) == 0) {
+			e = ufs_write_from(lun, 1, 1, hdr);
+		}
+		(void)ufs_sync_cache();
+		printf("SWEET SLOT: slot %c marked good%s\n", act, e ? " -- WRITE FAILED" : "");
+	} else {
+		printf("SWEET SLOT: slot %c %s (%d)\n", act, r == SWEET_SLOT_ALREADY ? "already good" : "not marked", r);
+	}
+out:
+	su.lun = saved;
+	lck_mtx_unlock(&sweet_ufs_lock);
+free:
+	if (hdr) kfree_data(hdr, blk);
+	if (bhdr) kfree_data(bhdr, blk);
+	if (ents) kfree_data(ents, 8 * blk);
+	if (bents) kfree_data(bents, 8 * blk);
+}
+
+void sweet_slot_mark_start(void);
+void
+sweet_slot_mark_start(void)
+{
+	uint32_t on = 1;
+	thread_t t;
+	(void)PE_parse_boot_argn("sweetmarkgood", &on, sizeof(on));
+	if (on && su.ready && su.writable && kernel_thread_start(sweet_slot_mark_thread, NULL, &t) == KERN_SUCCESS) {
+		thread_deallocate(t);
+	}
+}
+
+static int
+sysctl_sweet_boot_lun SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	uint32_t v = 0;
+	int error = EAGAIN;
+	if (su.ready) {
+		lck_mtx_lock(&sweet_ufs_lock);
+		error = ufs_boot_lun(&v);
+		lck_mtx_unlock(&sweet_ufs_lock);
+	}
+	if (error) {
+		return error;
+	}
+	int out = (int)v;
+	return SYSCTL_OUT(req, &out, sizeof(out));
+}
+SYSCTL_PROC(_kern, OID_AUTO, sweet_boot_lun, CTLTYPE_INT | CTLFLAG_RD | CTLFLAG_ANYBODY | CTLFLAG_LOCKED,
+    0, 0, sysctl_sweet_boot_lun, "I", "sapphire: the UFS bBootLunEn attribute (1 = slot a's XBL, 2 = slot b's)");
+
+/*
+ * sapphire 0310: the inbox, read from iOS. The raw space of the root partition after its HFS volume (the
+ * Windows installer and the Android app write there: updates, apps; installer/recovery/sapphire.sh,
+ * android/dualboot IpaInbox.java) is read through this, never through /dev/rufsroot0. Read-only, root
+ * only, and only inside [V, P - LOG): V = the volume size the installer gives the volume
+ * ((P - LOG - INBOX) rounded down to 1 MiB), P = the partition, LOG = the console ring at its end.
+ *
+ *   kern.sweet_inbox: new = u64 offset from the partition start, old = up to 1 MiB from there
+ *   (with no old buffer: the length of the inbox space)
+ */
+#define INBOX_LOG_BYTES   4198400ull      /* 1025 x 4 KiB */
+#define INBOX_BYTES       134217728ull
+#define INBOX_MIB         1048576ull
+
+static int
+sysctl_sweet_inbox SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	char want[64] = "userdata";
+	uint64_t off = 0;
+	unsigned slot = 0;
+	int error;
+
+	if (!kauth_cred_issuser(kauth_cred_get())) {
+		return EPERM;
+	}
+	if (req->newptr == USER_ADDR_NULL || req->newlen != sizeof(off)) {
+		return EINVAL;
+	}
+	error = SYSCTL_IN(req, &off, sizeof(off));
+	if (error) {
+		return error;
+	}
+	if (!su.ready) {
+		return EAGAIN;
+	}
+	PE_parse_boot_argn("ufsroot", want, sizeof(want));
+	lck_mtx_lock(&sweet_ufs_lock);
+	error = ufs_lookup_part(want, &slot);
+	uint64_t p = error ? 0 : part_cache[slot].nblocks * UFS_BLOCK;
+	lck_mtx_unlock(&sweet_ufs_lock);
+	if (error) {
+		return error;
+	}
+	if (p < INBOX_LOG_BYTES + INBOX_BYTES + 64 * INBOX_MIB) {
+		return ENOSPC;
+	}
+	uint64_t lo = (p - INBOX_LOG_BYTES - INBOX_BYTES) / INBOX_MIB * INBOX_MIB;
+	uint64_t hi = p - INBOX_LOG_BYTES;
+	if (req->oldptr == USER_ADDR_NULL) {
+		req->oldidx = (size_t)(hi - lo);
+		return 0;
+	}
+	uint64_t len = req->oldlen;
+	if (len > BOUNCE_SIZE) {
+		len = BOUNCE_SIZE;
+	}
+	if (off < lo || off >= hi) {
+		return ERANGE;
+	}
+	if (len > hi - off) {
+		len = hi - off;
+	}
+	void *buf = kalloc_data((vm_size_t)len, Z_WAITOK);
+	if (buf == NULL) {
+		return ENOMEM;
+	}
+	error = sweet_ufs_read_part(want, off, buf, len);
+	if (!error) {
+		error = SYSCTL_OUT(req, buf, (size_t)len);
+	}
+	kfree_data(buf, (vm_size_t)len);
+	return error;
+}
+SYSCTL_PROC(_kern, OID_AUTO, sweet_inbox, CTLTYPE_OPAQUE | CTLFLAG_RW | CTLFLAG_LOCKED,
+    0, 0, sysctl_sweet_inbox, "S", "sapphire: the inbox after the root volume (new: u64 offset; old: up to 1 MiB)");
diff --git a/bsd/dev/sweet_usb.c b/bsd/dev/sweet_usb.c
new file mode 100644
index 0000000..f4f919c
--- /dev/null
+++ b/bsd/dev/sweet_usb.c
@@ -0,0 +1,1202 @@
+/*
+ * SWEET: USB bring-up, step 1 - read-only state probe.
+ *
+ * The phone's USB is a Synopsys DWC3 (USB 2.0 only, maximum-speed
+ * high-speed) behind Qualcomm's dwc-usb3-msm wrapper; its power domain is
+ * the USB30_PRIM GDSC and its clocks come from GCC. sapphire/topaz
+ * (SM6225 khaje): DWC3 at 0x04e00000, Synopsys femto HS PHY at 0x01613000
+ * (not read here), GCC offsets from Linux gcc-sm6115.c (the khaje GCC; the
+ * USB30_PRIM GDSC at 0x141a004 matches the phone's DT). ABL uses this
+ * controller for fastboot; this probe only reports what state it is left
+ * in after `fastboot boot`. It never writes a register, and it touches the
+ * DWC3 / PHY register blocks only when the GCC status registers say their
+ * power domain and clocks are on (an access to a gated block would hang).
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <arm/caches_internal.h>
+#include <vm/pmap.h>
+#include <vm/vm_kern.h>
+#include <pexpert/pexpert.h>
+#include <kern/locks.h>
+#include <sys/kpi_mbuf.h>
+#include <sys/kpi_socket.h>
+#include <sys/sockio.h>
+#include <net/if.h>
+#include <net/if_types.h>
+#include <net/ethernet.h>
+#include <net/if_ether.h>
+#include <net/ether_if_module.h>
+#include <net/kpi_interface.h>
+#include <net/kpi_protocol.h>
+#include <netinet/in.h>
+#include <sys/sysctl.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+void sweet_usb_probe(void);
+static void sweet_usb_gadget_start(vm_offset_t dwc);
+extern ppnum_t pmap_find_phys(pmap_t pmap, addr64_t va);
+
+#define GCC_PA                  0x01400000
+#define GCC_SIZE                0x001f0000
+#define GCC_USB30_PRIM_GDSCR    0x1a004         /* bit 31: power on */
+#define CBCR_CLK_OFF            (1u << 31)
+
+static const struct {
+	const char *name;
+	uint32_t    off;
+} usb_cbcr[] = {
+	{ "master", 0x1a010 },
+	{ "sleep", 0x1a014 },
+	{ "utmi", 0x1a018 },
+	{ "cfg-noc-axi", 0x1a084 },
+	{ "sys-noc-axi", 0x1a080 },
+	{ "ahb2phy", 0x1d008 },
+	{ "clkref", 0x9f000 },
+};
+
+#define DWC3_PA                 0x04e00000
+#define DWC3_SIZE               0x0000d000
+
+static uint32_t
+usb_rd(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile ("dmb oshld" ::: "memory");
+	return v;
+}
+
+void
+sweet_usb_probe(void)
+{
+	int enabled = 0;
+	uint32_t gdscr, cbcr[sizeof(usb_cbcr) / sizeof(usb_cbcr[0])];
+	bool clocks_on = true;
+
+	/* sweetusb=0 (default) off, 1 report state only, 2 also start the USB device */
+	PE_parse_boot_argn("sweetusb", &enabled, sizeof(enabled));
+	if (!enabled) {
+		return;
+	}
+	vm_offset_t gcc = ml_io_map(GCC_PA, GCC_SIZE);
+	if (gcc == 0) {
+		printf("SWEET USB: GCC map failed\n");
+		return;
+	}
+	gdscr = usb_rd(gcc, GCC_USB30_PRIM_GDSCR);
+	printf("SWEET USB: GDSC usb30_prim 0x%08x (%s)\n", gdscr, (gdscr & (1u << 31)) ? "on" : "off");
+	for (unsigned i = 0; i < sizeof(usb_cbcr) / sizeof(usb_cbcr[0]); i++) {
+		cbcr[i] = usb_rd(gcc, usb_cbcr[i].off);
+		printf("SWEET USB: clk %-12s CBCR 0x%08x (%s)\n", usb_cbcr[i].name, cbcr[i],
+		    (cbcr[i] & CBCR_CLK_OFF) ? "off" : "on");
+	}
+	/* DWC3 registers need the GDSC, the master clock and the config-NoC path. */
+	clocks_on = (gdscr & (1u << 31)) && !(cbcr[0] & CBCR_CLK_OFF) && !(cbcr[3] & CBCR_CLK_OFF);
+	if (!clocks_on) {
+		printf("SWEET USB: controller unpowered or unclocked; DWC3 not read\n");
+		return;
+	}
+	vm_offset_t dwc = ml_io_map(DWC3_PA, DWC3_SIZE);
+	if (dwc == 0) {
+		printf("SWEET USB: DWC3 map failed\n");
+		return;
+	}
+	printf("SWEET USB: DWC3 GSNPSID 0x%08x GCTL 0x%08x GSTS 0x%08x GUSB2PHYCFG 0x%08x\n",
+	    usb_rd(dwc, 0xc120), usb_rd(dwc, 0xc110), usb_rd(dwc, 0xc118), usb_rd(dwc, 0xc200));
+	printf("SWEET USB: DWC3 DCFG 0x%08x DCTL 0x%08x DEVTEN 0x%08x DSTS 0x%08x DALEPENA 0x%08x\n",
+	    usb_rd(dwc, 0xc700), usb_rd(dwc, 0xc704), usb_rd(dwc, 0xc708), usb_rd(dwc, 0xc70c),
+	    usb_rd(dwc, 0xc720));
+	printf("SWEET USB: DWC3 GEVNTADR 0x%08x%08x GEVNTSIZ 0x%08x GEVNTCOUNT 0x%08x GHWPARAMS0 0x%08x\n",
+	    usb_rd(dwc, 0xc404), usb_rd(dwc, 0xc400), usb_rd(dwc, 0xc408), usb_rd(dwc, 0xc40c),
+	    usb_rd(dwc, 0xc140));
+	if (enabled >= 2) {
+		sweet_usb_gadget_start(dwc);
+	}
+}
+
+/*
+ * Step 2: USB device mode with only the default control endpoint, enough
+ * for the host to enumerate the phone (boot-arg sweetusb=2). ABL leaves
+ * the DWC3 powered, clocked, in device mode and halted, with the PHY set
+ * up, so only the device controller is restarted: soft reset, an event
+ * buffer in our memory, endpoint 0, run. Events are polled from a kernel
+ * thread (no interrupt), like the UFS driver. DMA is not cache coherent
+ * (DT qcom,gsi-disable-io-coherency): buffers are cleaned/invalidated.
+ * Register layout and the control-transfer state machine follow the
+ * Synopsys DWC3 databook as used by Linux drivers/usb/dwc3 (gadget.c,
+ * ep0.c).
+ */
+#define GCTL            0xc110
+#define GEVNTADRLO      0xc400
+#define GEVNTADRHI      0xc404
+#define GEVNTSIZ        0xc408
+#define GEVNTCOUNT      0xc40c
+#define DCFG            0xc700
+#define DCTL            0xc704
+#define DEVTEN          0xc708
+#define DSTS            0xc70c
+#define DALEPENA        0xc720
+#define DEPCMDPAR2(n)   (0xc800 + 0x10 * (n))
+#define DEPCMDPAR1(n)   (0xc804 + 0x10 * (n))
+#define DEPCMDPAR0(n)   (0xc808 + 0x10 * (n))
+#define DEPCMD(n)       (0xc80c + 0x10 * (n))
+
+/*
+ * Qualcomm wrapper registers ("QSCRATCH", core base + 0xf8800). The
+ * controller only connects (pull-up on D+) while it sees a valid VBUS
+ * session; Linux dwc3-qcom forces that in software when the charger
+ * reports a cable (dwc3_qcom_vbus_override_enable).
+ */
+#define QSCRATCH_PA             0x04ef8800    /* DWC3 + 0xf8800 */
+#define QSCRATCH_HS_PHY_CTRL    0x10
+#define   UTMI_OTG_VBUS_VALID   (1u << 20)
+#define   SW_SESSVLD_SEL        (1u << 28)
+#define QSCRATCH_SS_PHY_CTRL    0x30
+#define   LANE0_PWR_PRESENT     (1u << 24)
+
+#define DCTL_RUN_STOP   (1u << 31)
+#define DCTL_CSFTRST    (1u << 30)
+#define DSTS_DEVCTRLHLT (1u << 22)
+
+#define DEPCMD_SETEPCONFIG      1
+#define DEPCMD_SETTRANSFRESOURCE 2
+#define DEPCMD_SETSTALL         4
+#define DEPCMD_CLEARSTALL       5
+#define DEPCMD_STARTTRANSFER    6
+#define DEPCMD_ENDTRANSFER      8
+#define DEPCMD_HIPRI_FORCERM    (1u << 11)
+#define DEPCMD_DEPSTARTCFG      9
+#define DEPCMD_CMDACT           (1u << 10)
+
+#define TRB_HWO         (1u << 0)
+#define TRB_LST         (1u << 1)
+#define TRB_ISP_IMI     (1u << 10)
+#define TRB_IOC         (1u << 11)
+#define TRBCTL_SETUP    (2u << 4)
+#define TRBCTL_STATUS2  (3u << 4)
+#define TRBCTL_STATUS3  (4u << 4)
+#define TRBCTL_DATA     (5u << 4)
+
+/* DMA area layout */
+#define UD_EVT          0x0000          /* event buffer, 4 KiB */
+#define UD_EVT_SIZE     0x1000
+#define UD_TRB_OUT      0x1000          /* ep0 OUT TRB */
+#define UD_TRB_IN       0x1010          /* ep0 IN TRB */
+#define UD_TRB_RX       0x1020          /* ep1 OUT (bulk, host -> phone) */
+#define UD_TRB_TX       0x1030          /* ep1 IN (bulk, phone -> host) */
+#define UD_TRB_INT      0x1050          /* ep2 IN (interrupt, notifications) */
+#define UD_SETUP        0x1040          /* 8-byte setup packet */
+#define UD_DATA         0x1100          /* ep0 data stage, 512 bytes */
+#define UD_NOTIFY       0x1300          /* 16-byte notification */
+#define UD_RX           0x2000          /* one received frame */
+#define UD_TX           0x2800          /* one frame to send */
+#define UD_FRAME_MAX    0x800
+#define UD_SIZE         0x4000
+
+/* Physical endpoints: 2n = OUT, 2n+1 = IN */
+#define EP_RX           2               /* 0x01 bulk OUT */
+#define EP_TX           3               /* 0x81 bulk IN */
+#define EP_INT          5               /* 0x82 interrupt IN */
+#define TRBCTL_NORMAL   (1u << 4)
+
+#define UD_TXQ          32
+
+static struct {
+	vm_offset_t dwc;
+	vm_offset_t dma;
+	uint64_t    dma_pa;
+	uint32_t    evt_pos;
+	int         sleep_chan;
+	enum { EP0_SETUP, EP0_DATA, EP0_WAIT_STATUS2, EP0_WAIT_STATUS3, EP0_STATUS } state;
+	bool        data_in;        /* data stage direction */
+	uint32_t    events;
+	bool        configured;
+	uint8_t     data_alt;       /* data interface alternate setting */
+	/* network */
+	ifnet_t     ifp;
+	lck_mtx_t  *lock;           /* TX ring and TX endpoint */
+	mbuf_t      txq[UD_TXQ];
+	unsigned    txq_head, txq_count;
+	bool        tx_busy;
+	uint64_t    rx_frames, tx_frames;
+	/* every endpoint's transfer (control 0/1 and data), to end them on a bus reset */
+	bool        xfer_active[EP_INT + 1];
+	uint8_t     xfer_rsc[EP_INT + 1];
+	uint32_t    resets;
+	/* transfers the controller finished without an event reaching us (ud_watch) */
+	uint32_t    lost_rx, lost_tx, stale_rx;
+	uint32_t    rx_rearms;      /* RX armed but silent, ended and armed again (ud_watch) */
+	uint32_t    halt_clears;    /* 0289: CLEAR_FEATURE(ENDPOINT_HALT) / SET_INTERFACE: sequence numbers reset */
+	uint64_t    watch_rx, watch_tx;
+} ud;
+
+static inline void
+dwc_wr(uint32_t off, uint32_t v)
+{
+	*(volatile uint32_t *)(ud.dwc + off) = v;
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+static inline uint32_t
+dwc_rd(uint32_t off)
+{
+	return usb_rd(ud.dwc, off);
+}
+
+static void
+ud_sync(uint32_t off, uint32_t len)
+{
+	flush_dcache64((addr64_t)(ud.dma_pa + off), len, TRUE);
+}
+
+static void
+ud_sleep_ms(unsigned ms)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&ud.sleep_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static int
+ud_epcmd(unsigned ep, uint32_t cmd, uint32_t p0, uint32_t p1, uint32_t p2)
+{
+	dwc_wr(DEPCMDPAR0(ep), p0);
+	dwc_wr(DEPCMDPAR1(ep), p1);
+	dwc_wr(DEPCMDPAR2(ep), p2);
+	dwc_wr(DEPCMD(ep), cmd | DEPCMD_CMDACT);
+	for (int i = 0; i < 1000; i++) {
+		uint32_t v = dwc_rd(DEPCMD(ep));
+		if (!(v & DEPCMD_CMDACT)) {
+			uint32_t status = (v >> 12) & 0xf;
+			if (status) {
+				printf("SWEET USB: ep%u cmd 0x%x status %u\n", ep, cmd & 0xf, status);
+				return -1;
+			}
+			return 0;
+		}
+		delay(1);
+	}
+	printf("SWEET USB: ep%u cmd 0x%x timeout\n", ep, cmd & 0xf);
+	return -1;
+}
+
+/* One TRB (at DMA offset trb) on physical endpoint ep: 0, or -1 if the controller refused it. */
+static int
+ud_start_trb(unsigned ep, uint32_t trb, uint32_t buf, uint32_t len, uint32_t ctl)
+{
+	volatile uint32_t *t = (volatile uint32_t *)(ud.dma + trb);
+	uint64_t bpa = ud.dma_pa + buf;
+
+	t[0] = (uint32_t)bpa;
+	t[1] = (uint32_t)(bpa >> 32);
+	t[2] = len;
+	t[3] = ctl | TRB_HWO | TRB_LST | TRB_ISP_IMI | TRB_IOC;
+	ud_sync(trb, 16);
+	if (len) {
+		ud_sync(buf, len);
+	}
+	uint64_t tpa = ud.dma_pa + trb;
+	if (ud_epcmd(ep, DEPCMD_STARTTRANSFER, (uint32_t)(tpa >> 32), (uint32_t)tpa, 0) != 0) {
+		return -1;
+	}
+	if (ep <= EP_INT) {
+		/* the transfer resource index, for ENDTRANSFER (Linux: dwc3_gadget_ep_get_transfer_index) */
+		ud.xfer_rsc[ep] = (uint8_t)((dwc_rd(DEPCMD(ep)) >> 16) & 0x7f);
+		ud.xfer_active[ep] = true;
+	}
+	return 0;
+}
+
+static int
+ud_start(unsigned ep, uint32_t buf, uint32_t len, uint32_t ctl)
+{
+	return ud_start_trb(ep, ep ? UD_TRB_IN : UD_TRB_OUT, buf, len, ctl);
+}
+
+/* End endpoint ep's transfer, if it has one. */
+static void
+ud_end_transfer(unsigned ep)
+{
+	if (ep <= EP_INT && ud.xfer_active[ep]) {
+		ud_epcmd(ep, DEPCMD_ENDTRANSFER | DEPCMD_HIPRI_FORCERM | ((uint32_t)ud.xfer_rsc[ep] << 16), 0, 0, 0);
+		delay(100);
+		ud.xfer_active[ep] = false;
+	}
+}
+
+/*
+ * Arm ep0 for the next SETUP. If the controller refuses (a control transfer the host abandoned
+ * is still active: "ep0 cmd 0x6 status 1"), end it and try again: otherwise ep0 never listens
+ * again, and every enumeration after that fails at the first GET_DESCRIPTOR.
+ */
+static void
+ud_start_setup(void)
+{
+	ud.state = EP0_SETUP;
+	if (ud_start(0, UD_SETUP, 8, TRBCTL_SETUP) != 0) {
+		/* the transfer still active on ep0 is ended by the index it was started with */
+		ud.xfer_active[0] = true;
+		ud_end_transfer(0);
+		ud_end_transfer(1);
+		if (ud_start(0, UD_SETUP, 8, TRBCTL_SETUP) != 0) {
+			printf("SWEET USB: ep0 cannot be armed for SETUP\n");
+		}
+	}
+}
+
+static void
+ud_stall(void)
+{
+	ud_epcmd(0, DEPCMD_SETSTALL, 0, 0, 0);
+	ud_start_setup();
+}
+
+/*
+ * USB descriptors: a CDC-ECM (Ethernet) function, which Linux (cdc_ether)
+ * and macOS drive without extra drivers. VID 0x1209 / PID 0x0001 =
+ * pid.codes test ID, not a product.
+ */
+static const uint8_t ud_dev_desc[18] = {
+	18, 1, 0x00, 0x02, 0x02, 0x00, 0x00, 64,
+	0x09, 0x12, 0x01, 0x00, 0x00, 0x01, 1, 2, 3, 1,
+};
+static const uint8_t ud_cfg_desc[80] = {
+	9, 2, 80, 0, 2, 1, 0, 0x80, 250,                /* config: 2 interfaces, 500 mA */
+	9, 4, 0, 0, 1, 0x02, 0x06, 0x00, 0,             /* comm interface 0: CDC ECM, 1 endpoint */
+	5, 0x24, 0x00, 0x10, 0x01,                      /* header, CDC 1.10 */
+	5, 0x24, 0x06, 0, 1,                            /* union: control 0, data 1 */
+	13, 0x24, 0x0f, 4, 0, 0, 0, 0, 0xea, 0x05, 0, 0, 0, /* ethernet: MAC string 4, max segment 1514 */
+	7, 5, 0x82, 0x03, 16, 0, 9,                     /* ep 0x82 interrupt IN, 16 bytes, 2^(9-1) uframes */
+	9, 4, 1, 0, 0, 0x0a, 0x00, 0x00, 0,             /* data interface 1 alt 0: no endpoints */
+	9, 4, 1, 1, 2, 0x0a, 0x00, 0x00, 0,             /* data interface 1 alt 1: two bulk endpoints */
+	7, 5, 0x81, 0x02, 0x00, 0x02, 0,                /* ep 0x81 bulk IN, 512 */
+	7, 5, 0x01, 0x02, 0x00, 0x02, 0,                /* ep 0x01 bulk OUT, 512 */
+};
+/* The host side's MAC (ECM iMACAddress); the phone's own is ..:02 */
+static const char *const ud_strings[] = {
+	NULL, "ios-sweet", "Sweet iOS (USB Ethernet)", "0001", "02005E77EE01",
+};
+static const uint8_t ud_phone_mac[ETHER_ADDR_LEN] = { 0x02, 0x00, 0x5e, 0x77, 0xee, 0x02 };
+
+static uint32_t
+ud_string(unsigned idx, uint8_t *out)
+{
+	if (idx == 0) {
+		out[0] = 4; out[1] = 3; out[2] = 0x09; out[3] = 0x04;   /* en-US */
+		return 4;
+	}
+	if (idx >= sizeof(ud_strings) / sizeof(ud_strings[0])) {
+		return 0;
+	}
+	const char *str = ud_strings[idx];
+	uint32_t n = 2;
+	for (; *str && n < 126; str++) {
+		out[n++] = (uint8_t)*str;
+		out[n++] = 0;
+	}
+	out[0] = (uint8_t)n;
+	out[1] = 3;
+	return n;
+}
+
+static void ud_rx_arm(void);
+static void ud_tx_kick_locked(void);
+static void ud_ep_reset_seq(unsigned ep);
+
+/*
+ * 0290: what the controller and the host did, kept for after a dead link (the console log goes
+ * over the same link): 256 entries of (ms since boot, what, a, b). Read: kern.sweet_usb_trace.
+ */
+#define UT_N 256
+static struct ut_ent { uint32_t ms; char what[4]; uint32_t a, b; } ut_ring[UT_N];
+static uint32_t ut_pos;
+static uint64_t ut_last_rx_ms;
+
+static uint32_t
+ut_now_ms(void)
+{
+	uint64_t ns;
+	absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+	return (uint32_t)(ns / 1000000ull);
+}
+
+static void
+ut(const char *what, uint32_t a, uint32_t b)
+{
+	struct ut_ent *e = &ut_ring[ut_pos++ % UT_N];
+	e->ms = ut_now_ms();
+	strlcpy(e->what, what, sizeof(e->what));
+	e->a = a;
+	e->b = b;
+}
+
+/* NETWORK_CONNECTION notification: the host brings its link up on it. */
+static void
+ud_notify_connected(void)
+{
+	uint8_t *n = (uint8_t *)(ud.dma + UD_NOTIFY);
+	n[0] = 0xa1; n[1] = 0x00;       /* NETWORK_CONNECTION */
+	n[2] = 1; n[3] = 0;             /* connected */
+	n[4] = 0; n[5] = 0;             /* interface 0 */
+	n[6] = 0; n[7] = 0;
+	ud_start_trb(EP_INT, UD_TRB_INT, UD_NOTIFY, 8, TRBCTL_NORMAL);
+}
+
+/* SET_CONFIGURATION(1): bulk IN/OUT and the interrupt endpoint. */
+static void
+ud_configure(void)
+{
+	if (ud.configured) {
+		return;
+	}
+	if (ud_epcmd(0, DEPCMD_DEPSTARTCFG | (2u << 16), 0, 0, 0) ||
+	    ud_epcmd(EP_RX, DEPCMD_SETEPCONFIG, (2u << 1) | (512u << 3), (1u << 8) | ((uint32_t)EP_RX << 25), 0) ||
+	    ud_epcmd(EP_RX, DEPCMD_SETTRANSFRESOURCE, 1, 0, 0) ||
+	    ud_epcmd(EP_TX, DEPCMD_SETEPCONFIG, (2u << 1) | (512u << 3) | (1u << 17), (1u << 8) | ((uint32_t)EP_TX << 25), 0) ||
+	    ud_epcmd(EP_TX, DEPCMD_SETTRANSFRESOURCE, 1, 0, 0) ||
+	    ud_epcmd(EP_INT, DEPCMD_SETEPCONFIG, (3u << 1) | (16u << 3) | (2u << 17),
+	    (1u << 8) | (8u << 16) | ((uint32_t)EP_INT << 25), 0) ||
+	    ud_epcmd(EP_INT, DEPCMD_SETTRANSFRESOURCE, 1, 0, 0)) {
+		printf("SWEET USB: data endpoints setup failed\n");
+		return;
+	}
+	dwc_wr(DALEPENA, dwc_rd(DALEPENA) | (1u << EP_RX) | (1u << EP_TX) | (1u << EP_INT));
+	ud.configured = true;
+	ud_rx_arm();
+	printf("SWEET USB: ECM endpoints configured\n");
+}
+
+static void
+ud_setup(void)
+{
+	const uint8_t *st = (const uint8_t *)(ud.dma + UD_SETUP);
+	uint8_t *data = (uint8_t *)(ud.dma + UD_DATA);
+	uint8_t type = st[0], req = st[1];
+	uint16_t value = (uint16_t)(st[2] | st[3] << 8);
+	uint16_t index = (uint16_t)(st[4] | st[5] << 8);
+	uint16_t length = (uint16_t)(st[6] | st[7] << 8);
+	uint32_t n = 0;
+	bool ok = true;
+
+	printf("SWEET USB: setup %02x %02x %04x %04x len %u\n", type, req, value, index, length);
+	ut("SET", (uint32_t)type << 8 | req, (uint32_t)value << 16 | index);
+	ud.data_in = (type & 0x80) != 0;
+	if ((type & 0x60) == 0x20) {    /* class request (e.g. SET_ETHERNET_PACKET_FILTER) */
+		ok = (length == 0);
+	} else if ((type & 0x60) != 0) {
+		ok = false;
+	} else if (req == 6) {          /* GET_DESCRIPTOR */
+		switch (value >> 8) {
+		case 1: memcpy(data, ud_dev_desc, sizeof(ud_dev_desc)); n = sizeof(ud_dev_desc); break;
+		case 2: memcpy(data, ud_cfg_desc, sizeof(ud_cfg_desc)); n = sizeof(ud_cfg_desc); break;
+		case 3: n = ud_string(value & 0xff, data); ok = n != 0; break;
+		default: ok = false; break;
+		}
+	} else if (req == 5) {          /* SET_ADDRESS: takes effect now (DWC3 handles the timing) */
+		uint32_t dcfg = dwc_rd(DCFG) & ~(0x7fu << 3);
+		dwc_wr(DCFG, dcfg | ((uint32_t)(value & 0x7f) << 3));
+		printf("SWEET USB: address %u\n", value & 0x7f);
+	} else if (req == 9) {          /* SET_CONFIGURATION */
+		if (value == 1) {
+			ud_configure();
+		}
+		printf("SWEET USB: configured (%u)\n", value);
+	} else if (req == 8) {          /* GET_CONFIGURATION */
+		data[0] = ud.configured ? 1 : 0; n = 1;
+	} else if (req == 0) {          /* GET_STATUS */
+		data[0] = 0; data[1] = 0; n = 2;
+	} else if (req == 11) {         /* SET_INTERFACE */
+		if (index == 1) {
+			if (value == 1 && ud.configured && ud.lock != NULL) {
+				ud_ep_reset_seq(EP_RX);  /* 0289: a new alternate setting starts at DATA0 */
+				ud_ep_reset_seq(EP_TX);
+			}
+			ud.data_alt = (uint8_t)value;
+			if (value == 1 && ud.configured) {
+				ud_notify_connected();
+			}
+		}
+	} else if (req == 10) {         /* GET_INTERFACE */
+		data[0] = index == 1 ? ud.data_alt : 0; n = 1;
+	} else if (req == 1 && (type & 0x1f) == 2 && value == 0) { /* CLEAR_FEATURE(ENDPOINT_HALT) */
+		unsigned a = index & 0xff;
+		if (ud.configured && ud.lock != NULL) {
+			if (a == 0x01) {
+				ud_ep_reset_seq(EP_RX);
+			} else if (a == 0x81) {
+				ud_ep_reset_seq(EP_TX);
+			} else if (a == 0x82) {
+				ud_ep_reset_seq(EP_INT);
+			}
+		}
+	} else if (req == 1 || req == 3) { /* other CLEAR/SET_FEATURE (remote wakeup; SET halt is not used here) */
+	} else {
+		ok = false;
+	}
+	if (!ok) {
+		ud_stall();
+		return;
+	}
+	if (length == 0) {
+		ud.state = EP0_WAIT_STATUS2;    /* status stage on XferNotReady */
+		return;
+	}
+	ud.state = EP0_DATA;
+	if (ud.data_in) {
+		if (n > length) {
+			n = length;
+		}
+		ud_start(1, UD_DATA, n, TRBCTL_DATA);
+	} else {
+		ud_start(0, UD_DATA, 64, TRBCTL_DATA);  /* OUT data is not used here */
+	}
+}
+
+/* ---- network interface (ue0) ---- */
+
+/*
+ * 0289: the host reset a data endpoint's data toggle (CLEAR_FEATURE(ENDPOINT_HALT), or SET_INTERFACE,
+ * which resets every endpoint of the interface): the controller's sequence number must go back to
+ * DATA0 as well (DWC3 ClearStall does that), its transfer ended first and armed again after.
+ * Ignoring it left the bulk OUT one toggle off: every packet from the host was ACKed and thrown away
+ * as a retry, the link silent until the next bus reset. usbipd/Windows reset the pipe that way after
+ * a transfer it cancelled (a cdc_ether transmit timeout on the PC), which is how big copies died.
+ */
+static void
+ud_ep_reset_seq(unsigned ep)
+{
+	ud.halt_clears++;
+	if (ep == EP_TX) {
+		lck_mtx_lock(ud.lock);
+		ud_end_transfer(EP_TX);
+		(void)ud_epcmd(EP_TX, DEPCMD_CLEARSTALL, 0, 0, 0);
+		ud.tx_busy = false;
+		ud_tx_kick_locked();
+		lck_mtx_unlock(ud.lock);
+	} else if (ep == EP_RX) {
+		ud_end_transfer(EP_RX);
+		(void)ud_epcmd(EP_RX, DEPCMD_CLEARSTALL, 0, 0, 0);
+		ud_rx_arm();
+	} else if (ep == EP_INT) {
+		ud_end_transfer(EP_INT);
+		(void)ud_epcmd(EP_INT, DEPCMD_CLEARSTALL, 0, 0, 0);
+	}
+}
+
+static void
+ud_rx_arm(void)
+{
+	/* refused (a transfer still held by the controller): end it and arm again, or RX is dead for good */
+	if (ud_start_trb(EP_RX, UD_TRB_RX, UD_RX, UD_FRAME_MAX, TRBCTL_NORMAL) != 0) {
+		ut("RXR", dwc_rd(DEPCMD(EP_RX)), 0);
+		ud.xfer_active[EP_RX] = true;
+		ud_end_transfer(EP_RX);
+		(void)ud_start_trb(EP_RX, UD_TRB_RX, UD_RX, UD_FRAME_MAX, TRBCTL_NORMAL);
+	}
+}
+
+static void
+ud_rx_done(void)
+{
+	volatile uint32_t *t = (volatile uint32_t *)(ud.dma + UD_TRB_RX);
+	ud_sync(UD_TRB_RX, 16);
+	/*
+	 * 0291: the completion event can come before the controller's write-back of the TRB is visible
+	 * (HWO still set). Returning there left RX unarmed for good -- the event had already marked the
+	 * transfer inactive, so ud_watch did not look at it either -- and every bulk OUT from the host
+	 * was NAKed from then on: the PC -> phone direction of the link died ("late rx" went up by one
+	 * each time). Wait for the write-back; if HWO stays set the controller finished the transfer
+	 * without writing the TRB back (that frame is lost): arm RX again at once (ud_rx_arm ends a
+	 * transfer the controller still holds first).
+	 */
+	for (int i = 0; (t[3] & TRB_HWO) && i < 100; i++) {
+		delay(10);
+		ud_sync(UD_TRB_RX, 16);
+	}
+	if (t[3] & TRB_HWO) {
+		ud.stale_rx++;
+		ut("RXS", t[3], t[2]);
+		ud_rx_arm();
+		return;
+	}
+	uint32_t len = UD_FRAME_MAX - (t[2] & 0xffffff);
+	uint32_t now = ut_now_ms();
+	if ((t[2] >> 28) != 0 || len < ETHER_HDR_LEN || len > ETHER_MAX_LEN || (ut_last_rx_ms && now - ut_last_rx_ms > 1000)) {
+		ut("RXd", t[2], now - (uint32_t)ut_last_rx_ms);
+	}
+	ut_last_rx_ms = now;
+	ud_sync(UD_RX, UD_FRAME_MAX);
+	if (ud.ifp != NULL && len >= ETHER_HDR_LEN && len <= ETHER_MAX_LEN) {
+		/*
+		 * One mbuf with a 2 KiB cluster holds any frame. (mbuf_allocpacket
+		 * may return a first mbuf of length 0: stripping the header from
+		 * it panicked "Failed mbuf validity check: len -14".)
+		 */
+		mbuf_t m = NULL;
+		if (mbuf_gethdr(MBUF_DONTWAIT, MBUF_TYPE_DATA, &m) == 0 &&
+		    mbuf_mclget(MBUF_DONTWAIT, MBUF_TYPE_DATA, &m) == 0 &&
+		    (mbuf_flags(m) & MBUF_EXT) && mbuf_maxlen(m) >= len) {
+			struct ifnet_stat_increment_param stats = {};
+			memcpy(mbuf_data(m), (const void *)(ud.dma + UD_RX), len);
+			mbuf_setlen(m, len);
+			mbuf_pkthdr_setlen(m, len);
+			void *frame_header = mbuf_data(m);
+			mbuf_pkthdr_setrcvif(m, ud.ifp);
+			mbuf_pkthdr_setheader(m, frame_header);
+			mbuf_pkthdr_adjustlen(m, -ETHER_HDR_LEN);
+			(void)mbuf_setdata(m, (char *)mbuf_data(m) + ETHER_HDR_LEN, mbuf_len(m) - ETHER_HDR_LEN);
+			stats.packets_in = 1;
+			stats.bytes_in = len;
+			ud.rx_frames++;
+			ifnet_input(ud.ifp, m, &stats);
+		} else if (m != NULL) {
+			mbuf_freem(m);
+		}
+	}
+	ud_rx_arm();
+}
+
+/* Start the next queued frame if the IN endpoint is idle. ud.lock held. */
+static void
+ud_tx_kick_locked(void)
+{
+	while (!ud.tx_busy && ud.txq_count > 0 && ud.configured) {
+		mbuf_t m = ud.txq[ud.txq_head];
+		ud.txq_head = (ud.txq_head + 1) % UD_TXQ;
+		ud.txq_count--;
+		size_t len = mbuf_pkthdr_len(m);
+		if (len > ETHER_MAX_LEN - ETHER_CRC_LEN) {
+			mbuf_freem(m);
+			continue;
+		}
+		mbuf_copydata(m, 0, len, (void *)(ud.dma + UD_TX));
+		mbuf_freem(m);
+		/* A frame of a multiple of 512 bytes would need a zero-length
+		 * packet to end it; one pad byte does the same (IP ignores it). */
+		if ((len % 512) == 0) {
+			((uint8_t *)(ud.dma + UD_TX))[len++] = 0;
+		}
+		ud.tx_busy = true;
+		ud.tx_frames++;
+		if (ud_start_trb(EP_TX, UD_TRB_TX, UD_TX, (uint32_t)len, TRBCTL_NORMAL) != 0) {
+			ud.tx_busy = false;     /* refused: that frame is lost, the next ones are not */
+			break;
+		}
+	}
+}
+
+static errno_t
+ud_if_output(ifnet_t ifp, mbuf_t m)
+{
+	lck_mtx_lock(ud.lock);
+	if (ud.txq_count == UD_TXQ || !ud.configured) {
+		lck_mtx_unlock(ud.lock);
+		mbuf_freem(m);
+		ifnet_stat_increment_out(ifp, 0, 0, 1);
+		return 0;
+	}
+	ifnet_stat_increment_out(ifp, 1, mbuf_pkthdr_len(m), 0);
+	ud.txq[(ud.txq_head + ud.txq_count) % UD_TXQ] = m;
+	ud.txq_count++;
+	ud_tx_kick_locked();
+	lck_mtx_unlock(ud.lock);
+	return 0;
+}
+
+static errno_t
+ud_if_ioctl(ifnet_t ifp, unsigned long cmd, void *data __unused)
+{
+	switch (cmd) {
+	case SIOCSIFADDR:
+	case SIOCAIFADDR:
+		ifnet_set_flags(ifp, IFF_UP, IFF_UP);
+		return 0;
+	case SIOCSIFFLAGS:
+	case SIOCADDMULTI:
+	case SIOCDELMULTI:
+		return 0;
+	default:
+		return EOPNOTSUPP;
+	}
+}
+
+static void
+ud_if_detach(ifnet_t ifp __unused)
+{
+}
+
+/* ue0, 192.168.7.2/24 (the host side is 192.168.7.1). */
+static void
+ud_if_create(void)
+{
+	struct ifnet_init_eparams init;
+	static lck_grp_t *grp;
+
+	grp = lck_grp_alloc_init("sweet_usb", LCK_GRP_ATTR_NULL);
+	ud.lock = lck_mtx_alloc_init(grp, LCK_ATTR_NULL);
+
+	bzero(&init, sizeof(init));
+	init.ver = IFNET_INIT_CURRENT_VERSION;
+	init.len = sizeof(init);
+	init.flags = IFNET_INIT_LEGACY;
+	init.uniqueid = "sweet-usb-ecm";
+	init.uniqueid_len = sizeof("sweet-usb-ecm") - 1;
+	init.name = "ue";
+	init.unit = 0;
+	init.family = IFNET_FAMILY_ETHERNET;
+	init.type = IFT_ETHER;
+	init.output = ud_if_output;
+	init.demux = ether_demux;
+	init.add_proto = ether_add_proto;
+	init.del_proto = ether_del_proto;
+	init.check_multi = ether_check_multi;
+	init.framer_extended = ether_frameout_extended;
+	init.ioctl = ud_if_ioctl;
+	init.detach = ud_if_detach;
+	init.broadcast_addr = etherbroadcastaddr;
+	init.broadcast_len = ETHER_ADDR_LEN;
+	if (ifnet_allocate_extended(&init, &ud.ifp) != 0) {
+		printf("SWEET USB: ifnet_allocate failed\n");
+		ud.ifp = NULL;
+		return;
+	}
+	ifnet_set_addrlen(ud.ifp, ETHER_ADDR_LEN);
+	ifnet_set_hdrlen(ud.ifp, sizeof(struct ether_header));
+	ifnet_set_mtu(ud.ifp, ETHERMTU);
+	ifnet_set_baudrate(ud.ifp, 480000000);
+	ifnet_set_flags(ud.ifp, IFF_BROADCAST | IFF_SIMPLEX | IFF_MULTICAST, 0xffff);
+	if (ifnet_attach(ud.ifp, NULL) != 0) {
+		printf("SWEET USB: ifnet_attach failed\n");
+		ud.ifp = NULL;
+		return;
+	}
+	ifnet_set_lladdr(ud.ifp, ud_phone_mac, ETHER_ADDR_LEN);
+
+	errno_t err = proto_plumb(PF_INET, ud.ifp);
+	socket_t so = NULL;
+	if (err == 0) {
+		err = sock_socket(PF_INET, SOCK_DGRAM, 0, NULL, NULL, &so);
+	}
+	if (err == 0) {
+		struct ifaliasreq ifra;
+		bzero(&ifra, sizeof(ifra));
+		snprintf(ifra.ifra_name, sizeof(ifra.ifra_name), "ue0");
+		struct sockaddr_in *a = (struct sockaddr_in *)&ifra.ifra_addr;
+		a->sin_len = sizeof(*a);
+		a->sin_family = AF_INET;
+		a->sin_addr.s_addr = htonl(0xc0a80702);         /* 192.168.7.2 */
+		a = (struct sockaddr_in *)&ifra.ifra_mask;
+		a->sin_len = sizeof(*a);
+		a->sin_family = AF_INET;
+		a->sin_addr.s_addr = htonl(0xffffff00);
+		a = (struct sockaddr_in *)&ifra.ifra_broadaddr;
+		a->sin_len = sizeof(*a);
+		a->sin_family = AF_INET;
+		a->sin_addr.s_addr = htonl(0xc0a807ff);
+		err = sock_ioctl(so, SIOCAIFADDR, &ifra);
+		sock_close(so);
+	}
+	ifnet_set_flags(ud.ifp, IFF_UP | IFF_RUNNING, IFF_UP | IFF_RUNNING);
+	printf("SWEET USB: ue0 192.168.7.2/24 %s (err %d)\n", err ? "NOT configured" : "up", err);
+}
+
+/*
+ * A bus reset (the host's, or usbipd's when the phone was slow to answer) loses the data
+ * endpoints' configuration in the controller. Until now only the address went back to 0: the
+ * endpoints stayed "configured" here, so the next SET_CONFIGURATION set nothing up, a frame
+ * being sent kept tx_busy, and the link was dead until a reboot. As Linux's
+ * dwc3_gadget_reset_interrupt: end the data endpoints' transfers, forget the configuration and
+ * the queue, restart a control transfer caught in the middle.
+ */
+static void
+ud_bus_reset(void)
+{
+	for (unsigned ep = EP_RX; ep <= EP_INT; ep++) {
+		ud_end_transfer(ep);
+	}
+	dwc_wr(DALEPENA, dwc_rd(DALEPENA) & ~((1u << EP_RX) | (1u << EP_TX) | (1u << EP_INT)));
+	if (ud.lock != NULL) {
+		lck_mtx_lock(ud.lock);
+	}
+	ud.configured = false;
+	ud.data_alt = 0;
+	ud.tx_busy = false;
+	while (ud.txq_count > 0) {
+		mbuf_freem(ud.txq[ud.txq_head]);
+		ud.txq_head = (ud.txq_head + 1) % UD_TXQ;
+		ud.txq_count--;
+	}
+	if (ud.lock != NULL) {
+		lck_mtx_unlock(ud.lock);
+	}
+	/*
+	 * ep0: a SETUP already waiting stays; a control transfer caught in the middle is ended on
+	 * both directions (Linux: dwc3_ep0_end_control_data) and ep0 armed again.
+	 */
+	if (ud.state != EP0_SETUP || !ud.xfer_active[0]) {
+		ud_end_transfer(0);
+		ud_end_transfer(1);
+		ud_start_setup();
+	}
+}
+
+static void
+ud_event(uint32_t ev)
+{
+	if (ev & 1) {                   /* device event */
+		uint32_t type = (ev >> 8) & 0xf;
+		if (type == 1) {        /* USB reset */
+			dwc_wr(DCFG, dwc_rd(DCFG) & ~(0x7fu << 3));
+			ut("RST", ud.resets, (uint32_t)ud.rx_frames);
+			ud_bus_reset();
+			if (ud.resets++ < 20) {
+				printf("SWEET USB: bus reset\n");
+			}
+		} else if (type == 2) { /* connect done */
+			uint32_t speed = dwc_rd(DSTS) & 7;
+			/* ep0 max packet: 64 at high/full speed (modify action) */
+			ud_epcmd(0, DEPCMD_SETEPCONFIG, (0u << 1) | (64u << 3) | (2u << 30),
+			    (1u << 8) | (1u << 10) | (0u << 25), 0);
+			ud_epcmd(1, DEPCMD_SETEPCONFIG, (0u << 1) | (64u << 3) | (2u << 30),
+			    (1u << 8) | (1u << 10) | (1u << 25), 0);
+			printf("SWEET USB: connected, speed %u\n", speed);
+		} else if (type == 0) {
+			printf("SWEET USB: disconnect\n");
+		}
+		return;
+	}
+	unsigned ep = (ev >> 1) & 0x1f;
+	unsigned type = (ev >> 6) & 0xf;
+	unsigned status = (ev >> 12) & 0xf;
+
+	if (ep >= EP_RX && ep <= EP_INT && (type != 1 || (status & 1))) {   /* not a completion, or a bus error */
+		ut("EV", ev, (uint32_t)ud.rx_frames);
+	}
+	if (ep <= EP_INT && type == 1) {
+		ud.xfer_active[ep] = false;
+	}
+	if (ep == EP_RX && type == 1) {
+		ud_rx_done();
+		return;
+	}
+	if (ep == EP_TX && type == 1) {
+		lck_mtx_lock(ud.lock);
+		ud.tx_busy = false;
+		ud_tx_kick_locked();
+		lck_mtx_unlock(ud.lock);
+		return;
+	}
+	if (ep > 1) {
+		return;
+	}
+	/*
+	 * Control transfer state machine (Linux dwc3 ep0.c): SETUP completes ->
+	 * request handled; the data stage (if any) is started right away; the
+	 * status stage is started when the controller reports XferNotReady
+	 * with status "control status"; its completion re-arms SETUP.
+	 */
+	if (type == 1) {                /* XferComplete */
+		switch (ud.state) {
+		case EP0_SETUP:
+			ud_sync(UD_SETUP, 8);
+			ud_setup();
+			break;
+		case EP0_DATA:
+			ud.state = EP0_WAIT_STATUS3;
+			break;
+		case EP0_STATUS:
+			ud_start_setup();
+			break;
+		default:
+			break;
+		}
+		return;
+	}
+	if (type == 3 && status == 2) { /* XferNotReady, control status phase */
+		if (ud.state == EP0_WAIT_STATUS2 || ud.state == EP0_WAIT_STATUS3) {
+			uint32_t ctl = ud.state == EP0_WAIT_STATUS3 ? TRBCTL_STATUS3 : TRBCTL_STATUS2;
+			ud.state = EP0_STATUS;
+			ud_start(ep, UD_DATA, 0, ctl);
+		}
+	}
+}
+
+/*
+ * Every 500 ms: a data transfer the controller has finished (HWO clear in its TRB) while no
+ * event came for it, twice in a row with no frame moving. The link went dead that way under
+ * load (rx and tx counters frozen for half a minute, no USB event, back at the next bus reset):
+ * take the frame as if the event had come.
+ */
+static void
+ud_watch(void)
+{
+	static bool rx_seen, tx_seen;
+	volatile uint32_t *rt = (volatile uint32_t *)(ud.dma + UD_TRB_RX);
+	volatile uint32_t *tt = (volatile uint32_t *)(ud.dma + UD_TRB_TX);
+
+	if (!ud.configured || ud.lock == NULL) {
+		rx_seen = tx_seen = false;
+		return;
+	}
+	ud_sync(UD_TRB_RX, 16);
+	bool rx_idle = ud.xfer_active[EP_RX] && !(rt[3] & TRB_HWO) && ud.rx_frames == ud.watch_rx;
+	if (rx_idle && rx_seen) {
+		ut("RXL", ud.lost_rx, 0);
+		if (ud.lost_rx++ < 20) {
+			printf("SWEET USB: rx transfer done without an event (%u), taking it\n", ud.lost_rx);
+		}
+		ud.xfer_active[EP_RX] = false;
+		ud_rx_done();
+		rx_idle = false;
+	}
+	rx_seen = rx_idle;
+	/*
+	 * RX armed (HWO still set) and not a frame in 2 s: the link died that way under load too --
+	 * the host's bulk OUT never completing, its cdc_ether "transmit queue timed out" every 5 s,
+	 * until usbipd gave the device up, while the phone's own frames kept going out. End the
+	 * transfer and arm it again; on a link that is merely idle that costs nothing.
+	 */
+	/* 0291: configured and no RX transfer at all (nothing armed): arm it */
+	static unsigned rx_unarmed;
+	if (!ud.xfer_active[EP_RX] && !(rt[3] & TRB_HWO)) {
+		if (++rx_unarmed >= 2) {
+			rx_unarmed = 0;
+			ut("RXU", (uint32_t)ud.rx_frames, rt[3]);
+			ud_rx_arm();
+		}
+	} else {
+		rx_unarmed = 0;
+	}
+	static unsigned rx_silent;
+	if (ud.xfer_active[EP_RX] && (rt[3] & TRB_HWO) && ud.rx_frames == ud.watch_rx) {
+		if (++rx_silent >= 4) {
+			rx_silent = 0;
+			ud.rx_rearms++;
+			ut("RRA", ud.rx_rearms, ((volatile uint32_t *)(ud.dma + UD_TRB_RX))[2]);
+			ud_end_transfer(EP_RX);
+			ud_rx_arm();
+		}
+	} else {
+		rx_silent = 0;
+	}
+	ud.watch_rx = ud.rx_frames;
+
+	lck_mtx_lock(ud.lock);
+	ud_sync(UD_TRB_TX, 16);
+	bool tx_idle = ud.tx_busy && !(tt[3] & TRB_HWO) && ud.tx_frames == ud.watch_tx;
+	if (tx_idle && tx_seen) {
+		if (ud.lost_tx++ < 20) {
+			printf("SWEET USB: tx transfer done without an event (%u), going on\n", ud.lost_tx);
+		}
+		ud.xfer_active[EP_TX] = false;
+		ud.tx_busy = false;
+		ud_tx_kick_locked();
+		tx_idle = false;
+	}
+	tx_seen = tx_idle;
+	ud.watch_tx = ud.tx_frames;
+	lck_mtx_unlock(ud.lock);
+}
+
+static int
+sysctl_sweet_usb_stats SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	char buf[320];
+	uint32_t rx3 = 0, tx3 = 0, dsts = 0;
+	if (ud.dma != 0) {
+		ud_sync(UD_TRB_RX, 16);
+		ud_sync(UD_TRB_TX, 16);
+		rx3 = ((volatile uint32_t *)(ud.dma + UD_TRB_RX))[3];
+		tx3 = ((volatile uint32_t *)(ud.dma + UD_TRB_TX))[3];
+		dsts = dwc_rd(DSTS);
+	}
+	snprintf(buf, sizeof(buf), "configured %d events %u resets %u; rx %llu frames (trb %08x, active %d) tx %llu "
+	    "frames (trb %08x, busy %d, queue %u); without event: rx %u tx %u, late rx %u; rx rearms %u; halt clears %u; DSTS %08x",
+	    ud.configured, ud.events, ud.resets, ud.rx_frames, rx3, ud.xfer_active[EP_RX], ud.tx_frames, tx3,
+	    ud.tx_busy, ud.txq_count, ud.lost_rx, ud.lost_tx, ud.stale_rx, ud.rx_rearms, ud.halt_clears, dsts);
+	return SYSCTL_OUT(req, buf, strlen(buf) + 1);
+}
+static int
+sysctl_sweet_usb_trace SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	static char out[UT_N * 40];
+	size_t n = 0;
+	uint32_t start = ut_pos > UT_N ? ut_pos - UT_N : 0;
+	for (uint32_t i = start; i < ut_pos && n + 48 < sizeof(out); i++) {
+		struct ut_ent *e = &ut_ring[i % UT_N];
+		n += (size_t)snprintf(out + n, sizeof(out) - n, "%u %s %08x %08x\n", e->ms, e->what, e->a, e->b);
+	}
+	out[n] = 0;
+	return SYSCTL_OUT(req, out, n + 1);
+}
+SYSCTL_PROC(_kern, OID_AUTO, sweet_usb_trace, CTLTYPE_STRING | CTLFLAG_RD | CTLFLAG_LOCKED,
+    0, 0, sysctl_sweet_usb_trace, "A", "USB gadget trace: ms what a b");
+
+SYSCTL_PROC(_kern, OID_AUTO, sweet_usb_stats, CTLTYPE_STRING | CTLFLAG_RD | CTLFLAG_LOCKED,
+    0, 0, sysctl_sweet_usb_stats, "A", "USB Ethernet gadget state");
+
+static void
+ud_thread(void *arg __unused, wait_result_t wr __unused)
+{
+	uint32_t ticks = 0;
+	for (;;) {
+		uint32_t count = dwc_rd(GEVNTCOUNT) & 0xffff;
+		if (count) {
+			ud_sync(UD_EVT, UD_EVT_SIZE);
+			for (uint32_t done = 0; done < count; done += 4) {
+				uint32_t ev = *(volatile uint32_t *)(ud.dma + UD_EVT + ud.evt_pos);
+				ud.evt_pos = (ud.evt_pos + 4) % UD_EVT_SIZE;
+				if (ud.events++ < 200) {
+					printf("SWEET USB: event 0x%08x\n", ev);
+				}
+				ud_event(ev);
+			}
+			dwc_wr(GEVNTCOUNT, count);
+		}
+		if ((ticks % 500) == 0) {
+			ud_watch();
+		}
+		if ((++ticks % 30000) == 0) {
+			printf("SWEET USB: ue0 rx %llu tx %llu frames\n", ud.rx_frames, ud.tx_frames);
+		}
+		ud_sleep_ms(1);
+	}
+}
+
+/*
+ * Live console log over USB Ethernet: every 100 ms the new bytes of the
+ * console ring (bsd/dev/sweet_ufs.c) go as UDP datagrams to
+ * 192.168.7.1:5140 (on the PC: nc -ukl 5140). Starts with the last 64 KiB
+ * so the boot is included. Nothing here may print (it would feed itself).
+ * Boot-arg sweetusblog=0 disables it.
+ */
+extern uint32_t sweet_log_copy(uint64_t *pos, char *out, uint32_t max);
+extern uint64_t sweet_log_position(void);
+
+static void
+ud_log_thread(void *arg __unused, wait_result_t wr __unused)
+{
+	static char chunk[1400];
+	socket_t so = NULL;
+	struct sockaddr_in to;
+	uint64_t pos = sweet_log_position();
+
+	pos = pos > 65536 ? pos - 65536 : 0;
+	bzero(&to, sizeof(to));
+	to.sin_len = sizeof(to);
+	to.sin_family = AF_INET;
+	to.sin_port = htons(5140);
+	to.sin_addr.s_addr = htonl(0xc0a80701);         /* 192.168.7.1 */
+	for (;;) {
+		ud_sleep_ms(100);
+		if (!ud.configured) {
+			continue;
+		}
+		if (so == NULL && sock_socket(PF_INET, SOCK_DGRAM, IPPROTO_UDP, NULL, NULL, &so) != 0) {
+			so = NULL;
+			continue;
+		}
+		uint32_t n;
+		while ((n = sweet_log_copy(&pos, chunk, sizeof(chunk))) > 0) {
+			struct iovec iov = { .iov_base = chunk, .iov_len = n };
+			struct msghdr msg = {
+				.msg_name = &to, .msg_namelen = sizeof(to),
+				.msg_iov = &iov, .msg_iovlen = 1,
+			};
+			size_t sent = 0;
+			if (sock_send(so, &msg, 0, &sent) != 0) {
+				break;          /* no route/ARP yet: retry later */
+			}
+		}
+	}
+}
+
+static void
+sweet_usb_gadget_start(vm_offset_t dwc)
+{
+	thread_t thread;
+
+	ud.dwc = dwc;
+	if (kmem_alloc_contig(kernel_map, &ud.dma, UD_SIZE, PAGE_MASK, 0, 0,
+	    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		printf("SWEET USB: no DMA memory\n");
+		return;
+	}
+	ppnum_t pn = pmap_find_phys(kernel_pmap, (addr64_t)ud.dma);
+	if (!pn) {
+		return;
+	}
+	ud.dma_pa = ptoa_64(pn);
+	ud_if_create();
+
+	/* Device controller soft reset (PHY and global setup stay as ABL left them). */
+	dwc_wr(DCTL, DCTL_CSFTRST);
+	int i;
+	for (i = 0; i < 500 && (dwc_rd(DCTL) & DCTL_CSFTRST); i++) {
+		delay(1000);
+	}
+	printf("SWEET USB: soft reset %s after %d ms, GCTL 0x%08x DCFG 0x%08x\n",
+	    (dwc_rd(DCTL) & DCTL_CSFTRST) ? "STUCK" : "done", i, dwc_rd(GCTL), dwc_rd(DCFG));
+	if (dwc_rd(DCTL) & DCTL_CSFTRST) {
+		return;
+	}
+
+	dwc_wr(GEVNTADRLO, (uint32_t)(ud.dma_pa + UD_EVT));
+	dwc_wr(GEVNTADRHI, (uint32_t)((ud.dma_pa + UD_EVT) >> 32));
+	dwc_wr(GEVNTSIZ, (1u << 31) | UD_EVT_SIZE);     /* interrupt masked: polled */
+	dwc_wr(GEVNTCOUNT, dwc_rd(GEVNTCOUNT) & 0xffff);
+	ud.evt_pos = 0;
+
+	/* High speed, address 0 */
+	uint32_t dcfg = dwc_rd(DCFG) & ~(7u | (0x7fu << 3));
+	dwc_wr(DCFG, dcfg | 0);
+	/* Events: disconnect, USB reset, connect done */
+	dwc_wr(DEVTEN, 0x7);
+
+	/* Endpoint 0 OUT/IN: start config, control type, max packet 512 until connect done. */
+	if (ud_epcmd(0, DEPCMD_DEPSTARTCFG, 0, 0, 0) ||
+	    ud_epcmd(0, DEPCMD_SETEPCONFIG, (0u << 1) | (512u << 3), (1u << 8) | (1u << 10) | (0u << 25), 0) ||
+	    ud_epcmd(0, DEPCMD_SETTRANSFRESOURCE, 1, 0, 0) ||
+	    ud_epcmd(1, DEPCMD_SETEPCONFIG, (0u << 1) | (512u << 3), (1u << 8) | (1u << 10) | (1u << 25), 0) ||
+	    ud_epcmd(1, DEPCMD_SETTRANSFRESOURCE, 1, 0, 0)) {
+		printf("SWEET USB: endpoint 0 setup failed\n");
+		return;
+	}
+	dwc_wr(DALEPENA, 0x3);
+	ud_start_setup();
+
+	vm_offset_t qs = ml_io_map(QSCRATCH_PA, 0x100);
+	if (qs != 0) {
+		uint32_t hs = usb_rd(qs, QSCRATCH_HS_PHY_CTRL), ss = usb_rd(qs, QSCRATCH_SS_PHY_CTRL);
+		printf("SWEET USB: QSCRATCH HS_PHY_CTRL 0x%08x SS_PHY_CTRL 0x%08x GENERAL_CFG 0x%08x\n",
+		    hs, ss, usb_rd(qs, 0x08));
+		*(volatile uint32_t *)(qs + QSCRATCH_HS_PHY_CTRL) = hs | UTMI_OTG_VBUS_VALID | SW_SESSVLD_SEL;
+		*(volatile uint32_t *)(qs + QSCRATCH_SS_PHY_CTRL) = ss | LANE0_PWR_PRESENT;
+		__asm__ volatile ("dsb sy" ::: "memory");
+		printf("SWEET USB: VBUS override on: HS_PHY_CTRL 0x%08x SS_PHY_CTRL 0x%08x\n",
+		    usb_rd(qs, QSCRATCH_HS_PHY_CTRL), usb_rd(qs, QSCRATCH_SS_PHY_CTRL));
+	}
+
+	dwc_wr(DCTL, dwc_rd(DCTL) | DCTL_RUN_STOP);
+	for (i = 0; i < 500 && (dwc_rd(DSTS) & DSTS_DEVCTRLHLT); i++) {
+		delay(1000);
+	}
+	printf("SWEET USB: running (DSTS 0x%08x after %d ms), DMA at 0x%llx\n", dwc_rd(DSTS), i, ud.dma_pa);
+	if (kernel_thread_start(ud_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+	int livelog = 1;
+	PE_parse_boot_argn("sweetusblog", &livelog, sizeof(livelog));
+	if (livelog && ud.ifp != NULL && kernel_thread_start(ud_log_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
diff --git a/bsd/dev/sweet_vibrate.c b/bsd/dev/sweet_vibrate.c
new file mode 100755
index 0000000..6e46e20
--- /dev/null
+++ b/bsd/dev/sweet_vibrate.c
@@ -0,0 +1,211 @@
+/*
+ * sapphire 0263: the vibration motor. PM7250B LDO vibrator (dtbo 045 fragment 15,
+ * qcom,qpnp-vibrator-ldo): SPMI SID 3, peripheral 0x5300; VSET 0x5340/0x5341 in mV (3000 mV =
+ * 0x0bb8, qcom,vib-ldo-volt-uv), EN_CTL 0x5346 bit 7, STATUS1 0x5308 bit 7 VREG_READY
+ * (leds-qpnp-vibrator-ldo.c). Overdrive is disabled on this board: just on and off.
+ *   kern.sweet_vibrate = N: on for N ms (cap 2000), 0 stops; a new write replaces the running one.
+ *   kern.sweet_vibrate_pattern = "on,off,on,..." (ms, up to 10 steps, each capped at 2000):
+ *     iOS-like patterns; an empty string stops.
+ * The motor is turned off by a thread call; a generation number keeps a stale one from acting.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/sysctl.h>
+#include <sys/errno.h>
+#include <kern/locks.h>
+#include <kern/clock.h>
+#include <kern/thread_call.h>
+#include <libkern/OSAtomic.h>
+#include "sweet_spmi.h"
+
+extern void IODelay(unsigned microseconds);
+int sweet_spmi_read_any(unsigned sid, unsigned addr, uint8_t *out);
+
+#define VIB_SID         3
+#define VIB_STATUS1     0x5308
+#define VIB_VSET_LB     0x5340
+#define VIB_VSET_UB     0x5341
+#define VIB_EN_CTL      0x5346
+#define VIB_MAX_MS      2000
+#define VIB_STEPS       10
+
+static LCK_GRP_DECLARE(sweet_vib_grp, "sweet_vibrate");
+static LCK_MTX_DECLARE(sweet_vib_mtx, &sweet_vib_grp);
+static thread_call_t vib_call;
+static uint64_t vib_gen;
+static bool vib_vset_done, vib_logged, vib_on;
+static int vib_ms;
+static char vib_pattern[96];
+static uint32_t vib_steps[VIB_STEPS], vib_nsteps, vib_step;
+
+/* the motor on or off; sweet_vib_mtx held */
+static int
+vib_set(bool on)
+{
+	int r = 0;
+	if (on && !vib_vset_done) {
+		r = sweet_spmi_write(VIB_SID, VIB_VSET_LB, 0xb8);
+		if (r == 0) {
+			r = sweet_spmi_write(VIB_SID, VIB_VSET_UB, 0x0b);
+		}
+		if (r != 0) {
+			printf("SWEET VIB: setting 3000 mV failed: %d\n", r);
+			return r;
+		}
+		vib_vset_done = true;
+	}
+	uint8_t en = 0;
+	if (sweet_spmi_read_any(VIB_SID, VIB_EN_CTL, &en) != 0) {
+		printf("SWEET VIB: EN_CTL not readable\n");
+		return -1;
+	}
+	r = sweet_spmi_write(VIB_SID, VIB_EN_CTL, on ? (en | 0x80) : (en & 0x7f));
+	if (r == 0 && on) {
+		uint8_t st = 0;
+		for (int i = 0; i < 20; i++) {          /* VREG_READY, bounded (the driver polls ~100 us steps) */
+			if (sweet_spmi_read_any(VIB_SID, VIB_STATUS1, &st) == 0 && (st & 0x80)) {
+				break;
+			}
+			IODelay(100);
+		}
+		if (!vib_logged) {
+			uint8_t lb = 0, ub = 0, en2 = 0;
+			(void)sweet_spmi_read_any(VIB_SID, VIB_VSET_LB, &lb);
+			(void)sweet_spmi_read_any(VIB_SID, VIB_VSET_UB, &ub);
+			(void)sweet_spmi_read_any(VIB_SID, VIB_EN_CTL, &en2);
+			printf("SWEET VIB: first vibration: vset %u mV, en_ctl %#x -> %#x, status1 %#x (ready %u)\n",
+			    lb | (unsigned)ub << 8, en, en2, st, st >> 7);
+			vib_logged = true;
+		}
+	}
+	if (r != 0) {
+		printf("SWEET VIB: motor %s: SPMI write failed %d\n", on ? "on" : "off", r);
+	}
+	vib_on = on && r == 0;
+	return r;
+}
+
+static void
+vib_arm(uint32_t ms)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	thread_call_enter1_delayed(vib_call, (thread_call_param_t)(uintptr_t)vib_gen, deadline);
+}
+
+/* the end of a step: off, or the next pattern step */
+static void
+vib_fire(thread_call_param_t p0 __unused, thread_call_param_t p1)
+{
+	lck_mtx_lock(&sweet_vib_mtx);
+	if ((uint64_t)(uintptr_t)p1 == vib_gen) {
+		if (vib_nsteps != 0 && vib_step + 1 < vib_nsteps) {
+			vib_step++;
+			bool on = (vib_step & 1) == 0;
+			(void)vib_set(on);
+			vib_arm(vib_steps[vib_step]);
+		} else {
+			(void)vib_set(false);
+			vib_nsteps = 0;
+		}
+	}
+	lck_mtx_unlock(&sweet_vib_mtx);
+}
+
+/* a new request: the running one (if any) ends; steps[0] on, steps[1] off, ... */
+static int
+vib_start(const uint32_t *steps, uint32_t n)
+{
+	int r = 0;
+	if (sweet_spmi_init() != 0) {
+		return ENODEV;
+	}
+	if (vib_call == NULL) {
+		thread_call_t c = thread_call_allocate(vib_fire, NULL);
+		if (c == NULL) {
+			return ENOMEM;
+		}
+		if (!OSCompareAndSwapPtr(NULL, c, (void * volatile *)&vib_call)) {
+			thread_call_free(c);
+		}
+	}
+	lck_mtx_lock(&sweet_vib_mtx);
+	vib_gen++;
+	(void)thread_call_cancel(vib_call);
+	vib_nsteps = 0;
+	if (n == 0 || steps[0] == 0) {
+		if (vib_on || n == 0) {
+			r = vib_set(false);
+		}
+	} else {
+		memcpy(vib_steps, steps, n * sizeof(steps[0]));
+		vib_nsteps = n;
+		vib_step = 0;
+		r = vib_set(true);
+		if (r == 0) {
+			vib_arm(steps[0]);
+		} else {
+			vib_nsteps = 0;
+		}
+	}
+	lck_mtx_unlock(&sweet_vib_mtx);
+	return r == 0 ? 0 : EIO;
+}
+
+static int
+sysctl_sweet_vibrate SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	int ms = vib_ms;
+	int err = sysctl_io_number(req, ms, sizeof(ms), &ms, NULL);
+	if (err != 0 || req->newptr == USER_ADDR_NULL) {
+		return err;
+	}
+	ms = ms < 0 ? 0 : ms > VIB_MAX_MS ? VIB_MAX_MS : ms;
+	vib_ms = ms;
+	uint32_t s = (uint32_t)ms;
+	return vib_start(&s, ms == 0 ? 0 : 1);
+}
+
+SYSCTL_PROC(_kern, OID_AUTO, sweet_vibrate, CTLTYPE_INT | CTLFLAG_RW | CTLFLAG_LOCKED,
+    0, 0, sysctl_sweet_vibrate, "I", "vibrate for N ms (max 2000), 0 stops");
+
+static int
+sysctl_sweet_vibrate_pattern SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	char buf[sizeof(vib_pattern)];
+	strlcpy(buf, vib_pattern, sizeof(buf));
+	int err = sysctl_handle_string(oidp, buf, sizeof(buf), req);
+	if (err != 0 || req->newptr == USER_ADDR_NULL) {
+		return err;
+	}
+	uint32_t steps[VIB_STEPS], n = 0;
+	const char *p = buf;
+	while (*p != 0 && n < VIB_STEPS) {
+		uint32_t v = 0;
+		bool digits = false;
+		while (*p >= '0' && *p <= '9') {
+			v = v * 10 + (uint32_t)(*p - '0');
+			v = v > VIB_MAX_MS ? VIB_MAX_MS : v;
+			digits = true;
+			p++;
+		}
+		if (!digits) {
+			return EINVAL;
+		}
+		steps[n++] = v;
+		if (*p == ',') {
+			p++;
+		} else if (*p != 0) {
+			return EINVAL;
+		}
+	}
+	strlcpy(vib_pattern, buf, sizeof(vib_pattern));
+	return vib_start(steps, n);
+}
+
+SYSCTL_PROC(_kern, OID_AUTO, sweet_vibrate_pattern, CTLTYPE_STRING | CTLFLAG_RW | CTLFLAG_LOCKED,
+    0, 0, sysctl_sweet_vibrate_pattern, "A", "vibration pattern: on,off,on,... ms (max 10 steps)");
+#endif /* ARM64_BOARD_CONFIG_SWEET */
