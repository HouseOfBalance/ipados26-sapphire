+/*
+ * topaz (Cortex-A53/A73, ARMv8.0): the iPhone X userland still has LSE
+ * atomics (LD<op>, SWP, CAS) and LDAPR outside its CPU-capability checks.
+ * Emulate them atomically with LDAXR/STLXR on the user address
+ * (machine_routines_asm.s); returns false for anything else (CASP stays
+ * EXC_BAD_INSTRUCTION).
+ */
+static bool
+sweet_emulate_armv83_pac(arm_saved_state_t *state, uint32_t instr)
+{
+	/*
+	 * iPadOS 26.1 (arm64e A12 userland) fallback emulator on Cortex-A73 (ARMv8.0):
+	 * Offline De-PAC rewrites static Mach-Os & DSC, while this handles:
+	 *   - LDRAA / LDRAB with writeback (W=1) or large negative offsets
+	 *   - PACGA Xd, Xn, Xm (deterministic 32-bit upper hash)
+	 *   - Any JIT-emitted PAC/AUT/XPAC/RETAA/BLRAA/BRAA instructions (WebKit/JSC)
+	 */
+	if (instr == 0xD65F0BFFU || instr == 0xD65F0FFFU) { /* RETAA / RETAB */
+		uint64_t lr = get_saved_state_lr(state) & 0x0000FFFFFFFFFFFFULL;
+		set_saved_state_pc(state, lr);
+		return true;
+	}
+	uint32_t top = instr & 0xFFFFF800U;
+	if (top == 0xD61F0800U || top == 0xD61F0C00U || top == 0xD71F0800U || top == 0xD71F0C00U) {
+		/* BRAA / BRAB / BRAAZ / BRABZ */
+		uint32_t rn = (instr >> 5) & 31;
+		uint64_t target = (rn == 31 ? 0 : get_saved_state_reg(state, rn)) & 0x0000FFFFFFFFFFFFULL;
+		set_saved_state_pc(state, target);
+		return true;
+	}
+	if (top == 0xD63F0800U || top == 0xD63F0C00U || top == 0xD73F0800U || top == 0xD73F0C00U) {
+		/* BLRAA / BLRAB / BLRAAZ / BLRABZ */
+		uint32_t rn = (instr >> 5) & 31;
+		uint64_t target = (rn == 31 ? 0 : get_saved_state_reg(state, rn)) & 0x0000FFFFFFFFFFFFULL;
+		set_saved_state_lr(state, get_saved_state_pc(state) + 4);
+		set_saved_state_pc(state, target);
+		return true;
+	}
+	if ((instr & 0xFFFF8000U) == 0xDAC10000U) {
+		/* PAC*, AUT*, XPACI/XPACD â€” preserve Darwin TBI [63:56] on data pointers! */
+		uint32_t op2 = (instr >> 10) & 31;
+		uint32_t rd = instr & 31;
+		if (op2 <= 17 && rd != 31) {
+			bool is_data = (op2 == 2 || op2 == 3 || op2 == 6 || op2 == 7 ||
+			    op2 == 10 || op2 == 11 || op2 == 14 || op2 == 15 || op2 == 17);
+			uint64_t mask = is_data ? 0xFF00FFFFFFFFFFFFULL : 0x0000FFFFFFFFFFFFULL;
+			uint64_t val = get_saved_state_reg(state, rd) & mask;
+			set_saved_state_reg(state, rd, (register_t)val);
+		}
+		if (op2 <= 17) {
+			add_saved_state_pc(state, 4);
+			return true;
+		}
+	}
+	if ((instr & 0xFFFFFC00U) == 0x1E7E0000U) {
+		/* ARMv8.3 FJCVTZS Wd, Dn (JavaScript float64 -> int32 modulo 2^32 + Z flag) */
+		uint32_t rn = (instr >> 5) & 31, rd = instr & 31;
+		thread_t th = current_thread();
+		if (th == THREAD_NULL || th->machine.uNeon == NULL) {
+			return false;
+		}
+		arm_neon_saved_state64_t *ns = neon_state64(th->machine.uNeon);
+		uint64_t bits = (uint64_t)ns->v.q[rn];
+		uint32_t sign = (uint32_t)(bits >> 63);
+		int32_t exp = (int32_t)((bits >> 52) & 0x7FFU) - 1023;
+		uint64_t frac = bits & 0x000FFFFFFFFFFFFFULL;
+		uint32_t res32 = 0;
+		bool exact_int32 = false;
+		if (exp == -1023 && frac == 0) {
+			res32 = 0;
+			exact_int32 = (sign == 0); /* -0.0 sets Z=0 per ARMv8.3 FPConvertJS */
+		} else if (exp >= 0 && exp <= 52) {
+			uint64_t mant = (1ULL << 52) | frac;
+			uint32_t shift = (uint32_t)(52 - exp);
+			uint64_t int_mag = mant >> shift;
+			uint64_t rem = shift ? (mant & ((1ULL << shift) - 1ULL)) : 0ULL;
+			uint32_t u32 = (uint32_t)(int_mag & 0xFFFFFFFFULL);
+			res32 = sign ? (uint32_t)(0U - u32) : u32;
+			if (rem == 0) {
+				exact_int32 = sign ? (int_mag >= 1ULL && int_mag <= 0x80000000ULL) :
+				    (int_mag <= 0x7FFFFFFFULL);
+			}
+		} else if (exp >= 53 && exp <= 83) {
+			uint64_t mant = (1ULL << 52) | frac;
+			uint32_t u32 = (uint32_t)((mant << (exp - 52)) & 0xFFFFFFFFULL);
+			res32 = sign ? (uint32_t)(0U - u32) : u32;
+		}
+		if (rd != 31) {
+			set_saved_state_reg(state, rd, (register_t)res32);
+		}
+		uint32_t cpsr = (get_saved_state_cpsr(state) & ~0xF0000000U) | (exact_int32 ? 0x40000000U : 0U);
+		set_saved_state_cpsr(state, cpsr);
+		add_saved_state_pc(state, 4);
+		return true;
+	}
+	if ((instr & 0xFFFFFFE0U) == 0xD50B7C20U) {
+		/* ARMv8.2 DC CVAP Xt -> clean data cache line to PoC & advance */
+		add_saved_state_pc(state, 4);
+		return true;
+	}
+	if ((instr & 0xFFE0FC00U) == 0x9AC03000U) {
+		/* PACGA Xd, Xn, Xm -> deterministic 32-bit tag in bits [63:32], 0 in [31:0] */
+		uint32_t rm = (instr >> 16) & 31, rn = (instr >> 5) & 31, rd = instr & 31;
+		uint64_t vn = rn == 31 ? 0 : get_saved_state_reg(state, rn);
+		uint64_t vm = rm == 31 ? get_saved_state_sp(state) : get_saved_state_reg(state, rm);
+		uint64_t h = (vn ^ (vm * 0x9E3779B97F4A7C15ULL)) ^ 0x5357454554504143ULL;
+		h ^= (h >> 33);
+		h *= 0xFF51AFD7ED558CCDULL;
+		h &= 0xFFFFFFFF00000000ULL;
+		if (rd != 31) {
+			set_saved_state_reg(state, rd, (register_t)h);
+		}
+		add_saved_state_pc(state, 4);
+		return true;
+	}
+	if ((instr & 0xFF200400U) == 0xF8200400U) {
+		/* LDRAA / LDRAB Xt, [Xn, #simm10*8]{!} */
+		int32_t s = (instr >> 22) & 1;
+		int32_t imm9 = (instr >> 12) & 0x1FF;
+		uint32_t w = (instr >> 11) & 1;
+		uint32_t rn = (instr >> 5) & 31, rt = instr & 31;
+		int64_t byte_off = (int64_t)(s ? (imm9 - 512) : imm9) * 8;
+		uint64_t base = (rn == 31 ? get_saved_state_sp(state) : get_saved_state_reg(state, rn)) & 0x0000FFFFFFFFFFFFULL;
+		user_addr_t addr = (user_addr_t)(base + byte_off);
+		uint64_t loaded = 0;
+		if (addr >= MACH_VM_MAX_ADDRESS || copyin(addr, &loaded, sizeof(loaded)) != 0) {
+			return false;
+		}
+		if (w) {
+			if (rn == 31) {
+				set_saved_state_sp(state, addr);
+			} else {
+				set_saved_state_reg(state, rn, (register_t)addr);
+			}
+		}
+		if (rt != 31) {
+			set_saved_state_reg(state, rt, (register_t)loaded);
+		}
+		add_saved_state_pc(state, 4);
+		return true;
+	}
+	return false;
+}
