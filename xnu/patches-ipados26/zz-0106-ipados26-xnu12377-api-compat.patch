 {
@@ -53,4 +161,7 @@ sysctl_sweet_reboot_mode SYSCTL_HANDLER_ARGS
 
 SYSCTL_PROC(_kern, OID_AUTO, sweet_reboot_mode, CTLTYPE_INT | CTLFLAG_RW | CTLFLAG_LOCKED,
     0, 0, sysctl_sweet_reboot_mode, "I", "where a restart goes: 0 system, 1 recovery, 2 bootloader");
+
+SYSCTL_UINT(_kern, OID_AUTO, sweet_autoreboot, CTLFLAG_RW | CTLFLAG_LOCKED,
+    &sweet_autoreboot_secs, 0, "auto-reboot countdown in seconds (0 = disarmed)");
 #endif /* ARM64_BOARD_CONFIG_SWEET */
