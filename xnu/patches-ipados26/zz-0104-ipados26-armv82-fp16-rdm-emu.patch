+		uint16_t exp = (uint16_t)((((b6 ^ 1U) << 4) | (b6 ? 0xCU : 0U) | ((imm8 >> 4) & 3U)) << 10);
+		uint16_t h = sign | exp | (uint16_t)((imm8 & 0xFU) << 6);
+		__uint128_t out_q = 0;
+		for (uint32_t i = 0; i < (4U << qbit); i++) {
+			out_q |= (__uint128_t)h << (16U * i);
+		}
+		ns->v.q[rd] = out_q;
+		add_saved_state_pc(state, 4);
+		return true;
+	}
+	if ((instr & 0x9F7E0C00U) == 0x0E780800U) {
+		uint32_t qbit = (instr >> 30) & 1U, ubit = (instr >> 29) & 1U;
+		uint32_t abit = (instr >> 23) & 1U, opc = (instr >> 12) & 0x1FU;
+		uint32_t lanes = 4U << qbit;
+		__uint128_t out_q = 0;
+		for (uint32_t i = 0; i < lanes; i++) {
+			uint16_t a = sweet_q_get_h(ns, rn, i), r = 0;
+			if (ubit == 0 && abit == 1 && opc == 0x0F) r = a & 0x7FFFU;
+			else if (ubit == 1 && abit == 1 && opc == 0x0F) r = a ^ 0x8000U;
+			else if (ubit == 1 && abit == 1 && opc == 0x1F) r = sweet_fp16_sqrt(a);
+			else if (ubit == 0 && abit == 0 && opc == 0x1D) r = sweet_s128_to_fp16((__int128)(int16_t)a, 0, false);
+			else if (ubit == 1 && abit == 0 && opc == 0x1D) r = sweet_s128_to_fp16((__int128)(uint16_t)a, 0, false);
+			else if (ubit == 0 && abit == 1 && opc == 0x1B) r = (uint16_t)(int16_t)sweet_fp16_to_int(a, false, false, 3);
+			else if (ubit == 1 && abit == 1 && opc == 0x1B) r = (uint16_t)sweet_fp16_to_int(a, true, false, 3);
+			else if (ubit == 0 && abit == 0 && opc == 0x18) r = sweet_fp16_rint(a, 0);
+			else if (ubit == 0 && abit == 1 && opc == 0x18) r = sweet_fp16_rint(a, 2);
+			else if (ubit == 1 && abit == 0 && opc == 0x18) r = sweet_fp16_rint(a, 4);
+			else if (ubit == 0 && abit == 0 && opc == 0x19) r = sweet_fp16_rint(a, 1);
+			else if (ubit == 0 && abit == 1 && opc == 0x19) r = sweet_fp16_rint(a, 3);
+			else return false;
+			out_q |= (__uint128_t)r << (16U * i);
+		}
+		ns->v.q[rd] = out_q;
+		add_saved_state_pc(state, 4);
+		return true;
+	}
+
+	return false;
