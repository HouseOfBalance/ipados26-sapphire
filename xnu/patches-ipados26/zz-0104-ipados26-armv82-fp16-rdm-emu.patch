+		add_saved_state_pc(state, 4);
+		return true;
+	}
+
+	/* 7. ASIMDHP Vector 3-same (.4H / .8H) */
+	if ((instr & 0x9F600400U) == 0x0E400400U) {
+		uint32_t qbit = (instr >> 30) & 1U, ubit = (instr >> 29) & 1U;
+		uint32_t o2 = (instr >> 23) & 1U, opc = (instr >> 11) & 0x1FU;
