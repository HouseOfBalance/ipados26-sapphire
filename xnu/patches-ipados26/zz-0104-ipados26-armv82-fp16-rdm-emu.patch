+		__uint128_t out_q = 0;
+		for (uint32_t i = 0; i < lanes; i++) {
+			uint16_t a = sweet_q_get_h(ns, rn, i), b = sweet_q_get_h(ns, rm, i);
+			uint16_t c = sweet_q_get_h(ns, rd, i), r = 0;
