+		uint32_t opc = (instr >> 12) & 0xFU;
+		uint32_t idx = (((instr >> 11) & 1U) << 2) | (((instr >> 21) & 1U) << 1) | ((instr >> 20) & 1U);
+		uint16_t b = sweet_q_get_h(ns, rm & 0xFU, idx);
+		uint32_t lanes = 4U << qbit;
+		__uint128_t out_q = 0;
+		for (uint32_t i = 0; i < lanes; i++) {
+			uint16_t a = sweet_q_get_h(ns, rn, i), c = sweet_q_get_h(ns, rd, i), r = 0;
+			if (ubit == 0 && opc == 1) r = sweet_fp16_fma(c, a, b, false, false);
+			else if (ubit == 0 && opc == 5) r = sweet_fp16_fma(c, a, b, true, false);
+			else if (ubit == 0 && opc == 9) r = sweet_fp16_mul(a, b, false);
+			else if (ubit == 1 && opc == 9) r = sweet_fp16_mul(a, b, true);
+			else return false;
+			out_q |= (__uint128_t)r << (16U * i);
+		}
+		ns->v.q[rd] = out_q;
+		add_saved_state_pc(state, 4);
+		return true;
+	}
+
+	/* 9. ASIMDHP Vector 2-reg misc & Vector FMOV #imm8 (.4H / .8H) */
+	if ((instr & 0xBFF8FC00U) == 0x0F00FC00U) {
+		uint32_t qbit = (instr >> 30) & 1U;
+		uint32_t imm8 = (((instr >> 16) & 7U) << 5) | ((instr >> 5) & 0x1FU);
+		uint16_t sign = (uint16_t)((imm8 >> 7) << 15);
