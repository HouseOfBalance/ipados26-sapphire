+		}
+		ns->v.q[rd] = out_q;
+		add_saved_state_pc(state, 4);
+		return true;
+	}
+
+	/* 8. ASIMDHP Vector by-element (.4H / .8H: FMLA, FMLS, FMUL, FMULX) */
+	if ((instr & 0x9FC00400U) == 0x0F000000U) {
